{
  "version": 2,
  "buildCommand": "node src/ingest.js",
  "functions": {
    "api/index.js": {
      "includeFiles": "stores/**, src/**, data/index.json, data/gallery-manifest.json, public/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
