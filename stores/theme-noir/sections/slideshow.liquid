    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 300,
      "max": 500,
      "step": 2,
      "unit": "px",
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "%",
          "default": 46
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Things worth keeping"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Better meals, happier days"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Beautiful kitchenware made for the meals you'll remember."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore the collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#0f0c08"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Made to gather",
            "heading": "Set a table to remember",
            "text": "Serveware and linens for slow weekends."
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Seasonal edit",
            "heading": "Cook with the seasons",
            "text": "Fresh tools for fresh produce."
          }
        }
      ]
    }
  ]
}
  {% endschema %}
