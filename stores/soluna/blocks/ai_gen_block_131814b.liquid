{% doc %}
  @prompt
    Generate me an image with text overlay section.
    
    Give me option to upload seperate images for mobile vs computer.
    
    Have a button that reads Explore Now.
    The button needs to be link style and when hovered over, the underline forms and the text enlarges by 1 px.
    
    Give me the option to add heading and subheading.
    
    Give me ability to choose the alignment for heading, subheading and button seperately for mobile and computer.
    
    Make the Heading read: Elite Magic. Now Available.
    Keep the subheading empty for now.
    
    Have the heading and button at the bottom of the section as default., Give me option to change the font everywhere.
    
    Also make all the content centered horizontally by default.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-overlay-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-image-text-overlay__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    overflow: hidden;
  }

  .ai-image-text-overlay__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-overlay__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-overlay__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: {{ block.settings.content_padding }}px;
    z-index: 1;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }}--desktop-top {
    justify-content: flex-start;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }}--desktop-center {
    justify-content: center;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }}--desktop-bottom {
    justify-content: flex-end;
  }

  .ai-image-text-overlay__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-image-text-overlay__heading-{{ ai_gen_id }}--desktop-left {
    text-align: left;
  }

  .ai-image-text-overlay__heading-{{ ai_gen_id }}--desktop-center {
    text-align: center;
  }

  .ai-image-text-overlay__heading-{{ ai_gen_id }}--desktop-right {
    text-align: right;
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
    line-height: 1.4;
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }}--desktop-left {
    text-align: left;
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }}--desktop-center {
    text-align: center;
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }}--desktop-right {
    text-align: right;
  }

  .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }} {
    display: flex;
  }

  .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--desktop-left {
    justify-content: flex-start;
  }

  .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--desktop-center {
    justify-content: center;
  }

  .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--desktop-right {
    justify-content: flex-end;
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }} {
    color: {{ block.settings.button_color }};
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    font-size: {{ block.settings.button_size }}px;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
    display: inline-block;
    transition: font-size 0.3s ease;
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: {{ block.settings.button_color }};
    transition: width 0.3s ease;
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }}:hover {
    font-size: calc({{ block.settings.button_size }}px + 1px);
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }}:hover::after {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-overlay__image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-image-text-overlay__image-{{ ai_gen_id }}--desktop {
      display: none;
    }

    .ai-image-text-overlay__image-{{ ai_gen_id }}--mobile {
      display: block;
    }

    .ai-image-text-overlay__content-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-image-text-overlay__content-{{ ai_gen_id }}--mobile-top {
      justify-content: flex-start;
    }

    .ai-image-text-overlay__content-{{ ai_gen_id }}--mobile-center {
      justify-content: center;
    }

    .ai-image-text-overlay__content-{{ ai_gen_id }}--mobile-bottom {
      justify-content: flex-end;
    }

    .ai-image-text-overlay__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-image-text-overlay__heading-{{ ai_gen_id }}--mobile-left {
      text-align: left;
    }

    .ai-image-text-overlay__heading-{{ ai_gen_id }}--mobile-center {
      text-align: center;
    }

    .ai-image-text-overlay__heading-{{ ai_gen_id }}--mobile-right {
      text-align: right;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_size }}px;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }}--mobile-left {
      text-align: left;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }}--mobile-center {
      text-align: center;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }}--mobile-right {
      text-align: right;
    }

    .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--mobile-left {
      justify-content: flex-start;
    }

    .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--mobile-center {
      justify-content: center;
    }

    .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--mobile-right {
      justify-content: flex-end;
    }

    .ai-image-text-overlay__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_size }}px;
    }

    .ai-image-text-overlay__button-{{ ai_gen_id }}:hover {
      font-size: calc({{ block.settings.mobile_button_size }}px + 1px);
    }
  }

  @media screen and (min-width: 750px) {
    .ai-image-text-overlay__image-{{ ai_gen_id }}--desktop {
      display: block;
    }

    .ai-image-text-overlay__image-{{ ai_gen_id }}--mobile {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-image-text-overlay-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-overlay__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.desktop_image.width }}"
        height="{{ block.settings.desktop_image.height }}"
        class="ai-image-text-overlay__image-{{ ai_gen_id }} ai-image-text-overlay__image-{{ ai_gen_id }}--desktop"
      >
    {% else %}
      <div class="ai-image-text-overlay__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.mobile_image %}
      <img
        src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
        alt="{{ block.settings.mobile_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.mobile_image.width }}"
        height="{{ block.settings.mobile_image.height }}"
        class="ai-image-text-overlay__image-{{ ai_gen_id }} ai-image-text-overlay__image-{{ ai_gen_id }}--mobile"
      >
    {% elsif block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 1000 }}"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.desktop_image.width }}"
        height="{{ block.settings.desktop_image.height }}"
        class="ai-image-text-overlay__image-{{ ai_gen_id }} ai-image-text-overlay__image-{{ ai_gen_id }}--mobile"
      >
    {% endif %}

    <div class="ai-image-text-overlay__content-{{ ai_gen_id }} ai-image-text-overlay__content-{{ ai_gen_id }}--desktop-{{ block.settings.desktop_vertical_alignment }} ai-image-text-overlay__content-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_vertical_alignment }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-text-overlay__heading-{{ ai_gen_id }} ai-image-text-overlay__heading-{{ ai_gen_id }}--desktop-{{ block.settings.desktop_heading_alignment }} ai-image-text-overlay__heading-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_heading_alignment }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-image-text-overlay__subheading-{{ ai_gen_id }} ai-image-text-overlay__subheading-{{ ai_gen_id }}--desktop-{{ block.settings.desktop_subheading_alignment }} ai-image-text-overlay__subheading-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_subheading_alignment }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <div class="ai-image-text-overlay__button-wrapper-{{ ai_gen_id }} ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--desktop-{{ block.settings.desktop_button_alignment }} ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_button_alignment }}">
          <a href="{{ block.settings.button_link }}" class="ai-image-text-overlay__button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

