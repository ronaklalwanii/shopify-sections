{%- style -%}
  /* Load Fonts from Font Picker */
  {%- if section.settings.base_font_family != blank -%}
    {{ section.settings.base_font_family | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.eyebrow_font_family != blank -%}
    {{ section.settings.eyebrow_font_family | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.heading_font_family != blank -%}
    {{ section.settings.heading_font_family | font_face: font_display: 'swap' }}
  {%- endif -%}

  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.section {
    padding-block-start: 0 !important;
    padding-block-end: 0 !important;
    --ul-content-section-spacing-block-start: 0 !important;
    --ul-content-section-spacing-block-end: 0 !important;
    --ul-section-outer-spacing-block: 0 !important;
    margin: 0 !important;
  }

  .cts-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    {%- if section.settings.base_font_family != blank -%}
      font-family: {{ section.settings.base_font_family.family }}, {{ section.settings.base_font_family.fallback_families }};
    {%- else -%}
      font-family: Helvetica, Arial, sans-serif;
    {%- endif -%}
    position: relative;
  }

  .cts-{{ section.id }} .cts-swiper {
    position: relative;
  }

  .cts-{{ section.id }} .cts-swiper {
    overflow: hidden;
  }

  /* Self-contained Swiper base layout — don't depend on theme swiper CSS
     being loaded by another section on the page. */
  .cts-{{ section.id }} .cts-swiper .swiper-wrapper {
    display: flex;
    align-items: stretch;
  }

  .cts-{{ section.id }} .cts-swiper .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: auto;
  }

  .cts-slide {
    display: grid;
    grid-template-columns: minmax(280px, 32%) 1fr;
    gap: 56px;
    align-items: start;
    width: 100%;
    height: auto;
  }

  /* --- Left: text --- */
  .cts-text-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .cts-eyebrow {
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
    display: block;
    {%- if section.settings.eyebrow_font_family != blank -%}
      font-family: {{ section.settings.eyebrow_font_family.family }}, {{ section.settings.eyebrow_font_family.fallback_families }};
    {%- else -%}
      font-family: Arial, sans-serif;
    {%- endif -%}
  }

  .cts-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    {%- if section.settings.heading_font_family != blank -%}
      font-family: {{ section.settings.heading_font_family.family }}, {{ section.settings.heading_font_family.fallback_families }};
    {%- else -%}
      font-family: Georgia, serif;
    {%- endif -%}
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.15;
    margin: 0 0 20px 0;
    text-wrap: balance;
  }

  .cts-stars {
    color: {{ section.settings.star_color }};
    font-size: 18px;
    margin-bottom: 16px;
    letter-spacing: 3px;
    line-height: 1;
  }

  .cts-quote {
    font-size: {{ section.settings.quote_font_size }}px;
    color: {{ section.settings.quote_color }};
    line-height: 1.6;
    margin: 0 0 16px 0;
    font-style: italic;
  }

  .cts-author {
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  /* --- Right: image card --- */
  .cts-image-col {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    max-height: 400px;
  }

  .cts-image-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --- Carousel controls: [← arrow] [dots] [→ arrow] under the author --- */
  .cts-controls {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  /* Desktop: JS anchors the controls right below the active slide's text
     column instead of below the (much taller) image card. */
  @media (min-width: 901px) {
    .cts-controls {
      position: absolute;
      left: 0;
      margin-top: 0;
    }
  }

  .cts-controls .cts-pagination {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cts-controls .cts-pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ section.settings.dot_inactive_color }};
    opacity: 1;
    transition: background 0.25s ease, transform 0.25s ease;
    margin: 0;
  }

  .cts-controls .cts-pagination .swiper-pagination-bullet-active {
    background: {{ section.settings.dot_active_color }};
    transform: scale(1.15);
  }

  .cts-arrow {
    pointer-events: auto;
    appearance: none;
    width: 42px;
    height: 42px;
    border-radius: 2px;
    border: 1px solid {{ section.settings.arrow_border_color }};
    background: transparent;
    color: {{ section.settings.arrow_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.25s ease, background 0.25s ease;
  }

  .cts-arrow:hover {
    opacity: 0.65;
  }

  .cts-arrow.swiper-button-disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* --- Mobile --- */
  @media (max-width: 900px) {
    .cts-slide {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .cts-image-col {
      aspect-ratio: 4 / 5;
      border-radius: 16px;
    }

    .cts-heading {
      font-size: 32px !important;
    }

    .cts-controls {
      margin-top: 28px;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="cts-{{ section.id }}">
  <div class="swiper cts-swiper" data-cts-section="{{ section.id }}">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide cts-slide" {{ block.shopify_attributes }}>
          <div class="cts-text-col">
            {%- if section.settings.eyebrow_text != blank -%}
              <span class="cts-eyebrow">{{ section.settings.eyebrow_text }}</span>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="cts-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.rating > 0 -%}
              <div class="cts-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <p class="cts-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            {%- endif -%}

            {%- if block.settings.author != blank -%}
              <p class="cts-author">&mdash; {{ block.settings.author }}</p>
            {%- endif -%}
          </div>

          <div class="cts-image-col">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1400 }}"
                alt="{{ block.settings.author | default: 'Customer' | escape }}"
                loading="lazy"
                widths="400, 600, 800, 1000, 1200, 1400"
                sizes="(min-width: 901px) 65vw, 100vw"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_controls -%}
      <div class="cts-controls">
        <button type="button" class="cts-arrow cts-prev" aria-label="Previous testimonial">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <div class="cts-pagination swiper-pagination"></div>
        <button type="button" class="cts-arrow cts-next" aria-label="Next testimonial">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    // Vendor loader — same guard pattern as the theme's hero section so Swiper
    // is injected exactly once per page regardless of how many swiper sections
    // render. The string is split so "</scri" + "pt>" never appears contiguous.
    if (document.readyState === 'loading') {
      if (!window.__mhVendorRequested) {
        window.__mhVendorRequested = true;
        document.write('<scri' + 'pt src="{{ "sleek-hero-vendor.js" | asset_url }}" defer><' + '/scri' + 'pt>');
      }
    }
  })();
</script>
<script>
  (function () {
    var sectionId = '{{ section.id }}';

    function swiperApi() {
      // The theme's vendor bundle (sleek-hero-vendor.js) exposes Swiper under
      // window.FoxTheme.Swiper — there is no window.Swiper global.
      if (window.FoxTheme && window.FoxTheme.Swiper && window.FoxTheme.Swiper.Swiper) {
        return window.FoxTheme.Swiper;
      }
      return null;
    }

    function initCts() {
      var api = swiperApi();
      if (!api) {
        // Vendor bundle is deferred and may land after this script; poll briefly.
        if (initCts.tries === undefined) initCts.tries = 0;
        if (initCts.tries < 50) {
          initCts.tries++;
          setTimeout(initCts, 100);
        }
        return;
      }

      var root = document.querySelector('.cts-swiper[data-cts-section="' + sectionId + '"]');
      if (!root || root.dataset.ctsInit === '1') return;
      root.dataset.ctsInit = '1';

      var autoplay = {% if section.settings.autoplay %}{{ section.settings.autoplay_delay | times: 1000 }}{% else %}0{% endif %};

      var modules = [];
      if (api.Navigation) modules.push(api.Navigation);
      if (api.Pagination) modules.push(api.Pagination);
      if (api.Keyboard) modules.push(api.Keyboard);
      if (api.Autoplay && autoplay > 0) modules.push(api.Autoplay);

      var options = {
        modules: modules,
        slidesPerView: 1,
        spaceBetween: 24,
        watchOverflow: true,
        grabCursor: true,
        {% if section.settings.show_controls %}
        pagination: {
          el: root.querySelector('.cts-pagination'),
          clickable: true
        },
        navigation: {
          prevEl: root.querySelector('.cts-prev'),
          nextEl: root.querySelector('.cts-next')
        },
        keyboard: { enabled: true },
        {% endif %}
        {% if section.settings.autoplay %}
        autoplay: { delay: autoplay, disableOnInteraction: false, pauseOnMouseEnter: true },
        loop: true,
        {% endif %}
        a11y: true
      };

      if (window.FoxTheme && window.FoxTheme.Carousel) {
        root.ctsSwiper = new window.FoxTheme.Carousel(root, options);
        root.ctsSwiper.init();
      } else {
        root.ctsSwiper = new api.Swiper(root, options);
      }

      // Desktop: anchor controls right below the active slide's text column.
      var controls = root.querySelector('.cts-controls');
      if (controls) {
        var place = function () {
          if (!window.matchMedia('(min-width: 901px)').matches) {
            controls.style.top = '';
            return;
          }
          var textCol =
            root.querySelector('.swiper-slide-active .cts-text-col') ||
            root.querySelector('.swiper-slide .cts-text-col');
          if (textCol) {
            controls.style.top = textCol.offsetTop + textCol.offsetHeight + 24 + 'px';
          }
        };
        var inst = root.ctsSwiper.slider || root.ctsSwiper;
        if (typeof inst.on === 'function') inst.on('slideChange', place);
        window.addEventListener('resize', place);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);
        place();
      }
    }

    function destroyCts() {
      var root = document.querySelector('.cts-swiper[data-cts-section="' + sectionId + '"]');
      if (root && root.ctsSwiper) {
        var instance = root.ctsSwiper.slider || root.ctsSwiper;
        if (typeof instance.destroy === 'function') instance.destroy(true, true);
        root.dataset.ctsInit = '0';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCts);
    } else {
      initCts();
    }

    // Theme editor hot-reload: re-init on section re-render, clean up on unload.
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === sectionId) initCts();
    });
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail.sectionId === sectionId) destroyCts();
    });
  })();
</script>

{% schema %}
{
  "name": "Testimonial Showcase",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
