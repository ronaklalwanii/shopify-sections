{%- comment -%} Arena Process — accordion 01-05 + lobby image {%- endcomment -%}
<section id="ArenaProcess-{{ section.id }}" class="ap">
  {%- style -%}
    #ArenaProcess-{{ section.id }} {
      --ap-bg: {{ section.settings.bg_color }};
      --ap-max-w: {{ section.settings.max_width }}px;
      --ap-gutter: {{ section.settings.gutter }}px;
      --ap-space-top: {{ section.settings.space_top }}px;
      --ap-space-bottom: {{ section.settings.space_bottom }}px;
      --ap-radius: {{ section.settings.radius }}px;
      --ap-pad: {{ section.settings.card_pad }}px;
      --ap-gap: {{ section.settings.gap }}px;
      --ap-card-bg: {{ section.settings.card_bg }};
      --ap-border: {{ section.settings.border_color }};
    }
    #ArenaProcess-{{ section.id }} { background: var(--ap-bg); padding: var(--ap-space-top) var(--ap-gutter) var(--ap-space-bottom); overflow-x: clip; }
    #ArenaProcess-{{ section.id }} .ap__shell { width: min(100%, var(--ap-max-w)); margin: 0 auto; display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--ap-gap); min-width: 0; align-items: stretch; }
    #ArenaProcess-{{ section.id }} .ap__left { background: var(--ap-card-bg); border: 1px solid var(--ap-border); border-radius: var(--ap-radius); padding: var(--ap-pad); min-width: 0; }
    #ArenaProcess-{{ section.id }} .ap__heading { margin: 0; font-family: Georgia, serif; font-size: {{ section.settings.heading_size }}px; color: #2B2117; line-height: 1.2; font-weight: 400; }
    #ArenaProcess-{{ section.id }} .ap__list { margin-top: 20px; border-top: 1px solid #EDE3D3; }
    #ArenaProcess-{{ section.id }} .ap__item { display: grid; grid-template-columns: 32px 1fr 24px; gap: 10px; padding: 16px 0; border-bottom: 1px solid #EDE3D3; cursor: pointer; align-items: start; }
    #ArenaProcess-{{ section.id }} .ap__num { font-size: 11px; color: #9A8A78; padding-top: 2px; }
    #ArenaProcess-{{ section.id }} .ap__q { font-size: 14px; font-weight: 500; color: #2B2117; line-height: 1.4; margin: 0; }
    #ArenaProcess-{{ section.id }} .ap__icon { width: 24px; height: 24px; border-radius: 50%; border: 1px solid #C2A78A; color: #C2A78A; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; line-height: 1; flex-shrink: 0; transition: transform 250ms ease, background 200ms ease; }
    #ArenaProcess-{{ section.id }} .ap__item.is-open .ap__icon { background: #2B2117; color: #fff; border-color: #2B2117; transform: rotate(45deg); }
    #ArenaProcess-{{ section.id }} .ap__a { grid-column: 2; color: #6B5E4F; font-size: 12px; line-height: 1.6; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 320ms cubic-bezier(.22,1,.36,1), opacity 200ms ease, margin-top 200ms ease; margin-top: 0; }
    #ArenaProcess-{{ section.id }} .ap__item.is-open .ap__a { max-height: 200px; opacity: 1; margin-top: 8px; }
    #ArenaProcess-{{ section.id }} .ap__media { border-radius: var(--ap-radius); overflow: hidden; background: #EDE3D3; min-height: 420px; position: relative; }
    #ArenaProcess-{{ section.id }} .ap__media img { width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0; }
    @media (max-width: 900px) {
      #ArenaProcess-{{ section.id }} .ap__shell { grid-template-columns: 1fr; }
      #ArenaProcess-{{ section.id }} .ap__media { min-height: 320px; }
    }
  {%- endstyle -%}
  <div class="ap__shell">
    <div class="ap__left">
      <h2 class="ap__heading">{{ section.settings.heading | newline_to_br }}</h2>
      <div class="ap__list">
        {%- for block in section.blocks -%}
          <div class="ap__item{% if section.settings.open_last and forloop.last %} is-open{% elsif forloop.first and section.settings.open_first %} is-open{% endif %}" data-ap-item {{ block.shopify_attributes }}>
            <span class="ap__num">{{ block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div style="min-width:0">
              <p class="ap__q">{{ block.settings.title }}</p>
              <div class="ap__a rte">{{ block.settings.text }}</div>
            </div>
            <span class="ap__icon">+</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="ap__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1200" height="800">
      {%- else -%}
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#9A8A78;font-size:13px;">Upload lobby image</div>
      {%- endif -%}
    </div>
  </div>
  <script>
    (() => {
      const root = document.getElementById('ArenaProcess-{{ section.id }}');
      if (!root) return;
      root.querySelectorAll('[data-ap-item]').forEach(el=>{
        el.addEventListener('click', ()=>{
          const open = el.classList.contains('is-open');
          root.querySelectorAll('[data-ap-item]').forEach(i=>i.classList.remove('is-open'));
          if (!open) el.classList.add('is-open');
        });
      });
    })();
  </script>
</section>
{% schema %}
{
  "name": "Arena Process",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Page bg", "default": "#FDF6E8" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 900, "max": 1800, "step": 20, "default": 1400, "unit": "px" },
    { "type": "range", "id": "gutter", "label": "Gutter", "min": 0, "max": 40, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 80, "step": 4, "default": 12, "unit": "px" },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 80, "step": 4, "default": 12, "unit": "px" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 0, "max": 32, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "card_pad", "label": "Card padding", "min": 16, "max": 32, "step": 2, "default": 22, "unit": "px" },
    { "type": "range", "id": "gap", "label": "Gap", "min": 12, "max": 32, "step": 2, "default": 16, "unit": "px" },
    { "type": "color", "id": "card_bg", "label": "Card bg", "default": "#F5EBDC" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#EDE3D3" },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "How we create\ncomfortable urban environment" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 40, "step": 2, "default": 28, "unit": "px" },
    { "type": "image_picker", "id": "image", "label": "Right image (lobby)" },
    { "type": "checkbox", "id": "open_first", "label": "Open first", "default": false },
    { "type": "checkbox", "id": "open_last", "label": "Open last step", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number" },
        { "type": "text", "id": "title", "label": "Title", "default": "Design" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Detailed description.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arena Process",
      "blocks": [
        { "type": "step", "settings": { "title": "Design", "text": "<p>Concept, drawings, and approvals.</p>" } },
        { "type": "step", "settings": { "title": "Construction", "text": "<p>Foundations to handing over keys.</p>" } },
        { "type": "step", "settings": { "title": "Landscaping", "text": "<p>Courtyards, greenery, and playgrounds.</p>" } },
        { "type": "step", "settings": { "title": "Lobby finishing", "text": "<p>Entrance groups with designer finish.</p>" } },
        { "type": "step", "settings": { "title": "Handover and support", "text": "<p>Handover and key transfer. After commissioning, we escort you to handover of keys and apartment — support with paperwork, questions, and aftercare.</p>" } }
      ]
    }
  ]
}
{% endschema %}