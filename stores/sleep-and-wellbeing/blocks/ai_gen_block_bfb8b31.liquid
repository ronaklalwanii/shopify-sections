{% doc %}
  @prompt
    generate me a cool newsletter section and connect it to the newsletter settijg for the store. 
    
    Content as below:
    
    Here are a few options:
    
    Option 1 — Early access angle:
    Heading: Get There First.
    Subheading: New drops, exclusive offers, and early access straight to your inbox.
    Button: Count Me In
    
    Button needs to be rounded square. 
    
    Background needs to be black with white text and design , correct the code as it is not proper, Give me option to change the font everywhere.
    
    Give me options to change all the things in this section.
    
    M<ake the enter your rmail and button in same line.
    
    Make the section a bit interesting, Give me ability to control the font size seperately in desktop and mobile, Give me ability to control the height of the section manually in computer and in mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-newsletter-{{ ai_gen_id }} {
    display: block;
    {% if block.settings.background_type == 'solid' %}
      background: {{ block.settings.background_color }};
    {% else %}
      background: linear-gradient({{ block.settings.gradient_angle }}deg, {{ block.settings.gradient_color_1 }}, {{ block.settings.gradient_color_2 }});
    {% endif %}
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    {% if block.settings.height_mode == 'fixed' %}
      min-height: {{ block.settings.section_height_desktop }}px;
      display: flex;
      align-items: {{ block.settings.vertical_alignment }};
    {% endif %}
  }

  .ai-newsletter-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: {{ block.settings.accent_color }};
    opacity: {{ block.settings.accent_opacity | divided_by: 100.0 }};
    border-radius: 50%;
    filter: blur({{ block.settings.accent_blur }}px);
    pointer-events: none;
  }

  .ai-newsletter-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -5%;
    width: 400px;
    height: 400px;
    background: {{ block.settings.accent_color_2 }};
    opacity: {{ block.settings.accent_opacity | divided_by: 100.0 }};
    border-radius: 50%;
    filter: blur({{ block.settings.accent_blur }}px);
    pointer-events: none;
  }

  .ai-newsletter-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .ai-newsletter-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_text_transform }};
  }

  .ai-newsletter-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.subheading_size_desktop }}px;
    margin: 0 0 {{ block.settings.form_spacing }}px 0;
    opacity: {{ block.settings.subheading_opacity | divided_by: 100.0 }};
    line-height: 1.5;
  }

  .ai-newsletter-form-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    gap: {{ block.settings.form_gap }}px;
    align-items: stretch;
    justify-content: center;
    max-width: {{ block.settings.form_max_width }}px;
    margin: 0 auto;
  }

  .ai-newsletter-input-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-newsletter-input-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    padding: {{ block.settings.input_padding_vertical }}px {{ block.settings.input_padding_horizontal }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.input_font_size_desktop }}px;
  }

  .ai-newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_text_color }};
    opacity: {{ block.settings.placeholder_opacity | divided_by: 100.0 }};
  }

  .ai-newsletter-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
    box-shadow: 0 0 0 {{ block.settings.input_focus_ring_width }}px {{ block.settings.input_focus_ring_color }};
  }

  .ai-newsletter-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_font_size_desktop }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
  }

  .ai-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY({{ block.settings.button_hover_lift }}px);
  }

  .ai-newsletter-message-{{ ai_gen_id }} {
    margin-top: 16px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 14px;
  }

  .ai-newsletter-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-newsletter-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-newsletter-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
      {% if block.settings.height_mode == 'fixed' %}
        min-height: {{ block.settings.section_height_mobile }}px;
      {% endif %}
    }

    .ai-newsletter-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-newsletter-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-newsletter-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_font_size_mobile }}px;
    }

    .ai-newsletter-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size_mobile }}px;
    }

    .ai-newsletter-form-wrapper-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      gap: {{ block.settings.mobile_form_gap }}px;
    }

    {% if block.settings.mobile_layout == 'column' %}
      .ai-newsletter-button-{{ ai_gen_id }} {
        width: 100%;
      }
    {% endif %}
  }
{% endstyle %}

<newsletter-signup-{{ ai_gen_id }}
  class="ai-newsletter-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-newsletter-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-newsletter-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-newsletter-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    {% form 'contact' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <div class="ai-newsletter-form-wrapper-{{ ai_gen_id }}">
        <div class="ai-newsletter-input-wrapper-{{ ai_gen_id }}">
          <input
            type="email"
            name="contact[email]"
            class="ai-newsletter-input-{{ ai_gen_id }}"
            value="{{ form.email }}"
            placeholder="{{ block.settings.email_placeholder }}"
            aria-label="Email address"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-newsletter-error-{{ ai_gen_id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="ai-newsletter-success-{{ ai_gen_id }}"
            {% endif %}
            required
          >
        </div>

        <button
          type="submit"
          class="ai-newsletter-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>
      </div>

      {% if form.errors or form.posted_successfully? %}
        <div class="ai-newsletter-message-{{ ai_gen_id }}">
          {% if form.errors %}
            <div
              id="ai-newsletter-error-{{ ai_gen_id }}"
              class="ai-newsletter-error-{{ ai_gen_id }}"
            >
              {{ form.errors.messages.email }}
            </div>
          {% elsif form.posted_successfully? %}
            <div
              id="ai-newsletter-success-{{ ai_gen_id }}"
              class="ai-newsletter-success-{{ ai_gen_id }}"
            >
              {{ block.settings.success_message }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endform %}
  </div>
</newsletter-signup-{{ ai_gen_id }}>

<script>
  (function() {
    class NewsletterSignup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const emailInput = this.form.querySelector('input[type="email"]');
        if (emailInput && !emailInput.value) {
          event.preventDefault();
        }
      }
    }

    customElements.define('newsletter-signup-{{ ai_gen_id }}', NewsletterSignup{{ ai_gen_id }});
  })();
</script>

