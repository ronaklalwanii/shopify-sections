{%- comment -%}
  Decorative bloom — layered stylised peony in rose tones (background ornament).
  Accepts: class (extra classes)
{%- endcomment -%}
<svg class="bloom {{ class }}" viewBox="0 0 200 200" aria-hidden="true">
  <g fill="none">
    <circle cx="100" cy="100" r="96" fill="#5a1b23"/>
    <g fill="#6d222b">
      <ellipse cx="100" cy="52" rx="26" ry="46"/>
      <ellipse cx="100" cy="148" rx="26" ry="46"/>
      <ellipse cx="52" cy="100" rx="46" ry="26"/>
      <ellipse cx="148" cy="100" rx="46" ry="26"/>
    </g>
    <g fill="#7e2a33" transform="rotate(45 100 100)">
      <ellipse cx="100" cy="56" rx="22" ry="40"/>
      <ellipse cx="100" cy="144" rx="22" ry="40"/>
      <ellipse cx="56" cy="100" rx="40" ry="22"/>
      <ellipse cx="144" cy="100" rx="40" ry="22"/>
    </g>
    <circle cx="100" cy="100" r="34" fill="#8f323b"/>
    <circle cx="100" cy="100" r="22" fill="#a03b42"/>
    <g fill="#c96b62">
      <circle cx="92" cy="94" r="4"/>
      <circle cx="108" cy="96" r="3.4"/>
      <circle cx="100" cy="110" r="3.8"/>
      <circle cx="90" cy="106" r="2.8"/>
      <circle cx="110" cy="106" r="2.6"/>
    </g>
  </g>
</svg>
