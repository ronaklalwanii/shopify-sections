{%- comment -%}
  Product callouts — central image with labeled callout points around it
  (Suncare "Why choose" pattern). Horizon-safe.
{%- endcomment -%}
<section class="pcl pcl-{{ section.id }}" style="--pcl-accent: {{ section.settings.accent_color }};">
  <div class="page-width">
    <div class="pcl__intro">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2 pcl__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    <div class="pcl__stage">
      <div class="pcl__blob" aria-hidden="true"></div>
      <div class="pcl__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', alt: section.settings.heading }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pcl__placeholder' }}
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="pcl__callout pcl__callout--{{ block.settings.position }}" {{ block.shopify_attributes }}>
          <span class="pcl__callout-icon">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          <p class="pcl__callout-title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}<p class="pcl__callout-text">{{ block.settings.text | escape }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  .pcl-{{ section.id }} { padding-block: var(--section-space); background: var(--color-background); }
  .pcl-{{ section.id }} .pcl__intro { text-align: center; margin-bottom: clamp(2rem, 5vh, 3.5rem); }
  .pcl-{{ section.id }} .pcl__stage {
    position: relative;
    max-width: 46rem; margin-inline: auto;
    display: flex; justify-content: center;
  }
  .pcl-{{ section.id }} .pcl__blob {
    position: absolute; inset: 4% 8%;
    background: var(--pcl-accent); opacity: 0.16;
    border-radius: 48% 52% 55% 45% / 55% 48% 52% 45%;
  }
  .pcl-{{ section.id }} .pcl__media { position: relative; z-index: 1; width: min(60%, 22rem); }
  .pcl-{{ section.id }} .pcl__media img, .pcl-{{ section.id }} .pcl__placeholder { width: 100%; border-radius: 18px; display: block; }
  .pcl-{{ section.id }} .pcl__placeholder { background: #e5e0d5; }
  .pcl-{{ section.id }} .pcl__callout { position: absolute; z-index: 2; max-width: 11rem; }
  .pcl-{{ section.id }} .pcl__callout--top-left { top: 0; left: 0; text-align: right; }
  .pcl-{{ section.id }} .pcl__callout--top-right { top: 0; right: 0; }
  .pcl-{{ section.id }} .pcl__callout--bottom-left { bottom: 4%; left: 2%; text-align: right; }
  .pcl-{{ section.id }} .pcl__callout--bottom-right { bottom: 4%; right: 2%; }
  .pcl-{{ section.id }} .pcl__callout-icon { color: var(--pcl-accent); }
  .pcl-{{ section.id }} .pcl__callout-title { font-weight: 700; font-size: 0.92rem; margin-top: 0.3rem; }
  .pcl-{{ section.id }} .pcl__callout-text { font-size: 0.72rem; color: var(--color-text-muted); line-height: 1.5; margin-top: 0.2rem; }
  @media (max-width: 749px) {
    .pcl-{{ section.id }} .pcl__stage { flex-direction: column; gap: 1.5rem; }
    .pcl-{{ section.id }} .pcl__callout { position: static; max-width: none; text-align: left !important; }
    .pcl-{{ section.id }} .pcl__blob { inset: 10% 4%; }
  }
{% endstyle %}
{% schema %}
{
  "name": "Product callouts",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose us" },
    { "type": "image_picker", "id": "image", "label": "Center image" },
    { "type": "color", "id": "accent_color", "label": "Accent blob color", "default": "#7ba888" }
  ],
  "blocks": [
    {
      "type": "callout", "name": "Callout",
      "settings": [
        { "type": "select", "id": "position", "label": "Position", "options": [
          { "value": "top-left", "label": "Top left" }, { "value": "top-right", "label": "Top right" },
          { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-right", "label": "Bottom right" }
        ], "default": "top-left" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "leaf", "label": "Leaf" }, { "value": "sparkle", "label": "Sparkle" },
          { "value": "flower", "label": "Flower" }, { "value": "heart", "label": "Heart" },
          { "value": "drop" , "label": "Moisture" }, { "value": "shield", "label": "Shield" }
        ], "default": "leaf" },
        { "type": "text", "id": "title", "label": "Title", "default": "Natural" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    { "name": "Product callouts", "blocks": [
      { "type": "callout", "settings": { "position": "top-left", "icon": "leaf", "title": "Natural", "text": "97% natural ingredients" } },
      { "type": "callout", "settings": { "position": "top-right", "icon": "sparkle", "title": "Cooling", "text": "Soothes on contact" } },
      { "type": "callout", "settings": { "position": "bottom-left", "icon": "shield", "title": "Non-Toxic", "text": "Free of parabens" } },
      { "type": "callout", "settings": { "position": "bottom-right", "icon": "drop", "title": "Hydrating", "text": "72h moisture" } }
    ] }
  ]
}
{% endschema %}
