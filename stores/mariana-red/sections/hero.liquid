{%- comment -%}
  Hero image banner. Two layouts:
  - split: content on one side, image on the other (boutique look)
  - full:  full-bleed image with overlaid content (noir / homeware look)
  Buttons are blocks so merchants can add/remove/reorder.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign height = section.settings.height
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }}
  class="hero hero--{{ layout }}{% if layout == 'split' and section.settings.image_position == 'left' %} hero--image-left{% elsif layout == 'split' %} hero--image-right{% endif %} hero__height-{{ height }}"
  style="{% if layout == 'full' %}--overlay-color: rgba(0,0,0,{{ overlay }});{% endif %} {% if layout == 'split' and section.settings.image_height != blank %}--split-image-height: {{ section.settings.image_height }}px;{% endif %}"
>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '640, 960, 1280, 1600, 2400',
        sizes: '100vw',
        alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if layout == 'full' -%}
    <div class="hero__overlay" style="--overlay-color: linear-gradient(90deg, rgba(0,0,0,{{ overlay }}), rgba(0,0,0,{{ overlay | times: 0.3 }}));" aria-hidden="true"></div>
  {%- endif -%}

  {%- liquid
    assign hp = section.settings.product
    if hp.title == blank
      assign hp = all_products[hp]
    endif
  -%}
  <div class="{% if layout == 'full' %}page-width hero__stage{% endif %} hero__content-wrap" style="display: flex; width: {% if layout == 'split' %}100%{% endif %};">
    <div
      class="hero__content{% if layout == 'split' %} hero__content--{{ section.settings.content_align }}{% endif %}"
      style="{% if layout == 'split' %}margin-inline: auto; margin-left: max(calc((100vw - var(--page-width)) / 2 + clamp(1rem, 4vw, 3rem)), clamp(1rem, 4vw, 3rem));{% endif %} text-align: {{ section.settings.text_align }};"
    >
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading {{ section.settings.heading_size }}{% if section.settings.fluid_heading %} hero__heading--fluid{% endif %}">
          {{ section.settings.heading | escape | newline_to_br }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="hero__text">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__buttons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              {% render 'button',
                label: block.settings.label,
                link: block.settings.link,
                style: block.settings.style,
                attributes: block.shopify_attributes
              %}
            {%- endif -%}
          {%- endfor -%}
          {%- if layout == 'full' and section.settings.show_button_arrow -%}
            <span class="hero__btn-arrow" aria-hidden="true">{% render 'icon', name: 'arrow-up-right', size: 15 %}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.avatars_count > 0 or section.settings.meta_text != blank or section.settings.rating_value != blank -%}
        <div class="hero__meta">
          {%- if section.settings.avatars_count > 0 -%}
            <div class="hero__avatars">
              {%- for i in (1..section.settings.avatars_count) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign av = section.settings.avatar_1 -%}
                  {%- when 2 -%}{%- assign av = section.settings.avatar_2 -%}
                  {%- when 3 -%}{%- assign av = section.settings.avatar_3 -%}
                  {%- when 4 -%}{%- assign av = section.settings.avatar_4 -%}
                {%- endcase -%}
                {%- if av != blank -%}
                  {{ av | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  <span style="display:inline-flex;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--color-background-secondary);border:2px solid var(--color-background);"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.rating_value != blank or section.settings.meta_text != blank -%}
            <div class="hero__meta-copy">
              {%- if section.settings.rating_value != blank -%}
                <p class="hero__meta-rating">{{ section.settings.rating_value | escape }} {% render 'rating', rating: 5 %}</p>
              {%- endif -%}
              {%- if section.settings.meta_text != blank -%}
                <p class="hero__meta-text">{{ section.settings.meta_text | escape | newline_to_br }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if layout == 'full' -%}
      {%- if section.settings.side_text != blank -%}
        <p class="hero__side">{{ section.settings.side_text | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if hp != blank and hp.title != blank -%}
        <div class="hero__product-card">
          <a href="{{ hp.url }}" class="hero__product-media" aria-label="{{ hp.title | escape }}" tabindex="-1">
            {%- if hp.featured_media -%}
              {{ hp.featured_media | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 480', alt: hp.title }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="hero__product-row">
            <a href="{{ hp.url }}" class="hero__product-info">
              <span class="hero__product-title">{{ hp.title | escape }}</span>
              <span class="hero__product-price">{{ hp.price | money }}</span>
            </a>
            {%- if hp.available -%}
              {%- if hp.variants.size == 1 -%}
                {%- form 'product', hp, id: nil, class: 'hero__product-form' -%}
                  <input type="hidden" name="id" value="{{ hp.selected_or_first_available_variant.id }}">
                  <button type="submit" class="hero__product-plus" aria-label="{{ 'products.product.add_to_cart' | t }}">
                    {% render 'icon', name: 'plus', size: 14 %}
                  </button>
                {%- endform -%}
              {%- else -%}
                <a href="{{ hp.url }}" class="hero__product-plus" aria-label="{{ 'products.product.add_to_cart' | t }}">
                  {% render 'icon', name: 'plus', size: 14 %}
                </a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.script_text != blank -%}
        <p class="hero__script" style="{% if section.settings.script_color != blank %}color: {{ section.settings.script_color }};{% endif %}">
          {{- section.settings.script_text | escape -}}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if layout == 'full' and section.settings.scroll_label != blank -%}
    <a href="{{ section.settings.scroll_link | default: '#main' }}" class="hero__scroll">
      <span class="icon-button">{% render 'icon', name: 'arrow-down', size: 14 %}</span>
      {{ section.settings.scroll_label | escape }}
    </a>
  {%- endif -%}
</section>

<style>
  .hero--split .hero__media img { height: 100%; }
  @media (min-width: 990px) {
    .hero--split .hero__media img { max-height: var(--split-image-height, 620px); }
  }

  /* Full-bleed composition (Pyko): heading top-left, side note top-right,
     floating product card, avatars bottom-left, script note bottom-right. */
  .hero--full .hero__stage { position: relative; width: 100%; display: block; }
  .hero--full .hero__content { max-width: 40rem; padding-block: clamp(4rem, 9vh, 6.5rem); }
  .hero--full .hero__buttons .button--light { color: #2f2a24; }
  .hero__btn-arrow {
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: #ffffff; color: #2f2a24;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .hero__side {
    position: absolute; top: clamp(4.5rem, 9vh, 6.5rem); right: 0;
    max-width: 15.5rem; margin: 0;
    font-size: 0.82rem; line-height: 1.6;
  }
  .hero__product-card {
    position: absolute; left: 50%; bottom: 7%;
    transform: translateX(-50%);
    width: 12.5rem;
    background: #ffffff; color: #2f2a24;
    border-radius: 1.1rem; padding: 0.55rem 0.55rem 0.7rem;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.2);
    display: block; text-decoration: none;
  }
  .hero__product-media { display: block; border-radius: 0.8rem; overflow: hidden; aspect-ratio: 1 / 1.02; background: var(--color-background-secondary, #e9e0cf); }
  .hero__product-media img, .hero__product-media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__product-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.5rem; margin-top: 0.55rem; }
  .hero__product-info { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; text-decoration: none; }
  .hero__product-title { font-size: 0.86rem; font-weight: 600; line-height: 1.3; margin: 0; color: #2f2a24; }
  .hero__product-price { font-size: 0.76rem; color: rgba(0,0,0,0.55); margin: 0; }
  .hero__product-form { margin: 0; line-height: 0; }
  .hero__product-plus {
    width: 2.1rem; height: 2.1rem; border-radius: 50%; flex-shrink: 0;
    background: #1c1a16; color: #ffffff;
    display: inline-flex; align-items: center; justify-content: center;
    border: none; cursor: pointer; text-decoration: none;
  }
  .hero__product-plus:hover { filter: brightness(1.3); }
  .hero__script {
    position: absolute; right: 3%; bottom: 9%;
    margin: 0; text-align: center;
    font-family: var(--font-heading); font-style: italic; font-weight: 500;
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    transform: rotate(-9deg);
    pointer-events: none;
  }
  .hero--full .hero__meta { position: absolute; left: 0; bottom: 7%; margin: 0; }
  .hero__meta-copy { display: flex; flex-direction: column; gap: 0.1rem; }
  .hero__meta-rating { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 700; margin: 0; }
  .hero__meta-rating svg { width: 0.85em; height: 0.85em; }
  @media (max-width: 989px) {
    .hero--full .hero__content-wrap { display: block !important; }
    .hero__side { display: none; }
    .hero--full .hero__meta { position: static; margin-top: 1.8rem; }
    .hero__product-card { position: static; transform: none; margin: 1.8rem auto 0; }
    .hero__script { right: 6%; bottom: 3.5%; font-size: 1.5rem; }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Split \u2014 content beside image"
        },
        {
          "value": "full",
          "label": "Full width \u2014 content over image"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (split layout)",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image max height (split layout)",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height (full layout)",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (full layout)",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Wear the Story.\nLive the Style."
    },
    {
      "type": "checkbox",
      "id": "fluid_heading",
      "label": "Fluid wordmark size (scales with viewport)",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "Display"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p><em>Timeless designs. Thoughtfully crafted. Made for your every moment.</em></p>"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content vertical alignment (split)",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "textarea",
      "id": "side_text",
      "label": "Side note (full layout)",
      "info": "Small paragraph shown at the top right of a full-bleed hero."
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "Show circular arrow beside button (full layout)",
      "default": false
    },
    {
      "type": "header",
      "content": "Floating product card (full layout)"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Handwritten note (full layout)"
    },
    {
      "type": "text",
      "id": "script_text",
      "label": "Note text"
    },
    {
      "type": "color",
      "id": "script_color",
      "label": "Note color",
      "default": "#e4b54a"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "range",
      "id": "avatars_count",
      "label": "Avatar count",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0
    },    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "image_picker",
      "id": "avatar_4",
      "label": "Avatar 4"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "info": "e.g. 4.5 — shown with five stars above the social proof text."
    },
    {
      "type": "textarea",
      "id": "meta_text",
      "label": "Social proof text"
    },
    {
      "type": "header",
      "content": "Scroll hint (full layout)"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "scroll_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Accent"
            },
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "light",
              "label": "Light"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Shop new arrivals",
            "style": "primary"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Explore collections",
            "style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}
