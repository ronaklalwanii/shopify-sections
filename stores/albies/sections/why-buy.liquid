{%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
{%- style -%}
  /* Override theme's default section spacing */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.section {
    padding: 0 20px !important;
    --ul-content-section-spacing-block-start: 0 !important;
    --ul-content-section-spacing-block-end: 0 !important;
    --ul-section-outer-spacing-block: 0 !important;
    margin: 0 !important;
  }

  .section-why-buy-{{ section.id }} {
    /* max-width: 1440px; */
    margin: 0 auto !important;
    border-radius: {{ section.settings.border_radius }}px;
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
  }

  {%- if section.settings.full_width -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }}.section {
      padding: 0 !important;
    }
    
    .section-why-buy-{{ section.id }} {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    
    .why-buy-container,
    .why-buy-research-bar {
      padding-left: 40px;
      padding-right: 40px;
    }
  {%- endif -%}

  .why-buy-container {
    /* max-width: 1400px; */
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 25%) 1fr;
    gap: 32px;
    align-items: center;
  }

  /* Left Column */
  .why-buy-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    min-width: 0;
  }

  .why-buy-eyebrow {
    font-family: {{ section.settings.eyebrow_font_family }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    color: {{ section.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .why-buy-heading {
    font-family: {{ section.settings.heading_font_family }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
    margin: 0 0 8px 0;
  }

  .why-buy-description {
    font-family: {{ section.settings.desc_font_family }};
    font-size: {{ section.settings.desc_font_size }}px;
    font-weight: {{ section.settings.desc_font_weight }};
    color: {{ section.settings.desc_color }};
    line-height: 1.5;
    margin-bottom: 0;
    max-width: 100%;
  }

  /* Filled Button Style (only renders when text set) */
  .why-buy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    font-family: {{ section.settings.btn_font_family }};
    font-size: {{ section.settings.btn_font_size }}px;
    font-weight: {{ section.settings.btn_font_weight }};
    color: {{ section.settings.btn_text_color }};
    background-color: {{ section.settings.btn_bg_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 16px 32px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
    min-width: 200px;
  }

  .why-buy-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .why-buy-btn .arrow {
    font-size: 16px;
    line-height: 1;
  }

  /* Right Column: Features */
  .why-buy-features {
    display: grid;
    grid-template-columns: repeat({{ feature_blocks.size | at_least: 1 }}, 1fr);
    gap: 0;
    align-items: stretch;
  }

  .why-buy-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4px 16px;
    position: relative;
    min-width: 0;
  }

  .why-buy-feature-icon-wrap {
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    flex-shrink: 0;
  }

  /* Vertical divider between features */
  .why-buy-feature:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 10%;
    bottom: 10%;
    width: 1px;
    background-color: {{ section.settings.divider_color }};
  }

  .why-buy-feature-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.7;
  }

  .why-buy-feature-ordinal {
    font-family: {{ section.settings.stat_font_family }};
    font-size: 13px;
    font-weight: 600;
    color: {{ section.settings.stat_color }};
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .why-buy-feature-stat {
    font-family: {{ section.settings.stat_font_family }};
    font-size: {{ section.settings.stat_font_size }}px;
    font-weight: 400;
    color: {{ section.settings.stat_color }};
    line-height: 1;
    margin-bottom: 10px;
    white-space: nowrap;
  }

  .why-buy-feature-stat .stat-unit {
    font-size: 0.5em;
    font-weight: 400;
    margin-left: 4px;
    vertical-align: baseline;
  }

  .why-buy-feature-title {
    font-family: {{ section.settings.feature_title_font_family }};
    font-size: {{ section.settings.feature_title_font_size }}px;
    font-weight: {{ section.settings.feature_title_font_weight }};
    color: {{ section.settings.feature_title_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .why-buy-feature-divider {
    width: 30px;
    height: 1px;
    background-color: {{ section.settings.divider_color }};
    margin: 6px auto 10px auto;
  }

  .why-buy-feature-desc {
    font-family: {{ section.settings.feature_desc_font_family }};
    font-size: {{ section.settings.feature_desc_font_size }}px;
    font-weight: {{ section.settings.feature_desc_font_weight }};
    color: {{ section.settings.feature_desc_color }};
    line-height: 1.45;
    margin: 0;
  }

  /* Sources row: tiny, one line, no border */
  .why-buy-research-bar {
    max-width: 1400px;
    margin: 16px auto 0;
    padding-top: 0;
    border-top: none;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .why-buy-research-bar .why-buy-research-icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .why-buy-research-bar .why-buy-research-icon-wrap img,
  .why-buy-research-bar .why-buy-research-icon-wrap svg {
    display: block !important;
    object-fit: contain;
    width: 20px;
    height: 20px;
  }

  .why-buy-research-bar .why-buy-research-icon-wrap svg {
    stroke: {{ section.settings.research_icon_color }};
    fill: none;
  }

  .why-buy-research-content {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .why-buy-research-label {
    font-family: {{ section.settings.feature_title_font_family }};
    font-size: 11px;
    font-weight: 700;
    color: {{ section.settings.feature_title_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    flex-shrink: 0;
    text-decoration: none;
    display: inline-block;
    opacity: 0.75;
  }

  .why-buy-research-label:hover {
    opacity: 0.6;
  }

  .why-buy-research-citations {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    font-family: {{ section.settings.feature_desc_font_family }};
    font-size: 11px;
    color: {{ section.settings.feature_desc_color }};
    line-height: 1.5;
    min-width: 200px;
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: 0.75;
  }

  .why-buy-research-citations li {
    margin: 0;
  }

  .why-buy-citation-link {
    display: inline;
    font-family: {{ section.settings.btn_font_family }};
    font-size: {{ section.settings.btn_font_size | plus: 1 }}px;
    font-weight: {{ section.settings.btn_font_weight }};
    color: {{ section.settings.research_link_color }};
    text-decoration: underline;
    text-decoration-color: {{ section.settings.research_link_underline_color }};
    text-underline-offset: 4px;
    transition: opacity 0.3s ease;
  }

  .why-buy-citation-link:hover {
    opacity: 0.7;
  }

  .why-buy-citation-link .citation-arrow {
    font-size: 13px;
    margin-left: 6px;
    text-decoration: none;
  }

  /* Mobile Layout */
  @media (max-width: 900px) {
    .section-why-buy-{{ section.id }} {
      padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }}.section {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }

    {%- if section.settings.full_width -%}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }}.section {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
      
      .why-buy-container,
      .why-buy-research-bar {
        padding-left: 20px;
        padding-right: 20px;
      }
    {%- endif -%}

    .why-buy-container {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .why-buy-content {
      align-items: center;
      text-align: center;
    }

    .why-buy-features {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .why-buy-feature {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
      justify-content: flex-start;
      padding: 16px 0;
      gap: 16px;
    }

    .why-buy-feature:not(:last-child)::after {
      right: auto;
      left: 0;
      bottom: 0;
      top: auto;
      width: 100%;
      height: 1px;
      background-color: {{ section.settings.divider_color }};
    }

    .why-buy-feature-icon-wrap {
      width: 32px;
      height: 32px;
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .why-buy-feature-ordinal{
      display: none;
    }

    
    .why-buy-feature-stat {
      min-width: 60px;
    }

    .why-buy-feature-text {
      flex: 1;
    }

    .why-buy-feature-title {
      text-transform: none;
      font-size: 15px;
      margin-bottom: 6px;
    }

    .why-buy-feature-divider {
      display: none;
    }

    .why-buy-btn {
      width: 100%;
      max-width: 300px;
    }

    .why-buy-research-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-top: 16px;
    }

    .why-buy-research-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
{%- endstyle -%}

<div class="section-why-buy-{{ section.id }}">
  <div class="why-buy-container">

    <!-- Left Column -->
    <div class="why-buy-content">
      {%- if section.settings.eyebrow_text != blank -%}
        <span class="why-buy-eyebrow">{{ section.settings.eyebrow_text }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="why-buy-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="why-buy-description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link }}" class="why-buy-btn">
          {{ section.settings.btn_text }}
          {%- if section.settings.show_arrow -%}
            <span class="arrow">&rarr;</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>

    <!-- Right Column: Features -->
    <div class="why-buy-features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="why-buy-feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="why-buy-feature-icon-wrap">
                <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" class="why-buy-feature-icon" loading="lazy">
              </div>
            {%- endif -%}

            {%- if section.settings.show_ordinal_number -%}
              <span class="why-buy-feature-ordinal">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {%- endif -%}

            {%- if section.settings.show_stat_number and block.settings.stat_number != blank -%}
              <div class="why-buy-feature-stat">
                {{ block.settings.stat_number }}
              </div>
            {%- endif -%}

            <div class="why-buy-feature-text">
              {%- if block.settings.title != blank -%}
                <h3 class="why-buy-feature-title">{{ block.settings.title }}</h3>
                <div class="why-buy-feature-divider"></div>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="why-buy-feature-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

  <!-- Sources row -->
  {%- if section.settings.show_research_bar -%}
    <div class="why-buy-research-bar">
      {%- if section.settings.show_research_icon -%}
        <div class="why-buy-research-icon-wrap">
          {%- if section.settings.research_icon != blank -%}
            <img src="{{ section.settings.research_icon | image_url: width: 80 }}" alt="" loading="lazy">
          {%- else -%}
            <svg viewBox="0 0 48 48" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="10" y="6" width="28" height="36" rx="2"/>
              <path d="M16 16h16M16 24h16M16 32h10"/>
            </svg>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="why-buy-research-content">
        {%- if section.settings.research_link != blank -%}
          <a href="{{ section.settings.research_link }}" class="why-buy-research-label" target="_blank" rel="noopener">{{ section.settings.research_label_text }}</a>
        {%- else -%}
          <span class="why-buy-research-label">{{ section.settings.research_label_text }}</span>
        {%- endif -%}

        <ul class="why-buy-research-citations">
          {%- assign has_citations = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'citation' and block.settings.citation_text != blank -%}
              {%- assign has_citations = true -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.citation_link != blank -%}
                  <a href="{{ block.settings.citation_link }}" class="why-buy-citation-link" target="_blank" rel="noopener">{{ block.settings.citation_text }}<span class="citation-arrow">&rarr;</span></a>
                {%- else -%}
                  {{ block.settings.citation_text }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- unless has_citations -%}
            {%- if section.settings.research_citations != blank -%}
              {%- assign citation_lines = section.settings.research_citations | newline_to_br | split: '<br />' -%}
              {%- for line in citation_lines -%}
                {%- if line != blank -%}
                  <li>{{ line | strip }}</li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endunless -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Research Backed",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Haircare by the numbers." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Backed by research. Proven by science." },
    { "type": "text", "id": "btn_text", "label": "Button Text"},
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "checkbox", "id": "show_arrow", "label": "Show Arrow Icon", "default": true },

    { "type": "header", "content": "Sources Bar" },
    { "type": "checkbox", "id": "show_research_bar", "label": "Show sources bar", "default": true },
    { "type": "text", "id": "research_label_text", "label": "Sources label", "default": "Sources:" },
    { "type": "url", "id": "research_link", "label": "Label link (optional)" },
    { "type": "checkbox", "id": "show_research_icon", "label": "Show research icon", "default": false },
    { "type": "image_picker", "id": "research_icon", "label": "Research icon (optional)" },
    { "type": "color", "id": "research_icon_color", "label": "Research icon color", "default": "#8c7b70" },
    { "type": "textarea", "id": "research_citations", "label": "Citations fallback (one per line)", "info": "Cannot be linked; use Citation blocks. Ignored when Citation blocks exist." },
    { "type": "color", "id": "research_link_color", "label": "Citation link color", "default": "#8c7b70" },
    { "type": "color", "id": "research_link_underline_color", "label": "Citation link underline color", "default": "#8c7b70" },

    { "type": "header", "content": "Feature Display" },
    { "type": "checkbox", "id": "show_ordinal_number", "label": "Show row number (01, 02...)", "default": false },
    { "type": "checkbox", "id": "show_stat_number", "label": "Show large stat number", "default": true },

    { "type": "header", "content": "Section Layout" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 50, "step": 1, "unit": "px", "label": "Border Radius", "default": 16 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },

    { "type": "header", "content": "Section Padding" },
    { "type": "range", "id": "section_padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Top Padding", "default": 28 },
    { "type": "range", "id": "section_padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Bottom Padding", "default": 28 },
    { "type": "range", "id": "section_padding_horizontal", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Left/Right Padding", "default": 40 },

    { "type": "header", "content": "Eyebrow Typography" },
    { "type": "font_picker", "id": "eyebrow_font_family", "label": "Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "eyebrow_font_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Font Size", "default": 12 },
    { "type": "select", "id": "eyebrow_font_weight", "label": "Font Weight", "options": [ { "value": "400", "label": "Normal" }, { "value": "600", "label": "Semi Bold" }, { "value": "700", "label": "Bold" } ], "default": "600" },
    { "type": "color", "id": "eyebrow_color", "label": "Color", "default": "#8c7b70" },

    { "type": "header", "content": "Heading Typography" },
    { "type": "font_picker", "id": "heading_font_family", "label": "Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "heading_font_size", "min": 20, "max": 60, "step": 1, "unit": "px", "label": "Font Size", "default": 32 },
    { "type": "select", "id": "heading_font_weight", "label": "Font Weight", "options": [ { "value": "400", "label": "Normal" }, { "value": "600", "label": "Semi Bold" }, { "value": "700", "label": "Bold" } ], "default": "400" },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#1a1a1a" },

    { "type": "header", "content": "Description Typography" },
    { "type": "font_picker", "id": "desc_font_family", "label": "Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "desc_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font Size", "default": 14 },
    { "type": "select", "id": "desc_font_weight", "label": "Font Weight", "options": [ { "value": "400", "label": "Normal" }, { "value": "600", "label": "Semi Bold" } ], "default": "400" },
    { "type": "color", "id": "desc_color", "label": "Color", "default": "#555555" },

    { "type": "header", "content": "Button Typography" },
    { "type": "font_picker", "id": "btn_font_family", "label": "Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "btn_font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Font Size", "default": 12 },
    { "type": "select", "id": "btn_font_weight", "label": "Font Weight", "options": [ { "value": "400", "label": "Normal" }, { "value": "600", "label": "Semi Bold" }, { "value": "700", "label": "Bold" } ], "default": "700" },
    { "type": "color", "id": "btn_text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "btn_bg_color", "label": "Background Color", "default": "#8c7b70" },

    { "type": "header", "content": "Stat Typography" },
    { "type": "font_picker", "id": "stat_font_family", "label": "Stat Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "stat_font_size", "min": 24, "max": 80, "step": 2, "unit": "px", "label": "Stat Number Size", "default": 44 },
    { "type": "color", "id": "stat_color", "label": "Stat Color", "default": "#1a1a1a" },

    { "type": "header", "content": "Feature Items Typography" },
    { "type": "font_picker", "id": "feature_title_font_family", "label": "Title Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "feature_title_font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Title Font Size", "default": 13 },
    { "type": "select", "id": "feature_title_font_weight", "label": "Title Font Weight", "options": [ { "value": "400", "label": "Normal" }, { "value": "600", "label": "Semi Bold" }, { "value": "700", "label": "Bold" } ], "default": "700" },
    { "type": "color", "id": "feature_title_color", "label": "Title Color", "default": "#1a1a1a" },
    { "type": "font_picker", "id": "feature_desc_font_family", "label": "Description Font Family", "default": "assistant_n4" },
    { "type": "range", "id": "feature_desc_font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Description Font Size", "default": 13 },
    { "type": "select", "id": "feature_desc_font_weight", "label": "Description Font Weight", "options": [ { "value": "400", "label": "Normal" }, { "value": "600", "label": "Semi Bold" } ], "default": "400" },
    { "type": "color", "id": "feature_desc_color", "label": "Description Color", "default": "#555555" },

