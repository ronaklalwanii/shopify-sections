{%- comment -%}
  Section: Hero With Products
  Full-bleed hero + overlapping product panel (blocks).
  Desktop: aligned panel grid. Mobile: horizontal snap-scroll.
{%- endcomment -%}

{%- liquid
  if section.settings.desktop_columns == 'auto'
    assign cols = section.blocks.size | at_most: 4 | at_least: 1
  else
    assign cols = section.settings.desktop_columns | plus: 0
  endif
  assign cols_md = cols | at_most: 3
-%}

<section id="HeroProducts-{{ section.id }}" class="hp hp--align-{{ section.settings.panel_align }}">
  {%- style -%}
     #shopify-section-{{ section.id }} {
      padding: 0 !important;
      margin: 0 !important;
    }
    #HeroProducts-{{ section.id }} {
      --hp-page-bg: {{ section.settings.page_background }};
      --hp-overlay: {{ section.settings.overlay_color }};
      --hp-overlay-a: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --hp-hero-h: {{ section.settings.hero_height }}px;
      --hp-hero-h-m: {{ section.settings.hero_height_mobile }}px;
      --hp-nudge: {{ section.settings.content_nudge }}px;
      --hp-pos: {{ section.settings.image_position }};
      --hp-badge-color: {{ section.settings.badge_color }};
      --hp-badge-size: {{ section.settings.badge_text_size }}px;
      --hp-badge-spacing: {{ section.settings.badge_spacing }}px;
      --hp-emblem: {{ section.settings.badge_emblem_size }}px;
      --hp-head-color: {{ section.settings.heading_color }};
      --hp-head-size: {{ section.settings.heading_size }}px;
      --hp-head-size-m: {{ section.settings.heading_size_mobile }}px;
      --hp-head-weight: {{ section.settings.heading_weight }};
      --hp-sub-color: {{ section.settings.subtitle_color }};
      --hp-sub-size: {{ section.settings.subtitle_size }}px;
      --hp-sub-spacing: {{ section.settings.subtitle_spacing }}px;
      --hp-cta-bg: {{ section.settings.cta_bg }};
      --hp-cta-text: {{ section.settings.cta_text_color }};
      --hp-cta-radius: {{ section.settings.cta_radius }}px;
      --hp-cta-size: {{ section.settings.cta_size }}px;
      --hp-cta-px: {{ section.settings.cta_pad_x }}px;
      --hp-cta-py: {{ section.settings.cta_pad_y }}px;
      --hp-panel-w: {{ section.settings.panel_width }}%;
      --hp-overlap: {{ section.settings.panel_overlap }}px;
      --hp-panel-bg: {{ section.settings.panel_bg }};
      --hp-panel-pad: {{ section.settings.panel_padding }}px;
      --hp-panel-radius: {{ section.settings.panel_radius }}px;
      --hp-gap: {{ section.settings.panel_gap }}px;
      --hp-mobile-card: {{ section.settings.mobile_card_width }}%;
      --hp-card-title-size: {{ section.settings.card_title_size }}px;
      --hp-card-title-color: {{ section.settings.card_title_color }};
      --hp-divider: {{ section.settings.divider_color }};
      --hp-divider-w: {{ section.settings.divider_width }}px;
      --hp-btn-radius: {{ section.settings.card_btn_radius }}px;
      --hp-btn-size: {{ section.settings.card_btn_size }}px;
      --hp-speed: {{ section.settings.animation_speed }}ms;
      --hp-ease: cubic-bezier(.22, 1, .36, 1);
    }

    #HeroProducts-{{ section.id }} {
      background: var(--hp-page-bg);
      padding-bottom: {{ section.settings.bottom_space }}px;
      overflow-x: clip;
    }

    /* ---------- Hero ---------- */
    #HeroProducts-{{ section.id }} .hp__hero {
      position: relative;
      overflow: hidden;
    }
    #HeroProducts-{{ section.id }} .hp__bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--hp-pos);
    }
    #HeroProducts-{{ section.id }} .hp__bg-img--mobile { display: none; }
    #HeroProducts-{{ section.id }} .hp__overlay {
      position: absolute;
      inset: 0;
      background: var(--hp-overlay);
      opacity: var(--hp-overlay-a);
      pointer-events: none;
    }
    #HeroProducts-{{ section.id }} .hp__content {
      position: relative;
      z-index: 2;
      min-height: var(--hp-hero-h);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 48px 20px calc(var(--hp-overlap) * 0.6);
      transform: translateY(var(--hp-nudge));
    }

    #HeroProducts-{{ section.id }} .hp__badge-row {
      display: flex;
      align-items: center;
      gap: 16px;
      color: var(--hp-badge-color);
      transition: opacity var(--hp-speed) ease, transform var(--hp-speed) var(--hp-ease);
    }
    #HeroProducts-{{ section.id }} .hp__badge-text {
      font-size: var(--hp-badge-size);
      letter-spacing: var(--hp-badge-spacing);
      text-transform: uppercase;
      line-height: 1;
    }
    #HeroProducts-{{ section.id }} .hp__badge-emblem img {
      display: block;
      width: var(--hp-emblem);
      height: auto;
    }

    #HeroProducts-{{ section.id }} .hp__heading {
      margin: 18px 0 0;
      color: var(--hp-head-color);
      font-size: var(--hp-head-size);
      font-weight: var(--hp-head-weight);
      font-family: Georgia, 'Times New Roman', serif;
      {% if section.settings.heading_italic %}font-style: italic;{% endif %}
      line-height: 1.1;
      transition: opacity var(--hp-speed) ease 80ms, transform var(--hp-speed) var(--hp-ease) 80ms;
    }

    #HeroProducts-{{ section.id }} .hp__subtitle {
      margin: 14px 0 0;
      color: var(--hp-sub-color);
      font-size: var(--hp-sub-size);
      letter-spacing: var(--hp-sub-spacing);
      {% if section.settings.subtitle_uppercase %}text-transform: uppercase;{% endif %}
      line-height: 1.4;
      transition: opacity var(--hp-speed) ease 160ms, transform var(--hp-speed) var(--hp-ease) 160ms;
    }

    #HeroProducts-{{ section.id }} .hp__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 26px;
      padding: var(--hp-cta-py) var(--hp-cta-px);
      border-radius: var(--hp-cta-radius);
      background: var(--hp-cta-bg);
      color: var(--hp-cta-text);
      font-size: var(--hp-cta-size);
      font-weight: 600;
      letter-spacing: 0.5px;
      text-decoration: none;
      transition: opacity var(--hp-speed) ease 240ms, transform var(--hp-speed) var(--hp-ease) 240ms, filter 200ms ease;
    }
    #HeroProducts-{{ section.id }} .hp__cta:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
    }

    /* ---------- Panel ---------- */
    #HeroProducts-{{ section.id }} .hp__shell {
      position: relative;
      z-index: 3;
      width: min(100% - 40px, 1400px);
      margin: 0 auto;
    }
    #HeroProducts-{{ section.id }} .hp__panel {
      width: var(--hp-panel-w);
      min-width: min(100%, 320px);
      margin-top: calc(var(--hp-overlap) * -1);
      background: var(--hp-panel-bg);
      border-radius: var(--hp-panel-radius);
      padding: var(--hp-panel-pad);
      {% if section.settings.panel_shadow %}box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);{% endif %}
    }
    #HeroProducts-{{ section.id }}.hp--align-left .hp__panel { margin-left: 0; margin-right: auto; }
    #HeroProducts-{{ section.id }}.hp--align-right .hp__panel { margin-left: auto; margin-right: 0; }
    #HeroProducts-{{ section.id }}.hp--align-center .hp__panel { margin-left: auto; margin-right: auto; }

    #HeroProducts-{{ section.id }} .hp__grid {
      display: grid;
      grid-template-columns: repeat(var(--hp-cols, 3), minmax(0, 1fr));
      gap: var(--hp-gap);
      min-width: 0;
    }

    /* ---------- Cards ---------- */
    #HeroProducts-{{ section.id }} .hp__card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      text-decoration: none;
      min-width: 0;
      transition: opacity var(--hp-speed) ease, transform var(--hp-speed) var(--hp-ease);
      transition-delay: calc(var(--i, 0) * 90ms);
    }
    #HeroProducts-{{ section.id }} .hp__card-media {
      width: 100%;
      aspect-ratio: {{ section.settings.card_media_ratio }};
      overflow: hidden;
      background: #EFEDE9;
    }
    #HeroProducts-{{ section.id }} .hp__card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 700ms var(--hp-ease);
    }
    #HeroProducts-{{ section.id }} .hp__card:hover .hp__card-media img {
      transform: scale(1.05);
    }
    #HeroProducts-{{ section.id }} .hp__card-placeholder {
      width: 100%;
      height: 100%;
    }

    #HeroProducts-{{ section.id }} .hp__card-title {
      margin: 18px 0 0;
      color: var(--hp-card-title-color);
      font-size: var(--hp-card-title-size);
      font-family: Georgia, 'Times New Roman', serif;
      {% if section.settings.card_title_italic %}font-style: italic;{% endif %}
      line-height: 1.2;
    }

    #HeroProducts-{{ section.id }} .hp__card-divider {
      width: var(--hp-divider-w);
      height: 1px;
      margin: 12px 0 0;
      background: var(--hp-divider);
    }

    #HeroProducts-{{ section.id }} .hp__card-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 14px;
      padding: 9px 22px;
      border-radius: var(--hp-btn-radius);
      font-size: var(--hp-btn-size);
      font-weight: 500;
      letter-spacing: 0.4px;
      {% if section.settings.card_btn_style == 'solid' %}
        background: {{ section.settings.card_btn_bg }};
        border: 1px solid {{ section.settings.card_btn_bg }};
        color: {{ section.settings.card_btn_solid_text }};
      {% else %}
        background: transparent;
        border: 1px solid {{ section.settings.card_btn_text }};
        color: {{ section.settings.card_btn_text }};
      {% endif %}
      transition: transform 200ms ease, opacity 200ms ease;
    }
    #HeroProducts-{{ section.id }} .hp__card:hover .hp__card-btn {
      transform: translateY(-1px);
      opacity: 0.85;
    }

    /* ---------- Entrance ---------- */
    #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__badge-row,
    #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__heading,
    #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__subtitle,
    #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__cta {
      opacity: 0;
      transform: translateY(20px);
    }
    #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__card {
      opacity: 0;
      transform: translateY(26px);
    }

    /* ---------- Tablet ---------- */
    @media screen and (max-width: 1080px) {
      #HeroProducts-{{ section.id }} .hp__grid {
        grid-template-columns: repeat(var(--hp-cols-md, 3), minmax(0, 1fr));
      }
    }

    /* ---------- Mobile ---------- */
    @media screen and (max-width: 760px) {
      #HeroProducts-{{ section.id }} .hp__bg-img { display: none; }
      #HeroProducts-{{ section.id }} .hp__bg-img--mobile { display: block; }
      #HeroProducts-{{ section.id }} .hp__content {
        min-height: var(--hp-hero-h-m);
        padding-bottom: calc(var(--hp-overlap) * 0.4);
      }
      #HeroProducts-{{ section.id }} .hp__heading { font-size: var(--hp-head-size-m); }
      #HeroProducts-{{ section.id }} .hp__shell { width: calc(100% - 32px); }
      #HeroProducts-{{ section.id }} .hp__panel {
        width: 100%;
        margin-top: calc(var(--hp-overlap) * -0.5);
        padding: calc(var(--hp-panel-pad) * 0.75);
      }
      #HeroProducts-{{ section.id }} .hp__grid {
        grid-auto-flow: column;
        grid-auto-columns: var(--hp-mobile-card);
        grid-template-columns: none;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x proximity;
        scrollbar-width: none;
        padding-bottom: 4px;
      }
      #HeroProducts-{{ section.id }} .hp__grid::-webkit-scrollbar { display: none; }
      #HeroProducts-{{ section.id }} .hp__card { scroll-snap-align: start; }
    }

    @media (prefers-reduced-motion: reduce) {
      #HeroProducts-{{ section.id }} .hp__badge-row,
      #HeroProducts-{{ section.id }} .hp__heading,
      #HeroProducts-{{ section.id }} .hp__subtitle,
      #HeroProducts-{{ section.id }} .hp__cta,
      #HeroProducts-{{ section.id }} .hp__card,
      #HeroProducts-{{ section.id }} .hp__card-media img,
      #HeroProducts-{{ section.id }} .hp__card-btn,
      #HeroProducts-{{ section.id }} .hp__cta {
        transition: none;
      }
      #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__badge-row,
      #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__heading,
      #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__subtitle,
      #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__cta,
      #HeroProducts-{{ section.id }}.hp-animated:not(.is-in-view) .hp__card {
        opacity: 1;
        transform: none;
      }
    }
  {%- endstyle -%}

  <div class="hp__hero">
    {%- if section.settings.hero_image != blank -%}
      <img
        class="hp__bg-img"
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_image.alt | default: 'Hero' | escape }}"
        loading="{% if section.index < 2 %}eager{% else %}lazy{% endif %}"
        width="2000"
        height="1200"
      >
    {%- endif -%}
    {%- assign mobile_img = section.settings.hero_image_mobile | default: section.settings.hero_image -%}
    {%- if mobile_img != blank -%}
      <img
        class="hp__bg-img hp__bg-img--mobile"
        src="{{ mobile_img | image_url: width: 900 }}"
        alt="{{ mobile_img.alt | default: 'Hero' | escape }}"
        loading="lazy"
        width="900"
        height="1200"
      >
    {%- endif -%}
    <div class="hp__overlay" aria-hidden="true"></div>

    <div class="hp__content">
      {%- if section.settings.show_badge_row -%}
        <div class="hp__badge-row">
          {%- if section.settings.badge_left_text != blank -%}
            <span class="hp__badge-text">{{ section.settings.badge_left_text }}</span>
          {%- endif -%}
          {%- if section.settings.badge_emblem != blank -%}
            <span class="hp__badge-emblem">
              <img src="{{ section.settings.badge_emblem | image_url: width: 200 }}" alt="" loading="lazy" width="200" height="200">
            </span>
          {%- endif -%}
          {%- if section.settings.badge_right_text != blank -%}
            <span class="hp__badge-text">{{ section.settings.badge_right_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hp__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="hp__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.show_cta and section.settings.cta_text != blank and section.settings.cta_link != blank -%}
        <a class="hp__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp__shell">
    <div class="hp__panel">
      <div class="hp__grid" style="--hp-cols: {{ cols }}; --hp-cols-md: {{ cols_md }};">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          {%- assign card_image = block.settings.image | default: collection.image | default: collection.products.first.featured_image -%}
          {%- assign card_title = block.settings.title | default: collection.title -%}
          {%- assign card_link = block.settings.link | default: collection.url -%}
          {%- assign card_label = block.settings.button_label | default: section.settings.button_label -%}

          {%- if card_link != blank -%}
            <a class="hp__card" href="{{ card_link }}" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="hp__card" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- endif -%}

            <div class="hp__card-media">
              {%- if card_image != blank -%}
                <img
                  src="{{ card_image | image_url: width: 800 }}"
                  alt="{{ card_title | default: 'Collection' | escape }}"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'hp__card-placeholder' }}
              {%- endif -%}
            </div>

            {%- if card_title != blank -%}
              <h3 class="hp__card-title">{{ card_title }}</h3>
            {%- endif -%}

            {%- if section.settings.show_divider -%}
              <span class="hp__card-divider" aria-hidden="true"></span>
            {%- endif -%}

            {%- if card_label != blank -%}
              <span class="hp__card-btn">{{ card_label }}</span>
            {%- endif -%}

          {%- if card_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('HeroProducts-{{ section.id }}');
      if (!root) return;

      {%- if section.settings.enable_animation -%}
        root.classList.add('hp-animated');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) {
          root.classList.add('is-in-view');
        } else {
          const obs = new IntersectionObserver((entries, o) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                root.classList.add('is-in-view');
                o.unobserve(e.target);
              }
            });
          }, { threshold: 0.1 });
          obs.observe(root);
        }
      {%- else -%}
        root.classList.add('is-in-view');
      {%- endif -%}
    })();
  </script>
</section>

{% schema %}
{
  "name": "Hero With Products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Hero background" },
    { "type": "image_picker", "id": "hero_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "hero_image_mobile", "label": "Mobile image" },
    { "type": "select", "id": "image_position", "label": "Focal point", "default": "center", "options": [
      { "value": "left center", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right center", "label": "Right" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" }
    ] },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "default": 30, "unit": "%" },
    { "type": "range", "id": "hero_height", "label": "Desktop hero height", "min": 400, "max": 900, "step": 10, "default": 600, "unit": "px" },
    { "type": "range", "id": "hero_height_mobile", "label": "Mobile hero height", "min": 300, "max": 700, "step": 10, "default": 420, "unit": "px" },
    { "type": "color", "id": "page_background", "label": "Page background below panel", "default": "#F6F4F1" },

    { "type": "header", "content": "Hero content" },
    { "type": "checkbox", "id": "show_badge_row", "label": "Show badge row", "default": true },
    { "type": "text", "id": "badge_left_text", "label": "Badge left text", "default": "EST." },
    { "type": "text", "id": "badge_right_text", "label": "Badge right text", "default": "2023" },
    { "type": "image_picker", "id": "badge_emblem", "label": "Badge emblem image" },
    { "type": "range", "id": "badge_emblem_size", "label": "Emblem size", "min": 24, "max": 120, "step": 2, "default": 56, "unit": "px" },
    { "type": "range", "id": "badge_text_size", "label": "Badge text size", "min": 8, "max": 18, "step": 1, "default": 11, "unit": "px" },
    { "type": "range", "id": "badge_spacing", "label": "Badge text spacing", "min": 0, "max": 6, "step": 0.5, "default": 2, "unit": "px" },
    { "type": "color", "id": "badge_color", "label": "Badge color", "default": "#FFFFFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Holiday Specials" },
    { "type": "checkbox", "id": "heading_italic", "label": "Italic heading", "default": true },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 90, "step": 2, "default": 56, "unit": "px" },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 24, "max": 60, "step": 2, "default": 36, "unit": "px" },
    { "type": "range", "id": "heading_weight", "label": "Heading weight", "min": 100, "max": 900, "step": 100, "default": 500 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Your source for all things Christmas" },
    { "type": "checkbox", "id": "subtitle_uppercase", "label": "Uppercase subtitle", "default": true },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size", "min": 9, "max": 22, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "subtitle_spacing", "label": "Subtitle spacing", "min": 0, "max": 8, "step": 0.5, "default": 3, "unit": "px" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle color", "default": "#FFFFFF" },
    { "type": "range", "id": "content_nudge", "label": "Content vertical nudge", "min": -80, "max": 80, "step": 4, "default": 0, "unit": "px" },
    { "type": "checkbox", "id": "show_cta", "label": "Show hero button", "default": true },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Start Shopping" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "cta_bg", "label": "Button background", "default": "#E4573D" },
    { "type": "color", "id": "cta_text_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "range", "id": "cta_radius", "label": "Button radius", "min": 0, "max": 60, "step": 2, "default": 30, "unit": "px" },
