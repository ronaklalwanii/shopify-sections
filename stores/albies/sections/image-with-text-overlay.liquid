{%- unless section.settings.full_width -%}
	{%- render 'section-spacing-collapsing' -%}
{%- endunless -%}

<style>
	#shopify-section-{{ section.id }}{
		{% if section.settings.custom_padding %}
		padding-top: {{ section.settings.padding_top }}px;
		padding-bottom: {{ section.settings.padding_bottom }}px;
		{% endif %}
	    {%- if section.settings.full_width -%}
	        --ul-section-outer-spacing-block: 0;
	    {%- endif -%}

	    --ul-content-over-media-overlay: {{ section.settings.overlay_color.rgb }}/{{ section.settings.overlay_opacity | divided_by: 100.0 }};

	    {%- if section.settings.allow_transparent_header -%}
	        margin-block-start: calc(-1 * var(--ul-header-height) * var(--ul-section-is-first));
	    {%- endif -%}
	}

	/* Snatched Variant Styles */
	{% if section.settings.snatched_variant_mode == 'snatched' %}
		#shopify-section-{{ section.id }} .snatched-layout {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0;
			align-items: stretch;
			max-width: 1400px;
			margin: 0 auto;
			min-height: 600px;
		}

		#shopify-section-{{ section.id }} .snatched-content {
			order: 1;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 4rem 3rem 4rem 5rem;
			z-index: 2;
			background: {{ section.settings.snatched_content_bg }};
		}

		#shopify-section-{{ section.id }} .snatched-media {
			order: 2;
			position: relative;
			{% comment %} overflow: hidden; {% endcomment %}
			width: 100%;
			height: 100%;
		}

		#shopify-section-{{ section.id }} .snatched-media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		/* Typography Classes */
		.snatched-font-heading {
			font-family: {{ section.settings.snatched_heading_font.family }}, {{ section.settings.snatched_heading_font.fallback_families }};
		}
		
		.snatched-font-body {
			font-family: {{ section.settings.snatched_body_font.family }}, {{ section.settings.snatched_body_font.fallback_families }};
		}

		.snatched-font-feature {
			font-family: {{ section.settings.snatched_feature_font.family }}, {{ section.settings.snatched_feature_font.fallback_families }};
		}

		/* Subheading Block */
		#shopify-section-{{ section.id }} .snatched-block-subheading {
			font-size: 0.8rem;
			font-weight: 700;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: {{ section.settings.snatched_subheading_color }};
			margin-bottom: 1.5rem;
			margin-top: 0;
		}

		/* Heading Block */
		#shopify-section-{{ section.id }} .snatched-block-heading {
			font-size: {{ section.settings.snatched_heading_size }}px;
			line-height: 1.1;
			margin-bottom: 0.5rem;
			color: {{ section.settings.snatched_heading_color }};
			font-weight: 400;
		}

		#shopify-section-{{ section.id }} .snatched-block-heading .word-snatched {
			font-style: italic;
			color: {{ section.settings.snatched_accent_color }};
		}

		/* Richtext/Paragraph Block */
		#shopify-section-{{ section.id }} .snatched-block-richtext {
			font-size: 1rem;
			line-height: 1.6;
			color: {{ section.settings.snatched_text_color }};
			margin-bottom: 2rem;
			margin-top: 1rem;
			max-width: 400px;
		}

		/* Button Block */
		#shopify-section-{{ section.id }} .snatched-block-button {
			margin-top: 1rem;
			margin-bottom: 2rem;
		}

		/* Features (Section Setting) */
		#shopify-section-{{ section.id }} .snatched-features {
			display: flex;
			gap: 0;
			align-items: center;
			flex-wrap: wrap;
			margin-top: 1rem;
		}

		#shopify-section-{{ section.id }} .snatched-feature {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 0.85rem;
			color: {{ section.settings.snatched_text_color }};
			font-weight: 500;
		}

		#shopify-section-{{ section.id }} .snatched-feature-icon {
			width: 20px;
			height: 20px;
			flex-shrink: 0;
			opacity: 0.7;
		}

		#shopify-section-{{ section.id }} .snatched-feature-divider {
			width: 1px;
			height: 20px;
			background-color: #d0d0d0;
			margin: 0 1.5rem;
		}

		/* Rating Badge */
		#shopify-section-{{ section.id }} .snatched-rating-badge {
			position: absolute;
			bottom: 3rem;
			right: -2rem;
			background: rgba(255, 255, 255, 0.95);
			padding: 1.5rem;
			border-radius: 50%;
			width: 160px;
			height: 160px;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			text-align: center;
			border: {{ section.settings.snatched_rating_border_width }}px solid {{ section.settings.snatched_rating_border_color }};
			{% if section.settings.snatched_rating_enable_shadow %}
			box-shadow: 0 10px 30px rgba(0,0,0,0.1);
			{% endif %}
			z-index: 10;
		}

		#shopify-section-{{ section.id }} .snatched-rating-stars {
			color: {{ section.settings.snatched_subheading_color }};
			font-size: 1rem;
			margin-bottom: 0.5rem;
			letter-spacing: 2px;
		}

		#shopify-section-{{ section.id }} .snatched-rating-score {
			font-size: 1.5rem;
			font-weight: 700;
			color: #1a1a1a;
			line-height: 1;
			margin-bottom: 0.4rem;
		}

		#shopify-section-{{ section.id }} .snatched-rating-text {
			font-size: 0.75rem;
			color: #666666;
			line-height: 1.3;
		}

		@media (max-width: 999px) {
			#shopify-section-{{ section.id }} .snatched-layout {
				grid-template-columns: 1fr;
				min-height: auto;
			}

			#shopify-section-{{ section.id }} .snatched-content {
				order: 2;
				text-align: center;
				padding: 3rem 2rem;
				align-items: center;
			}

			#shopify-section-{{ section.id }} .snatched-media {
				order: 1;
				min-height: 400px;
			}

			#shopify-section-{{ section.id }} .snatched-block-heading {
				font-size: {{ section.settings.snatched_heading_size_mobile }}px;
			}

			#shopify-section-{{ section.id }} .snatched-block-richtext {
				max-width: 100%;
			}

			/* Fixed Feature Responsiveness */
			#shopify-section-{{ section.id }} .snatched-features {
				flex-direction: column;
				justify-content: center;
				align-items: center;
				width: 100%;
			}

			#shopify-section-{{ section.id }} .snatched-feature {
				justify-content: center;
				padding: 10px 0;
				width: 100%;
			}

			/* Turn vertical dividers into horizontal dividers for mobile stack */
			#shopify-section-{{ section.id }} .snatched-feature-divider {
				width: 60px;
				height: 1px;
				margin: 5px 0;
			}

			#shopify-section-{{ section.id }} .snatched-rating-badge {
				bottom: 1rem;
				right: 1rem;
				width: 130px;
				height: 130px;
				padding: 1rem;
			}
			
			#shopify-section-{{ section.id }} .snatched-rating-badge {
		        bottom: -2rem;
		        right: 4rem;
		        transform: translateX(50%);
		        width: 140px;
		        height: 140px;
		        padding: 1.25rem 1rem;
		    }
			
			#shopify-section-{{ section.id }} .snatched-rating-stars {
		       font-size: 12px;
		    }
			
			#shopify-section-{{ section.id }} .snatched-rating-score {
		       font-size: 1rem;
		    }
		}
	{% endif %}
</style>

<div
	{% render 'section-attributes' %}
	{% if section.settings.allow_transparent_header %}
		allow-transparent-header
	{% endif %}
>
	{%- if section.settings.snatched_variant_mode == 'snatched' -%}
		<div class="snatched-layout">
			
			<!-- Left Column: Content from Blocks -->
			<div class="snatched-content">
				{%- for block in section.blocks -%}
					{%- case block.type -%}
						
						{%- when 'subheading' -%}
							{%- if block.settings.text != blank -%}
								<p class="snatched-block-subheading snatched-font-body" {{ block.shopify_attributes }}>
									{{ block.settings.text | escape }}
								</p>
							{%- endif -%}

						{%- when 'heading' -%}
							{%- if block.settings.text != blank -%}
								<div class="snatched-block-heading snatched-font-heading" {{ block.shopify_attributes }}>
									{%- assign heading_parts = block.settings.text | split: ' ' -%}
									{%- for part in heading_parts -%}
										{%- if part contains 'Snatched' or part contains 'snatched' -%}
											<span class="word-snatched">{{ part }}</span>
										{%- else -%}
											{{ part }}
										{%- endif -%}
										{%- unless forloop.last -%} {% endunless -%}
									{%- endfor -%}
								</div>
							{%- endif -%}

						{%- when 'richtext' -%}
							{%- if block.settings.content != blank -%}
								<div class="snatched-block-richtext snatched-font-body" {{ block.shopify_attributes }}>
									{{- block.settings.content -}}
								</div>
							{%- endif -%}

						{%- when 'button' -%}
							{%- if block.settings.text != blank -%}
								<div class="snatched-block-button" {{ block.shopify_attributes }}>
									{% render 'button',
										content: block.settings.text,
										href: block.settings.url,
										size: block.settings.size,
										style: block.settings.style,
										background: block.settings.background,
										text_color: block.settings.text_color,
										block: block
									%}
								</div>
							{%- endif -%}
							
						{%- when 'liquid' -%}
							{%- if block.settings.liquid != blank -%}
								<div {{ block.shopify_attributes }}>
									{{- block.settings.liquid -}}
								</div>
							{%- endif -%}
							
					{%- endcase -%}
				{%- endfor -%}

				<!-- Features (From Section Settings) -->
				{%- if section.settings.snatched_show_features -%}
					<div class="snatched-features snatched-font-feature">
						{%- if section.settings.snatched_f1_icon != blank and section.settings.snatched_f1_text != blank -%}
							<div class="snatched-feature">
								<img src="{{ section.settings.snatched_f1_icon | image_url: width: 40 }}" alt="" class="snatched-feature-icon" loading="lazy">
								<span>{{ section.settings.snatched_f1_text }}</span>
							</div>
						{%- endif -%}
						{%- if section.settings.snatched_f2_icon != blank and section.settings.snatched_f2_text != blank -%}
							<div class="snatched-feature-divider"></div>
							<div class="snatched-feature">
								<img src="{{ section.settings.snatched_f2_icon | image_url: width: 40 }}" alt="" class="snatched-feature-icon" loading="lazy">
								<span>{{ section.settings.snatched_f2_text }}</span>
							</div>
						{%- endif -%}
						{%- if section.settings.snatched_f3_icon != blank and section.settings.snatched_f3_text != blank -%}
							<div class="snatched-feature-divider"></div>
							<div class="snatched-feature">
								<img src="{{ section.settings.snatched_f3_icon | image_url: width: 40 }}" alt="" class="snatched-feature-icon" loading="lazy">
								<span>{{ section.settings.snatched_f3_text }}</span>
							</div>
						{%- endif -%}
					</div>
				{%- endif -%}
			</div>

			<!-- Right Column: Image -->
			<div class="snatched-media">
				{%- if section.settings.image != blank -%}
					{{-
						section.settings.image
						| image_url: width: section.settings.image.width
						| image_tag:
							loading: 'lazy',
							sizes: '(max-width: 999px) 100vw, 50vw',
							widths: '400,600,800,1000,1200,1400,1600,1800,2000'
					-}}
				{%- else -%}
					{{
						'lifestyle-1'
						| placeholder_svg_tag: 'placeholder'
					}}
				{%- endif -%}

				{%- if section.settings.snatched_show_rating -%}
					<div class="snatched-rating-badge">
						<div class="snatched-rating-stars">★★★★★</div>
						<div class="snatched-rating-score">{{ section.settings.snatched_rating_score }}</div>
						<div class="snatched-rating-text">From Over<br>{{ section.settings.snatched_rating_count }} Customers</div>
					</div>
				{%- endif -%}
			</div>
		</div>
	{%- else -%}
		{%- capture class -%}content-over-media content-over-media--{{ section.settings.image_size }}
	        {% if section.settings.full_width %}full-bleed{% else %}shadow-block rounded-lg{% endif %}
	    {%- endcapture -%}

		<image-banner
			reveal-on-scroll="true"
			{% if section.settings.enable_parallax %}
				parallax="0.3"
			{% endif -%}
			{% render 'surface', class: class, text_color: section.settings.text_color %}
			{% if section.settings.overlay_height_vh > 0 %}
				style="min-height: {{ section.settings.overlay_height_vh }}vh;"
			{% endif %}
		>
			{%- if section.settings.image != blank -%}
				{%- capture image_class -%}
	                {% if section.settings.mobile_image != blank %}hidden sm:block{% endif %}
	            {%- endcapture -%}
				{%- capture sizes -%}
	                {% if section.settings.full_width %}100vw{% else %}(max-width: 740px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 64px), min({{ settings.page_width }}px, 100vw - 96px){% endif %}
	            {%- endcapture -%}

				{{-
					section.settings.image
					| image_url: width: section.settings.image.width
					| image_tag:
						loading: 'lazy',
						sizes: sizes,
						widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200',
						class: image_class
				-}}

				{%- if section.settings.mobile_image != blank -%}
					{{-
						section.settings.mobile_image
						| image_url: width: section.settings.mobile_image.width
						| image_tag:
							loading: 'lazy',
							sizes: sizes,
							widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600',
							class: 'sm:hidden'
					-}}
				{%- endif -%}
			{%- else -%}
				{{
					'lifestyle-1'
					| placeholder_svg_tag: 'placeholder'
					| replace: '<svg', '<svg preserveAspectRatio="xMinYMin slice"'
				}}
			{%- endif -%}

			{%- if section.blocks.size > 0 -%}
				<div class="{{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
					<div class="prose">
						{%- for block in section.blocks -%}
							{%- case block.type -%}
								{%- when 'subheading' -%}
									{%- if block.settings.text != blank -%}
										<p class="bold" {{ block.shopify_attributes }}>
											{{ block.settings.text | escape }}
										</p>
									{%- endif -%}

								{%- when 'heading' -%}
									{%- if block.settings.text != blank -%}
										<p
											class="{{ block.settings.heading_tag }}"
											{% if settings.heading_apparition != 'none' %}
												reveal-on-scroll="true"
											{% endif -%}
											{{ block.shopify_attributes }}
										>
											{%- render 'styled-text',
												content: block.settings.text,
												text_color: block.settings.heading_color,
												gradient: block.settings.heading_gradient,
												apparition_effect: true
											-%}
										</p>
									{%- endif -%}

								{%- when 'richtext' -%}
									{%- if block.settings.content != blank -%}
										<div {{ block.shopify_attributes }}>
											{{- block.settings.content -}}
										</div>
									{%- endif -%}

								{%- when 'liquid' -%}
									{%- if block.settings.liquid != blank -%}
										<div {{ block.shopify_attributes }}>
											{{- block.settings.liquid -}}
										</div>
									{%- endif -%}

								{%- when 'button' -%}
									{%- if block.settings.text != blank -%}
										{% render 'button',
											content: block.settings.text,
											href: block.settings.url,
											size: block.settings.size,
											style: block.settings.style,
											background: block.settings.background,
											text_color: block.settings.text_color,
											block: block
										%}
									{%- endif -%}
							{%- endcase -%}
						{%- endfor -%}
					</div>
				</div>
			{%- endif -%}
		</image-banner>
	{%- endif -%}
</div>

{% schema %}
{
	"name": "Image with text overlay",
	"class": "shopify-section--image-with-text-overlay",
	"tag": "section",
	"disabled_on": {
		"templates": ["password"],
		"groups": ["header", "custom.overlay"]
	},
	"max_blocks": 6,
	"settings": [
		{
			"type": "select",
			"id": "snatched_variant_mode",
			"label": "Section variant",
			"options": [
				{
					"value": "default",
					"label": "Default (Overlay)"
				},
				{
					"value": "snatched",
					"label": "Snatched (Split Layout)"
				}
			],
			"default": "default",
			"info": "Choose 'Snatched' for a split layout with text and image side by side"
		},
		{
			"type": "checkbox",
			"id": "full_width",
			"label": "Full width",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "allow_transparent_header",
			"label": "Allow transparent header",
			"info": "This setting only applies when this section is the first one.",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "enable_parallax",
			"label": "Enable parallax effect",
			"info": "Parallax crops images.",
			"default": false
		},
		{
			"type": "select",
			"id": "image_size",
			"label": "Image size",
			"options": [
				{
					"value": "auto",
					"label": "Original image ratio"
				},
				{
					"value": "sm",
					"label": "Small"
				},
				{
					"value": "md",
					"label": "Medium"
				},
				{
					"value": "lg",
					"label": "Large"
				},
				{
					"value": "fill",
					"label": "Fill screen"
				}
			],
			"info": "Choose \"Original image ratio\" to avoid image cropping.",
			"default": "auto"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "Image",
			"info": "For Snatched layout, use a portrait image (e.g., 1200x1600px) for best results."
		},
		{
			"type": "image_picker",
			"id": "mobile_image",
			"label": "Mobile image",
			"info": "1300 x 1500px .jpg recommended. Default to desktop image."
		},
		{
			"type": "select",
			"id": "mobile_text_position",
			"label": "Mobile content position",
			"options": [
				{ "value": "place-self-start text-start", "label": "Top left" },
				{ "value": "place-self-start-center text-center", "label": "Top center" },
				{ "value": "place-self-start-end text-end", "label": "Top right" },
				{ "value": "place-self-center-start text-start", "label": "Middle left" },
				{ "value": "place-self-center text-center", "label": "Middle center" },
				{ "value": "place-self-center-end text-end", "label": "Middle right" },
				{ "value": "place-self-end-start text-start", "label": "Bottom left" },
				{ "value": "place-self-end-center text-center", "label": "Bottom center" },
				{ "value": "place-self-end text-end", "label": "Bottom right" }
			],
			"default": "place-self-center text-center"
		},
		{
			"type": "select",
			"id": "desktop_text_position",
			"label": "Desktop content position",
			"options": [
				{ "value": "sm:place-self-start sm:text-start", "label": "Top left" },
				{ "value": "sm:place-self-start-center sm:text-center", "label": "Top center" },
				{ "value": "sm:place-self-start-end sm:text-end", "label": "Top right" },
				{ "value": "sm:place-self-center-start sm:text-start", "label": "Middle left" },
				{ "value": "sm:place-self-center sm:text-center", "label": "Middle center" },
				{ "value": "sm:place-self-center-end sm:text-end", "label": "Middle right" },
				{ "value": "sm:place-self-end-start sm:text-start", "label": "Bottom left" },
				{ "value": "sm:place-self-end-center sm:text-center", "label": "Bottom center" },
				{ "value": "sm:place-self-end sm:text-end", "label": "Bottom right" }
			],
			"default": "sm:place-self-center sm:text-center"
		},
		{
			"type": "header",
			"content": "Colors (Default Variant)"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text",
			"default": "#ffffff"
		},
		{
			"type": "color",
			"id": "overlay_color",
			"label": "Overlay",
			"default": "#000000"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"label": "Overlay opacity",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"default": 30
		},
		{
			"type": "header",
			"content": "Snatched Variant Settings",
			"info": "These settings apply when variant is 'Snatched'."
		},
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "font_picker",
			"id": "snatched_heading_font",
			"label": "Heading Font",
			"default": "assistant_n4"
		},
		{
			"type": "font_picker",
			"id": "snatched_body_font",
			"label": "Body & Subheading Font",
			"default": "assistant_n4"
		},
		{
			"type": "font_picker",
			"id": "snatched_feature_font",
			"label": "Feature Text Font",
			"default": "assistant_n4"
		},
		{
			"type": "checkbox",
			"id": "snatched_show_features",
			"label": "Show feature icons",
			"default": true
		},
		{
			"type": "image_picker",
			"id": "snatched_f1_icon",
