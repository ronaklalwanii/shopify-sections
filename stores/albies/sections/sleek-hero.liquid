{%- liquid
  assign slide_height = section.settings.slide_height
  assign text_alignment_mobile = section.settings.text_alignment_mobile
  assign show_text_below = section.settings.show_text_below
  assign show_dots = section.settings.show_dots
  assign slider_layout = section.settings.layout

  assign first_block = section.blocks.first
  if first_block.type == 'video'
    assign aspect_ratio = first_block.settings.video.aspect_ratio | default: '16/9'
    assign aspect_ratio_mobile = aspect_ratio
  else
    assign aspect_ratio = first_block.settings.background.aspect_ratio | default: 2.333
    assign aspect_ratio_mobile = first_block.settings.background_mobile.aspect_ratio | default: 1.778
  endif

  assign autoplay = 0
  if section.settings.autoplay
    assign autoplay = section.settings.autoplay_delay | times: 1000
  endif
-%}
{%- comment -%}
  Participates in Change's section padding-collapsing chain. Without this the
  section directly below the hero never receives --ul-previous-section-background-hash
  and always applies full top padding.
{%- endcomment -%}
{%- render 'section-spacing-collapsing' -%}
{%- if section.settings.enable_custom_font -%}
  <style>{{ section.settings.font_family | font_face: font_display: 'swap' }}</style>
{%- endif -%}

{{ 'sleek-hero.css' | asset_url | stylesheet_tag }}
{%- if section.settings.design_style == 'numbered' -%}
  {{ 'sleek-hero-numbered.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<style>
  /* Elqorin editorial hero. Scoped so the default Sleek hero is untouched. */
  .sleek-hero--elqorin-editorial {
    --elqorin-ivory: #F9F6F2;
    --elqorin-black: #000000;
    --elqorin-white: #FFFFFF;
    --elqorin-line: rgba(0, 0, 0, .18);
    background: var(--elqorin-ivory);
  }

   .sleek-hero--elqorin-editorial .slideshow__buttons,
  .sleek-hero--elqorin-dark .slideshow__buttons {
    margin-top: 34px;
  }

  .sleek-hero--elqorin-editorial .slideshow__buttons motion-element,
  .sleek-hero--elqorin-dark .slideshow__buttons motion-element {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* keep wrapped buttons aligned with the slide's text alignment */
  .sleek-hero--elqorin-editorial .slideshow__text.text-left .slideshow__buttons motion-element,
  .sleek-hero--elqorin-dark .slideshow__text.text-left .slideshow__buttons motion-element {
    justify-content: flex-start;
  }

  .sleek-hero--elqorin-editorial .slideshow__text.text-center .slideshow__buttons motion-element,
  .sleek-hero--elqorin-dark .slideshow__text.text-center .slideshow__buttons motion-element {
    justify-content: center;
  }

  .sleek-hero--elqorin-editorial .slideshow__text.text-right .slideshow__buttons motion-element,
  .sleek-hero--elqorin-dark .slideshow__text.text-right .slideshow__buttons motion-element {
    justify-content: flex-end;
  }

  @media (min-width: 768px) {
    .sleek-hero--elqorin-editorial .slideshow__text.md\:text-left .slideshow__buttons motion-element,
    .sleek-hero--elqorin-dark .slideshow__text.md\:text-left .slideshow__buttons motion-element {
      justify-content: flex-start;
    }

    .sleek-hero--elqorin-editorial .slideshow__text.md\:text-center .slideshow__buttons motion-element,
    .sleek-hero--elqorin-dark .slideshow__text.md\:text-center .slideshow__buttons motion-element {
      justify-content: center;
    }

    .sleek-hero--elqorin-editorial .slideshow__text.md\:text-right .slideshow__buttons motion-element,
    .sleek-hero--elqorin-dark .slideshow__text.md\:text-right .slideshow__buttons motion-element {
      justify-content: flex-end;
    }
  }

  .sleek-hero--elqorin-editorial .slideshow__buttons .btn,
  .sleek-hero--elqorin-dark .slideshow__buttons .btn {
    min-height: 52px;
    padding: 0 30px;
    border-radius: 2px;
    background: var(--elqorin-black);
    color: var(--elqorin-white);
    border: 1px solid var(--elqorin-black);
    letter-spacing: .03em;
  }

  /* A button without a link renders [disabled]; keep it full-strength
     instead of the theme's 0.5-opacity dimmed state. */
  .sleek-hero--elqorin-editorial .slideshow__buttons .btn[disabled],
  .sleek-hero--elqorin-dark .slideshow__buttons .btn[disabled] {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .sleek-hero--elqorin-editorial .slideshow__item-wrap {
      min-height: clamp(620px, calc(100svh - var(--ul-header-height, 88px)), 820px);
      display: flex;
      flex-wrap: wrap;
      background: var(--elqorin-ivory);
    }

    .sleek-hero--elqorin-editorial .slideshow__bg {
      position: relative !important;
      inset: auto !important;
      z-index: 0 !important;
      order: 2;
      width: 58% !important;
      height: auto !important;
      min-height: clamp(620px, calc(100svh - var(--ul-header-height, 88px)), 820px);
      background: var(--elqorin-ivory);
    }

    .sleek-hero--elqorin-editorial .slideshow__content {
      position: relative !important;
      inset: auto !important;
      z-index: 2;
      order: 1;
      width: 42% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: clamp(48px, 6vw, 96px) clamp(32px, 5vw, 88px);
      display: flex;
      align-items: center;
      background: var(--elqorin-ivory) !important;
      color: var(--elqorin-black);
    }

    .sleek-hero--elqorin-editorial .slideshow__content--in-container {
      max-width: none !important;
    }

    .sleek-hero--elqorin-editorial .slideshow__text {
      width: 100%;
      max-width: 520px;
      margin: 0;
    }

    .sleek-hero--elqorin-editorial .slideshow__subtitle {
      margin-bottom: 18px;
      font-size: 12px;
      line-height: 1.2;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--elqorin-black);
    }

    .sleek-hero--elqorin-editorial .slideshow__title {
      max-width: 560px;
      margin: 0;
      color: var(--elqorin-black);
      font-size: clamp(48px, 5vw, 84px);
      line-height: .98;
      letter-spacing: -.035em;
      text-wrap: balance;
    }

    .sleek-hero--elqorin-editorial .slideshow__description {
      max-width: 440px;
      margin-top: 24px;
      color: var(--elqorin-black);
      font-size: 16px;
      line-height: 1.65;
    }

    /* Slide buttons — original Elqorin pill styling (from final-fix-old),
       applied to both Elqorin styles. */
    {% comment %} .sleek-hero--elqorin-editorial .slideshow__buttons,
    .sleek-hero--elqorin-dark .slideshow__buttons {
      margin-top: 34px;
    }

    .sleek-hero--elqorin-editorial .slideshow__buttons motion-element,
    .sleek-hero--elqorin-dark .slideshow__buttons motion-element {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .sleek-hero--elqorin-editorial .slideshow__buttons .btn,
    .sleek-hero--elqorin-dark .slideshow__buttons .btn {
      min-height: 52px;
      padding: 0 30px;
      border-radius: 999px;
      background: var(--elqorin-black);
      color: var(--elqorin-white);
      border: 1px solid var(--elqorin-black);
      letter-spacing: .03em;
    }

    /* A button without a link renders [disabled]; keep it full-strength
       instead of the theme's 0.5-opacity dimmed state. */
    .sleek-hero--elqorin-editorial .slideshow__buttons .btn[disabled],
    .sleek-hero--elqorin-dark .slideshow__buttons .btn[disabled] {
      opacity: 1;
    } {% endcomment %}

    .sleek-hero--elqorin-editorial .slideshow__overlay {
      display: none !important;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-controls {
      position: absolute;
      left: clamp(32px, 4vw, 64px);
      right: clamp(32px, 4vw, 64px);
      bottom: clamp(24px, 3vw, 44px);
      z-index: 20;
      display: grid;
      grid-template-columns: 34px minmax(120px, 1fr) 34px auto;
      align-items: center;
      gap: 14px;
      pointer-events: none;
      color: var(--elqorin-black);
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-progress {
      height: 1px;
      background: var(--elqorin-line);
      position: relative;
      overflow: hidden;
    }

    .sleek-hero--elqorin-editorial [data-elqorin-progress] {
      position: absolute;
      inset: 0 auto 0 0;
      width: 33.333%;
      background: var(--elqorin-black);
      transition: width .45s ease;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-index {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      letter-spacing: .08em;
      white-space: nowrap;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-index-separator {
      opacity: .35;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-arrows {
      display: flex;
      gap: 4px;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-arrow {
      pointer-events: auto;
      appearance: none;
      border: 0;
      background: transparent;
      color: var(--elqorin-black);
      width: 34px;
      height: 34px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-arrow:hover {
      opacity: .55;
    }

    .sleek-hero--elqorin-editorial .swiper-controls {
      display: none !important;
    }

    .sleek-hero--elqorin-editorial .slideshow__slide-bg,
    .sleek-hero--elqorin-editorial .slideshow__slide-bg > motion-element,
    .sleek-hero--elqorin-editorial .slideshow__slide-bg .media,
    .sleek-hero--elqorin-editorial .slideshow__slide-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (max-width: 767px) {
    .sleek-hero--elqorin-editorial {
      background: var(--elqorin-ivory);
    }

    .sleek-hero--elqorin-editorial .slideshow__item-wrap {
      display: flex;
      flex-direction: column;
      min-height: 0 !important;
      background: var(--elqorin-ivory);
    }

    .sleek-hero--elqorin-editorial .slideshow__bg {
      position: relative !important;
      inset: auto !important;
      order: 1;
      width: 100% !important;
      height: min(72vw, 520px) !important;
      min-height: 0 !important;
      z-index: 0 !important;
    }

    .sleek-hero--elqorin-editorial .slideshow__content {
      position: relative !important;
      inset: auto !important;
      order: 2;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 42px 24px 48px !important;
      background: var(--elqorin-ivory) !important;
      color: var(--elqorin-black) !important;
    }

    .sleek-hero--elqorin-editorial .slideshow__text {
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
    }

    .sleek-hero--elqorin-editorial .slideshow__title {
      color: var(--elqorin-black);
      font-size: clamp(40px, 12vw, 58px);
      line-height: 1;
      letter-spacing: -.03em;
    }

    .sleek-hero--elqorin-editorial .slideshow__subtitle,
    .sleek-hero--elqorin-editorial .slideshow__description {
      color: var(--elqorin-black);
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-controls {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 18px;
      z-index: 20;
      display: grid;
      grid-template-columns: 30px minmax(80px, 1fr) 30px auto;
      align-items: center;
      gap: 8px;
      pointer-events: none;
      color: var(--elqorin-black);
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-progress {
      height: 1px;
      background: var(--elqorin-line);
      position: relative;
    }

    .sleek-hero--elqorin-editorial [data-elqorin-progress] {
      position: absolute;
      inset: 0 auto 0 0;
      width: 33.333%;
      background: var(--elqorin-black);
      transition: width .45s ease;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-index {
      display: flex;
      gap: 6px;
      font-size: 10px;
      letter-spacing: .06em;
      white-space: nowrap;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-arrows {
      display: flex;
      gap: 2px;
    }

    .sleek-hero--elqorin-editorial .elqorin-hero-arrow {
      pointer-events: auto;
      appearance: none;
      border: 0;
      background: transparent;
      color: var(--elqorin-black);
      width: 30px;
      height: 30px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .sleek-hero--elqorin-editorial .swiper-controls {
      display: none !important;
    }
  }

  /* =======================================================
     Elqorin Dark — full-bleed overlay hero
     ("Your space. Your ritual. Your reset.")
     ======================================================= */
  .sleek-hero--elqorin-dark {
    --elqorin-dark-bg: #0a0a09;
    --elqorin-black: #000000;
    --elqorin-white: #ffffff;
    background: var(--elqorin-dark-bg);
  }

  /* bottom scrim keeps the controls legible over bright imagery */
  .sleek-hero-section--elqorin-dark .slideshow__item-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(5, 5, 5, 0.28) 0%,
      rgba(5, 5, 5, 0) 30%,
      rgba(5, 5, 5, 0) 55%,
      rgba(5, 5, 5, 0.55) 100%
    );
  }

  /* controls: 01 — progress — 03 on the content gutter, arrows at the edge */
  .sleek-hero--elqorin-dark .elqorin-hero-controls {
    position: absolute;
    z-index: 20;
    left: calc(max((100% - var(--page-width, 88.125rem)) / 2, 0px) + var(--page-padding, 3.125rem));
    right: clamp(24px, 3vw, 64px);
    bottom: clamp(24px, 3.5vw, 44px);
    display: grid;
    grid-template-columns: auto minmax(160px, 520px) auto 1fr;
    align-items: center;
    gap: 14px;
    pointer-events: none;
    color: #fff;
  }

  .sleek-hero--elqorin-dark .elqorin-hero-progress {
