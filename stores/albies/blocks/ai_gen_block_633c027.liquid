{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_background }};
    color: {{ block.settings.section_text_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    width: 100%;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
  }

  .ai-faq-container-{{ ai_gen_id }} {
    box-sizing: border-box;
    width: 100%;
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  .ai-faq-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.left_column_width }}fr {{ block.settings.center_image_width }}fr {{ block.settings.faq_column_width }}fr;
    gap: {{ block.settings.column_spacing }}px;
    align-items: start;
  }

  .ai-faq-intro-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 20px;
    padding-top: 40px;
    min-width: 0;
  }

  .ai-faq-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size_desktop }}px;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    opacity: 0.7;
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    margin: 0;
    font-weight: 700;
    line-height: 1.2;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-faq-paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size_desktop }}px;
    margin: 0;
    line-height: 1.6;
    opacity: 0.85;
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-faq-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.button_width_desktop }}px;
    max-width: 100%;
    height: {{ block.settings.button_height_desktop }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_text_size_desktop }}px;
    font-weight: 500;
    transition: opacity 0.3s ease;
    border: 1px solid {{ block.settings.button_background }};
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
  }

  .ai-faq-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-faq-image-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    min-width: 0;
    padding-top: 0;
  }

  .ai-faq-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    max-width: 100%;
    height: {{ block.settings.image_height }}px;
    object-fit: {{ block.settings.image_fit }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-faq-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    max-width: 100%;
    height: {{ block.settings.image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-faq-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-faq-accordion-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.faq_spacing }}px;
    min-width: 0;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border: {{ block.settings.faq_border_thickness }}px solid {{ block.settings.faq_border_color }};
    border-radius: {{ block.settings.faq_border_radius }}px;
    overflow: hidden;
    transition: background-color 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.collapsed {
    background-color: {{ block.settings.faq_collapsed_background }};
  }

  .ai-faq-item-{{ ai_gen_id }}.expanded {
    background-color: {{ block.settings.faq_expanded_background }};
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.faq_padding }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: {{ block.settings.faq_question_size_desktop }}px;
    font-weight: 500;
    gap: 16px;
    transition: color 0.3s ease;
    font-family: {{ block.settings.faq_question_font.family }}, {{ block.settings.faq_question_font.fallback_families }};
    font-weight: {{ block.settings.faq_question_font.weight }};
    font-style: {{ block.settings.faq_question_font.style }};
  }

  .ai-faq-item-{{ ai_gen_id }}.collapsed .ai-faq-question-{{ ai_gen_id }} {
    color: {{ block.settings.faq_question_collapsed_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}.expanded .ai-faq-question-{{ ai_gen_id }} {
    color: {{ block.settings.faq_question_expanded_color }};
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.collapsed .ai-faq-icon-{{ ai_gen_id }} {
    color: {{ block.settings.faq_icon_collapsed_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}.expanded .ai-faq-icon-{{ ai_gen_id }} {
    color: {{ block.settings.faq_icon_expanded_color }};
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-faq-item-{{ ai_gen_id }}.expanded .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(45deg);
  }

  .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease;
    opacity: 0;
  }

  .ai-faq-item-{{ ai_gen_id }}.expanded .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 1000px;
    opacity: 1;
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.faq_padding }}px {{ block.settings.faq_padding }}px {{ block.settings.faq_padding }}px;
    font-size: {{ block.settings.faq_answer_size_desktop }}px;
    line-height: 1.7;
    color: {{ block.settings.faq_answer_color }};
    font-family: {{ block.settings.faq_answer_font.family }}, {{ block.settings.faq_answer_font.fallback_families }};
    font-weight: {{ block.settings.faq_answer_font.weight }};
    font-style: {{ block.settings.faq_answer_font.style }};
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  @media screen and (max-width: 1200px) {
    .ai-faq-container-{{ ai_gen_id }} {
      padding-left: 30px;
      padding-right: 30px;
    }

    .ai-faq-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.column_spacing | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-faq-container-{{ ai_gen_id }} {
      padding-left: 24px;
      padding-right: 24px;
    }

    .ai-faq-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.7 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-faq-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-faq-intro-{{ ai_gen_id }} {
      gap: 16px;
      text-align: center;
      align-items: center;
      padding-top: 0;
    }

    .ai-faq-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-faq-paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_text_size_mobile }}px;
    }

    .ai-faq-button-{{ ai_gen_id }} {
      width: {{ block.settings.button_width_mobile }}px;
      height: {{ block.settings.button_height_mobile }}px;
      font-size: {{ block.settings.button_text_size_mobile }}px;
    }

    .ai-faq-image-{{ ai_gen_id }},
    .ai-faq-image-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      min-height: 300px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.faq_question_size_mobile }}px;
      padding: {{ block.settings.faq_padding | times: 0.85 }}px;
    }

    .ai-faq-answer-{{ ai_gen_id }} {
      font-size: {{ block.settings.faq_answer_size_mobile }}px;
      padding: 0 {{ block.settings.faq_padding | times: 0.85 }}px {{ block.settings.faq_padding | times: 0.85 }}px {{ block.settings.faq_padding | times: 0.85 }}px;
    }

    .ai-faq-accordion-{{ ai_gen_id }} {
      gap: {{ block.settings.faq_spacing | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-faq-container-{{ ai_gen_id }} {
      padding-left: 20px;
      padding-right: 20px;
    }

    .ai-faq-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.5 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.5 }}px;
    }

    .ai-faq-grid-{{ ai_gen_id }} {
      gap: 32px;
    }

    .ai-faq-intro-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-faq-image-{{ ai_gen_id }},
    .ai-faq-image-placeholder-{{ ai_gen_id }} {
      min-height: 250px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      padding: {{ block.settings.faq_padding | times: 0.75 }}px;
      gap: 12px;
    }

    .ai-faq-answer-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.faq_padding | times: 0.75 }}px {{ block.settings.faq_padding | times: 0.75 }}px {{ block.settings.faq_padding | times: 0.75 }}px;
    }

    .ai-faq-accordion-{{ ai_gen_id }} {
      gap: {{ block.settings.faq_spacing | times: 0.7 }}px;
    }

    .ai-faq-icon-{{ ai_gen_id }} {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-faq-container-{{ ai_gen_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    .ai-faq-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.4 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.4 }}px;
    }

    .ai-faq-grid-{{ ai_gen_id }} {
      gap: 28px;
    }

    .ai-faq-image-{{ ai_gen_id }},
    .ai-faq-image-placeholder-{{ ai_gen_id }} {
      min-height: 200px;
    }
  }
{% endstyle %}

<soluna-faq-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    <div class="ai-faq-grid-{{ ai_gen_id }}">
      <div class="ai-faq-intro-{{ ai_gen_id }}">
        {% if block.settings.subheading != blank %}
          <p class="ai-faq-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-faq-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.paragraph != blank %}
          <p class="ai-faq-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph }}</p>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-faq-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-faq-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-faq-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-faq-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-faq-accordion-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% assign question_key = 'faq_question_' | append: i %}
          {% assign answer_key = 'faq_answer_' | append: i %}
          {% assign question = block.settings[question_key] %}
          {% assign answer = block.settings[answer_key] %}

          {% if question != blank and answer != blank %}
            <div class="ai-faq-item-{{ ai_gen_id }} collapsed" data-faq-item>
              <button
                class="ai-faq-question-{{ ai_gen_id }}"
                aria-expanded="false"
                data-faq-button
              >
                <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ question }}</span>
                <span class="ai-faq-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </button>
              <div class="ai-faq-answer-wrapper-{{ ai_gen_id }}" data-faq-answer>
                <div class="ai-faq-answer-{{ ai_gen_id }}">{{ answer }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</soluna-faq-{{ ai_gen_id }}>

<script>
  (function() {
    class SolunaFaq{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.faqItems = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.faqItems.forEach((item) => {
          const button = item.querySelector('[data-faq-button]');
          
          button.addEventListener('click', () => {
            const isExpanded = item.classList.contains('expanded');
            
            if (isExpanded) {
              item.classList.remove('expanded');
              item.classList.add('collapsed');
              button.setAttribute('aria-expanded', 'false');
            } else {
              this.faqItems.forEach((otherItem) => {
                if (otherItem !== item) {
                  otherItem.classList.remove('expanded');
                  otherItem.classList.add('collapsed');
                  otherItem.querySelector('[data-faq-button]').setAttribute('aria-expanded', 'false');
                }
              });
              
              item.classList.remove('collapsed');
              item.classList.add('expanded');
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('soluna-faq-{{ ai_gen_id }}', SolunaFaq{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "FAQ section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Section width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
