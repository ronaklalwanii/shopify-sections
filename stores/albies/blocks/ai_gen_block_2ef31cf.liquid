{% doc %}
  @prompt
    Generate a clean and stylish header. The header should be able to connect with the menu that is created. Give me option to change the font of menu. Give me control over the size of logo seperately in mobile and computer. In mobile, have a stylish menu button with cool animation in the left side that opens the menu drawer. Give me search and cart icons in the right. Make the icons stylish and raw. Give me option to hide and show the menu icons separately in computer and mobile mode. , Give the button for menu only in mobile mode and not in computer mode., Give me different design for the hamburger menu option in mobile mode, In mobile mode, Make the logo centered. Keep the search option turned off in mobile by default. In mobile mode, add a search bar in menu drawer, In desktop the logo should be left and the menu should be centred while in mobile the menu should be center aligned, Logo is not visible in mobile, Give me option to adjust the height of section seperately in mobile and computer mode, In mobile mode, give me different design options for hamburger menu style, The hamburger options don't work.. Correct those options please, Give me another extra button on the menu that reads "Loyalty Program". Give this button a hollow outlined look and give me an option to control the radius of border. In mobile version, this button needs to be in drawer menu and should also have that box outlined.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.header_bg_color }};
    width: 100%;
    display: block;
  }

  .ai-header-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 {{ block.settings.horizontal_padding_desktop }}px;
    height: {{ block.settings.header_height_desktop }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-header-left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
  }

  .ai-header-center-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .ai-header-right-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    justify-content: flex-end;
    flex: 1;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width_desktop }}px;
    height: auto;
    display: block;
  }

  .ai-header-menu-button-{{ ai_gen_id }} {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.icon_color }};
  }

  .ai-header-hamburger-{{ ai_gen_id }} {
    width: 24px;
    height: 18px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ai-header-hamburger-line-{{ ai_gen_id }} {
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition: all 0.3s ease;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style2 .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
    width: 70%;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style3 .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
    width: 60%;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style3 .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
    width: 80%;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style4 {
    justify-content: center;
    gap: 3px;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style4 .ai-header-hamburger-line-{{ ai_gen_id }} {
    height: 3px;
    border-radius: 2px;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style5 .ai-header-hamburger-line-{{ ai_gen_id }} {
    border-radius: 2px;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style5 .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
    width: 80%;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style5 .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
    width: 100%;
  }

  .ai-header-hamburger-{{ ai_gen_id }}--style5 .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
    width: 60%;
  }

  .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
    opacity: 0;
  }

  .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .ai-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_spacing }}px;
  }

  .ai-header-nav-{{ ai_gen_id }} a {
    color: {{ block.settings.menu_color }};
    text-decoration: none;
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: {{ block.settings.menu_font_size }}px;
    transition: color 0.3s ease;
  }

  .ai-header-nav-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-loyalty-button-{{ ai_gen_id }} {
    padding: {{ block.settings.loyalty_button_padding_vertical }}px {{ block.settings.loyalty_button_padding_horizontal }}px;
    border: 2px solid {{ block.settings.loyalty_button_border_color }};
    border-radius: {{ block.settings.loyalty_button_border_radius }}px;
    background: transparent;
    color: {{ block.settings.loyalty_button_text_color }};
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: {{ block.settings.menu_font_size }}px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .ai-header-loyalty-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.loyalty_button_border_color }};
    color: {{ block.settings.header_bg_color }};
  }

  .ai-header-icon-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease;
  }

  .ai-header-icon-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-header-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke-width: 1.5px;
  }

  .ai-header-drawer-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: -100%;
    width: {{ block.settings.drawer_width }}%;
    height: 100vh;
    background-color: {{ block.settings.drawer_bg_color }};
    z-index: 9999;
    transition: left 0.3s ease;
    overflow-y: auto;
    padding: 20px;
  }

  .ai-header-drawer-{{ ai_gen_id }}.active {
    left: 0;
  }

  .ai-header-drawer-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-header-drawer-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-header-drawer-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .ai-header-drawer-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.drawer_text_color }};
  }

  .ai-header-drawer-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} a {
    color: {{ block.settings.drawer_text_color }};
    text-decoration: none;
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: 18px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-header-drawer-search-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-header-drawer-search-{{ ai_gen_id }} input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.drawer_search_border_color }};
    border-radius: 8px;
    font-size: 16px;
  }

  .ai-header-drawer-loyalty-{{ ai_gen_id }} {
    margin-top: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-header-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.horizontal_padding_mobile }}px;
      height: {{ block.settings.header_height_mobile }}px;
    }

    .ai-header-left-{{ ai_gen_id }} {
      flex: 0;
    }

    .ai-header-center-{{ ai_gen_id }} {
      flex: 1;
    }

    .ai-header-right-{{ ai_gen_id }} {
      flex: 0;
    }

    .ai-header-logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width_mobile }}px;
    }

    .ai-header-menu-button-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-header-nav-{{ ai_gen_id }} {
      display: none;
    }

    {% if block.settings.hide_search_mobile %}
      .ai-header-search-icon-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}

    {% if block.settings.hide_cart_mobile %}
      .ai-header-cart-icon-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-header-drawer-{{ ai_gen_id }},
    .ai-header-drawer-overlay-{{ ai_gen_id }} {
      display: none;
    }

    {% if block.settings.hide_search_desktop %}
      .ai-header-search-icon-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}

    {% if block.settings.hide_cart_desktop %}
      .ai-header-cart-icon-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

<header-component-{{ ai_gen_id }} class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <div class="ai-header-left-{{ ai_gen_id }}">
      <button class="ai-header-menu-button-{{ ai_gen_id }}" aria-label="Open menu">
        <div class="ai-header-hamburger-{{ ai_gen_id }} ai-header-hamburger-{{ ai_gen_id }}--{{ block.settings.hamburger_style }}">
          <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
          <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
          <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
        </div>
      </button>

      <a href="/" class="ai-header-logo-{{ ai_gen_id }} ai-header-logo-desktop-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy">
        {% else %}
          <span style="font-size: 24px; font-weight: bold; color: {{ block.settings.menu_color }};">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="ai-header-center-{{ ai_gen_id }}">
      <a href="/" class="ai-header-logo-{{ ai_gen_id }} ai-header-logo-mobile-{{ ai_gen_id }}" style="display: none;">
        {% if block.settings.logo %}
          <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy">
        {% else %}
          <span style="font-size: 20px; font-weight: bold; color: {{ block.settings.menu_color }};">{{ shop.name }}</span>
        {% endif %}
      </a>

      <nav class="ai-header-nav-{{ ai_gen_id }}">
        {% if block.settings.menu != blank %}
          {% for link in block.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% endif %}
        {% if block.settings.loyalty_button_text != blank %}
          <a href="{{ block.settings.loyalty_button_link }}" class="ai-header-loyalty-button-{{ ai_gen_id }}">
            {{ block.settings.loyalty_button_text }}
          </a>
        {% endif %}
      </nav>
    </div>

    <div class="ai-header-right-{{ ai_gen_id }}">
      <button class="ai-header-icon-{{ ai_gen_id }} ai-header-search-icon-{{ ai_gen_id }}" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <a href="/cart" class="ai-header-icon-{{ ai_gen_id }} ai-header-cart-icon-{{ ai_gen_id }}" aria-label="Cart">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="ai-header-drawer-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-header-drawer-{{ ai_gen_id }}">
    <div class="ai-header-drawer-header-{{ ai_gen_id }}">
      <div style="font-size: 20px; font-weight: bold; color: {{ block.settings.drawer_text_color }};">Menu</div>
      <button class="ai-header-drawer-close-{{ ai_gen_id }}" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="ai-header-drawer-search-{{ ai_gen_id }}">
      <input type="search" placeholder="Search..." aria-label="Search">
    </div>

    <nav class="ai-header-drawer-nav-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        {% for link in block.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    {% if block.settings.loyalty_button_text != blank %}
      <div class="ai-header-drawer-loyalty-{{ ai_gen_id }}">
        <a href="{{ block.settings.loyalty_button_link }}" class="ai-header-loyalty-button-{{ ai_gen_id }}" style="display: block; text-align: center;">
          {{ block.settings.loyalty_button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</header-component-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.menuButton = this.querySelector('.ai-header-menu-button-{{ ai_gen_id }}');
        this.drawer = this.querySelector('.ai-header-drawer-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-header-drawer-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-header-drawer-close-{{ ai_gen_id }}');
        this.logoDesktop = this.querySelector('.ai-header-logo-desktop-{{ ai_gen_id }}');
        this.logoMobile = this.querySelector('.ai-header-logo-mobile-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.handleResize();
        window.addEventListener('resize', this.handleResize.bind(this));
      }

      setupEventListeners() {
        if (this.menuButton) {
          this.menuButton.addEventListener('click', () => this.toggleDrawer());
        }

        if (this.closeButton) {
          this.closeButton.addEventListener('click', () => this.closeDrawer());
        }

        if (this.overlay) {
          this.overlay.addEventListener('click', () => this.closeDrawer());
        }
      }

      toggleDrawer() {
        const isActive = this.drawer.classList.contains('active');
        if (isActive) {
          this.closeDrawer();
        } else {
          this.openDrawer();
        }
      }

      openDrawer() {
        this.drawer.classList.add('active');
        this.overlay.classList.add('active');
        this.menuButton.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeDrawer() {
        this.drawer.classList.remove('active');
        this.overlay.classList.remove('active');
        this.menuButton.classList.remove('active');
        document.body.style.overflow = '';
      }

      handleResize() {
        if (window.innerWidth < 750) {
          if (this.logoDesktop) this.logoDesktop.style.display = 'none';
          if (this.logoMobile) this.logoMobile.style.display = 'flex';
        } else {
          if (this.logoDesktop) this.logoDesktop.style.display = 'flex';
          if (this.logoMobile) this.logoMobile.style.display = 'none';
          this.closeDrawer();
        }
      }
    }

    customElements.define('header-component-{{ ai_gen_id }}', HeaderComponent{{ ai_gen_id }});
  })();
</script>

