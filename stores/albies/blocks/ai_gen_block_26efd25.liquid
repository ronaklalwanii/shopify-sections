{% doc %}
  @prompt
    a premium look and feel section to highlight clothing for men and women. a side by side card which leads to a collection. 2x2 on desktop and mobile and make it animated.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-collections-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-collections__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-premium-collections__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-premium-collections__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-premium-collections__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-premium-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-premium-collections__card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    aspect-ratio: 1 / 1;
    opacity: 0;
    transform: translateY(30px);
  }

  .ai-premium-collections__card-{{ ai_gen_id }}.animate-in {
    animation: ai-premium-fade-up-{{ ai_gen_id }} 0.8s ease-out forwards;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:nth-child(1) {
    animation-delay: 0.1s;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:nth-child(2) {
    animation-delay: 0.2s;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:nth-child(3) {
    animation-delay: 0.3s;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:nth-child(4) {
    animation-delay: 0.4s;
  }

  @keyframes ai-premium-fade-up-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-premium-collections__card-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .ai-premium-collections__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ai-premium-collections__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:hover .ai-premium-collections__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-premium-collections__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
    transition: opacity 0.4s ease;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:hover .ai-premium-collections__overlay-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-premium-collections__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px;
    z-index: 2;
  }

  .ai-premium-collections__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 12px;
    font-weight: 700;
    transform: translateY(0);
    transition: transform 0.4s ease;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:hover .ai-premium-collections__card-title-{{ ai_gen_id }} {
    transform: translateY(-8px);
  }

  .ai-premium-collections__card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 20px;
    opacity: 0.9;
    transform: translateY(0);
    transition: transform 0.4s ease;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:hover .ai-premium-collections__card-description-{{ ai_gen_id }} {
    transform: translateY(-8px);
  }

  .ai-premium-collections__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    transform: translateY(0);
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:hover .ai-premium-collections__cta-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-8px);
  }

  .ai-premium-collections__cta-arrow-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-premium-collections__card-{{ ai_gen_id }}:hover .ai-premium-collections__cta-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-premium-collections__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-premium-collections__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-premium-collections__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-premium-collections-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-premium-collections__header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-premium-collections__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-premium-collections__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-premium-collections__content-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-premium-collections__card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.8 }}px;
    }

    .ai-premium-collections__card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_description_size | times: 0.9 }}px;
    }

    .ai-premium-collections__cta-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }
{% endstyle %}

<premium-collections-{{ ai_gen_id }}
  class="ai-premium-collections-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-premium-collections__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-premium-collections__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-premium-collections__title-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-premium-collections__subtitle-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-premium-collections__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'
          assign button_key = 'card_' | append: i | append: '_button_text'
          assign image_key = 'card_' | append: i | append: '_image'

          assign collection = block.settings[collection_key]
          assign card_title = block.settings[title_key]
          assign card_description = block.settings[description_key]
          assign button_text = block.settings[button_key]
          assign custom_image = block.settings[image_key]
        %}

        <div class="ai-premium-collections__card-{{ ai_gen_id }}" data-card-index="{{ i }}">
          {% if collection != blank %}
            <a
              href="{{ collection.url }}"
              class="ai-premium-collections__card-link-{{ ai_gen_id }}"
              aria-label="{{ card_title | default: collection.title }}"
            >
              <div class="ai-premium-collections__image-wrapper-{{ ai_gen_id }}">
                {% if custom_image != blank %}
                  <img
                    src="{{ custom_image | image_url: width: 800 }}"
                    alt="{{ custom_image.alt | escape }}"
                    class="ai-premium-collections__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% elsif collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-premium-collections__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-premium-collections__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-premium-collections__overlay-{{ ai_gen_id }}"></div>

              <div class="ai-premium-collections__content-{{ ai_gen_id }}">
                <h3 class="ai-premium-collections__card-title-{{ ai_gen_id }}">
                  {{ card_title | default: collection.title }}
                </h3>
                {% if card_description != blank %}
                  <p class="ai-premium-collections__card-description-{{ ai_gen_id }}">
                    {{ card_description }}
                  </p>
                {% endif %}
                <span class="ai-premium-collections__cta-{{ ai_gen_id }}">
                  {{ button_text }}
                  <svg
                    class="ai-premium-collections__cta-arrow-{{ ai_gen_id }}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </a>
          {% else %}
            <div class="ai-premium-collections__card-link-{{ ai_gen_id }}">
              <div class="ai-premium-collections__image-wrapper-{{ ai_gen_id }}">
                {% if custom_image != blank %}
                  <img
                    src="{{ custom_image | image_url: width: 800 }}"
                    alt="{{ custom_image.alt | escape }}"
                    class="ai-premium-collections__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-premium-collections__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                    <div class="ai-premium-collections__empty-state-{{ ai_gen_id }}">
                      Next, select a collection
                    </div>
                  </div>
                {% endif %}
              </div>

              <div class="ai-premium-collections__overlay-{{ ai_gen_id }}"></div>

              <div class="ai-premium-collections__content-{{ ai_gen_id }}">
                <h3 class="ai-premium-collections__card-title-{{ ai_gen_id }}">
                  {{ card_title }}
                </h3>
                {% if card_description != blank %}
                  <p class="ai-premium-collections__card-description-{{ ai_gen_id }}">
                    {{ card_description }}
                  </p>
                {% endif %}
                <span class="ai-premium-collections__cta-{{ ai_gen_id }}">
                  {{ button_text }}
                  <svg
                    class="ai-premium-collections__cta-arrow-{{ ai_gen_id }}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</premium-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = this.querySelectorAll('.ai-premium-collections__card-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-in');
              observer.unobserve(entry.target);
            }
          });
        }, options);

        this.cards.forEach((card) => {
          observer.observe(card);
        });
      }
    }

    customElements.define('premium-collections-{{ ai_gen_id }}', PremiumCollections{{ ai_gen_id }});
  })();
</script>

