{% doc %}
  @prompt
    a utility margin block that has margin top, right, bottom and left selector with no content
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-utility-margin-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 0;
    margin-top: {{ block.settings.margin_top }}px;
    margin-right: {{ block.settings.margin_right }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: {{ block.settings.margin_left }}px;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-utility-margin-{{ ai_gen_id }} {
      margin-top: {{ block.settings.mobile_margin_top }}px;
      margin-right: {{ block.settings.mobile_margin_right }}px;
      margin-bottom: {{ block.settings.mobile_margin_bottom }}px;
      margin-left: {{ block.settings.mobile_margin_left }}px;
    }
  }
{% endstyle %}

<utility-margin-{{ ai_gen_id }}
  class="ai-utility-margin-{{ ai_gen_id }}"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></utility-margin-{{ ai_gen_id }}>

