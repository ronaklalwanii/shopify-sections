      "default": 16
    },
    {
      "type": "header",
      "content": "Left Column Content"
    },
    {
      "type": "text",
      "id": "po_left_eyebrow",
      "label": "Eyebrow Text",
      "default": "HOW WE CREATE CHANGE"
    },
    {
      "type": "text",
      "id": "po_left_heading",
      "label": "Heading",
      "default": "From awareness to lasting change"
    },
    {
      "type": "header",
      "content": "Right Column Content"
    },
    {
      "type": "text",
      "id": "po_right_eyebrow",
      "label": "Eyebrow Text",
      "default": "THE OUTCOMES"
    },
    {
      "type": "text",
      "id": "po_right_heading",
      "label": "Heading",
