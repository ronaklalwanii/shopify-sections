  ],
  "presets": [
    {
      "name": "Process & Outcomes",
      "blocks": [
        { "type": "step", "settings": { "po_step_number": "1", "po_step_title": "Understand", "po_step_desc": "Build shared understanding of consent, power, boundaries and digital harm." } },
