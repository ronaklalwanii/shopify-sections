    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "po_step_number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "po_step_title",
