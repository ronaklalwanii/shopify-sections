<style>
    #shopify-section-{{ section.id }} {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}
  .fc-section-{{ section.id }} {
    /* Layout Variables */
    --fc-bg: {{ section.settings.fc_section_bg }};
    --fc-padding-top: {{ section.settings.fc_padding_top }}px;
    --fc-padding-bottom: {{ section.settings.fc_padding_bottom }}px;
    --fc-max-width: {{ section.settings.fc_max_width }}px;
    --fc-gap: {{ section.settings.fc_grid_gap }}px;
    
    /* Grid Columns */
    --fc-cols-desktop: {{ section.settings.fc_cols_desktop }};
    --fc-cols-tablet: {{ section.settings.fc_cols_tablet }};
    --fc-cols-mobile: {{ section.settings.fc_cols_mobile }};

    /* Card Variables */
    --fc-card-bg: {{ section.settings.fc_card_bg }};
    --fc-card-border: {{ section.settings.fc_card_border_color }};
    --fc-card-border-width: {{ section.settings.fc_card_border_width }}px;
    --fc-card-radius: {{ section.settings.fc_card_radius }}px;
    --fc-card-padding: {{ section.settings.fc_card_padding }}px;

    /* Typography Variables */
    --fc-eyebrow-color: {{ section.settings.fc_eyebrow_color }};
    --fc-eyebrow-size: {{ section.settings.fc_eyebrow_size }}px;
    
    --fc-heading-color: {{ section.settings.fc_heading_color }};
    --fc-heading-size: {{ section.settings.fc_heading_size }}px;
    --fc-heading-weight: {{ section.settings.fc_headding_weight }};
    
    --fc-footer-color: {{ section.settings.fc_footer_color }};
    --fc-footer-size: {{ section.settings.fc_footer_size }}px;

    --fc-title-color: {{ section.settings.fc_title_color }};
    --fc-title-size: {{ section.settings.fc_title_size }}px;
    --fc-title-weight: {{ section.settings.fc_title_weight }};

    --fc-desc-color: {{ section.settings.fc_desc_color }};
    --fc-desc-size: {{ section.settings.fc_desc_size }}px;

    --fc-link-color: {{ section.settings.fc_link_color }};
    --fc-link-size: {{ section.settings.fc_link_size }}px;
    --fc-link-weight: {{ section.settings.fc_link_weight }};

    background-color: var(--fc-bg);
    padding-top: var(--fc-padding-top);
    padding-bottom: var(--fc-padding-bottom);
  }

  .fc-section-{{ section.id }} .fc-container {
    max-width: var(--fc-max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .fc-section-{{ section.id }} .fc-header {
    text-align: center;
    margin-bottom: 50px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .fc-section-{{ section.id }} .fc-eyebrow {
    color: var(--fc-eyebrow-color);
    font-size: var(--fc-eyebrow-size);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
    display: block;
  }

  .fc-section-{{ section.id }} .fc-heading {
    color: var(--fc-heading-color);
    font-size: var(--fc-heading-size);
    font-weight: var(--fc-heading-weight);
    line-height: 1.2;
    margin: 0;
  }

  .fc-section-{{ section.id }} .fc-grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-cols-desktop), 1fr);
    gap: var(--fc-gap);
    margin-bottom: 40px;
  }

  .fc-section-{{ section.id }} .fc-card {
    background-color: var(--fc-card-bg);
    border: var(--fc-card-border-width) solid var(--fc-card-border);
    border-radius: var(--fc-card-radius);
    padding: var(--fc-card-padding);
    display: flex;
    flex-direction: row; /* Horizontal layout */
    align-items: flex-start;
    gap: 20px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%; /* Ensure equal height in grid */
    box-sizing: border-box;
  }

  .fc-section-{{ section.id }} .fc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .fc-section-{{ section.id }} .fc-icon-wrapper {
    flex-shrink: 0;
    width: 60px; /* Fixed width for icon column */
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fc-section-{{ section.id }} .fc-icon {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .fc-section-{{ section.id }} .fc-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: left;
  }

  .fc-section-{{ section.id }} .fc-title {
    color: var(--fc-title-color);
    font-size: var(--fc-title-size);
    font-weight: var(--fc-title-weight);
    margin-bottom: 12px;
    line-height: 1.3;
    margin-top: 0;
  }

  .fc-section-{{ section.id }} .fc-desc {
    color: var(--fc-desc-color);
    font-size: var(--fc-desc-size);
    line-height: 1.5;
    margin: 0 0 20px 0;
    flex-grow: 1; /* Pushes link to bottom if content varies */
  }

  .fc-section-{{ section.id }} .fc-link {
    color: var(--fc-link-color);
    font-size: var(--fc-link-size);
    font-weight: var(--fc-link-weight);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto; /* Pushes link to bottom of card */
    transition: gap 0.3s ease;
  }

  .fc-section-{{ section.id }} .fc-link:hover {
    gap: 12px; /* Arrow animation */
  }

  .fc-section-{{ section.id }} .fc-footer {
    text-align: center;
    color: var(--fc-footer-color);
    font-size: var(--fc-footer-size);
    font-weight: 500;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 990px) {
    .fc-section-{{ section.id }} .fc-grid {
      grid-template-columns: repeat(var(--fc-cols-tablet), 1fr);
    }
  }
/* --- MOD START --- */
  @media (max-width: 749px) {
    /* Horizontal Scroll Setup */
    .fc-section-{{ section.id }} .fc-grid {
      display: flex;
      overflow-x: auto;
      overflow-y: visible; /* Prevents scroll hijacking */
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none;  /* IE 10+ */
      padding-bottom: 10px; /* Visual breathing room at bottom */
    }
    
    /* Hide Scrollbar for Chrome/Safari/Opera */
    .fc-section-{{ section.id }} .fc-grid::-webkit-scrollbar { 
      display: none; 
    }

    /* Card Sizing for Peek Effect */
    .fc-section-{{ section.id }} .fc-card {
      flex: 0 0 85%; /* 85% width leaves 15% of next card visible */
      scroll-snap-align: start;
      /* Stack card content on mobile */
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .fc-section-{{ section.id }} .fc-heading {
      font-size: calc(var(--fc-heading-size) * 0.8);
    }
    .fc-section-{{ section.id }} .fc-content {
      align-items: center;
    }
    .fc-section-{{ section.id }} .fc-link {
      margin-top: 20px;
    }
  }
/* --- MOD END --- */
</style>

<section class="fc-section-{{ section.id }}">
  <div class="fc-container">
    
    <div class="fc-header">
      {% if section.settings.fc_eyebrow_text != blank %}
        <span class="fc-eyebrow">{{ section.settings.fc_eyebrow_text }}</span>
      {% endif %}
      {% if section.settings.fc_heading_text != blank %}
        <h2 class="fc-heading">{{ section.settings.fc_heading_text }}</h2>
      {% endif %}
    </div>

    <div class="fc-grid">
      {% for block in section.blocks %}
        <article class="fc-card" {{ block.shopify_attributes }}>
          {% if block.settings.fc_card_icon != blank %}
            <div class="fc-icon-wrapper">
              {{ block.settings.fc_card_icon | image_url: width: 100 | image_tag: class: 'fc-icon', loading: 'lazy', widths: '50, 100, 150' }}
            </div>
          {% endif %}
          
          <div class="fc-content">
            {% if block.settings.fc_card_title != blank %}
              <h3 class="fc-title">{{ block.settings.fc_card_title }}</h3>
            {% endif %}
            
            {% if block.settings.fc_card_desc != blank %}
              <p class="fc-desc">{{ block.settings.fc_card_desc }}</p>
            {% endif %}

            {% if block.settings.fc_card_link_text != blank and block.settings.fc_card_link_url != blank %}
              <a href="{{ block.settings.fc_card_link_url }}" class="fc-link">
                {{ block.settings.fc_card_link_text }}
                <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.fc_footer_text != blank %}
      <p class="fc-footer">{{ section.settings.fc_footer_text }}</p>
    {% endif %}

  </div>
</section>

