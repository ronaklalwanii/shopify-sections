      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "hero_eyebrow_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Weight",
      "default": 600
    },
    {
      "type": "header",
      "content": "Typography: Heading"
    },
    {
      "type": "color",
      "id": "hero_heading_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "hero_heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "hero_heading_weight",
      "min": 100,
      "max": 900,
      "step": 100,
