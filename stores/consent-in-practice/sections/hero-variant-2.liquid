    },
    {
      "type": "range",
      "id": "hero_description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "hero_description_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Weight",
      "default": 400
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
