      "label": "Icon"
    },
    {
      "type": "text",
      "id": "badge_2_title",
      "label": "Title",
      "default": "Delivered by a Specialist"
    },
    {
      "type": "textarea",
      "id": "badge_2_description",
      "label": "Description",
      "default": "Led by an MSc-trained researcher in consent and digital harm"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "image_picker",
      "id": "badge_3_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "badge_3_title",
      "label": "Title",
      "default": "Accredited Completion Certificates"
    },
    {
      "type": "textarea",
      "id": "badge_3_description",
      "label": "Description",
