          <span class="ai-hamburger-dot-{{ ai_gen_id }}"></span>
          <span class="ai-hamburger-dot-{{ ai_gen_id }}"></span>
          <span class="ai-hamburger-dot-{{ ai_gen_id }}"></span>
          <span class="ai-hamburger-dot-{{ ai_gen_id }}"></span>
          <span class="ai-hamburger-dot-{{ ai_gen_id }}"></span>
