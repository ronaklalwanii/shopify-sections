{% doc %}
  @prompt
    Generate a clean and stylish header. The header should be able to connect with the menu that is created. Give me option to change the font of menu. Give me control over the size of logo seperately in mobile and computer. In mobile, have a stylish menu button with cool animation in the left side that opens the menu drawer. Give me search and cart icons in the right. Make the icons stylish and raw. Give me option to hide and show the menu icons separately in computer and mobile mode. , Give the button for menu only in mobile mode and not in computer mode., Give me different design for the hamburger menu option in mobile mode, In mobile mode, Make the logo centered. Keep the search option turned off in mobile by default. In mobile mode, add a search bar in menu drawer, In desktop the logo should be left and the menu should be centred while in mobile the menu should be center aligned, Logo is not visible in mobile, Give me option to adjust the height of section seperately in mobile and computer mode, In mobile mode, give me different design options for hamburger menu style, The hamburger options don't work.. Correct those options please, Give me another extra button on the menu that reads "Loyalty Program". Give this button a hollow outlined look and give me an option to control the radius of border. In mobile version, this button needs to be in drawer menu and should also have that box outlined.
    
    For computer layout, give me layout options:
    
    Logo left, menu centered
    Logo centered, menu left
    Logo Left, menu inline, Give me option to control the border thickness of loyalty button.
    Give me option to control the height and width of the loyalty button.
    , Give me ability to control the colour of the text in menu, Give me more design and animation options for mobile menu hamburger, Now give me different designs for hamburger as well, In hamburger Menu, Give me variations ofr three lines as well for design
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.header_bg_color }};
    position: relative;
    z-index: 100;
  }

  .ai-header-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    height: {{ block.settings.header_height_desktop }}px;
    max-width: 100%;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    display: block;
    max-width: {{ block.settings.logo_width_desktop }}px;
    height: auto;
  }

  .ai-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-nav-{{ ai_gen_id }} a {
    color: {{ block.settings.menu_text_color }};
    text-decoration: none;
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: {{ block.settings.menu_font_size }}px;
    transition: opacity 0.3s ease;
  }

  .ai-header-nav-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-header-loyalty-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    height: {{ block.settings.loyalty_button_height }}px;
    width: {{ block.settings.loyalty_button_width }}px;
    background: transparent;
    border: {{ block.settings.loyalty_border_thickness }}px solid {{ block.settings.loyalty_border_color }};
    border-radius: {{ block.settings.loyalty_border_radius }}px;
    color: {{ block.settings.loyalty_text_color }};
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: {{ block.settings.menu_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-header-loyalty-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.loyalty_border_color }};
    color: {{ block.settings.header_bg_color }};
  }

  .ai-header-icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .ai-header-icon-btn-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: {{ block.settings.icon_color }};
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-header-icon-btn-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-header-icon-btn-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke-width: 1.5;
  }

  .ai-header-hamburger-{{ ai_gen_id }} {
    display: none;
  }

  .ai-header-drawer-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: -100%;
    width: 80%;
    max-width: 400px;
    height: 100vh;
    background-color: {{ block.settings.drawer_bg_color }};
    z-index: 1000;
    transition: left 0.3s ease;
    overflow-y: auto;
  }

  .ai-header-drawer-{{ ai_gen_id }}.active {
    left: 0;
  }

  .ai-header-drawer-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-header-drawer-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-header-drawer-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-header-drawer-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: {{ block.settings.drawer_menu_text_color }};
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-header-drawer-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} a {
    color: {{ block.settings.drawer_menu_text_color }};
    text-decoration: none;
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: 18px;
    display: block;
  }

  .ai-header-drawer-search-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-header-drawer-search-{{ ai_gen_id }} input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.drawer_menu_text_color }};
    border-radius: 8px;
    background: transparent;
    color: {{ block.settings.drawer_menu_text_color }};
    font-size: 16px;
  }

  .ai-header-drawer-search-{{ ai_gen_id }} input::placeholder {
    color: {{ block.settings.drawer_menu_text_color }};
    opacity: 0.6;
  }

  .ai-header-drawer-loyalty-{{ ai_gen_id }} {
    margin-top: 30px;
  }

  .ai-header-drawer-loyalty-{{ ai_gen_id }} .ai-header-loyalty-btn-{{ ai_gen_id }} {
    width: 100%;
  }

  {% if block.settings.desktop_layout == 'logo_left_menu_center' %}
    .ai-header-container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .ai-header-logo-{{ ai_gen_id }} {
      justify-self: start;
    }

    .ai-header-nav-wrapper-{{ ai_gen_id }} {
      justify-self: center;
    }

    .ai-header-icons-{{ ai_gen_id }} {
      justify-self: end;
    }
  {% elsif block.settings.desktop_layout == 'logo_center_menu_left' %}
    .ai-header-container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .ai-header-nav-wrapper-{{ ai_gen_id }} {
      justify-self: start;
      order: 1;
    }

    .ai-header-logo-{{ ai_gen_id }} {
      justify-self: center;
      order: 2;
    }

    .ai-header-icons-{{ ai_gen_id }} {
      justify-self: end;
      order: 3;
    }
  {% elsif block.settings.desktop_layout == 'logo_left_menu_inline' %}
    .ai-header-container-{{ ai_gen_id }} {
      display: flex;
      justify-content: space-between;
    }

    .ai-header-nav-wrapper-{{ ai_gen_id }} {
      margin-left: 40px;
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .ai-header-container-{{ ai_gen_id }} {
      height: {{ block.settings.header_height_mobile }}px;
      display: flex !important;
      grid-template-columns: none !important;
      justify-content: space-between;
    }

    .ai-header-logo-{{ ai_gen_id }} {
      order: 2;
      justify-self: center !important;
      margin: 0 auto;
    }

    .ai-header-logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width_mobile }}px;
    }

    .ai-header-hamburger-{{ ai_gen_id }} {
      display: flex;
      order: 1;
    }

    .ai-header-nav-wrapper-{{ ai_gen_id }} {
      display: none;
    }

    .ai-header-icons-{{ ai_gen_id }} {
      order: 3;
    }

    {% if block.settings.hide_search_mobile %}
      .ai-header-search-desktop-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}

    {% if block.settings.hide_cart_mobile %}
      .ai-header-cart-mobile-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }

  @media screen and (min-width: 990px) {
    .ai-header-drawer-{{ ai_gen_id }},
    .ai-header-drawer-overlay-{{ ai_gen_id }} {
      display: none;
    }

    {% if block.settings.hide_search_desktop %}
      .ai-header-search-desktop-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}

    {% if block.settings.hide_cart_desktop %}
      .ai-header-cart-desktop-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }

  .ai-hamburger-icon-{{ ai_gen_id }} {
    width: {{ block.settings.hamburger_size }}px;
    height: {{ block.settings.hamburger_size }}px;
    position: relative;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  {% if block.settings.three_lines_style == 'standard' %}
    {% if block.settings.hamburger_animation == 'x_rotate' %}
      .ai-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: {{ block.settings.hamburger_thickness }}px;
        background-color: {{ block.settings.hamburger_color }};
        transition: all 0.3s ease;
        border-radius: {{ block.settings.hamburger_line_radius }}px;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        opacity: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%) rotate(-45deg);
      }
    {% elsif block.settings.hamburger_animation == 'arrow_left' %}
      .ai-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: {{ block.settings.hamburger_thickness }}px;
        background-color: {{ block.settings.hamburger_color }};
        transition: all 0.3s ease;
        border-radius: {{ block.settings.hamburger_line_radius }}px;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        width: 50%;
        transform: translateY(-50%) rotate(-45deg);
        transform-origin: left center;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        transform: translateY(-50%) translateX(5px);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        width: 50%;
        transform: translateY(50%) rotate(45deg);
        transform-origin: left center;
      }
    {% elsif block.settings.hamburger_animation == 'squeeze' %}
      .ai-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: {{ block.settings.hamburger_thickness }}px;
        background-color: {{ block.settings.hamburger_color }};
        transition: all 0.3s ease;
        border-radius: {{ block.settings.hamburger_line_radius }}px;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
        width: 80%;
        left: 10%;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        opacity: 0;
        transform: translateY(-50%) scale(0);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%) rotate(-45deg);
        width: 80%;
        left: 10%;
      }
    {% elsif block.settings.hamburger_animation == 'spin' %}
      .ai-hamburger-icon-{{ ai_gen_id }} {
        transition: transform 0.3s ease;
      }

      .ai-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: {{ block.settings.hamburger_thickness }}px;
        background-color: {{ block.settings.hamburger_color }};
        transition: all 0.3s ease;
        border-radius: {{ block.settings.hamburger_line_radius }}px;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active {
        transform: rotate(180deg);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        opacity: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%) rotate(-45deg);
      }
    {% elsif block.settings.hamburger_animation == 'elastic' %}
      .ai-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: {{ block.settings.hamburger_thickness }}px;
        background-color: {{ block.settings.hamburger_color }};
        transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        border-radius: {{ block.settings.hamburger_line_radius }}px;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        opacity: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%) rotate(-45deg);
      }
    {% elsif block.settings.hamburger_animation == 'minus' %}
      .ai-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: {{ block.settings.hamburger_thickness }}px;
        background-color: {{ block.settings.hamburger_color }};
        transition: all 0.3s ease;
        border-radius: {{ block.settings.hamburger_line_radius }}px;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        transform: translateY(-50%);
      }

      .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%);
        opacity: 0;
      }
    {% endif %}
  {% elsif block.settings.three_lines_style == 'staggered_right' %}
    .ai-hamburger-line-{{ ai_gen_id }} {
      position: absolute;
      height: {{ block.settings.hamburger_thickness }}px;
      background-color: {{ block.settings.hamburger_color }};
      transition: all 0.3s ease;
      border-radius: {{ block.settings.hamburger_line_radius }}px;
      right: 0;
    }

    .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
      top: 0;
      width: 100%;
    }

    .ai-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
      top: 50%;
      transform: translateY(-50%);
      width: 75%;
    }

    .ai-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
      bottom: 0;
      width: 50%;
    }

    .ai-hamburger-icon-{{ ai_gen_id }}.active .ai-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
