{%- liquid
  assign socials = 'facebook,instagram,youtube,tiktok,twitter,snapchat,pinterest,tumblr,vimeo' | split: ','
-%}
<ul class="social-icons">
  {%- for platform in socials -%}
    {%- assign setting_key = 'social_' | append: platform | append: '_link' -%}
    {%- assign url = settings[setting_key] -%}
    {%- if url != blank -%}
      <li>
        <a href="{{ url }}" class="social-icons__link" aria-label="{{ platform | capitalize }}" target="_blank" rel="noopener">
          {%- case platform -%}
            {%- when 'facebook' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon icon--filled"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9c0-.3.2-.5.5-.5H14V9Z"></path></svg>
            {%- when 'instagram' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" class="icon--filled"></circle></svg>
            {%- when 'youtube' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><rect x="2" y="5" width="20" height="14" rx="3"></rect><path d="m10 9 5 3-5 3V9Z" class="icon--filled"></path></svg>
            {%- when 'tiktok' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M15 3v10.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M15 3c.5 2.5 2 4 5 4.5"></path></svg>
            {%- when 'twitter' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M4 4l16 16M20 4 4 20"></path></svg>
            {%- when 'snapchat' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><circle cx="12" cy="12" r="8"></circle></svg>
            {%- when 'pinterest' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><circle cx="12" cy="12" r="9"></circle><path d="M10 18c1-4 1-8 1-9.5a2.5 2.5 0 0 1 5 0c0 2-1 4-3 4"></path></svg>
            {%- when 'tumblr' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M13 3v4h3v3h-3v6c0 1 .5 1.5 1.5 1.5h1.5v3h-2.5A3.5 3.5 0 0 1 10 17V10H8V7h2V3h3Z" class="icon--filled"></path></svg>
            {%- when 'vimeo' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M3 8c2 0 3 1 3.5 3.5C7 15 8 18 9.5 18c1.5 0 3-3 3.2-5.4.2-2.5-1-3-2-2.6.8-3 2.7-4.7 5.3-4.7 3.2 0 4.5 2 4 5-.5 3.6-3.5 8.7-6.5 8.7-3 0-4-3-5-8-.5-2.7-1.3-3.5-2.5-2.7L3 8Z"></path></svg>
          {%- endcase -%}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
