{{ 'image-with-text-overlay.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign variant_mode = section.settings.arc_variant_mode | default: 'default'
  assign image_size = section.settings.image_size | default: 'auto'
  assign content_h_align = section.settings.content_h_align | default: 'center'
  assign content_v_align = section.settings.content_v_align | default: 'center'
  assign text_align = section.settings.text_align | default: 'center'
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | default: 30 | divided_by: 100.0
  assign enable_gradient = section.settings.enable_gradient | default: false
  assign gradient_direction = section.settings.gradient_direction | default: 'to top'
  assign gradient_strength = section.settings.gradient_strength | default: 60 | divided_by: 100.0
  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 40
-%}

<style>
  {%- if section.settings.arc_heading_font != blank -%}
    {{ section.settings.arc_heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.arc_body_font != blank -%}
    {{ section.settings.arc_body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.arc_feature_font != blank -%}
    {{ section.settings.arc_feature_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.subheading_font != blank -%}
    {{ section.settings.subheading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.heading_font != blank -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.paragraph_font != blank -%}
    {{ section.settings.paragraph_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #shopify-section-{{ section.id }} {
    {%- if section.settings.custom_padding -%}
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
    {%- endif -%}

    --iwto-overlay-color: {{ overlay_color }};
    --iwto-overlay-opacity: {{ overlay_opacity }};
    --iwto-gradient-direction: {{ gradient_direction }};
    --iwto-gradient-strength: {{ gradient_strength }};
    {%- if section.settings.text_color != blank -%}
      --iwto-text-color: {{ section.settings.text_color }};
    {%- endif -%}

    /* Hero image dimensions */
    --iwto-desktop-image-height: {{ section.settings.desktop_image_height | default: 680 }}px;
    --iwto-mobile-image-height: {{ section.settings.mobile_image_height | default: 620 }}px;
    --iwto-desktop-image-position: {{ section.settings.desktop_image_position | default: 'center' }};
    --iwto-mobile-image-position: {{ section.settings.mobile_image_position | default: 'center' }};

    /* Typography */
    {%- if section.settings.subheading_font != blank -%}
      --iwto-subheading-font-family: {{ section.settings.subheading_font.family }}, {{ section.settings.subheading_font.fallback_families }};
    {%- endif -%}
    --iwto-subheading-size: {{ section.settings.subheading_size | default: 14 }}px;
    --iwto-subheading-size-mobile: {{ section.settings.subheading_size_mobile | default: 12 }}px;
    --iwto-subheading-weight: {{ section.settings.subheading_weight | default: 700 }};
    --iwto-subheading-color: {{ section.settings.subheading_color | default: '#ffffff' }};

    {%- if section.settings.heading_font != blank -%}
      --iwto-heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    {%- endif -%}
    --iwto-heading-size: {{ section.settings.heading_size | default: 48 }}px;
    --iwto-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 32 }}px;
    --iwto-heading-weight: {{ section.settings.heading_weight | default: 700 }};
    --iwto-heading-color: {{ section.settings.heading_color | default: '#ffffff' }};

    {%- if section.settings.paragraph_font != blank -%}
      --iwto-paragraph-font-family: {{ section.settings.paragraph_font.family }}, {{ section.settings.paragraph_font.fallback_families }};
    {%- endif -%}
    --iwto-paragraph-size: {{ section.settings.paragraph_size | default: 16 }}px;
    --iwto-paragraph-size-mobile: {{ section.settings.paragraph_size_mobile | default: 14 }}px;
    --iwto-paragraph-color: {{ section.settings.paragraph_color | default: '#ffffff' }};

    /* Arc specific CSS variables */
    --iwto-arc-heading-size: {{ section.settings.arc_heading_size | default: 64 }}px;
    --iwto-arc-heading-size-mobile: {{ section.settings.arc_heading_size_mobile | default: 36 }}px;
    {%- if section.settings.arc_heading_font != blank -%}
      --iwto-arc-heading-font-family: {{ section.settings.arc_heading_font.family }}, {{ section.settings.arc_heading_font.fallback_families }};
    {%- endif -%}
    {%- if section.settings.arc_body_font != blank -%}
      --iwto-arc-body-font-family: {{ section.settings.arc_body_font.family }}, {{ section.settings.arc_body_font.fallback_families }};
    {%- endif -%}
    {%- if section.settings.arc_feature_font != blank -%}
      --iwto-arc-feature-font-family: {{ section.settings.arc_feature_font.family }}, {{ section.settings.arc_feature_font.fallback_families }};
    {%- endif -%}
    {%- if section.settings.arc_content_bg != blank -%}
      --iwto-arc-content-bg: {{ section.settings.arc_content_bg }};
    {%- endif -%}
    {%- if section.settings.arc_subheading_color != blank -%}
      --iwto-arc-subheading-color: {{ section.settings.arc_subheading_color }};
    {%- endif -%}
    {%- if section.settings.arc_heading_color != blank -%}
      --iwto-arc-heading-color: {{ section.settings.arc_heading_color }};
    {%- endif -%}
    {%- if section.settings.arc_accent_color != blank -%}
      --iwto-arc-accent-color: {{ section.settings.arc_accent_color }};
    {%- endif -%}
    {%- if section.settings.arc_text_color != blank -%}
      --iwto-arc-text-color: {{ section.settings.arc_text_color }};
    {%- endif -%}
    --iwto-arc-rating-border-width: {{ section.settings.arc_rating_border_width | default: 1 }}px;
    --iwto-arc-rating-border-color: {{ section.settings.arc_rating_border_color | default: '#e8e8e8' }};
  }
</style>

<div
  id="shopify-section-{{ section.id }}-content"
  class="iwto {% if variant_mode == 'arc' %}iwto--arc{% else %}iwto--overlay iwto--{{ image_size }} iwto--v-{{ content_v_align }} iwto--h-{{ content_h_align }} iwto--text-{{ text_align }}{% endif %} color-{{ section.settings.color_scheme }} {% if section.settings.full_width %}iwto--full{% endif %}"
>
  {%- if variant_mode == 'arc' -%}
    <div class="iwto-arc">
      <!-- Left Column: Content from Blocks -->
      <div class="iwto-arc__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              {%- if block.settings.text != blank -%}
                <p class="iwto-arc__subheading iwto-arc__font-body" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if block.settings.text != blank -%}
                {%- assign heading_tag = block.settings.heading_tag | default: 'h2' -%}
                <{{ heading_tag }} class="iwto-arc__heading iwto-arc__font-heading" {{ block.shopify_attributes }}>
                  {%- assign heading_parts = block.settings.text | split: ' ' -%}
                  {%- for part in heading_parts -%}
                    {%- if part contains 'Arc' or part contains 'arc' -%}
                      <span class="iwto-arc__accent">{{ part }}</span>
                    {%- else -%}
                      {{ part }}
                    {%- endif -%}
                    {%- unless forloop.last %} {% endunless -%}
                  {%- endfor -%}
                </{{ heading_tag }}>
              {%- endif -%}

            {%- when 'richtext' -%}
              {%- if block.settings.content != blank -%}
                <div class="iwto-arc__richtext iwto-arc__font-body" {{ block.shopify_attributes }}>
                  {{- block.settings.content -}}
                </div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- assign btn_label = block.settings.label | default: block.settings.text -%}
              {%- assign btn_url = block.settings.link | default: block.settings.url -%}
              {%- assign btn_style = block.settings.button_style | default: block.settings.style -%}
              {%- if btn_label != blank -%}
                <div class="iwto-arc__button" {{ block.shopify_attributes }}>
                  {%- render 'button',
                    label: btn_label,
                    url: btn_url,
                    style: btn_style,
                    icon: block.settings.button_icon,
                    icon_position: block.settings.button_icon_position,
                    override_bg: block.settings.background,
                    override_text: block.settings.text_color,
                    extra_class: 'iwto-arc__btn'
                  -%}
                </div>
              {%- endif -%}

            {%- when 'liquid' -%}
              {%- if block.settings.liquid != blank -%}
                <div {{ block.shopify_attributes }}>
                  {{- block.settings.liquid -}}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        <!-- Features (From Section Settings) -->
        {%- if section.settings.arc_show_features -%}
          <div class="iwto-arc__features iwto-arc__font-feature">
            {%- if section.settings.arc_f1_icon != blank or section.settings.arc_f1_text != blank -%}
              <div class="iwto-arc__feature">
                {%- if section.settings.arc_f1_icon != blank -%}
                  <img src="{{ section.settings.arc_f1_icon | image_url: width: 40 }}" alt="" class="iwto-arc__feature-icon" width="40" height="40" loading="lazy">
                {%- endif -%}
                {%- if section.settings.arc_f1_text != blank -%}
                  <span>{{ section.settings.arc_f1_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.arc_f2_icon != blank or section.settings.arc_f2_text != blank -%}
              <div class="iwto-arc__feature-divider" aria-hidden="true"></div>
              <div class="iwto-arc__feature">
                {%- if section.settings.arc_f2_icon != blank -%}
                  <img src="{{ section.settings.arc_f2_icon | image_url: width: 40 }}" alt="" class="iwto-arc__feature-icon" width="40" height="40" loading="lazy">
                {%- endif -%}
                {%- if section.settings.arc_f2_text != blank -%}
                  <span>{{ section.settings.arc_f2_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.arc_f3_icon != blank or section.settings.arc_f3_text != blank -%}
              <div class="iwto-arc__feature-divider" aria-hidden="true"></div>
              <div class="iwto-arc__feature">
                {%- if section.settings.arc_f3_icon != blank -%}
                  <img src="{{ section.settings.arc_f3_icon | image_url: width: 40 }}" alt="" class="iwto-arc__feature-icon" width="40" height="40" loading="lazy">
                {%- endif -%}
                {%- if section.settings.arc_f3_text != blank -%}
                  <span>{{ section.settings.arc_f3_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Media -->
      <div class="iwto-arc__media">
        {%- if section.settings.image != blank -%}
          {{-
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 999px) 100vw, 50vw',
              widths: '400,600,800,1000,1200,1400,1600,1800,2000'
          -}}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}

        {%- if section.settings.arc_show_rating -%}
          <div class="iwto-arc__rating {% if section.settings.arc_rating_enable_shadow %}iwto-arc__rating--shadow{% endif %}">
            <div class="iwto-arc__rating-stars" aria-hidden="true">★★★★★</div>
            <div class="iwto-arc__rating-score">{{ section.settings.arc_rating_score }}</div>
            <div class="iwto-arc__rating-text">From Over<br>{{ section.settings.arc_rating_count }} Customers</div>
          </div>
        {%- endif -%}
      </div>
    </div>

  {%- else -%}
    <!-- Default (Overlay) Layout -->
    <div class="iwto__media">
      {%- if section.settings.image != blank -%}
        <img
          class="iwto__image iwto__image--desktop{% if section.settings.mobile_image == blank %} iwto__image--always{% endif %}"
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="
            {{ section.settings.image | image_url: width: 750 }} 750w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1600 }} 1600w,
            {{ section.settings.image | image_url: width: 2000 }} 2000w,
            {{ section.settings.image | image_url: width: 2600 }} 2600w
          "
          sizes="100vw"
          width="2000"
          height="{{ 2000 | divided_by: section.settings.image.aspect_ratio | round }}"
          alt="{{ section.settings.image.alt | default: '' }}"
          loading="lazy"
        >
      {%- endif -%}

      {%- if section.settings.mobile_image != blank -%}
        <img
          class="iwto__image iwto__image--mobile"
          src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
          width="1200"
          height="{{ 1200 | divided_by: section.settings.mobile_image.aspect_ratio | round }}"
          alt="{{ section.settings.mobile_image.alt | default: '' }}"
          loading="lazy"
        >
      {%- endif -%}

      {%- if section.settings.image == blank and section.settings.mobile_image == blank -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'iwto__image iwto__image--desktop iwto__image--always' }}
      {%- endif -%}

      {%- if section.settings.enable_overlay -%}
        <div class="iwto__overlay" aria-hidden="true"></div>
      {%- endif -%}

      {%- if enable_gradient -%}
        <div class="iwto__gradient" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="iwto__content-wrapper">
        <div class="iwto__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'subheading' -%}
                {%- if block.settings.text != blank -%}
                  <p class="iwto__subheading" {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.text != blank -%}
                  {%- assign heading_tag = block.settings.heading_tag | default: 'h2' -%}
                  <{{ heading_tag }}
                    class="iwto__heading"
                    style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text | newline_to_br }}
                  </{{ heading_tag }}>
                {%- endif -%}

              {%- when 'richtext' -%}
                {%- if block.settings.content != blank -%}
                  <div class="iwto__richtext" {{ block.shopify_attributes }}>
                    {{- block.settings.content -}}
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- assign btn_label = block.settings.label | default: block.settings.text -%}
                {%- assign btn_url = block.settings.link | default: block.settings.url -%}
                {%- assign btn_style = block.settings.button_style | default: block.settings.style -%}
                {%- if btn_label != blank -%}
                  <div class="iwto__button" {{ block.shopify_attributes }}>
                    {%- render 'button',
                      label: btn_label,
                      url: btn_url,
                      style: btn_style,
                      icon: block.settings.button_icon,
                      icon_position: block.settings.button_icon_position,
                      override_bg: block.settings.background,
                      override_text: block.settings.text_color,
                      extra_class: 'iwto__btn'
                    -%}
                  </div>
                {%- endif -%}

              {%- when 'liquid' -%}
                {%- if block.settings.liquid != blank -%}
                  <div {{ block.shopify_attributes }}>
                    {{- block.settings.liquid -}}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Image with text overlay",
  "tag": "section",
  "class": "shopify-section--image-with-text-overlay",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "arc_variant_mode",
      "label": "Section variant",
      "options": [
        {
          "value": "default",
          "label": "Default (Overlay)"
        },
        {
          "value": "arc",
          "label": "Arc (Split Layout)"
        }
      ],
      "default": "default",
      "info": "Choose 'Arc' for a split layout with text and image side by side."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "For Arc layout, a portrait image (e.g. 1200x1600px) is recommended."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Falls back to desktop image."
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size (Overlay variant)",
      "options": [
        { "value": "auto", "label": "Original image ratio" },
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "fill", "label": "Fill screen" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Image Dimensions"
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "label": "Desktop image height",
      "min": 400,
      "max": 900,
      "step": 10,
      "default": 680,
      "unit": "px",
      "info": "Controls the visible height of the image. The image is cropped to fill the selected height."
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 400,
      "max": 900,
      "step": 10,
      "default": 620,
      "unit": "px",
      "info": "Controls the visible height of the image. The image is cropped to fill the selected height."
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Overlay Variant Settings",
      "info": "These settings apply when Section variant is 'Default (Overlay)'."
    },
    {
      "type": "select",
      "id": "content_h_align",
      "label": "Content horizontal position",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "content_v_align",
      "label": "Content vertical position",
      "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable dark overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable gradient overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "default": "to top",
      "options": [
        { "value": "to top", "label": "Bottom to top" },
        { "value": "to bottom", "label": "Top to bottom" },
        { "value": "to left", "label": "Right to left" },
        { "value": "to right", "label": "Left to right" }
      ]
    },
    {
      "type": "range",
      "id": "gradient_strength",
      "label": "Gradient strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "subheading_font",
      "label": "Subheading font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size (desktop)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "subheading_weight",
      "label": "Subheading weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 56,
