{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign apply_transparent_header = false
  if section.settings.enable_transparent_header
    if request.page_type == 'index'
      assign apply_transparent_header = true
    elsif section.settings.transparent_templates != blank
      assign tpl_list = section.settings.transparent_templates | split: ','
      assign current_tpl = template.name | downcase
      for t in tpl_list
        assign t_clean = t | strip | downcase
        if t_clean == current_tpl
          assign apply_transparent_header = true
        endif
      endfor
    endif
  endif
-%}

{%- liquid
  if apply_transparent_header
    assign overlay = section.settings.transparent_overlay_bg
    assign overlay_rgb = overlay.red | append: ',' | append: overlay.green | append: ',' | append: overlay.blue
    assign overlay_o = section.settings.transparent_overlay_opacity | times: 1.0 | divided_by: 100.0
  endif
-%}
<sticky-header
  data-sticky="{{ section.settings.sticky_header }}"
  class="header-wrapper color-{{ section.settings.color_scheme }}{% if apply_transparent_header %} header-wrapper--transparent transparent--{{ section.settings.transparent_visibility }}{% if section.settings.floating_header %} floating-true{% endif %}{% unless section.settings.transparent_hover_solid %} hover-solid-false{% endunless %}{% endif %}{% if section.settings.show_separator_line %} header-wrapper--separator{% endif %}"
  style="--header-padding-top: {{ section.settings.padding_top }}px; --header-padding-bottom: {{ section.settings.padding_bottom }}px; --header-min-height: {{ section.settings.header_height }}px;{% if apply_transparent_header %} --transparent-color: {{ section.settings.transparent_header_color }}; --transparent-overlay-rgb: {{ overlay_rgb }}; --transparent-overlay-o: {{ overlay_o }}; --blur-background: {{ section.settings.blur_background }}px;{% endif %}{% if section.settings.blur_background > 0 %} border-bottom: 1px solid rgb(var(--color-border));{% endif %}{% if section.settings.floating_header %} --floating-header-margin-top: {{ section.settings.floating_header_margin_top }}px; --floating-header-bg: {{ section.settings.floating_header_bg }}; --floating-header-border-color: {{ section.settings.floating_header_border_color }};{% if section.settings.floating_header_text_color != blank %} --floating-header-text: {{ section.settings.floating_header_text_color }};{% endif %} --floating-header-blur-on-scroll: {{ section.settings.floating_header_blur_on_scroll }}px;{% endif %}"
>
  <div class="header{% if section.settings.container == 'fixed' %} page-width{% endif %} header--{{ section.settings.header_layout }}">
    <div class="header__toggle header__toggle--left">
      <button type="button" class="header__icon-btn" aria-expanded="false" aria-controls="MenuDrawer" data-menu-drawer-toggle aria-label="Menu">
        {%- render 'icon-hamburger' -%}
      </button>
    </div>

    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="header__logo-link">
        {%- if settings.logo != blank -%}
          {%- liquid
            # image_url's `width:` argument can't be piped through further filters inline -
            # a trailing `| times: 2 | round` there binds to image_url's own STRING output,
            # not to logo_width, so it must be pre-computed here instead.
            assign logo_src_width = settings.logo_width | times: 2 | round
            assign logo_src_width_mobile = settings.logo_width_mobile | times: 2 | round
          -%}
          <img
            src="{{ settings.logo | image_url: width: logo_src_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
            class="header__logo-image header__logo-image--desktop header__logo-image--default"
            loading="eager"
          >
          {%- if settings.logo_transparent != blank -%}
            <img
              src="{{ settings.logo_transparent | image_url: width: logo_src_width }}"
              alt="{{ shop.name }}"
              width="{{ settings.logo_width }}"
              height="{{ settings.logo_width | divided_by: settings.logo_transparent.aspect_ratio | round }}"
              class="header__logo-image header__logo-image--desktop header__logo-image--transparent"
              loading="eager"
            >
          {%- endif -%}
          {%- liquid
            # Mobile logo: exactly one visible logo on phones, always.
            # - default img = dedicated mobile logo, falling back to the regular logo
            # - the transparent img only exists if the merchant uploaded a real
            #   transparent variant, and only then do both carry swap classes for
            #   the transparent-header CSS. When no transparent variant exists the
            #   default img OMITS the --default class so no hide rule can target it:
            #   otherwise transparent pages lost their only logo, and
            #   non-transparent pages rendered the fallback logo twice.
            assign mobile_logo_default = settings.logo_mobile | default: settings.logo
            assign has_transparent_variant = false
            if settings.logo_transparent_mobile != blank or settings.logo_transparent != blank
              assign has_transparent_variant = true
            endif
          -%}
          <img
            src="{{ mobile_logo_default | image_url: width: logo_src_width_mobile }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width_mobile }}"
            height="{{ settings.logo_width_mobile | divided_by: mobile_logo_default.aspect_ratio | round }}"
            class="header__logo-image header__logo-image--mobile{% if has_transparent_variant %} header__logo-image--default{% endif %}"
            loading="eager"
          >
          {%- if has_transparent_variant -%}
            {%- liquid
              assign mobile_logo_transparent = settings.logo_transparent_mobile | default: settings.logo_transparent | default: mobile_logo_default
              assign mobile_transparent_ratio = mobile_logo_transparent.aspect_ratio
            -%}
            <img
              src="{{ mobile_logo_transparent | image_url: width: logo_src_width_mobile }}"
              alt="{{ shop.name }}"
              width="{{ settings.logo_width_mobile }}"
              height="{{ settings.logo_width_mobile | divided_by: mobile_transparent_ratio | round }}"
              class="header__logo-image header__logo-image--mobile header__logo-image--transparent"
              loading="eager"
            >
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="header__nav" aria-label="Main navigation">
      {%- render 'desktop-menu', menu: section.settings.menu, trigger: section.settings.menu_trigger, blocks: section.blocks -%}
    </nav>

    <div class="header__icons">
      {%- if section.settings.enable_country_selector -%}
        <div class="header__localization">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            {%- render 'country-selector', id: 'HeaderCountry' -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social_media_icons -%}
        {%- render 'social-icons' -%}
      {%- endif -%}

      <button type="button" class="header__icon-btn" aria-controls="SearchDrawer" aria-label="Search">
        {%- render 'icon-search' -%}
      </button>

      {%- if shop.customer_accounts_enabled -%}
        {%- if customer -%}
          <a href="{{ routes.account_url }}" class="header__icon-btn" aria-label="Account">
            {%- render 'icon-account' -%}
          </a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="header__icon-btn" aria-label="Log in">
            {%- render 'icon-account' -%}
          </a>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.cart_type == 'page' -%}
        <a href="{{ routes.cart_url }}" class="header__icon-btn header__cart-btn" aria-label="Cart">
          {%- render 'icon-cart' -%}
          <cart-count class="cart-count{% if cart.item_count == 0 %} cart-count--empty{% endif %}">{{ cart.item_count }}</cart-count>
        </a>
      {%- else -%}
        <button type="button" class="header__icon-btn header__cart-btn" aria-controls="CartDrawer" aria-label="Cart">
          {%- render 'icon-cart' -%}
          <cart-count class="cart-count{% if cart.item_count == 0 %} cart-count--empty{% endif %}">{{ cart.item_count }}</cart-count>
        </button>
      {%- endif -%}

      <div class="header__toggle header__toggle--right">
        <button type="button" class="header__icon-btn" aria-expanded="false" aria-controls="MenuDrawer" data-menu-drawer-toggle aria-label="Menu">
          {%- render 'icon-hamburger' -%}
        </button>
      </div>
    </div>
  </div>
</sticky-header>

<div class="page-overlay" aria-hidden="true"></div>

{%- render 'menu-drawer', menu: section.settings.menu, blocks: section.blocks, section: section -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: page.url | default: shop.url | json }},
    "logo": {% if settings.logo != blank %}{{ settings.logo | image_url: width: 500 | prepend: "https:" | json }}{% else %}null{% endif %}
  }
</script>

