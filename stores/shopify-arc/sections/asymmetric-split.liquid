{%- style -%}
  .split-card-{{ section.id }} {
    --sc-badge-size: {{ section.settings.badge_font_size }}px;
    --sc-badge-weight: {{ section.settings.badge_font_weight }};
    --sc-badge-color: {{ section.settings.badge_color }};
    --sc-badge-bg: {{ section.settings.badge_background }};
    --sc-heading-size: {{ section.settings.heading_size }}px;
    --sc-heading-weight: {{ section.settings.heading_weight }};
    --sc-heading-color: {{ section.settings.heading_color }};
    --sc-subtitle-size: {{ section.settings.subtitle_size }}px;
    --sc-subtitle-weight: {{ section.settings.subtitle_weight }};
    --sc-subtitle-color: {{ section.settings.subtitle_color }};
    --sc-image-radius: {{ section.settings.image_radius }}px;
    --sc-image-height: {{ section.settings.image_height }}px;
    --sc-image-gap: {{ section.settings.image_gap }}px;
    --sc-column-gap: {{ section.settings.column_gap }}rem;
    --sc-padding-top: {{ section.settings.padding_top }}rem;
    --sc-padding-bottom: {{ section.settings.padding_bottom }}rem;
    
    {% if section.settings.heading_font_family != blank %}
      --sc-heading-family: {{ section.settings.heading_font_family.family }}, {{ section.settings.heading_font_family.fallback_families }};
    {% endif %}
    {% if section.settings.subtitle_font_family != blank %}
      --sc-subtitle-family: {{ section.settings.subtitle_font_family.family }}, {{ section.settings.subtitle_font_family.fallback_families }};
    {% endif %}
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  .split-card-{{ section.id }} .split-card__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sc-column-gap);
    align-items: center;
  }

  .split-card-{{ section.id }}.split-card--reverse .split-card__grid {
    grid-template-columns: 1fr 1fr;
  }

  .split-card-{{ section.id }} .split-card__content {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .split-card-{{ section.id }} .split-card__badge {
    display: inline-block;
    padding: 8px 16px;
    background-color: var(--sc-badge-bg);
    color: var(--sc-badge-color);
    font-size: var(--sc-badge-size);
    font-weight: var(--sc-badge-weight);
    border-radius: 999px;
    width: fit-content;
  }

  .split-card-{{ section.id }} .split-card__heading {
    font-size: var(--sc-heading-size);
    font-weight: var(--sc-heading-weight);
    color: var(--sc-heading-color);
    line-height: 1.2;
    margin: 0;
    {% if section.settings.heading_font_family != blank %}
      font-family: var(--sc-heading-family);
    {% endif %}
  }

  .split-card-{{ section.id }} .split-card__subtitle {
    font-size: var(--sc-subtitle-size);
    font-weight: var(--sc-subtitle-weight);
    color: var(--sc-subtitle-color);
    line-height: 1.6;
    margin: 0;
    {% if section.settings.subtitle_font_family != blank %}
      font-family: var(--sc-subtitle-family);
    {% endif %}
  }

  .split-card-{{ section.id }} .split-card__button {
    margin-top: 16px;
  }

  .split-card-{{ section.id }} .split-card__images {
    display: flex;
    gap: var(--sc-image-gap);
  }

  .split-card-{{ section.id }} .split-card__image-wrapper {
    flex: 1;
    overflow: hidden;
    border-radius: var(--sc-image-radius);
    height: var(--sc-image-height);
  }

  .split-card-{{ section.id }} .split-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 990px) {
    .split-card-{{ section.id }} .split-card__grid,
    .split-card-{{ section.id }}.split-card--reverse .split-card__grid {
      grid-template-columns: 1fr;
    }

    .split-card-{{ section.id }} .split-card__content {
      padding: 32px 24px;
    }

    .split-card-{{ section.id }} .split-card__images {
      flex-direction: column;
    }

    .split-card-{{ section.id }} .split-card__image-wrapper {
      height: 300px;
    }
  }

  @media (max-width: 749px) {
    .split-card-{{ section.id }} .split-card__content {
      padding: 24px 20px;
    }

    .split-card-{{ section.id }} .split-card__image-wrapper {
      height: 250px;
    }
  }
{%- endstyle -%}

<section class="split-card-{{ section.id }} split-card color-{{ section.settings.color_scheme }}{% if section.settings.image_position == 'left' %} split-card--reverse{% endif %}">
  <div class="page-width">
    <div class="split-card__grid">
      <div class="split-card__content">
        {%- if section.settings.badge_text != blank -%}
          <span class="split-card__badge">{{ section.settings.badge_text | escape }}</span>
        {%- endif -%}

        {%- if section.settings.button_position == 'top' and section.settings.button_text != blank -%}
          <div class="split-card__button">
            {%- liquid
              capture button_classes
                render 'button-classes', style: section.settings.button_style
              endcapture
            -%}
            <a href="{{ section.settings.button_link }}" class="btn {{ button_classes }}">
              {{ section.settings.button_text | escape }}
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="split-card__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="split-card__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.button_position == 'bottom' and section.settings.button_text != blank -%}
          <div class="split-card__button">
            {%- liquid
              capture button_classes
                render 'button-classes', style: section.settings.button_style
              endcapture
            -%}
            <a href="{{ section.settings.button_link }}" class="btn {{ button_classes }}">
              {{ section.settings.button_text | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <div class="split-card__images">
        {%- if section.settings.image_1 != blank -%}
          <div class="split-card__image-wrapper">
            <img
              src="{{ section.settings.image_1 | image_url: width: 800 }}"
              alt="{{ section.settings.image_1.alt | default: section.settings.heading | escape }}"
              class="split-card__image"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: section.settings.image_1.aspect_ratio | round }}"
              widths="400, 600, 800, 1000"
              sizes="(min-width: 990px) 50vw, 100vw"
            >
          </div>
        {%- else -%}
          <div class="split-card__image-wrapper">
            {{ 'image' | placeholder_svg_tag: 'split-card__image' }}
          </div>
        {%- endif -%}

        {%- if section.settings.image_2 != blank -%}
          <div class="split-card__image-wrapper">
            <img
              src="{{ section.settings.image_2 | image_url: width: 800 }}"
              alt="{{ section.settings.image_2.alt | default: section.settings.heading | escape }}"
              class="split-card__image"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: section.settings.image_2.aspect_ratio | round }}"
              widths="400, 600, 800, 1000"
              sizes="(min-width: 990px) 50vw, 100vw"
            >
          </div>
        {%- else -%}
          <div class="split-card__image-wrapper">
            {{ 'image' | placeholder_svg_tag: 'split-card__image' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split Card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Start now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover your next perfect desert escape"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Plan your trip in minutes and enjoy every moment of your desert escape."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get started"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (after badge)" },
        { "value": "bottom", "label": "Bottom (after subtitle)" }
      ]
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "btn--primary",
      "options": [
        { "value": "", "label": "Use theme default" },
        { "value": "btn--primary", "label": "Filled" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--hollow", "label": "Hollow" },
        { "value": "btn--underline", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "badge_font_weight",
      "label": "Badge font weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#f2f1ed"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "font_picker",
      "id": "heading_font_family",
      "label": "Heading font family",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "font_picker",
      "id": "subtitle_font_family",
      "label": "Subtitle font family",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "subtitle_weight",
      "label": "Subtitle weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" }
      ]
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (desktop)",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Asymmetric Split"
    }
  ]
}
{% endschema %}