{%- comment -%}
  Project / property cards — photo card with title, spec meta rows and a
  price + arrow CTA (architecture & real-estate patterns). Horizon-safe.
{%- endcomment -%}
<section class="prj prj-{{ section.id }}" style="background: var(--color-background);">
  <div class="page-width">
    <div class="prj__head">
      <div>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.show_heading and section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.show_subheading and section.settings.subheading != blank -%}<p class="subtitle">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_cta and section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}" class="arrow-link">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow-right', size: 12 %}</a>
      {%- endif -%}
    </div>
    <div class="prj__grid" style="--prj-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <article class="prj__card{% if section.settings.style == 'overlay' %} prj__card--overlay{% endif %}" {{ block.shopify_attributes }}>
          <div class="prj__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 1000', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'prj__placeholder' }}
            {%- endif -%}
            {%- if block.settings.badge != blank -%}<span class="prj__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            {%- if section.settings.show_wishlist -%}<button type="button" class="prj__wish" aria-label="Save" aria-pressed="false" data-wish-key="{{ section.id }}-{{ forloop.index }}">♡</button>{%- endif -%}
            {%- if section.settings.style == 'overlay' -%}
              <div class="prj__overlay">
                <h3 class="prj__title">{{ block.settings.title | escape }}</h3>
                <p class="prj__price">{{ block.settings.price | escape }}</p>
              </div>
            {%- endif -%}
          </div>
          {%- if section.settings.style != 'overlay' -%}
            <div class="prj__body">
              <div class="prj__title-row">
                <h3 class="prj__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.price != blank -%}<p class="prj__price">{{ block.settings.price | escape }}</p>{%- endif -%}
              </div>
              {%- if block.settings.meta_1_label != blank -%}
                <div class="prj__meta">
                  <span>{{ block.settings.meta_1_label | escape }}</span>
                  {%- if block.settings.meta_1_value != blank -%}<span>{{ block.settings.meta_1_value | escape }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.meta_2_label != blank -%}
                <div class="prj__meta">
                  <span>{{ block.settings.meta_2_label | escape }}</span>
                  {%- if block.settings.meta_2_value != blank -%}<span>{{ block.settings.meta_2_value | escape }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.meta_3_label != blank -%}
                <div class="prj__meta">
                  <span>{{ block.settings.meta_3_label | escape }}</span>
                  {%- if block.settings.meta_3_value != blank -%}<span>{{ block.settings.meta_3_value | escape }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="prj__cta">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow-right', size: 12 %}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  .prj-{{ section.id }} { padding-block: var(--section-space); color: var(--color-foreground); }
  .prj-{{ section.id }} .prj__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: clamp(1.6rem, 4vh, 2.8rem); flex-wrap: wrap; }
  .prj-{{ section.id }} .prj__grid { display: grid; grid-template-columns: repeat(var(--prj-cols, 3), 1fr); gap: clamp(1rem, 2.4vw, 2rem); }
  .prj-{{ section.id }} .prj__card {
    border-radius: var(--card-radius); overflow: hidden;
    background: var(--color-surface); border: 1px solid var(--color-border);
    display: flex; flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
  }
  .prj-{{ section.id }} .prj__card:hover { transform: translateY(-5px); box-shadow: 0 24px 50px rgba(0,0,0,0.12); }
  .prj-{{ section.id }} .prj__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .prj-{{ section.id }} .prj__media img, .prj-{{ section.id }} .prj__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .prj-{{ section.id }} .prj__placeholder { background: {{ section.settings.fallback_bg }}; }
  .prj-{{ section.id }} .prj__card:hover .prj__media img { transform: scale(1.05); }
  .prj-{{ section.id }}   .prj__badge {
    position: absolute; top: 0.8rem; left: 0.8rem;
    background: var(--color-accent); color: var(--color-accent-label);
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.3rem 0.6rem; border-radius: 999px;
  }
  .prj-{{ section.id }} .prj__wish {
    position: absolute; top: 0.8rem; right: 0.8rem; z-index: 2;
    width: 2rem; height: 2rem; border-radius: 50%;
    background: rgba(255,255,255,0.92); border: 1px solid var(--color-border);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 1rem; line-height: 1; color: inherit;
  }
  /* interactivity: wishlist-toggle */
  .prj-{{ section.id }} .prj__wish:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .prj-{{ section.id }} .prj__wish[aria-pressed="true"] { color: #d6336c; }
  .prj-{{ section.id }} .prj__body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.55rem; flex: 1; }
  .prj-{{ section.id }} .prj__title-row { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .prj-{{ section.id }} .prj__title { font-family: var(--font-heading); font-size: 1.15rem; }
  .prj-{{ section.id }} .prj__price { font-weight: 700; white-space: nowrap; }
  .prj-{{ section.id }} .prj__meta {
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: 0.76rem; color: var(--color-text-muted);
    border-top: 1px solid var(--color-border); padding-top: 0.5rem;
  }
  .prj-{{ section.id }} .prj__meta span:last-child { color: var(--color-foreground); font-weight: 600; text-align: right; }
  .prj-{{ section.id }} .prj__cta {
    margin-top: 0.7rem; align-self: flex-end;
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: var(--color-accent); color: var(--color-accent-label);
    border-radius: 999px; padding: 0.5rem 1rem;
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .prj-{{ section.id }} .prj__card--overlay .prj__overlay {
    position: absolute; inset: auto 0 0 0; z-index: 2;
    padding: clamp(1rem, 2vw, 1.6rem);
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.6));
    color: #fff;
  }
  .prj-{{ section.id }} .prj__card--overlay .prj__title { font-size: 1.25rem; }
  @media (max-width: 980px) { .prj-{{ section.id }} .prj__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .prj-{{ section.id }} .prj__grid { grid-template-columns: 1fr; } }
  /* reduced-motion: kill all added motion, force visible state */
  @media (prefers-reduced-motion: reduce) {
    .prj-{{ section.id }},
    .prj-{{ section.id }} * {
      animation: none !important;
      transition: none !important;
    transform: none !important;
    }
  }
{% endstyle %}
<script>
  /* interactivity: wishlist-toggle */
  (function () {
    var SID = '{{ section.id }}';
    var KEY = 'atelier-wishlist-v1';
    function readStore() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } }
    function writeStore(store) { try { localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) {} }
    function init() {
      var root = document.getElementById('shopify-section-' + SID);
      if (!root) { return; }
      var buttons = root.querySelectorAll('.prj__wish');
      buttons.forEach(function (btn) {
        if (btn.dataset.wishBound) { return; }
        btn.dataset.wishBound = '1';
        var key = btn.getAttribute('data-wish-key') || SID;
        var sync = function () {
          var on = !!readStore()[key];
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          btn.textContent = on ? '\u2665' : '\u2661';
        };
        sync();
        btn.addEventListener('click', function () {
          var store = readStore();
          if (store[key]) { delete store[key]; } else { store[key] = true; }
          writeStore(store);
          sync();
        });
      });
    }
    init();
    document.addEventListener('shopify:section:load', function (evt) { if (evt.detail && evt.detail.sectionId === SID) { init(); } });
  })();
</script>
{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Project cards",
  "tag": "section",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected work"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Header link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Header link"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "options": [
        {
          "value": "specs",
          "label": "Photo + spec rows"
        },
        {
          "value": "overlay",
          "label": "Overlay title + price"
        }
      ],
      "default": "specs"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist hearts",
      "default": false
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Image fallback background",
      "default": "#ddd6ca"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
