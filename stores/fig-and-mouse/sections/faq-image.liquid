{%- liquid
  assign section_id = 'faq-image-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="faq-image-section"
  style="
    --faq-bg: {{ section.settings.background_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-accent: {{ section.settings.accent_color }};
    --faq-border: {{ section.settings.divider_color }};
    --faq-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --faq-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --faq-eyebrow-font: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    --faq-note-font: {{ section.settings.note_font.family }}, {{ section.settings.note_font.fallback_families }};
    --faq-padding: {{ section.settings.section_padding }}px;
    --faq-gap: {{ section.settings.column_gap }}px;
    --faq-image-radius: {{ section.settings.image_radius }}px;
    --faq-image-aspect-ratio: {{ section.settings.image_aspect_ratio }};
  "
>
  <div class="faq-image__inner">
    
    <!-- Image Column -->
    <div class="faq-image__media">
      {%- if section.settings.image != blank -%}
        <div class="faq-image__image-wrapper">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'faq-image__image'
          }}
          
          {%- if section.settings.note_text != blank -%}
            <div class="faq-image__note" style="
              top: {{ section.settings.note_offset_y }}px;
              left: {{ section.settings.note_offset_x }}px;
            ">
              {{ section.settings.note_text }}
              {%- if section.settings.show_note_heart -%}
                <span class="faq-image__note-heart">♡</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="faq-image__placeholder">
          {{ 'image' | placeholder_svg_tag: 'faq-image__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <!-- FAQ Column -->
    <div class="faq-image__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="faq-image__eyebrow">
          {%- if section.settings.show_dot -%}
            <span class="faq-image__dot"></span>
          {%- endif -%}
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="faq-image__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="faq-image__accordion">
          {%- for block in section.blocks -%}
            <div class="faq-image__item" {{ block.shopify_attributes }}>
              <button 
                class="faq-image__question"
                aria-expanded="false"
                aria-controls="faq-answer-{{ block.id }}"
              >
                <span>{{ block.settings.question }}</span>
                <span class="faq-image__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <line class="faq-icon-vertical" x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </button>
              <div 
                class="faq-image__answer"
                id="faq-answer-{{ block.id }}"
                role="region"
                aria-hidden="true"
              >
                <div class="faq-image__answer-inner rte">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}
  {{ section.settings.note_font | font_face: font_display: 'swap' }}

  #{{ section_id }} {
    width: 100%;
    background: var(--faq-bg);
    color: var(--faq-text);
    padding: var(--faq-padding) 0;
  }

  #{{ section_id }} .faq-image__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--faq-gap);
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5%;
    align-items: start;
  }

  /* --- Image Column --- */
  #{{ section_id }} .faq-image__media {
    position: sticky;
    top: 100px;
  }

  #{{ section_id }} .faq-image__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: var(--faq-image-aspect-ratio);
    overflow: hidden;
    border-radius: var(--faq-image-radius);
  }

  #{{ section_id }} .faq-image__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Floating Note on Image */
  #{{ section_id }} .faq-image__note {
    position: absolute;
    font-family: var(--faq-note-font);
    font-style: italic;
    font-size: {{ section.settings.note_size }}px;
    color: var(--faq-text);
    line-height: 1.4;
    max-width: 160px;
    z-index: 2;
  }

  #{{ section_id }} .faq-image__note-heart {
    display: inline-block;
    margin-left: 4px;
    font-size: 0.9em;
  }

  #{{ section_id }} .faq-image__placeholder {
    background: #e8e1d2;
    width: 100%;
    aspect-ratio: var(--faq-image-aspect-ratio);
    border-radius: var(--faq-image-radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .faq-image__placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.5;
  }

  /* --- FAQ Column --- */
  #{{ section_id }} .faq-image__content {
    padding: 20px 0;
  }

  /* Eyebrow */
  #{{ section_id }} .faq-image__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    font-family: var(--faq-eyebrow-font);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    text-transform: {{ section.settings.eyebrow_transform }};
    letter-spacing: 0.15em;
    color: var(--faq-text);
  }

  #{{ section_id }} .faq-image__dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: {{ section.settings.dot_radius }}%;
    background: var(--faq-accent);
    flex-shrink: 0;
  }

  /* Heading */
  #{{ section_id }} .faq-image__heading {
    font-family: var(--faq-heading-font);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.1;
    margin: 0 0 40px 0;
    color: var(--faq-text);
  }

  /* Accordion */
  #{{ section_id }} .faq-image__accordion {
    border-top: 1px solid var(--faq-border);
  }

  #{{ section_id }} .faq-image__item {
    border-bottom: 1px solid var(--faq-border);
  }

  #{{ section_id }} .faq-image__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: {{ section.settings.item_padding_v }}px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--faq-body-font);
    font-size: {{ section.settings.question_size }}px;
    font-weight: {{ section.settings.question_weight }};
    color: var(--faq-text);
    gap: 16px;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .faq-image__question:hover {
    opacity: 0.7;
  }

  #{{ section_id }} .faq-image__icon {
    flex-shrink: 0;
    color: var(--faq-text);
    transition: transform 0.3s ease;
  }

  #{{ section_id }} .faq-image__icon .faq-icon-vertical {
    transition: opacity 0.3s ease;
  }

  /* Open state - Shows minus/dash instead of slash */
  #{{ section_id }} .faq-image__item.is-open .faq-icon-vertical {
    opacity: 0; /* Hides the vertical line */
  }
  
  /* Removed rotation so it stays a horizontal dash */

  /* Answer */
  #{{ section_id }} .faq-image__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  #{{ section_id }} .faq-image__item.is-open .faq-image__answer {
    max-height: 500px;
  }

  #{{ section_id }} .faq-image__answer-inner {
    padding-bottom: {{ section.settings.item_padding_v }}px;
    font-family: var(--faq-body-font);
    font-size: {{ section.settings.answer_size }}px;
    line-height: 1.6;
    color: var(--faq-text);
    opacity: 0.8;
  }

  #{{ section_id }} .faq-image__answer-inner p {
    margin: 0 0 1em 0;
  }

  #{{ section_id }} .faq-image__answer-inner p:last-child {
    margin-bottom: 0;
  }

  /* --- Mobile Responsive --- */
  @media screen and (max-width: 749px) {
    #{{ section_id }} .faq-image__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 0 20px;
    }

    #{{ section_id }} .faq-image__media {
      position: relative;
      top: 0;
    }

    #{{ section_id }} .faq-image__image-wrapper {
      aspect-ratio: 1 / 1;
    }

    #{{ section_id }} .faq-image__note {
      max-width: 140px;
      font-size: calc({{ section.settings.note_size }}px * 0.9);
    }

    #{{ section_id }} .faq-image__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.7);
      margin-bottom: 28px;
    }

    #{{ section_id }} .faq-image__eyebrow {
      margin-bottom: 16px;
    }

    #{{ section_id }} .faq-image__question {
      padding: 18px 0;
      font-size: calc({{ section.settings.question_size }}px * 0.95);
    }

    #{{ section_id }} .faq-image__answer-inner {
      padding-bottom: 18px;
      font-size: calc({{ section.settings.answer_size }}px * 0.95);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .faq-image__answer {
      transition: none;
    }
    #{{ section_id }} .faq-image__icon {
      transition: none;
    }
    #{{ section_id }} .faq-image__icon .faq-icon-vertical {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqSection = document.getElementById('{{ section_id }}');
    if (!faqSection) return;

    const items = faqSection.querySelectorAll('.faq-image__item');

    items.forEach(function(item) {
      const button = item.querySelector('.faq-image__question');
      
      button.addEventListener('click', function() {
        const isOpen = item.classList.contains('is-open');
        
        // Close all other items (accordion behavior)
        items.forEach(function(otherItem) {
          if (otherItem !== item) {
            otherItem.classList.remove('is-open');
            otherItem.querySelector('.faq-image__question').setAttribute('aria-expanded', 'false');
            otherItem.querySelector('.faq-image__answer').setAttribute('aria-hidden', 'true');
          }
        });

        // Toggle current item
        if (isOpen) {
          item.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
          item.querySelector('.faq-image__answer').setAttribute('aria-hidden', 'true');
        } else {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
          item.querySelector('.faq-image__answer').setAttribute('aria-hidden', 'false');
        }
      });
    });
  });
</script>

