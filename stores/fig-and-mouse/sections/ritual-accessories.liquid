    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#6B675F"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All accessories"
    },
    {
