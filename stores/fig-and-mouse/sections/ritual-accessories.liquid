{%- liquid
  assign s = section.settings
  
  assign br = s.banner_image_radius
  if s.image_side == 'right'
    assign banner_radius = '0 ' | append: br | append: 'px ' | append: br | append: 'px 0'
  else
    assign banner_radius = br | append: 'px 0 0 ' | append: br | append: 'px'
  endif
-%}
{%- comment -%}
  Participates in Change's section padding-collapsing chain, same as the hero.
{%- endcomment -%}
{%- render 'section-spacing-collapsing' -%}

{{ 'ritual-accessories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ritual-accessories.js' | asset_url }}" defer></script>

{%- if s.enable_custom_font -%}
  <style>{{ s.font_family | font_face: font_display: 'swap' }}</style>
{%- endif -%}

<style>
  /* Per-instance design tokens, driven by the section schema. */
  .ra--{{ section.id }} {
    --ra-bg: {{ s.background }};
    --ra-pad-top: {{ s.padding_top }}px;
    --ra-pad-bottom: {{ s.padding_bottom }}px;
    --ra-max-w: {{ s.max_width }}px;
    --ra-side-pad: {{ s.side_padding }}px;

    --ra-banner-h: {{ s.banner_height }}px;
    --ra-banner-text-w: {{ s.banner_text_width }}%;
    --ra-banner-pad: {{ s.banner_text_padding }}px;

    --ra-eyebrow-size: {{ s.eyebrow_size }}px;
    --ra-eyebrow-tracking: {{ s.eyebrow_tracking | divided_by: 100.0 }}em;
    --ra-eyebrow-color: {{ s.eyebrow_color }};
    --ra-eyebrow-gap: {{ s.eyebrow_gap }}px;

    --ra-title-size: {{ s.heading_size }}px;
    --ra-title-lh: {{ s.heading_line_height | divided_by: 100.0 }};
    --ra-title-tracking: {{ s.heading_letter_spacing | divided_by: 100.0 }}em;
    --ra-title-color: {{ s.heading_color }};
    --ra-desc-size: {{ s.description_size }}px;
    --ra-desc-color: {{ s.description_color }};
    --ra-link-color: {{ s.link_color }};

    --ra-cols: {{ s.columns }};
    --ra-card-gap: {{ s.card_gap }}px;
    --ra-card-bg: {{ s.card_bg }};
    --ra-card-pad: {{ s.card_padding }}px;
    --ra-card-aspect: {{ s.card_image_ratio }};
    --ra-card-radius: {{ s.card_radius }}px;
    --ra-card-title-size: {{ s.card_title_size }}px;
    --ra-card-title-tracking: {{ s.card_title_tracking | divided_by: 100.0 }}em;
    --ra-card-desc-size: {{ s.card_desc_size }}px;
    --ra-card-desc-color: {{ s.card_desc_color }};
    --ra-card-price-size: {{ s.price_size }}px;
    --ra-card-text-color: {{ s.card_text_color }};
    --ra-add-color: {{ s.add_color }};
    
    {% if s.enable_custom_font -%}
      --ra-font-serif: {{ s.font_family.family }}, {{ s.font_family.fallback_families }};
    {%- endif %}
  }

  /* Card image bottom gradient blur effect (Restored) */
  .ra--{{ section.id }} .ra-card__media {
    position: relative;
    overflow: hidden;
  }
  
  .ra--{{ section.id }} .ra-card__media::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 50%;
    background: linear-gradient(to bottom, transparent 0%, var(--ra-card-bg) 100%);
    backdrop-filter: blur({{ s.card_image_blur }}px);
    -webkit-backdrop-filter: blur({{ s.card_image_blur }}px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
    pointer-events: none;
    opacity: {% if s.card_image_blur > 0 %}1{% else %}0{% endif %};
    transition: opacity 0.3s ease;
  }
</style>

<section
  class="ra ra--{{ section.id }}"
  data-ra-section
  data-reveal="{{ s.enable_reveal }}"
>
  {%- comment -%} ---------- Banner ---------- {%- endcomment -%}
  <div class="ra__banner ra__banner--{{ s.image_side }}{% if s.mobile_order == 'image' %} ra__banner--image-first{% endif %}">
    <div class="ra__banner-text">
      {%- if false -%}
        <p class="ra__eyebrow" data-ra-reveal>{{ s.eyebrow }}</p>
      {%- endif -%}
      
      <h2 class="ra__heading">
        {%- if s.heading_line_1 != blank -%}
          <span class="ra__heading-line" data-ra-reveal>{{ s.heading_line_1 }}</span>
        {%- endif -%}
        {%- if s.heading_line_2 != blank -%}
          <span class="ra__heading-line" data-ra-reveal>{{ s.heading_line_2 }}</span>
        {%- endif -%}
      </h2>
      
      {%- if s.description != blank -%}
        <p class="ra__desc" data-ra-reveal>{{ s.description }}</p>
      {%- endif -%}
      
      {%- if s.link_label != blank -%}
        <a
          class="ra__link"
          data-ra-reveal
          {% if s.link_url != blank %}href="{{ s.link_url }}"{% else %}aria-disabled="true"{% endif %}
        >
          <span class="ra__link-label">{{ s.link_label }}</span>
          
        </a>
      {%- endif -%}
    </div>
    
    {%- if s.banner_image != blank -%}
      {%- assign banner_alt = s.banner_image.alt | default: s.heading_line_1 | escape -%}
      <div class="ra__banner-media" aria-hidden="true" style="border-radius: var(--ra-banner-radius, {{ banner_radius }}); overflow: hidden;">
        {{
          s.banner_image
          | image_url: width: 2200
          | image_tag:
            loading: 'lazy',
            class: 'ra__banner-img',
            widths: '600,900,1200,1600,2000,2200',
            sizes: '(max-width: 767px) 100vw, 60vw',
            alt: banner_alt
        }}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Product / Collection cards ---------- {%- endcomment -%}
  <div class="ra__grid-wrap">
    <div class="ra__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        
        {%- comment -%} Determine card type {%- endcomment -%}
        {%- assign card_type = b.card_type | default: 'product' -%}
        
        {%- if card_type == 'collection' -%}
          {%- comment -%} COLLECTION CARD {%- endcomment -%}
          {%- assign col = b.collection -%}
          
          {%- liquid
            assign card_img = b.image
            if card_img == blank and col != blank
              assign card_img = col.image
            endif
            
            assign card_title = b.title_override
            if card_title == blank and col != blank
              assign card_title = col.title
            endif
            
            assign card_href = col.url
            assign card_desc = b.description
            if card_desc == blank and col != blank and col.description != blank
              assign card_desc = col.description | strip_html | truncate: 80
            endif
            
          -%}
          
          <article class="ra-card" data-ra-reveal {{ block.shopify_attributes }} style="border-radius: {{ s.card_radius }}px; overflow: hidden;">
            <div class="ra-card__media{% if s.enable_hover_zoom %} ra-card__media--zoom{% endif %}">
              {%- if card_href != blank %}<a class="ra-card__media-link" href="{{ card_href }}" tabindex="-1" aria-hidden="true">{% endif -%}
                {%- if card_img != blank -%}
                  {%- assign ra_card_alt = card_img.alt | default: card_title -%}
                  {{
                    card_img
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'ra-card__img',
                      widths: '300,450,600,750,900',
                      sizes: '(max-width: 767px) 78vw, (max-width: 1279px) 32vw, 18vw',
                      alt: ra_card_alt
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'ra-card__img ra-card__img--placeholder' }}
                {%- endif -%}
              {%- if card_href != blank %}</a>{% endif -%}
            </div>

            <!-- Applied inline text-align here to ensure it works -->
             <div class="ra-card__info" style="text-align: {{ s.card_text_alignment }}; align-items: {{ s.card_text_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};">
              {%- if card_title != blank -%}
                <h3 class="ra-card__title">
                  {%- if card_href != blank %}<a href="{{ card_href }}">{{ card_title }}</a>{% else %}{{ card_title }}{% endif -%}
                </h3>
              {%- endif -%}
              
              {%- if card_desc != blank -%}
                <p class="ra-card__desc">{{ card_desc }}</p>
              {%- endif -%}
              
              {% comment %} {%- if card_count > 0 -%}
                <p class="ra-card__price">
                  {{ card_count }} {{ card_count | pluralize: 'product', 'products' }}
                </p>
              {%- endif -%} {% endcomment %}

              <div style="text-align: {{ s.card_button_alignment }}; width: 100%; margin-top: 16px;">
                {%- if card_href != blank -%}
                  <a class="ra-card__add" href="{{ card_href }}" style="display: inline-flex;">
                    <span class="ra-card__add-label">{{ s.add_label }}</span>
                    
                  </a>
                {%- else -%}
                  <span class="ra-card__add ra-card__add--static" style="display: inline-flex;">
                    <span class="ra-card__add-label">{{ s.add_label }}</span>
                    
                  </span>
                {%- endif -%}
              </div>
            </div>
          </article>
          
        {%- else -%}
          {%- comment -%} PRODUCT CARD (default) {%- endcomment -%}
          {%- assign p = b.product -%}
          
          {%- liquid
            assign card_img = b.image
            if card_img == blank and p != blank
              assign card_img = p.featured_image
            endif
            
            assign card_title = b.title_override
            if card_title == blank and p != blank
              assign card_title = p.title
            endif
            
            assign card_href = p.url
          -%}
          
          <article class="ra-card" data-ra-reveal {{ block.shopify_attributes }} style="border-radius: {{ s.card_radius }}px; overflow: hidden;">
            <div class="ra-card__media{% if s.enable_hover_zoom %} ra-card__media--zoom{% endif %}">
              {%- if card_href != blank %}<a class="ra-card__media-link" href="{{ card_href }}" tabindex="-1" aria-hidden="true">{% endif -%}
                {%- if card_img != blank -%}
                  {%- assign ra_card_alt = card_img.alt | default: card_title -%}
                  {{
                    card_img
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'ra-card__img',
                      widths: '300,450,600,750,900',
                      sizes: '(max-width: 767px) 78vw, (max-width: 1279px) 32vw, 18vw',
                      alt: ra_card_alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'ra-card__img ra-card__img--placeholder' }}
                {%- endif -%}
              {%- if card_href != blank %}</a>{% endif -%}
            </div>

            <!-- Applied inline text-align here to ensure it works -->
            <div class="ra-card__info" style="text-align: {{ s.card_text_alignment }};">
              {%- if card_title != blank -%}
                <h3 class="ra-card__title">
                  {%- if card_href != blank %}<a href="{{ card_href }}">{{ card_title }}</a>{% else %}{{ card_title }}{% endif -%}
                </h3>
              {%- endif -%}
              
              {%- if b.description != blank -%}
                <p class="ra-card__desc">{{ b.description }}</p>
              {%- endif -%}
              
              {%- if p != blank or b.price_fallback != blank -%}
                <p class="ra-card__price">
                  {%- if p != blank -%}
                    {{- p.price | money -}}
                  {%- else -%}
                    {{- b.price_fallback -}}
                  {%- endif -%}
                </p>
              {%- endif -%}

              <div style="text-align: {{ s.card_button_alignment }}; width: 100%; margin-top: 16px;">
                {%- if p != blank and p.available and p.variants.size == 1 -%}
                  <form method="post" action="{{ routes.cart_add_url }}" class="ra-card__add-form" data-ra-add style="display: inline-flex;">
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <button type="submit" class="ra-card__add">
                      <span class="ra-card__add-label">{{ s.add_label }}</span>
                      
                    </button>
                  </form>
                {%- elsif p != blank -%}
                  <a class="ra-card__add" href="{{ p.url }}" style="display: inline-flex;">
                    <span class="ra-card__add-label">{{ s.add_label }}</span>
                    
                  </a>
                {%- elsif b.price_fallback != blank -%}
                  <span class="ra-card__add ra-card__add--static" style="display: inline-flex;">
                    <span class="ra-card__add-label">{{ s.add_label }}</span>
                    
                  </span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% render 'fm-section-design', section: section, kind: 'ritual-accessories' %}

{% schema %}
{
  "name": "Ritual accessories",
  "settings": [
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ECE6DC"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Cards max width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1800
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 12,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "fm_mobile_side_padding",
      "label": "Side padding — mobile",
      "info": "Applies the same inset to the banner, text and product cards.",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "range",
      "id": "banner_image_radius",
      "label": "Banner image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 320,
      "max": 760,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "banner_text_width",
      "label": "Text column width",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "banner_text_padding",
      "label": "Text inset from edge",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile order",
      "options": [
        {
          "value": "text",
          "label": "Text first"
        },
        {
          "value": "image",
          "label": "Image first"
        }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Text",
      "default": "Complete the ritual"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_tracking",
      "label": "Letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 16
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#A38B69"
    },
    {
      "type": "range",
      "id": "eyebrow_gap",
      "label": "Space below",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading · line 1",
      "default": "Everything you need"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading · line 2",
      "default": "to make it yours."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 28,
      "max": 84,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "min": 90,
      "max": 150,
      "step": 2,
      "unit": "%",
      "default": 116
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -4,
      "max": 0,
      "step": 1,
      "unit": "%",
      "default": -1
    },
    {
      "type": "color",
      "id": "heading_color",
