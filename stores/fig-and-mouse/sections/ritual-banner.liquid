{%- style -%}
  /* Font Loading - Only load if fonts are selected */
  {%- if section.settings.eyebrow_font != blank -%}
    {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.heading_font != blank -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.desc_font != blank -%}
    {{ section.settings.desc_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.btn_font != blank -%}
    {{ section.settings.btn_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.section {
    padding-block-start: 0 !important;
    padding-block-end: 0 !important;
    --ul-content-section-spacing-block-start: 0 !important;
    --ul-content-section-spacing-block-end: 0 !important;
    --ul-section-outer-spacing-block: 0 !important;
    margin: 0 !important;
  }


  .ritual-section-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  .ritual-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }

  /* Left Column: Text */
  .ritual-text-col {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }

  .ritual-eyebrow {
    {%- if section.settings.eyebrow_font != blank -%}
      font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
      font-weight: {{ section.settings.eyebrow_font.weight }};
      font-style: {{ section.settings.eyebrow_font.style }};
    {%- else -%}
      font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    {%- endif -%}
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 15px;
    display: block;
  }

  .ritual-heading {
    {%- if section.settings.heading_font != blank -%}
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
      font-style: {{ section.settings.heading_font.style }};
    {%- else -%}
      font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    {%- endif -%}
    font-size: 42px;
    line-height: 1.1;
    margin: 0 0 20px 0;
    color: {{ section.settings.heading_color }};
  }

  .ritual-desc {
    {%- if section.settings.desc_font != blank -%}
      font-family: {{ section.settings.desc_font.family }}, {{ section.settings.desc_font.fallback_families }};
      font-weight: {{ section.settings.desc_font.weight }};
      font-style: {{ section.settings.desc_font.style }};
    {%- else -%}
      font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    {%- endif -%}
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 30px;
    color: {{ section.settings.text_color }};
    max-width: 90%;
  }

  .ritual-btn {
    {%- if section.settings.btn_font != blank -%}
      font-family: {{ section.settings.btn_font.family }}, {{ section.settings.btn_font.fallback_families }};
      font-weight: {{ section.settings.btn_font.weight }};
      font-style: {{ section.settings.btn_font.style }};
    {%- else -%}
      font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    {%- endif -%}
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    padding: 15px 30px;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }

  .ritual-btn:hover {
    opacity: 0.9;
  }

  /* Middle Column: Image */
  .ritual-image-col {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transform: scale(0.95);
    transition: all 1s ease-out;
  }

  .ritual-image-col img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Right Column: Features */
  .ritual-features-col {
    display: flex;
    flex-direction: column;
    gap: 25px;
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.8s ease-out;
  }

  .ritual-feature-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding-bottom: 25px;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .ritual-feature-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ritual-icon {
    width: 32px;
    height: 32px;
    color: {{ section.settings.accent_color }};
    flex-shrink: 0;
  }

  .ritual-feature-text {
    {%- if block.settings.feature_font != blank -%}
      font-family: {{ block.settings.feature_font.family }}, {{ block.settings.feature_font.fallback_families }};
      font-weight: {{ block.settings.feature_font.weight }};
      font-style: {{ block.settings.feature_font.style }};
    {%- else -%}
      font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    {%- endif -%}
    font-size: 15px;
    color: {{ section.settings.text_color }};
  }

  /* Animation Classes */
  .ritual-visible {
    opacity: 1 !important;
    transform: translate(0) scale(1) !important;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 990px) {
    .ritual-section-wrapper {
      padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px 20px;
    }
    
    .ritual-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ritual-text-col, .ritual-features-col {
      text-align: left;
    }
    
    .ritual-heading {
      font-size: 32px;
    }

    .ritual-image-col {
      min-height: 300px;
      order: 2;
    }
    
    .ritual-text-col { order: 1; }
    .ritual-features-col { order: 3; }
  }
{%- endstyle -%}

<div class="ritual-section-wrapper" id="ritual-section-{{ section.id }}">
  <div class="ritual-container">
    
    <!-- Left Column: Text -->
    <div class="ritual-text-col ritual-animate">
      <span class="ritual-eyebrow">{{ section.settings.eyebrow_text }}</span>
      <h2 class="ritual-heading">{{ section.settings.heading }}</h2>
      <p class="ritual-desc">{{ section.settings.description }}</p>
      {% if section.settings.btn_link != blank %}
        <a href="{{ section.settings.btn_link }}" class="ritual-btn">
          {{ section.settings.btn_text }}
        </a>
      {% endif %}
    </div>

    <!-- Middle Column: Image -->
    <div class="ritual-image-col ritual-animate">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | image_url: width: 800 }}" 
             alt="{{ section.settings.main_image.alt | escape }}" 
             loading="lazy"
             width="{{ section.settings.main_image.width }}"
             height="{{ section.settings.main_image.height }}">
      {% else %}
        <div style="background:#f4f4f4; width:100%; height:300px; display:flex; align-items:center; justify-content:center; color:#999;">
          Upload Image
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Features -->
    <div class="ritual-features-col ritual-animate">
      {% for block in section.blocks %}
        <div class="ritual-feature-item" {{ block.shopify_attributes }}>
          <div class="ritual-icon">
            {% assign icon_index = forloop.index0 | modulo: 3 %}
            {% if icon_index == 0 %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {% elsif icon_index == 1 %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            {% endif %}
          </div>
          <div class="ritual-feature-text">
            {{ block.settings.feature_text }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const observerOptions = { root: null, rootMargin: '0px', threshold: 0.2 };
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('ritual-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    document.querySelectorAll('.ritual-animate').forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "10-Minute Ritual Banner",
  "tag": "section",
  "class": "section-ritual",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "YOUR 10-MINUTE RITUAL"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Eyebrow Font",
      "default": "assistant_n4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small ritual. Big results."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "assistant_n4"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Ten minutes is all it takes to look more lifted, sculpted and refreshed."
    },
    {
      "type": "font_picker",
      "id": "desc_font",
      "label": "Description Font",
      "default": "assistant_n4"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "DISCOVER HOW"
    },
    {
      "type": "font_picker",
      "id": "btn_font",
      "label": "Button Font",
      "default": "assistant_n4"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Product Image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Icons & Eyebrow)",
      "default": "#8c7b70"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#968678"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Right Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Left Padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "feature_text",
          "label": "Feature Text",
          "default": "10 Minutes"
        },
        {
          "type": "font_picker",
          "id": "feature_font",
          "label": "Feature Font",
          "default": "assistant_n4"
