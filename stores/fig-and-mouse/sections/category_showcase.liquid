{%- comment -%}
  Section: Collection Cards
  Wide image cards (collection showcases) with gradient overlay,
  serif title, description and explore link. Responsive + fully customizable.
{%- endcomment -%}

<section id="CollectionCards-{{ section.id }}" class="cc">
  {%- style -%}
    #CollectionCards-{{ section.id }} {
      --cc-bg: {{ section.settings.bg_color }};
      --cc-max-width: {{ section.settings.max_width }}px;
      --cc-space-top: {{ section.settings.space_top }}px;
      --cc-space-bottom: {{ section.settings.space_bottom }}px;
      --cc-gutter: {{ section.settings.mobile_gutter }}px;
      --cc-columns: {{ section.settings.desktop_columns }};
      --cc-gap: {{ section.settings.card_gap }}px;
      --cc-radius: {{ section.settings.card_radius }}px;
      --cc-card-h: {{ section.settings.card_height }}px;
      --cc-mobile-h: {{ section.settings.mobile_card_height }}px;
      --cc-pad: {{ section.settings.card_padding }}px;
      --cc-overlay: {{ section.settings.overlay_color }};
      --cc-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --cc-head-size: {{ section.settings.heading_size }}px;
      --cc-head-weight: {{ section.settings.heading_weight }};
      --cc-head-color: {{ section.settings.heading_color }};
      --cc-shop-size: {{ section.settings.shop_link_size }}px;
      --cc-shop-color: {{ section.settings.shop_link_color }};
      --cc-title-size: {{ section.settings.title_size }}px;
      --cc-title-weight: {{ section.settings.title_weight }};
      --cc-title-spacing: {{ section.settings.title_spacing }}px;
      --cc-title-color: {{ section.settings.title_color }};
      --cc-desc-size: {{ section.settings.desc_size }}px;
      --cc-desc-color: {{ section.settings.desc_color }};
      --cc-desc-maxw: {{ section.settings.desc_max_width }}px;
      --cc-link-size: {{ section.settings.link_size }}px;
      --cc-link-weight: {{ section.settings.link_weight }};
      --cc-link-spacing: {{ section.settings.link_spacing }}px;
      --cc-link-color: {{ section.settings.link_color }};
    }

    #CollectionCards-{{ section.id }} {
      background: var(--cc-bg);
      padding-top: var(--cc-space-top);
      padding-bottom: var(--cc-space-bottom);
      overflow-x: clip;
    }

    #CollectionCards-{{ section.id }} .cc__shell {
      width: min(100%, var(--cc-max-width));
      margin: 0 auto;
      min-width: 0;
    }

    /* Header row */
    #CollectionCards-{{ section.id }} .cc__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
      min-width: 0;
    }
    #CollectionCards-{{ section.id }} .cc__heading {
      margin: 0;
      color: var(--cc-head-color);
      font-size: var(--cc-head-size);
      font-weight: var(--cc-head-weight);
      line-height: 1.15;
    }
    {%- if section.settings.heading_font == 'serif' %}
      #CollectionCards-{{ section.id }} .cc__heading { font-family: Georgia, 'Times New Roman', serif; }
    {%- endif %}
    #CollectionCards-{{ section.id }} .cc__shop-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--cc-shop-color);
      font-size: var(--cc-shop-size);
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
    }
    #CollectionCards-{{ section.id }} .cc__shop-link svg {
      width: 14px;
      height: 14px;
      transition: transform 200ms ease;
    }
    #CollectionCards-{{ section.id }} .cc__shop-link:hover svg {
      transform: translateX(4px);
    }

    /* Grid */
    #CollectionCards-{{ section.id }} .cc__grid {
      display: grid;
      grid-template-columns: repeat(var(--cc-columns), minmax(0, 1fr));
      gap: var(--cc-gap);
      min-width: 0;
    }

    /* Card */
    #CollectionCards-{{ section.id }} .cc-card {
      position: relative;
      display: flex;
      min-height: var(--cc-card-h);
      border-radius: var(--cc-radius);
      overflow: hidden;
      isolation: isolate;
      text-decoration: none;
      
      /* Scroll Animation Initial State */
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), 
                  transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--cc-index, 0) * 100ms);
    }

    /* Scroll Animation Visible State */
    #CollectionCards-{{ section.id }} .cc-card.cc-card--visible {
      opacity: 1;
      transform: translateY(0);
    }

    #CollectionCards-{{ section.id }} .cc-card__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.image_position }};
      transform: scale(1.01);
      transition: transform 700ms cubic-bezier(.22, 1, .36, 1);
    }
    #CollectionCards-{{ section.id }} .cc-card:hover .cc-card__bg {
      transform: scale(1.05);
    }
    #CollectionCards-{{ section.id }} .cc-card__overlay {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: linear-gradient(100deg, var(--cc-overlay) 0%, rgba(0, 0, 0, 0) 78%);
      opacity: var(--cc-overlay-opacity);
      pointer-events: none;
    }

    #CollectionCards-{{ section.id }} .cc-card__content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      padding: var(--cc-pad);
      min-width: 0;
    }

    #CollectionCards-{{ section.id }} .cc-card__title {
      margin: 0;
      color: var(--cc-title-color);
      font-size: var(--cc-title-size);
      font-weight: var(--cc-title-weight);
      letter-spacing: var(--cc-title-spacing);
      line-height: 1.05;
      text-transform: uppercase;
      overflow-wrap: break-word;
    }
    {%- if section.settings.title_font == 'serif' %}
      #CollectionCards-{{ section.id }} .cc-card__title { font-family: Georgia, 'Times New Roman', serif; }
    {%- endif %}

    #CollectionCards-{{ section.id }} .cc-card__desc {
      margin: 16px 0 0;
      max-width: var(--cc-desc-maxw);
      color: var(--cc-desc-color);
      font-size: var(--cc-desc-size);
      line-height: 1.55;
    }

    #CollectionCards-{{ section.id }} .cc-card__link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      padding-top: 28px;
      color: var(--cc-link-color);
      font-size: var(--cc-link-size);
      font-weight: var(--cc-link-weight);
      letter-spacing: var(--cc-link-spacing);
      text-transform: uppercase;
    }
    #CollectionCards-{{ section.id }} .cc-card__link svg {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
      transition: transform 200ms ease;
    }
    #CollectionCards-{{ section.id }} .cc-card:hover .cc-card__link svg {
      transform: translateX(4px);
    }

    /* Tablet */
    @media (max-width: 1000px) {
      #CollectionCards-{{ section.id }} .cc-card {
        min-height: calc(var(--cc-card-h) * 0.85);
      }
      #CollectionCards-{{ section.id }} .cc-card__title {
        font-size: calc(var(--cc-title-size) * 0.8);
      }
    }

    /* Mobile */
    @media (max-width: 760px) {
      #CollectionCards-{{ section.id }} {
        padding-left: var(--cc-gutter);
        padding-right: var(--cc-gutter);
      }
      #CollectionCards-{{ section.id }} .cc__grid {
        grid-template-columns: 1fr;
      }
      #CollectionCards-{{ section.id }} .cc-card {
        min-height: var(--cc-mobile-h);
      }
      #CollectionCards-{{ section.id }} .cc-card__content {
        padding: 24px;
      }
      #CollectionCards-{{ section.id }} .cc-card__title {
        font-size: clamp(28px, 8vw, 40px);
      }
      #CollectionCards-{{ section.id }} .cc-card__desc {
        font-size: clamp(13px, 3.6vw, 15px);
      }
      #CollectionCards-{{ section.id }} .cc-card__link {
        padding-top: 20px;
      }
    }

    /* Accessibility: Respect reduced motion preferences */
    @media (prefers-reduced-motion: reduce) {
      #CollectionCards-{{ section.id }} .cc-card {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      #CollectionCards-{{ section.id }} .cc-card__bg,
      #CollectionCards-{{ section.id }} .cc-card__link svg,
      #CollectionCards-{{ section.id }} .cc__shop-link svg {
        transition: none;
      }
      #CollectionCards-{{ section.id }} .cc-card:hover .cc-card__bg {
        transform: scale(1.01);
      }
    }
  {%- endstyle -%}

  <div class="cc__shell">
    {%- if section.settings.show_header -%}
      <div class="cc__header">
        {%- if section.settings.heading_text != blank -%}
          <h2 class="cc__heading">{{ section.settings.heading_text }}</h2>
        {%- endif -%}
        {%- if section.settings.shop_link_url != blank -%}
          <a class="cc__shop-link" href="{{ section.settings.shop_link_url }}">
            {{ section.settings.shop_link_text }}
            {%- if section.settings.show_shop_arrow -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc__grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}

        {%- if collection != blank -%}
          {%- assign card_title = collection.title -%}
          {%- assign card_url = collection.url -%}
          {%- assign card_img = blank -%}
          {%- if collection.image != blank -%}
            {%- assign card_img = collection.image -%}
          {%- elsif collection.products.first.featured_image != blank -%}
            {%- assign card_img = collection.products.first.featured_image -%}
          {%- endif -%}
        {%- else -%}
          {%- assign card_title = block.settings.custom_title | default: block.settings.title -%}
          {%- assign card_url = block.settings.link -%}
          {%- assign card_img = blank -%}
        {%- endif -%}

        {%- assign saved_title = block.settings.custom_title | default: block.settings.title -%}
        {%- if saved_title != blank -%}
          {%- assign card_title = saved_title -%}
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {%- assign card_img = block.settings.image -%}
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          {%- assign card_url = block.settings.link -%}
        {%- endif -%}

        {%- if block.settings.link_label != blank -%}
          {%- assign card_label = block.settings.link_label -%}
        {%- else -%}
          {%- assign card_label = section.settings.link_prefix | append: ' ' | append: card_title -%}
        {%- endif -%}

        {%- assign card_index = forloop.index0 -%}

        {%- if card_url != blank -%}
          <a class="cc-card" href="{{ card_url }}" style="--cc-index: {{ card_index }};" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="cc-card" style="--cc-index: {{ card_index }};" {{ block.shopify_attributes }}>
        {%- endif -%}

          {%- if card_img != blank -%}
            <img
              class="cc-card__bg"
              src="{{ card_img | image_url: width: 1600 }}"
              alt="{{ card_title | escape }}"
              loading="lazy"
              width="1600"
              height="900"
            >
          {%- endif -%}
          <div class="cc-card__overlay" aria-hidden="true"></div>

          <div class="cc-card__content">
            {%- if card_title != blank -%}
              <h3 class="cc-card__title">{{ card_title }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="cc-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}

            <span class="cc-card__link">
              {{ card_label }}
              {%- if section.settings.show_card_arrow -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              {%- endif -%}
            </span>
          </div>

        {%- if card_url != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const section = document.getElementById('CollectionCards-{{ section.id }}');
      if (!section) return;
      
      // Check if user prefers reduced motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      const cards = section.querySelectorAll('.cc-card');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('cc-card--visible');
            observer.unobserve(entry.target); // Only animate once
          }
        });
      }, {
        threshold: 0.1, // Trigger when 10% of the card is visible
        rootMargin: '0px 0px -50px 0px' // Trigger slightly before it's fully in view
      });
      
      cards.forEach(card => {
        observer.observe(card);
      });
    });
  </script>
</section>

