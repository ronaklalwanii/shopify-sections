{%- comment -%}
  Steps — icon process with dotted connector ("Style delivered in 4 simple steps").
{%- endcomment -%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }} class="section" style="--section-space: {{ section.settings.padding | default: 72 }}px;">
  <div class="page-width">
    <div class="section-intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2 section-intro__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    <div class="steps" style="--steps-count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <span class="step__icon{% if section.settings.filled_icons %} step__icon--filled{% endif %}">
            {% render 'icon', name: block.settings.icon, size: 22 %}
          </span>
          <p class="step__title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}
            <p class="step__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Style delivered in 4 simple steps"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "filled_icons",
      "label": "Filled icon circles",
      "default": false
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "ruler",
              "label": "Ruler"
            },
            {
              "value": "bag",
              "label": "Bag"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "check-circle",
              "label": "Check"
            }
          ],
          "default": "search"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Browse"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Explore our latest collections"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "search",
            "title": "Browse",
            "text": "Explore our latest collections"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "ruler",
            "title": "Select size",
            "text": "Find your perfect fit"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "bag",
            "title": "Checkout",
            "text": "Secure & easy payment"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "heart",
            "title": "Wear with confidence",
            "text": "Feel beautiful every day"
          }
        }
      ]
    }
  ]
}
{% endschema %}
