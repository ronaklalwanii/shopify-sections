{%- comment -%}
  Image with text — story sections ("Fashion with Purpose", "Crafted with
  Passion"). Optional feature blocks render as a third column.
{%- endcomment -%}
{%- liquid
  assign has_features = false
  for block in section.blocks
    if block.type == 'feature'
      assign has_features = true
    endif
  endfor
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }}
  class="section"
  style="--section-space: {{ section.settings.padding | default: 72 }}px; --iwt-ratio: {{ section.settings.image_ratio }};"
>
  <div class="page-width">
    <div class="image-with-text{% if has_features %} image-with-text--features{% endif %}{% if section.settings.image_position == 'left' %} image-with-text--image-left{% else %} image-with-text--image-right{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '540, 720, 960, 1400', sizes: '(min-width: 990px) 33vw, 100vw', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content" style="text-align: {{ section.settings.text_align }};">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 image-with-text__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text" style="font-size: 0.9rem;">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="image-with-text__buttons">
            {%- for block in section.blocks -%}
              {%- if block.type == 'button' -%}
                {% render 'button',
                  label: block.settings.label,
                  link: block.settings.link,
                  style: block.settings.style,
                  size: 'small',
                  attributes: block.shopify_attributes
                %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if has_features -%}
        <div class="image-with-text__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="image-with-text__feature" {{ block.shopify_attributes }}>
                {% render 'icon', name: block.settings.icon, size: 24 %}
                <div>
                  <h4>{{ block.settings.title | escape }}</h4>
                  {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sustainable by choice"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Fashion with Purpose.\nBetter for You. Better for Earth."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in slow fashion: crafted with care using sustainable fabrics and ethical practices. Look good while doing good.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Learn our journey"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Accent"
            },
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Icon feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "flower",
              "label": "Flower"
            },
            {
              "value": "hands",
              "label": "Hands"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "shield-check",
              "label": "Shield with check"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium materials"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sourced from the world's finest farms"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
