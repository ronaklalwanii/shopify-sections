{%- comment -%}
  Advantages — checkerboard of two large images and four text cards (noir "Our
  advantages"). Grid areas place images on opposite corners.
{%- endcomment -%}
{%- liquid
  assign img_1 = section.settings.image_1
  assign img_2 = section.settings.image_2
  assign cards = section.blocks | where: 'type', 'card'
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }} class="section" style="--section-space: {{ section.settings.padding | default: 72 }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2" style="margin-bottom: clamp(1.4rem, 3vw, 2.4rem);">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="advantages">
      <div class="advantages__image" style="grid-row: span 2;">
        {%- if img_1 != blank -%}
          {{ img_1 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '540, 720, 1200', alt: section.settings.image_1_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- assign card_index = 0 -%}
      {%- for block in cards -%}
        {%- assign card_index = card_index | plus: 1 -%}
        {%- if card_index == 3 -%}
          <div class="advantages__image" style="grid-row: span 2;">
            {%- if img_2 != blank -%}
              {{ img_2 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '540, 720, 1200', alt: section.settings.image_2_alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="advantages__card" {{ block.shopify_attributes }}>
          <h3 class="advantages__card-title">{{ block.settings.title | escape }}</h3>
          <p class="advantages__card-text">{{ block.settings.text | escape }}</p>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link }}" class="advantages__card-link">
              <span class="icon-button">{% render 'icon', name: 'arrow-up-right', size: 12 %}</span>
              {{ block.settings.link_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advantages",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our advantages"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (top left)"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (bottom right)"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 alt text"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Independent designers"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Our platform celebrates the ingenuity of independent designers, offering a diverse range of fashion-forward garments."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advantages",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Independent designers"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Exclusive & uniquity",
            "text": "Indulge in curated collections showcasing exclusive, one-of-a-kind pieces, each with its own story and charm."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "High quality",
            "text": "Embrace superior craftsmanship with meticulously curated, undeniably high-quality garments."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Eco-friendly",
            "text": "Join our commitment to sustainability with eco-friendly fashion options, stylish yet mindful of our planet."
          }
        }
      ]
    }
  ]
}
{% endschema %}
