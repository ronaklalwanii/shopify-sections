      "label": "Video link"
    },
    {
      "type": "text",
      "id": "video_label",
      "label": "Video label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
