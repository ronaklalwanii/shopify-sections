    {
      "type": "text",
      "id": "heading_mut_1",
      "label": "Heading — muted part (line 1)",
      "default": "you'll"
    },
    {
      "type": "text",
      "id": "heading_mut_2",
      "label": "Heading — muted part (line 2)",
      "default": "love next."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Browse handpicked pieces crafted to refine your everyday look and enhance your style."
    },
    {
