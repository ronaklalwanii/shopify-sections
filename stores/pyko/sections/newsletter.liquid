{%- comment -%}
  Newsletter — two layouts:
  - strip:  full-width signup band (homeware / chocolatier)
  - banner: full-bleed image, centered content, pill input (Pyko)
{%- endcomment -%}
{%- liquid
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}

{%- if section.settings.layout == 'banner' -%}
  <section {{ section_colors_style }} class="newsletter-banner newsletter-banner-{{ section.id }}" style="--overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay }};">
    {%- if section.settings.show_image and section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'newsletter-banner__bg', loading: 'lazy', widths: '960, 1280, 1600, 2400', sizes: '100vw', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'newsletter-banner__bg placeholder-svg' }}
    {%- endif -%}
    <div class="newsletter-banner__scrim" aria-hidden="true"></div>
    <div class="page-width newsletter-banner__inner" {{ section.shopify_attributes }}>
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="newsletter-banner__title h1">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="newsletter-banner__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- form 'customer', class: 'newsletter-form newsletter-banner__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-banner__pill">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input
            type="email"
            id="NewsletterEmail-{{ section.id }}"
            class="newsletter-banner__input"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
          >
          <button type="submit" class="newsletter-banner__submit">{{ section.settings.button_label | escape }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success newsletter-banner__note">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form__message form__message--error newsletter-banner__note">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>

<style>
  .newsletter-banner-{{ section.id }} { position: relative; overflow: hidden; display: flex; align-items: center; min-height: var(--banner-min-height, 540px); }
  .newsletter-banner-{{ section.id }} img.newsletter-banner__bg, .newsletter-banner-{{ section.id }} svg.newsletter-banner__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .newsletter-banner-{{ section.id }} .newsletter-banner__scrim { position: absolute; inset: 0; background: var(--overlay-color); }
  .newsletter-banner-{{ section.id }} .newsletter-banner__inner {
    position: relative; z-index: 2; width: 100%;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    color: #ffffff; padding-block: clamp(3rem, 8vh, 5.5rem);
  }
  .newsletter-banner-{{ section.id }} .newsletter-banner__title { max-width: 42rem; margin: 0 0 0.6rem; font-weight: 500; }
  .newsletter-banner-{{ section.id }} .newsletter-banner__text { max-width: 26rem; font-size: 0.85rem; line-height: 1.6; opacity: 0.92; margin: 0 0 1.8rem; }
  .newsletter-banner-{{ section.id }} .newsletter-banner__pill {
    display: flex; align-items: center; gap: 0.4rem;
    background: #ffffff; border-radius: 999px;
    padding: 0.3rem 0.3rem 0.3rem 1.3rem;
    width: min(26rem, 100%);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
  }
  .newsletter-banner-{{ section.id }} .newsletter-banner__input {
    flex: 1; min-width: 0; border: none; background: transparent;
    font-size: 0.85rem; color: #2f2a24; outline: none;
  }
  .newsletter-banner-{{ section.id }} .newsletter-banner__input::placeholder { color: rgba(0, 0, 0, 0.45); }
  .newsletter-banner-{{ section.id }} .newsletter-banner__submit {
    border: 1px solid rgba(0, 0, 0, 0.14); border-radius: 999px;
    background: #ffffff; color: #2f2a24;
    font-size: 0.78rem; font-weight: 600;
    padding: 0.6rem 1.2rem; cursor: pointer;
  }
  .newsletter-banner-{{ section.id }} .newsletter-banner__submit:hover { background: #f5efe6; }
  .newsletter-banner-{{ section.id }} .newsletter-banner__note { margin-top: 0.9rem; }
  .newsletter-banner-{{ section.id }} .form__message--success { color: #ffffff; }
  .newsletter-banner-{{ section.id }} .form__message--error { color: #ffd7d2; }
</style>

{%- else -%}
<section {{ section_colors_style }} class="newsletter-band">
  <div class="page-width">
    <div class="newsletter-band__inner">
      <div>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.show_heading and section.settings.heading != blank -%}
          <h2 class="h3 newsletter-band__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="newsletter-band__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <div {{ section.shopify_attributes }}>
        {%- form 'customer', class: 'newsletter-form newsletter-band__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display: flex; gap: 0.7rem; flex-wrap: wrap;">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <input
              type="email"
              id="NewsletterEmail-{{ section.id }}"
              class="field__input"
              style="flex: 1; min-width: 9rem;"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | escape }}"
              required
            >
            <button type="submit" class="button button--{{ section.settings.button_style }}" aria-label="{{ section.settings.button_label | escape }}">
              {%- if section.settings.button_icon -%}
                {% render 'icon', name: 'arrow-right', size: 14 %}
              {%- else -%}
                {{ section.settings.button_label | escape }}
              {%- endif -%}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success">{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="form__message form__message--error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          {%- if section.settings.note != blank -%}
            <p class="newsletter-band__note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "strip",
          "label": "Signup strip"
        },
        {
          "value": "banner",
          "label": "Full-bleed banner"
        }
      ],
      "default": "strip"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (banner layout)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (banner layout)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 16
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (strip layout)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our kitchen community"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Be the first to know about new arrivals, recipes and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "checkbox",
      "id": "button_icon",
      "label": "Icon-only arrow button",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Accent"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Privacy note",
      "default": "By subscribing, you agree to our Privacy Policy."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#18120c"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "header",
      "content": "Enriched shape"
    },
    {
      "type": "range",
      "id": "enr_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "enr_border_width",
      "label": "Card border width",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1 px"
        },
        {
          "value": "2",
          "label": "2 px"
        },
        {
          "value": "3",
          "label": "3 px"
        },
        {
          "value": "4",
          "label": "4 px"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "Enriched sizes (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_sizes",
      "label": "Enable custom sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_title_size",
      "label": "Title size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "enr_body_size",
      "label": "Body size",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "enr_eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "enr_icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Enriched spacing (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_space_top",
      "label": "Space top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_space_bottom",
      "label": "Space bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media",
      "label": "Enable custom media heights",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_media_height",
      "label": "Media height (desktop)",
      "min": 380,
      "max": 580,
      "step": 2,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 300,
      "max": 500,
      "step": 2,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
