{%- comment -%}
    --ul---------------------------------------------------------------------------------------------------------------------
    SOCIAL MEDIA
    --ul---------------------------------------------------------------------------------------------------------------------

    Output a list of social media icons based on the social URL settings.

    ********************************************
    Supported variables
    ********************************************

    * size: can be "sm" or nothing. When setting is set to "sm", this only impacts the mobile (desktop uses the same size)
{%- endcomment -%}

{%- capture social_media -%}
    {%- if settings.social_facebook != blank or shop.brand.metafields.social_links.facebook != blank -%}
        <li>
            <a
                href="{{ settings.social_facebook | default: shop.brand.metafields.social_links.facebook }}"
                class="tap-area"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'general.social.follow_on' | t: social_media: 'Facebook' }}">
                {%- render 'nocturne-store--icon' with 'facebook' -%}
            </a>
        </li>
    {%- endif -%}

