{%- comment -%}
  Renders an inline SVG icon.
  Accepts:
  - name: {String} icon name (required)
  - size: {Number} width/height in px (optional)
  Usage: {% render 'pyko--icon', name: 'cart' %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 16
-%}
