{% doc %}
  Renders all global scripts, module preloads, and importmaps for the theme.

  @param {object} [product] - The product object, available on product pages.
{% enddoc %}

<script type="importmap">
  {
    "imports": {
      "@theme/overflow-list": "{{ 'horizon--overflow-list.js' | asset_url }}",
      "@theme/component": "{{ 'horizon--component.js' | asset_url }}",
      "@theme/dialog": "{{ 'horizon--dialog.js' | asset_url }}",
      "@theme/events": "{{ 'horizon--events.js' | asset_url }}",
      "@shopify/events": "https://cdn.shopify.com/storefront/standard-events.js",
      "@theme/view-event-elements": "{{ 'horizon--view-event-elements.js' | asset_url }}",
      "@theme/focus": "{{ 'horizon--focus.js' | asset_url }}",
      "@theme/morph": "{{ 'horizon--morph.js' | asset_url }}",
      "@theme/paginated-list": "{{ 'horizon--paginated-list.js' | asset_url }}",
      "@theme/performance": "{{ 'horizon--performance.js' | asset_url }}",
      "@theme/product-form": "{{ 'horizon--product-form.js' | asset_url }}",
      "@theme/recently-viewed-products": "{{ 'horizon--recently-viewed-products.js' | asset_url }}",
      "@theme/scrolling": "{{ 'horizon--scrolling.js' | asset_url }}",
      "@theme/section-renderer": "{{ 'horizon--section-renderer.js' | asset_url }}",
      "@theme/section-hydration": "{{ 'horizon--section-hydration.js' | asset_url }}",
      "@theme/money-formatting": "{{ 'horizon--money-formatting.js' | asset_url }}",
      "@theme/utilities": "{{ 'horizon--utilities.js' | asset_url }}",
      "@theme/variant-picker": "{{ 'horizon--variant-picker.js' | asset_url }}",
      "@theme/variant-resolution": "{{ 'horizon--variant-resolution.js' | asset_url }}",
      "@theme/media-gallery": "{{ 'horizon--media-gallery.js' | asset_url }}",
      "@theme/quick-add": "{{ 'horizon--quick-add.js' | asset_url }}",
      "@theme/paginated-list-aspect-ratio": "{{ 'horizon--paginated-list-aspect-ratio.js' | asset_url }}",
      "@theme/component-quantity-selector": "{{ 'horizon--component-quantity-selector.js' | asset_url }}",
      "@theme/comparison-slider": "{{ 'horizon--comparison-slider.js' | asset_url }}",
      "@theme/sticky-add-to-cart": "{{ 'horizon--sticky-add-to-cart.js' | asset_url }}",
      "@theme/fly-to-cart": "{{ 'horizon--fly-to-cart.js' | asset_url }}",
      "@theme/scroll-container": "{{ 'horizon--scroll-container.js' | asset_url }}",
      "@theme/theme-drawer": "{{ 'horizon--theme-drawer.js' | asset_url }}"
    }
  }
</script>

{%- comment -%}
  Registers Horizon's cart-drawer behaviour against the standard-actions
  bundle (loaded separately into <head>). Module scripts execute in
  document order, so this runs after the bundle regardless of where it
  lands in <head>.
{%- endcomment -%}
<script
  src="{{ 'horizon--standard-actions-override.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'horizon--page-view-event.js' | asset_url }}"
  type="module"
  defer
></script>

{% if settings.transition_to_main_product or settings.page_transition_enabled %}
  {%- comment -%}
    Inlined to avoid a network round trip for a render blocking asset.
  {%- endcomment -%}
  <script>
    {{- 'view-transitions.js' | inline_asset_content -}}
  </script>
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'horizon--utilities.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'horizon--component.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'horizon--section-renderer.js' | asset_url }}"
  fetchpriority="low"
>
<link
