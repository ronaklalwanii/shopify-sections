  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'horizon--morph.js' | asset_url }}"
  fetchpriority="low"
>

{% if template.name == 'collection' or template.name == 'search' %}
  <link
    rel="modulepreload"
    href="{{ 'horizon--paginated-list-aspect-ratio.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'horizon--paginated-list.js' | asset_url }}"
    fetchpriority="low"
  >
{% endif %}

