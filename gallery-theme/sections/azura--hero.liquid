{%- comment -%} Section Library: injected global assets for store "azura" {%- endcomment -%}
{{ 'azura--base.css' | asset_url | stylesheet_tag }}
{{ 'azura--components.css' | asset_url | stylesheet_tag }}
{% render 'azura--layout-tokens' %}
{{ 'azura--global.js' | asset_url | script_tag }}
{{ 'azura--wishlist.js' | asset_url | script_tag }}
{%- comment -%}
  Hero image banner. Two layouts:
  - split: content on one side, image on the other (boutique look)
  - full:  full-bleed image with overlaid content (noir / homeware look)
  Buttons are blocks so merchants can add/remove/reorder.

  Phase 2 enrichment: custom colors, gated size/spacing overrides, content width +
  mobile stack selects, shape controls, mobile image height, visibility toggles and
  optional Ken Burns motion (off by default, reduced-motion safe). All additions are
  neutral by default — existing sections render exactly as before.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign height = section.settings.height
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign ov_soft = overlay | times: 0.3
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
{%- capture hero_vars_style -%}
  style="{% if layout == 'full' %}--overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay }};{% endif %} {% if layout == 'split' and section.settings.image_height != blank %}--split-image-height: {{ section.settings.image_height }}px;{% endif %}{% if section.settings.heading_color != blank %} --hero-heading-color: {{ section.settings.heading_color }};{% endif %}{% if section.settings.subheading_color != blank %} --hero-subheading-color: {{ section.settings.subheading_color }};{% endif %}{% if section.settings.eyebrow_color != blank %} --hero-eyebrow-color: {{ section.settings.eyebrow_color }};{% endif %}{% if section.settings.meta_text_color != blank %} --hero-meta-color: {{ section.settings.meta_text_color }};{% endif %}{% if section.settings.scroll_hint_color != blank %} --hero-scroll-color: {{ section.settings.scroll_hint_color }};{% endif %}{% if section.settings.avatar_ring_color != blank %} --hero-avatar-ring: {{ section.settings.avatar_ring_color }};{% endif %}{% if section.settings.border_color != blank %} --hero-border-color: {{ section.settings.border_color }};{% endif %}{% if section.settings.content_radius > 0 %} --hero-content-radius: {{ section.settings.content_radius }}px;{% endif %}{% if section.settings.enable_custom_spacing %} --hero-space-top: {{ section.settings.space_top }}px; --hero-space-bottom: {{ section.settings.space_bottom }}px; --hero-buttons-gap: {{ section.settings.buttons_gap }}px; --hero-meta-gap: {{ section.settings.meta_gap }}px;{% endif %}{% if section.settings.enable_custom_sizes %} --hero-title-size: {{ section.settings.heading_size_px }}px; --hero-subheading-size: {{ section.settings.subheading_size_px }}px; --hero-meta-size: {{ section.settings.meta_text_size_px }}px; --hero-button-size: {{ section.settings.button_text_size_px }}px; --hero-scroll-size: {{ section.settings.scroll_hint_size_px }}px;{% endif %}"
{%- endcapture -%}
<section {{ section_colors_style }}
  class="hero hero-{{ section.id }} hero--{{ layout }}{% if layout == 'split' and section.settings.image_position == 'left' %} hero--image-left{% elsif layout == 'split' %} hero--image-right{% endif %} hero__height-{{ height }}"
  {{ hero_vars_style }}
>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '640, 960, 1280, 1600, 2400',
        sizes: '100vw',
        alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if layout == 'full' -%}
    <div class="hero__overlay" style="--overlay-color: linear-gradient(90deg, {{ section.settings.overlay_color | color_modify: 'alpha', overlay }}, {{ section.settings.overlay_color | color_modify: 'alpha', ov_soft }});" aria-hidden="true"></div>
  {%- endif -%}

  <div class="{% if layout == 'full' %}page-width{% endif %} hero__content-wrap" style="display: flex; width: {% if layout == 'split' %}100%{% endif %};{% if section.settings.enable_custom_spacing %} padding-block: var(--hero-space-top, 0) var(--hero-space-bottom, 0);{% endif %}{% if section.settings.content_width == 'narrow' %} max-width: 46rem;{% elsif section.settings.content_width == 'wide' %} max-width: none;{% endif %}">
    <div
      class="hero__content{% if layout == 'split' %} hero__content--{{ section.settings.content_align }}{% endif %}"
      style="{% if layout == 'split' %}margin-inline: auto; margin-left: max(calc((100vw - var(--page-width)) / 2 + clamp(1rem, 4vw, 3rem)), clamp(1rem, 4vw, 3rem));{% endif %} text-align: {{ section.settings.text_align }};{% if section.settings.content_radius > 0 %} border-radius: var(--hero-content-radius, 0);{% endif %}{% if section.settings.border_width != '0' %} border: {{ section.settings.border_width }}px solid var(--hero-border-color, var(--color-border));{% endif %}"
    >
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading {{ section.settings.heading_size }}{% if section.settings.fluid_heading %} hero__heading--fluid{% endif %}">
          {{ section.settings.heading | escape | newline_to_br }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="hero__text">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 and section.settings.show_cta -%}
        <div class="hero__buttons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              {% render 'azura--button',
                label: block.settings.label,
                link: block.settings.link,
                style: block.settings.style,
                attributes: block.shopify_attributes
              %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social_proof and section.settings.avatars_count > 0 or section.settings.show_social_proof and section.settings.meta_text != blank -%}
        <div class="hero__meta">
          {%- if section.settings.avatars_count > 0 -%}
            <div class="hero__avatars">
              {%- for i in (1..section.settings.avatars_count) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign av = section.settings.avatar_1 -%}
                  {%- when 2 -%}{%- assign av = section.settings.avatar_2 -%}
                  {%- when 3 -%}{%- assign av = section.settings.avatar_3 -%}
                  {%- when 4 -%}{%- assign av = section.settings.avatar_4 -%}
                {%- endcase -%}
                {%- if av != blank -%}
                  {{ av | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  <span style="display:inline-flex;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--color-background-secondary);border:2px solid var(--hero-avatar-ring, var(--color-background));"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.meta_text != blank -%}
            <p class="hero__meta-text">{{ section.settings.meta_text | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if layout == 'full' and section.settings.show_scroll_hint and section.settings.scroll_label != blank -%}
    <a href="{{ section.settings.scroll_link | default: '#main' }}" class="hero__scroll">
      <span class="icon-button">{% render 'azura--icon', name: 'arrow-down', size: 14 %}</span>
      {{ section.settings.scroll_label | escape }}
    </a>
  {%- endif -%}
</section>

{% style %}
  .hero-{{ section.id }}.hero--split .hero__media img { height: 100%; }
  @media (min-width: 990px) {
    .hero-{{ section.id }}.hero--split .hero__media img { max-height: var(--split-image-height, 620px); }
  }
  /* phase 2: color hooks (fallbacks preserve the exact current tokens) */
  .hero-{{ section.id }} .hero__heading { color: var(--hero-heading-color, var(--color-heading, inherit)); }
  .hero-{{ section.id }} .hero__text { color: var(--hero-subheading-color, inherit); }
  .hero-{{ section.id }} .hero__eyebrow { color: var(--hero-eyebrow-color, inherit); }
  .hero-{{ section.id }} .hero__meta-text { color: var(--hero-meta-color, inherit); }
  .hero-{{ section.id }} .hero__scroll { color: var(--hero-scroll-color, inherit); }
  /* phase 2: gated custom sizes */
  {%- if section.settings.enable_custom_sizes -%}
  .hero-{{ section.id }} .hero__heading { font-size: var(--hero-title-size) !important; }
  .hero-{{ section.id }} .hero__text { font-size: var(--hero-subheading-size); }
  .hero-{{ section.id }} .hero__meta-text { font-size: var(--hero-meta-size); }
  .hero-{{ section.id }} .hero__buttons .button { font-size: var(--hero-button-size); }
  .hero-{{ section.id }} .hero__scroll { font-size: var(--hero-scroll-size); }
  {%- endif -%}
  /* phase 2: gated custom spacing */
  {%- if section.settings.enable_custom_spacing -%}
  .hero-{{ section.id }} .hero__buttons { gap: var(--hero-buttons-gap, 1rem); }
  .hero-{{ section.id }} .hero__meta { gap: var(--hero-meta-gap, 1rem); }
  {%- endif -%}
  /* phase 2: gated mobile image height */
  {%- if section.settings.enable_mobile_image_height -%}
  @media (max-width: 749px) {
    .hero-{{ section.id }}.hero--split .hero__media img { max-height: {{ section.settings.image_height_mobile }}px; }
  }
  {%- endif -%}
  /* phase 2: gated mobile stack order */
  {%- if section.settings.mobile_stack_order == 'content_first' -%}
  @media (max-width: 989px) {
    .hero-{{ section.id }}.hero--split { display: flex; flex-direction: column; }
    .hero-{{ section.id }}.hero--split .hero__content-wrap { order: -1; }
  }
  {%- endif -%}
  {%- if section.settings.enable_ken_burns -%}
  /* interactivity: ken-burns (optional hero motion, <=6% travel, reduced-motion safe) */
  .hero-{{ section.id }} .hero__media img {
    animation: heroKb-{{ section.id }} {{ section.settings.ken_burns_speed }}s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes heroKb-{{ section.id }} {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-{{ section.id }} .hero__media img { animation: none !important; }
  }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
