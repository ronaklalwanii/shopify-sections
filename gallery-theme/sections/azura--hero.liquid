      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide (full bleed text)"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Mobile stacking order (split)",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "content_first",
          "label": "Content above image"
        }
      ],
      "default": "default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
