{%- comment -%} Section Library: injected global assets for store "nocturne-store" {%- endcomment -%}
{{ 'nocturne-store--theme.css' | asset_url | stylesheet_tag }}
{{ 'nocturne-store--product.css' | asset_url | stylesheet_tag }}
{% render 'nocturne-store--css-variables' %}
{%- liquid
  assign s = section.settings
-%}
{%- comment -%}
  Participates in Change's section padding-collapsing chain, same as the hero.
{%- endcomment -%}
{%- render 'nocturne-store--section-spacing-collapsing' -%}

{{ 'nocturne-store--three-paths.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nocturne-store--three-paths.js' | asset_url }}" defer></script>

{%- if s.enable_custom_font -%}
  <style>{{ s.font_family | font_face: font_display: 'swap' }}</style>
{%- endif -%}

<style>
  /* Per-instance design tokens, driven by the section schema. */
  .paths--{{ section.id }} {
    --paths-bg: {{ s.background }};
    --paths-pad-top: {{ s.padding_top }}px;
    --paths-pad-bottom: {{ s.padding_bottom }}px;
    --paths-max-w: {{ s.max_width }}px;
    --paths-side-pad: {{ s.side_padding }}px;
    --paths-col-gap: {{ s.card_gap }}px;
    --paths-card-min-w: {{ s.card_min_width }}px;

    --paths-eyebrow-size: {{ s.eyebrow_size }}px;
    --paths-eyebrow-tracking: {{ s.eyebrow_tracking | divided_by: 100.0 }}em;
    --paths-eyebrow-color: {{ s.eyebrow_color }};
    --paths-eyebrow-gap: {{ s.eyebrow_gap }}px;

    --paths-title-size: {{ s.heading_size }}px;
    --paths-title-lh: {{ s.heading_line_height | divided_by: 100.0 }};
    --paths-title-tracking: {{ s.heading_letter_spacing | divided_by: 100.0 }}em;
    --paths-title-color: {{ s.heading_color }};

    --paths-link-color: {{ s.compare_color }};

    --paths-card-bg: {{ s.card_bg }};
    --paths-card-radius: {{ s.card_radius }}px;
    --paths-card-border-o: {{ s.card_border_opacity }};
    --paths-card-pad: {{ s.card_padding }}px;
    --paths-card-label-color: {{ s.card_label_color }};
    --paths-card-title-size: {{ s.card_title_size }}px;
    --paths-card-desc-size: {{ s.card_desc_size }}px;
    --paths-card-desc-color: {{ s.card_desc_color }};

    --paths-media-w: {{ s.card_image_width }}%;
    --paths-media-scrim: {{ s.card_image_scrim }};

    --paths-icon-size: {{ s.spec_icon_size }}px;
    --paths-spec-size: {{ s.spec_text_size }}px;
    --paths-spec-color: {{ s.spec_text_color }};
    --paths-spec-justify: {{ s.spec_alignment }};
    --paths-spec-divider-o: {{ s.spec_divider_opacity }};

    --paths-from-color: {{ s.from_color }};
    --paths-price-size: {{ s.price_size }}px;
    --paths-price-color: {{ s.price_color }};

    --paths-btn-bg: {{ s.button_bg }};
    --paths-btn-text: {{ s.button_text_color }};
    --paths-btn-radius: {{ s.button_radius }}px;
    --paths-btn-hover-bg: {{ s.button_hover_bg }};

    --paths-speed: {{ s.hover_speed }}ms;
    {% if s.enable_custom_font -%}
    --paths-font-serif: {{ s.font_family.family }}, {{ s.font_family.fallback_families }};
    {%- endif %}
  }
</style>

<section
  class="paths paths--{{ section.id }}"
  data-paths-section
  data-reveal="{{ s.enable_reveal }}"
>
  <div class="paths__inner">
    <div class="paths__head">
      <div class="paths__head-left">
        {%- if s.eyebrow != blank -%}
          <p class="paths__eyebrow" data-paths-reveal>{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="paths__heading">
          {%- if s.heading_line_1 != blank -%}
            <span class="paths__heading-line" data-paths-reveal>{{ s.heading_line_1 }}</span>
          {%- endif -%}
          {%- if s.heading_line_2 != blank -%}
            <span class="paths__heading-line" data-paths-reveal>{{ s.heading_line_2 }}</span>
          {%- endif -%}
        </h2>
      </div>
      {%- if s.compare_label != blank -%}
        <a
          class="paths__compare"
          data-paths-reveal
          {% if s.compare_link != blank %}href="{{ s.compare_link }}"{% else %}aria-disabled="true"{% endif %}
        >
          {{- s.compare_label -}}
          <svg class="paths__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15" /><path d="M13 6l6 6-6 6" /></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="paths__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- liquid
          assign card_href = b.cta_link
          if card_href == blank and b.product != blank
            assign card_href = b.product.url
          endif
          assign img_alt = b.image.alt | default: b.title | escape
        -%}
        <article class="paths-card" data-paths-reveal {{ block.shopify_attributes }}>
          <div class="paths-card__media" aria-hidden="true">
            {%- if b.image != blank -%}
              {{
                b.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'paths-card__img',
                  widths: '400,600,800,1000,1200',
                  sizes: '(max-width: 767px) 84vw, (max-width: 1199px) 44vw, 20vw',
                  alt: img_alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'paths-card__img paths-card__placeholder' }}
            {%- endif -%}
          </div>
          <div class="paths-card__body">
            {%- if b.label != blank -%}
              <p class="paths-card__label">{{ b.label }}</p>
            {%- endif -%}
            {%- if b.title != blank -%}
              <h3 class="paths-card__title">{{ b.title }}</h3>
            {%- endif -%}
            {%- if b.description != blank -%}
              <p class="paths-card__desc">{{ b.description }}</p>
            {%- endif -%}

            {%- if b.spec_1_icon != blank or b.spec_2_icon != blank or b.spec_3_icon != blank -%}
              <ul class="paths-card__specs">
                {%- if b.spec_1_icon != blank or b.spec_1_text != blank -%}
                  <li class="paths-card__spec">
                    {%- if b.spec_1_icon != blank -%}
                      {{
                        b.spec_1_icon
                        | image_url: width: 88
                        | image_tag: loading: 'lazy', class: 'paths-card__spec-icon', widths: '44,88', alt: ''
                      }}
                    {%- endif -%}
                    {%- if b.spec_1_text != blank -%}<span>{{ b.spec_1_text }}</span>{%- endif -%}
                  </li>
                {%- endif -%}
                {%- if b.spec_2_icon != blank or b.spec_2_text != blank -%}
                  <li class="paths-card__spec">
                    {%- if b.spec_2_icon != blank -%}
                      {{
                        b.spec_2_icon
                        | image_url: width: 88
                        | image_tag: loading: 'lazy', class: 'paths-card__spec-icon', widths: '44,88', alt: ''
                      }}
                    {%- endif -%}
                    {%- if b.spec_2_text != blank -%}<span>{{ b.spec_2_text }}</span>{%- endif -%}
                  </li>
                {%- endif -%}
                {%- if b.spec_3_icon != blank or b.spec_3_text != blank -%}
                  <li class="paths-card__spec">
                    {%- if b.spec_3_icon != blank -%}
                      {{
                        b.spec_3_icon
                        | image_url: width: 88
                        | image_tag: loading: 'lazy', class: 'paths-card__spec-icon', widths: '44,88', alt: ''
                      }}
                    {%- endif -%}
                    {%- if b.spec_3_text != blank -%}<span>{{ b.spec_3_text }}</span>{%- endif -%}
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            <div class="paths-card__foot">
              {%- if b.product != blank or b.price_fallback != blank -%}
                <div class="paths-card__price">
                  {%- if s.from_label != blank -%}<span class="paths-card__from">{{ s.from_label }}</span>{%- endif -%}
                  <span class="paths-card__amount">
                    {%- if b.product != blank -%}
                      {{- b.product.price | money -}}
                    {%- else -%}
                      {{- b.price_fallback -}}
                    {%- endif -%}
                  </span>
                </div>
              {%- endif -%}
              {%- if b.cta_label != blank -%}
                <a
                  class="paths-card__btn"
                  {% if card_href != blank %}href="{{ card_href }}"{% else %}aria-disabled="true"{% endif %}
                >
                  {{- b.cta_label -}}
                  <svg class="paths__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15" /><path d="M13 6l6 6-6 6" /></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Three paths",
  "settings": [
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#0B0B0A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1680
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_min_width",
      "label": "Minimum card width",
      "info": "Cards wrap to a new row instead of squeezing narrower than this.",
      "min": 220,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Text",
      "default": "Bring the ritual home"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_tracking",
      "label": "Letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 14
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#C9C6C0"
    },
    {
      "type": "range",
      "id": "eyebrow_gap",
      "label": "Space below",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading · line 1",
      "default": "Three paths."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading · line 2",
      "default": "One goal — you."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 28,
      "max": 84,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "min": 90,
      "max": 150,
      "step": 1,
      "unit": "%",
      "default": 118
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -4,
      "max": 0,
      "step": 1,
      "unit": "%",
      "default": -1
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#F5F3EF"
    },
    {
      "type": "header",
      "content": "Compare link"
    },
    {
      "type": "text",
      "id": "compare_label",
      "label": "Label",
      "default": "Compare all products"
    },
    {
      "type": "url",
      "id": "compare_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Color",
      "default": "#EDEAE5"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#141311"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Inner padding",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "card_label_color",
      "label": "Category label color",
      "default": "#B9B6B0"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "card_desc_size",
      "label": "Description size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Description color",
      "default": "#E8E5E0"
    },
    {
      "type": "header",
      "content": "Card image"
    },
    {
      "type": "range",
      "id": "card_image_width",
      "label": "Image width",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 100,
      "info": "Portion of the card the photo covers, anchored right. 100% spans the full card."
    },
    {
      "type": "range",
      "id": "card_image_scrim",
      "label": "Image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Specs"
    },
    {
      "type": "range",
      "id": "spec_icon_size",
      "label": "Icon size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "spec_text_size",
      "label": "Spec text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "spec_text_color",
      "label": "Spec text color",
      "default": "#D9D6D0"
    },
    {
      "type": "range",
      "id": "spec_divider_opacity",
      "label": "Divider opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 14
    },
    {
      "type": "select",
      "id": "spec_alignment",
      "label": "Spec alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "From label",
      "default": "From"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#F5F3EF"
    },
    {
      "type": "color",
      "id": "from_color",
      "label": "From label color",
      "default": "#A8A5A0"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#111110"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Hover background",
      "default": "#E9E6E0"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "hover_speed",
      "label": "Hover speed",
      "min": 200,
      "max": 900,
      "step": 50,
      "unit": "ms",
      "default": 450
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Reveal on scroll",
      "info": "Fades the header and cards in, staggered, as the section enters the viewport.",
      "default": true
    },
    {
      "type": "header",
      "content": "Serif font"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Override serif font",
      "info": "Applies to the heading, card titles and prices. Body text keeps the theme font.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Serif font family",
      "default": "playfair_display_n4"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Category label",
          "default": "Heat"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Saunas"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Slow down. Relax. Recharge."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Anchored to the right side of the card and faded into the background."
        },
        {
          "type": "header",
          "content": "Specs"
        },
        {
          "type": "image_picker",
          "id": "spec_1_icon",
          "label": "Spec 1 · icon"
        },
        {
          "type": "text",
          "id": "spec_1_text",
          "label": "Spec 1 · text",
          "default": "1–5 People"
        },
        {
          "type": "image_picker",
          "id": "spec_2_icon",
          "label": "Spec 2 · icon"
        },
        {
          "type": "text",
          "id": "spec_2_text",
          "label": "Spec 2 · text",
          "default": "Premium Materials"
        },
        {
          "type": "image_picker",
          "id": "spec_3_icon",
          "label": "Spec 3 · icon"
        },
        {
          "type": "text",
          "id": "spec_3_text",
          "label": "Spec 3 · text",
          "default": "5 Year Warranty"
        },
        {
          "type": "header",
          "content": "Price & button"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "The card shows this product's live \"from\" price."
        },
        {
          "type": "text",
          "id": "price_fallback",
          "label": "Fallback price",
          "info": "Only used when no product is selected.",
          "default": "£4,995"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Explore Saunas"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Falls back to the product page when empty."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Three paths",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "Heat",
            "title": "Saunas",
            "description": "Slow down. Relax. Recharge.",
            "spec_1_text": "1–5 People",
            "spec_2_text": "Premium Materials",
            "spec_3_text": "5 Year Warranty",
            "price_fallback": "£4,995",
            "cta_label": "Explore Saunas"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Cold",
            "title": "Cold Plunges",
            "description": "Breathe your body. Refresh your mind.",
            "spec_1_text": "1–5 People",
            "spec_2_text": "Premium Materials",
            "spec_3_text": "5 Year Warranty",
            "price_fallback": "£2,995",
            "cta_label": "Explore Cold Plunges"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Contrast",
            "title": "Heat + Cold",
            "description": "Go further. Stronger together.",
            "spec_1_text": "1–5 People",
            "spec_2_text": "Premium Materials",
            "spec_3_text": "5 Year Warranty",
            "price_fallback": "£7,495",
            "cta_label": "Explore Contrast"
          }
        }
      ]
    }
  ]
}
{% endschema %}
