<script>
  (function () {
    if (customElements.get('mega-header')) return;

    class MegaHeader extends HTMLElement {
      connectedCallback() {
        this.trigger = this.dataset.trigger || 'hover';
        this.overlay = this.querySelector('[data-overlay]');
        this.drawer = this.querySelector('[data-drawer]');
        this.details = Array.prototype.slice.call(this.querySelectorAll('.mh__details'));
        this.openPanels = [];

        // Document-level handlers are bound here and removed in
        // disconnectedCallback. Keeping references on the instance is what makes
        // removal possible — anonymous handlers leaked on every section reload.
        this.onKey = this.onKey.bind(this);
        this.onDocClick = this.onDocClick.bind(this);
        this.onCartChange = this.onCartChange.bind(this);
        this.measure = this.measure.bind(this);

        document.addEventListener('keydown', this.onKey);
        document.addEventListener('click', this.onDocClick);
        document.addEventListener('cart:change', this.onCartChange);

        // Child listeners live on nodes that survive a move, so bind them once.
        if (!this._childrenBound) {
          this.bindMenus();
          this.bindDrawer();
          this._childrenBound = true;
        }

        this.measure();
        if (window.ResizeObserver) {
          this._ro = new ResizeObserver(this.measure);
          this._ro.observe(this);
        }
        window.addEventListener('resize', this.measure);
      }

      disconnectedCallback() {
        document.removeEventListener('keydown', this.onKey);
        document.removeEventListener('click', this.onDocClick);
        document.removeEventListener('cart:change', this.onCartChange);
        window.removeEventListener('resize', this.measure);
        if (this._ro) { this._ro.disconnect(); this._ro = null; }
        document.body.classList.remove('mh-locked');
      }

      /* --------- integration with the rest of the Change theme --------- */

      // sections/header.liquid publishes --ul-header-height on <html>. Several
      // Change rules multiply by it (transparent-header padding, boxed slideshow
      // top padding, --ul-sticky-area-height -> scroll-padding). Replacing the
      // stock header means this section has to publish it too, or they all
      // collapse to 0px.
      measure() {
        var section = this.closest('.shopify-section') || this;
        var h = Math.round(section.getBoundingClientRect().height);
        if (h && h !== this._lastHeight) {
          this._lastHeight = h;
          document.documentElement.style.setProperty('--ul-header-height', h + 'px');
        }
      }

      // Change broadcasts cart:change on document with detail.cart.
      onCartChange(e) {
        var count = e && e.detail && e.detail.cart ? e.detail.cart.item_count : null;
        if (count === null || count === undefined) return;
        var badge = this.querySelector('[data-cart-count]');
        if (!badge) return;
        badge.textContent = count;
        if (count > 0) badge.removeAttribute('hidden');
        else badge.setAttribute('hidden', '');
      }

      onDocClick(e) {
        if (!this.contains(e.target)) this.closeAll();
      }

      /* ---------------- desktop menus ---------------- */
      bindMenus() {
        var self = this;
        var isTouch = window.matchMedia('(hover: none)').matches;
        var useHover = this.trigger === 'hover' && !isTouch;

        this.details.forEach(function (d) {
          var summary = d.querySelector('.mh__summary');
          if (!summary) return;

          summary.addEventListener('click', function (e) {
            // In hover mode the label is a real link, so let the browser handle
            // the click. That keeps middle-click, ctrl/cmd-click and "open in new
            // tab" working, which the old window.location.href jump did not.
            if (useHover && e.target.closest('a[href]')) return;
            e.preventDefault();
            self.toggle(d, !d.open);
          });

          if (useHover) {
            var timer;
            d.addEventListener('mouseenter', function () {
              clearTimeout(timer);
              self.closeOthers(d);
              self.toggle(d, true);
            });
            d.addEventListener('mouseleave', function () {
              timer = setTimeout(function () { self.toggle(d, false); }, 120);
            });
          }

          // Keyboard: close when focus leaves the whole item.
          d.addEventListener('focusout', function (e) {
            if (!d.contains(e.relatedTarget)) self.toggle(d, false);
          });
        });
        // The outside-click handler now lives in connectedCallback so it can be
        // removed again; it used to be an anonymous listener added here and never
        // detached, leaking one closure over the element per section reload.
      }

      // Panel slide is Web Animations API, not a CSS transition — see the
      // comment on .mh__panel for why. Ported from Sleek's own
      // DetailsMega.showWithTransition/hideWithTransition (assets/header.js).
      // element.animate() plays a real animation on every call, unconditionally,
      // so it has none of the "only replays once" behaviour a CSS
      // transition keyed to [open] has on repeat <details> opens.
      showPanel(d) {
        var panel = d.querySelector('.mh__panel');
        if (!panel) return null;
        if (panel._anim) panel._anim.cancel();
        panel._anim = panel.animate(
          [
            { transform: 'translateY(-16px)', opacity: 0, visibility: 'hidden' },
            { transform: 'translateY(0)', opacity: 1, visibility: 'visible' }
          ],
          { duration: 250, easing: 'cubic-bezier(0.39, 0.575, 0.565, 1)', fill: 'forwards' }
        );
        return panel._anim;
      }

      hidePanel(d) {
        var panel = d.querySelector('.mh__panel');
        if (!panel) return null;
        if (panel._anim) panel._anim.cancel();
        panel._anim = panel.animate(
          [
            { transform: 'translateY(0)', opacity: 1, visibility: 'visible' },
            { transform: 'translateY(-16px)', opacity: 0, visibility: 'hidden' }
          ],
          { duration: 250, easing: 'cubic-bezier(0.39, 0.575, 0.565, 1)', fill: 'forwards' }
        );
        return panel._anim;
      }

      // <details>/<summary> expose expanded state natively — setting aria-expanded
      // by hand duplicated it and could disagree with the real state.
      toggle(d, open) {
        var self = this;
        if (open) {
          this.closeOthers(d);
          d.open = true;
          this.showPanel(d);
          d.classList.remove('mh__details--revealed');
          clearTimeout(d._revealTimer);
          // Ported from Sleek's own details-mega (assets/header.js,
          // DetailsDropdown.transition): it sets `open` on the <details>
          // immediately but delays setting `open` on the content div by
          // 100ms specifically so the class/attribute that drives the CSS
          // reveal transition lands strictly after native <details> has
          // actually un-hidden its content, every time — not just the first.
          d._revealTimer = setTimeout(function () {
            d.classList.add('mh__details--revealed');
          }, 100);
          this.showOverlay(true);
        } else {
          clearTimeout(d._revealTimer);
          d.classList.remove('mh__details--revealed');
          var anim = this.hidePanel(d);
          if (anim) {
            // Also ported from Sleek: don't remove the native `open` attribute
            // until the close animation has actually finished, or native
            // <details> hides the content mid-slide and cuts the animation off.
            anim.finished
              .then(function () {
                if (!d.classList.contains('mh__details--revealed')) d.open = false;
              })
              .catch(function () {
                /* animation was cancelled by a re-open mid-close — that open already owns state */
              });
          } else {
            d.open = false;
          }
          if (!this.anyOpen()) this.showOverlay(false);
        }
      }

      anyOpen() {
        return this.details.some(function (d) { return d.open; });
      }

      closeOthers(except) {
        var self = this;
        this.details.forEach(function (d) { if (d !== except && d.open) self.toggle(d, false); });
      }

      closeAll() {
        var self = this;
        this.details.forEach(function (d) { if (d.open) self.toggle(d, false); });
      }

      showOverlay(show) {
        if (!this.overlay) return;
        if (show) {
          this.overlay.hidden = false;
          requestAnimationFrame(() => this.overlay.setAttribute('data-visible', ''));
        } else {
          this.overlay.removeAttribute('data-visible');
          setTimeout(() => { if (!this.overlay.hasAttribute('data-visible')) this.overlay.hidden = true; }, 300);
        }
      }

      /* ---------------- mobile drawer ---------------- */
      bindDrawer() {
        var self = this;
        var openBtn = this.querySelector('[data-drawer-open]');
        var closeBtn = this.querySelector('[data-drawer-close]');
        if (!this.drawer) return;

        if (openBtn) openBtn.addEventListener('click', function () { self.setDrawer(true); });
        if (closeBtn) closeBtn.addEventListener('click', function () { self.setDrawer(false); });
        if (this.overlay) this.overlay.addEventListener('click', function () {
          self.setDrawer(false);
          self.closeAll();
        });

        this.querySelectorAll('[data-open-panel]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-open-panel');
            var panel = self.drawer.querySelector('[data-panel-id="' + id + '"]');
            if (!panel) return;
            panel.hidden = false;
            requestAnimationFrame(function () { panel.setAttribute('data-active', ''); });
            self.openPanels.push(panel);
          });
        });

        this.querySelectorAll('[data-close-panel]').forEach(function (btn) {
          btn.addEventListener('click', function () { self.popPanel(); });
        });
      }

      popPanel() {
        var panel = this.openPanels.pop();
        if (!panel) return;
        panel.removeAttribute('data-active');
        setTimeout(function () {
          if (!panel.hasAttribute('data-active')) panel.hidden = true;
        }, 320);
      }

      setDrawer(open) {
        if (!this.drawer) return;
        if (open) {
          // Remember where focus came from so it can be handed back on close.
          this._returnFocusTo = document.activeElement;
          this.drawer.hidden = false;
          requestAnimationFrame(() => {
            this.drawer.setAttribute('data-open', '');
            var first = this.drawer.querySelector('[data-drawer-close]') || this.focusables()[0];
            if (first) first.focus();
          });
          document.body.classList.add('mh-locked');
          this.showOverlay(true);
        } else {
          this.drawer.removeAttribute('data-open');
          document.body.classList.remove('mh-locked');
          this.showOverlay(false);
          while (this.openPanels.length) this.popPanel();
          setTimeout(() => { if (!this.drawer.hasAttribute('data-open')) this.drawer.hidden = true; }, 400);
          // Only hand focus back if the opener is still rendered. The burger is
          // display:none above the mobile breakpoint, so focusing it after a
          // resize would be a silent no-op that strands focus inside the closed
          // drawer; blur out of the drawer instead.
          var back = this._returnFocusTo;
          var backVisible = back && back.focus &&
            (back.offsetWidth || back.offsetHeight || back.getClientRects().length);
          if (backVisible) {
            back.focus();
          } else if (document.activeElement && this.drawer.contains(document.activeElement)) {
            document.activeElement.blur();
          }
          this._returnFocusTo = null;
        }
      }

      get drawerOpen() {
        return !!(this.drawer && this.drawer.hasAttribute('data-open'));
      }

      // Visible, focusable descendants of the open drawer.
      focusables() {
        if (!this.drawer) return [];
        var sel = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
        return Array.prototype.filter.call(this.drawer.querySelectorAll(sel), function (el) {
          return el.offsetWidth || el.offsetHeight || el.getClientRects().length;
        });
      }

      onKey(e) {
        // Trap Tab inside the drawer while it is open, so focus can't wander
        // into the page behind it.
        if (e.key === 'Tab' && this.drawerOpen) {
          var items = this.focusables();
          if (!items.length) return;
          var first = items[0];
          var last = items[items.length - 1];
          if (!this.drawer.contains(document.activeElement)) {
            e.preventDefault();
            first.focus();
          } else if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
          return;
        }

        if (e.key !== 'Escape') return;
        if (this.drawerOpen) {
          if (this.openPanels.length) this.popPanel();
          else this.setDrawer(false);
          return;
        }
        this.closeAll();
      }
    }

    customElements.define('mega-header', MegaHeader);
  })();
</script>

{%- if has_products_carousel -%}
  <script>
    (function () {
      if (customElements.get('mh-carousel')) return;

      // Ported from Sleek's MenuProductList (assets/header.js): a thin
      // wrapper around Swiper.js (window.FoxTheme.Swiper, from the vendor
      // bundle loaded above) that turns a plain list of slides into a
      // fraction-paginated carousel with prev/next buttons. Sleek's own
      // FoxTheme.Carousel wrapper class (theme.js) isn't pulled in — it's
      // ~15 lines of pure glue around the same Swiper constructor, inlined
      // directly here instead of loading the rest of that (large,
      // unrelated) file just for it.
      class MHCarousel extends HTMLElement {
        connectedCallback() {
          this.init();
        }

        init() {
          var self = this;
          var container = this.querySelector('.swiper');
          // Non-carousel (plain grid) mode: no .swiper container, nothing to do.
          if (!container) return;

          // The prev/next buttons and pagination live in .mh__procarousel-head,
          // a *sibling* of <mh-carousel> (both inside .mh__procarousel), not a
          // descendant of it — self.querySelector alone would never find them.
          var scope = this.closest('.mh__procarousel') || this;

          function start() {
            if (self._slider) return;
            // The vendor bundle loads with `defer`, so by the time this
            // element's own (also deferred, later in the document) script
            // runs, it's normally already there — this poll only matters if
            // something delays that fetch/parse longer than usual.
            if (!(window.FoxTheme && window.FoxTheme.Swiper && window.FoxTheme.Swiper.Swiper)) {
              setTimeout(start, 50);
              return;
            }
            var Swiper = window.FoxTheme.Swiper;
            self._slider = new Swiper.Swiper(container, {
              modules: [Swiper.Navigation, Swiper.Pagination],
              spaceBetween: 20,
              slidesPerView: parseInt(self.dataset.columns, 10) || 3,
              loop: false,
              pagination: {
                el: scope.querySelector('.swiper-pagination'),
                type: 'fraction'
              },
              navigation: {
                nextEl: scope.querySelector('.swiper-button-next'),
                prevEl: scope.querySelector('.swiper-button-prev')
              }
            });
          }
          start();
        }
      }

      customElements.define('mh-carousel', MHCarousel);
    })();
  </script>
{%- endif -%}

