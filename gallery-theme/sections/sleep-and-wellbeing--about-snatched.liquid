{%- comment -%} Section Library: injected global assets for store "sleep-and-wellbeing" {%- endcomment -%}
{{ 'sleep-and-wellbeing--theme.css' | asset_url | stylesheet_tag }}
{{ 'sleep-and-wellbeing--product.css' | asset_url | stylesheet_tag }}
{% render 'sleep-and-wellbeing--css-variables' %}
{%- style -%}
  /* Font Loading */
  {%- if section.settings.eyebrow_font != blank -%}
    {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.heading_font != blank -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font != blank -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.badge_font != blank -%}
    {{ section.settings.badge_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.section {
    padding-block-start: 0 !important;
    padding-block-end: 0 !important;
    --ul-content-section-spacing-block-start: 0 !important;
    --ul-content-section-spacing-block-end: 0 !important;
    --ul-section-outer-spacing-block: 0 !important;
    margin: 0 !important;
  }

  .about-snatched-wrapper {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  /* ===== HERO SECTION ===== */
  .about-hero {
    padding: {{ section.settings.hero_padding_top }}px {{ section.settings.container_padding_x }}px {{ section.settings.hero_padding_bottom }}px;
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-hero__content {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s ease-out;
  }

  .about-hero__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-weight: {{ section.settings.eyebrow_font.weight }};
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 20px;
    display: block;
  }

  .about-hero__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: {{ section.settings.hero_heading_size }}px;
    line-height: 1.1;
    margin: 0 0 24px 0;
    color: {{ section.settings.heading_color }};
  }

  .about-hero__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-weight: {{ section.settings.body_font.weight }};
    font-size: {{ section.settings.body_text_size }}px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 32px;
    max-width: 90%;
  }

  .about-link-btn {
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid {{ section.settings.accent_color }};
    transition: opacity 0.3s ease;
  }

  .about-link-btn:hover {
    opacity: 0.7;
  }

  .about-hero__image-wrap {
    position: relative;
    opacity: 0;
    transform: translateX(30px);
    transition: all 1s ease-out;
  }

  .about-hero__image-wrap img.about-main-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: {{ section.settings.hero_image_radius }}px;
  }

  .about-hero__badge {
    position: absolute;
    top: 20px;
    right: 20px;
    width: {{ section.settings.badge_size }}px;
    height: {{ section.settings.badge_size }}px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.badge_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: {{ section.settings.badge_bg_color }};
    padding: 15px;
    box-sizing: border-box;
  }

  .about-hero__badge-text {
    font-family: {{ section.settings.badge_font.family }}, {{ section.settings.badge_font.fallback_families }};
    font-size: {{ section.settings.badge_text_size }}px;
    line-height: 1.3;
    color: {{ section.settings.badge_text_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .about-hero__badge-text strong {
    display: block;
    font-size: {{ section.settings.badge_text_size }}px;
    font-weight: 600;
    margin: 4px 0;
  }

  /* ===== PHILOSOPHY SECTION ===== */
  .about-philosophy {
    padding: {{ section.settings.philosophy_padding_top }}px {{ section.settings.container_padding_x }}px {{ section.settings.philosophy_padding_bottom }}px;
    background-color: {{ section.settings.philosophy_bg_color }};
    text-align: center;
  }

  .about-philosophy__inner {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .about-philosophy__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-weight: {{ section.settings.eyebrow_font.weight }};
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
    display: block;
  }

  .about-philosophy__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: {{ section.settings.philosophy_heading_size }}px;
    line-height: 1.2;
    margin: 0 0 16px 0;
    color: {{ section.settings.heading_color }};
  }

  .about-philosophy__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.body_text_size }}px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .about-features-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
  }

  .about-feature-item {
    padding: 30px 20px;
    text-align: center;
    position: relative;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s ease-out;
  }

  .about-feature-item:not(:last-child) {
    border-right: 1px solid {{ section.settings.divider_color }};
  }

  .about-feature-item__icon {
    width: {{ section.settings.feature_icon_size }}px;
    height: {{ section.settings.feature_icon_size }}px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-feature-item__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Optional: If you want to colorize PNG icons, use filter. For SVGs, use currentColor in the file or remove this. */
    /* For uploaded SVGs to take color, they usually need to be inline or use a specific CSS mask trick. 
       Since we are using <img> tags for flexibility, we assume the uploaded icon has its own color or is black. */
  }

  .about-feature-item__title {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-weight: 600;
    font-size: {{ section.settings.feature_title_size }}px;
    color: {{ section.settings.heading_color }};
    margin-bottom: 10px;
  }

  .about-feature-item__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.feature_desc_size }}px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
  }

  /* ===== STORY SECTION ===== */
  .about-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: {{ section.settings.story_bg_color }};
  }

  .about-story__image {
    opacity: 0;
    transform: translateX(-30px);
    transition: all 1s ease-out;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px; /* Space for radius if bg is different */
  }

  .about-story__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 400px;
    border-radius: {{ section.settings.story_image_radius }}px;
  }

  .about-story__content {
    padding: {{ section.settings.story_padding_top }}px {{ section.settings.container_padding_x }}px {{ section.settings.story_padding_bottom }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateX(30px);
    transition: all 1s ease-out;
  }

  .about-story__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-weight: {{ section.settings.eyebrow_font.weight }};
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
    display: block;
  }

  .about-story__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: {{ section.settings.story_heading_size }}px;
    line-height: 1.15;
    margin: 0 0 20px 0;
    color: {{ section.settings.heading_color }};
  }

  .about-story__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.body_text_size }}px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 40px;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .about-stat {
    text-align: center;
    padding: 20px 10px;
  }

  .about-stat__number {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-size: {{ section.settings.stat_number_size }}px;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
    display: block;
  }

  .about-stat__label {
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 10px;
    display: block;
    font-weight: 600;
  }

  .about-stat__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.stat_desc_size }}px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  /* ===== PROMISE SECTION ===== */
  .about-promise {
    padding: {{ section.settings.promise_padding_top }}px {{ section.settings.container_padding_x }}px {{ section.settings.promise_padding_bottom }}px;
    background-color: {{ section.settings.promise_bg_color }};
  }

  .about-promise__inner {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-promise__content {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }

  .about-promise__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-weight: {{ section.settings.eyebrow_font.weight }};
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
    display: block;
  }

  .about-promise__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: {{ section.settings.promise_heading_size }}px;
    line-height: 1.15;
    margin: 0 0 20px 0;
    color: {{ section.settings.heading_color }};
  }

  .about-promise__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.body_text_size }}px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 32px;
  }

  .about-promise__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }

  .about-promise-card {
    background: {{ section.settings.promise_card_bg }};
    border-radius: {{ section.settings.promise_card_radius }}px;
    padding: 36px 24px;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .about-promise-card:hover {
    transform: translateY(-4px);
  }

  .about-promise-card__icon {
    width: {{ section.settings.promise_icon_size }}px;
    height: {{ section.settings.promise_icon_size }}px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-promise-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .about-promise-card__title {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-weight: 600;
    font-size: {{ section.settings.promise_card_title_size }}px;
    color: {{ section.settings.heading_color }};
    margin-bottom: 10px;
  }

  .about-promise-card__desc {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.promise_card_desc_size }}px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
  }

  /* Animation */
  .about-visible {
    opacity: 1 !important;
    transform: translate(0) !important;
  }

  /* ===== RESPONSIVE ===== */
  @media screen and (max-width: 1024px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-hero__image-wrap {
      order: -1;
    }

    .about-features-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .about-feature-item:nth-child(3) {
      border-right: none;
    }

    .about-feature-item:nth-child(4),
    .about-feature-item:nth-child(5) {
      border-top: 1px solid {{ section.settings.divider_color }};
    }

    .about-story {
      grid-template-columns: 1fr;
    }

    .about-story__image img {
      min-height: 300px;
    }

    .about-promise__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .about-hero__heading {
      font-size: {{ section.settings.hero_heading_size | times: 0.7 | round }}px !important;
    }

    .about-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-feature-item {
      border-right: none !important;
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    .about-feature-item:nth-child(even) {
      border-right: none;
    }

    .about-feature-item:nth-child(odd) {
      border-right: 1px solid {{ section.settings.divider_color }};
    }

    .about-feature-item:last-child,
    .about-feature-item:nth-last-child(2) {
      border-bottom: none;
    }

    .about-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .about-promise__cards {
      grid-template-columns: 1fr;
    }

    .about-philosophy__heading,
    .about-story__heading,
    .about-promise__heading {
      font-size: {{ section.settings.philosophy_heading_size | times: 0.75 | round }}px !important;
    }
  }

  @media screen and (max-width: 480px) {
    .about-features-grid {
      grid-template-columns: 1fr;
    }

    .about-feature-item {
      border-right: none !important;
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    .about-feature-item:last-child {
      border-bottom: none;
    }

    .about-stats {
      grid-template-columns: 1fr;
    }

    .about-hero__badge {
      width: 100px;
      height: 100px;
      top: 10px;
      right: 10px;
    }
  }
{%- endstyle -%}

<div class="about-snatched-wrapper" id="about-section-{{ section.id }}">

  <!-- ===== HERO SECTION ===== -->
  <div class="about-hero">
    <div class="about-hero__content about-animate">
      <span class="about-hero__eyebrow">{{ section.settings.hero_eyebrow }}</span>
      <h2 class="about-hero__heading">{{ section.settings.hero_heading }}</h2>
      <p class="about-hero__desc">{{ section.settings.hero_description }}</p>
      {% if section.settings.hero_link != blank %}
        <a href="{{ section.settings.hero_link }}" class="about-link-btn">
          {{ section.settings.hero_link_text }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>
    <div class="about-hero__image-wrap about-animate">
      {% if section.settings.hero_image != blank %}
        <img class="about-main-img" src="{{ section.settings.hero_image | image_url: width: 800 }}"
             alt="{{ section.settings.hero_image.alt | escape }}"
             loading="lazy"
             width="{{ section.settings.hero_image.width }}"
             height="{{ section.settings.hero_image.height }}">
      {% else %}
        <div style="background:#f4f4f4; width:100%; height:400px; display:flex; align-items:center; justify-content:center; color:#999; border-radius: {{ section.settings.hero_image_radius }}px;">Upload Hero Image</div>
      {% endif %}
      {% if section.settings.show_badge %}
        <div class="about-hero__badge">
          <div class="about-hero__badge-text">
            <span style="font-size:9px; letter-spacing:1px; text-transform:uppercase;">{{ section.settings.badge_top_text }}</span>
            <strong>{{ section.settings.badge_main_text }}</strong>
            <span style="font-size:9px; letter-spacing:1px; text-transform:uppercase;">{{ section.settings.badge_bottom_text }}</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- ===== PHILOSOPHY SECTION ===== -->
  <div class="about-philosophy">
    <div class="about-philosophy__inner">
      <span class="about-philosophy__eyebrow">{{ section.settings.philosophy_eyebrow }}</span>
      <h2 class="about-philosophy__heading">{{ section.settings.philosophy_heading }}</h2>
      <p class="about-philosophy__desc">{{ section.settings.philosophy_description }}</p>

      <div class="about-features-grid">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="about-feature-item about-animate" {{ block.shopify_attributes }}>
              <div class="about-feature-item__icon">
                {% if block.settings.custom_icon != blank %}
                  <img src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="{{ block.settings.feature_title }}" width="40" height="40">
                {% else %}
                  <!-- Fallback if no icon uploaded -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: {{ section.settings.feature_icon_color }}"><circle cx="12" cy="12" r="10"/></svg>
                {% endif %}
              </div>
              <h4 class="about-feature-item__title">{{ block.settings.feature_title }}</h4>
              <p class="about-feature-item__desc">{{ block.settings.feature_description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- ===== STORY SECTION ===== -->
  <div class="about-story">
    <div class="about-story__image about-animate">
      {% if section.settings.story_image != blank %}
        <img src="{{ section.settings.story_image | image_url: width: 800 }}"
             alt="{{ section.settings.story_image.alt | escape }}"
             loading="lazy"
             width="{{ section.settings.story_image.width }}"
             height="{{ section.settings.story_image.height }}">
      {% else %}
        <div style="background:#f4f4f4; width:100%; height:400px; display:flex; align-items:center; justify-content:center; color:#999; border-radius: {{ section.settings.story_image_radius }}px;">Upload Story Image</div>
      {% endif %}
    </div>
    <div class="about-story__content about-animate">
      <span class="about-story__eyebrow">{{ section.settings.story_eyebrow }}</span>
      <h2 class="about-story__heading">{{ section.settings.story_heading }}</h2>
      <p class="about-story__desc">{{ section.settings.story_description }}</p>

      <div class="about-stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="about-stat" {{ block.shopify_attributes }}>
              <span class="about-stat__number">{{ block.settings.stat_number }}</span>
              <span class="about-stat__label">{{ block.settings.stat_label }}</span>
              <p class="about-stat__desc">{{ block.settings.stat_description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- ===== PROMISE SECTION ===== -->
  <div class="about-promise">
    <div class="about-promise__inner">
      <div class="about-promise__content about-animate">
        <span class="about-promise__eyebrow">{{ section.settings.promise_eyebrow }}</span>
        <h2 class="about-promise__heading">{{ section.settings.promise_heading }}</h2>
        <p class="about-promise__desc">{{ section.settings.promise_description }}</p>
        {% if section.settings.promise_link != blank %}
          <a href="{{ section.settings.promise_link }}" class="about-link-btn">
            {{ section.settings.promise_link_text }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>

      <div class="about-promise__cards about-animate">
        {% for block in section.blocks %}
          {% if block.type == 'promise_card' %}
            <div class="about-promise-card" {{ block.shopify_attributes }}>
              <div class="about-promise-card__icon">
                {% if block.settings.custom_icon != blank %}
                  <img src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="{{ block.settings.card_title }}" width="36" height="36">
                {% else %}
                  <!-- Fallback if no icon uploaded -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: {{ section.settings.promise_icon_color }}"><circle cx="12" cy="12" r="10"/></svg>
                {% endif %}
              </div>
              <h4 class="about-promise-card__title">{{ block.settings.card_title }}</h4>
              <p class="about-promise-card__desc">{{ block.settings.card_description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const observerOptions = { root: null, rootMargin: '0px', threshold: 0.15 };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('about-visible');
          }, index * 100);
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    document.querySelectorAll('.about-animate').forEach(el => observer.observe(el));
  });
</script>

