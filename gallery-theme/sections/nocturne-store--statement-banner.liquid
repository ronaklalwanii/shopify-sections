{%- comment -%} Section Library: injected global assets for store "nocturne-store" {%- endcomment -%}
{{ 'nocturne-store--theme.css' | asset_url | stylesheet_tag }}
{{ 'nocturne-store--product.css' | asset_url | stylesheet_tag }}
{% render 'nocturne-store--css-variables' %}
{% comment %}
  Section: Statement Banner
  Editorial manifesto band: giant outlined vertical ticker words framing
  a centered statement (eyebrow / heading / divider / body / optional CTA).
{% endcomment %}

<section id="StatementBanner-{{ section.id }}" class="sb sb--mobile-{{ section.settings.mobile_words }} sb--motion-{{ section.settings.word_motion }}">
  {%- style -%}
    /* Full-bleed band: kill theme section spacing */
    #shopify-section-{{ section.id }} {
      padding: 0 !important;
      margin: 0 !important;
    }

    #StatementBanner-{{ section.id }} {
      --sb-bg: {{ section.settings.background_color }};
      --sb-text: {{ section.settings.text_color }};
      --sb-body: {{ section.settings.body_color }};
      --sb-stroke: {{ section.settings.stroke_color }};
      --sb-stroke-w: {{ section.settings.stroke_width }}px;
      --sb-stroke-a: {{ section.settings.stroke_opacity | divided_by: 100.0 }};
      --sb-word: {{ section.settings.word_size }}px;
      --sb-word-gap: {{ section.settings.word_gap }}px;
      --sb-ticker: {{ section.settings.ticker_speed }}s;
      --sb-head-size: {{ section.settings.heading_size }}px;
      --sb-head-size-m: {{ section.settings.heading_size_mobile }}px;
      --sb-head-weight: {{ section.settings.heading_weight }};
      --sb-eyebrow-size: {{ section.settings.eyebrow_size }}px;
      --sb-eyebrow-spacing: {{ section.settings.eyebrow_spacing }}px;
      --sb-divider-w: {{ section.settings.divider_width }}px;
      --sb-divider-t: {{ section.settings.divider_thickness }}px;
      --sb-divider-color: {{ section.settings.divider_color }};
      --sb-body-size: {{ section.settings.body_size }}px;
      --sb-body-lh: {{ section.settings.body_line_height }};
      --sb-body-max: {{ section.settings.body_max_width }}px;
      --sb-cta-radius: {{ section.settings.cta_radius }}px;
      --sb-cta-size: {{ section.settings.cta_size }}px;
      --sb-cta-px: {{ section.settings.cta_pad_x }}px;
      --sb-cta-py: {{ section.settings.cta_pad_y }}px;
      --sb-speed: {{ section.settings.animation_speed }}ms;
      --sb-ease: cubic-bezier(.22, 1, .36, 1);
    }

    #StatementBanner-{{ section.id }} {
      position: relative;
      background: var(--sb-bg);
      overflow: hidden;
      padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    }

    /* ---------- Vertical outline ticker words ---------- */
    #StatementBanner-{{ section.id }} .sb__word {
      position: absolute;
      top: 0;
      bottom: 0;
      z-index: 1;
      display: flex;
      justify-content: center;
      overflow: hidden;
      pointer-events: none;
      user-select: none;
      transition: opacity var(--sb-speed) ease;
    }
    #StatementBanner-{{ section.id }} .sb__word--left { left: var(--sb-word-gap); }
    #StatementBanner-{{ section.id }} .sb__word--right { right: var(--sb-word-gap); }

    #StatementBanner-{{ section.id }} .sb__word-track {
      display: flex;
      flex-direction: column;
      align-items: center;
      will-change: transform;
      animation: sbTickerUp var(--sb-ticker) linear infinite;
    }
    @keyframes sbTickerUp {
      from { transform: translateY(0); }
      to { transform: translateY(-50%); }
    }
    @keyframes sbTickerDown {
      from { transform: translateY(-50%); }
      to { transform: translateY(0); }
    }

    /* Direction modes */
    #StatementBanner-{{ section.id }}.sb--motion-up .sb__word-track { animation-name: sbTickerUp; }
    #StatementBanner-{{ section.id }}.sb--motion-down .sb__word-track { animation-name: sbTickerDown; }
    #StatementBanner-{{ section.id }}.sb--motion-opposite .sb__word--right .sb__word-track { animation-name: sbTickerUp; }
    #StatementBanner-{{ section.id }}.sb--motion-opposite .sb__word--left .sb__word-track { animation-name: sbTickerDown; }

    #StatementBanner-{{ section.id }} .sb__word-text {
      writing-mode: vertical-rl;
      white-space: nowrap;
      margin: 24px 0;
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(48px, 13vw, var(--sb-word));
      line-height: 1;
      letter-spacing: 0.02em;
      color: transparent;
      -webkit-text-stroke: var(--sb-stroke-w) var(--sb-stroke);
      opacity: var(--sb-stroke-a);
    }
    #StatementBanner-{{ section.id }} .sb__word--left .sb__word-text {
      transform: rotate(180deg);
    }
    @supports not (-webkit-text-stroke: 1px black) {
      #StatementBanner-{{ section.id }} .sb__word-text {
        color: var(--sb-stroke);
        opacity: calc(var(--sb-stroke-a) * 0.5);
      }
    }

    /* Static mode (centered, like the original design) */
    #StatementBanner-{{ section.id }}.sb--motion-static .sb__word {
      top: 50%;
      bottom: auto;
      height: auto;
      overflow: visible;
      transform: translateY(-50%);
    }
    #StatementBanner-{{ section.id }}.sb--motion-static .sb__word-track {
      animation: none;
    }
    #StatementBanner-{{ section.id }}.sb--motion-static .sb__word-text + .sb__word-text {
      display: none;
    }
    #StatementBanner-{{ section.id }}.sb--motion-static .sb__word-text {
      margin: 0;
    }

    /* ---------- Content ---------- */
    #StatementBanner-{{ section.id }} .sb__content {
      position: relative;
      z-index: 2;
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
    }

    #StatementBanner-{{ section.id }} .sb__eyebrow {
      margin: 0 0 {{ section.settings.eyebrow_margin }}px;
      color: var(--sb-text);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: var(--sb-eyebrow-size);
      letter-spacing: var(--sb-eyebrow-spacing);
      text-transform: uppercase;
      line-height: 1.3;
    }

    #StatementBanner-{{ section.id }} .sb__heading {
      margin: 0 0 {{ section.settings.heading_margin }}px;
      color: var(--sb-text);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: var(--sb-head-size);
      font-weight: var(--sb-head-weight);
      line-height: 1.15;
    }

    #StatementBanner-{{ section.id }} .sb__divider {
      width: var(--sb-divider-w);
      height: var(--sb-divider-t);
      background: var(--sb-divider-color);
      margin: 0 auto {{ section.settings.divider_margin }}px;
    }

    #StatementBanner-{{ section.id }} .sb__body {
      margin: 0 auto;
      max-width: var(--sb-body-max);
      color: var(--sb-body);
      font-size: var(--sb-body-size);
      line-height: var(--sb-body-lh);
    }

    #StatementBanner-{{ section.id }} .sb__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: {{ section.settings.cta_margin }}px;
      padding: var(--sb-cta-py) var(--sb-cta-px);
      border-radius: var(--sb-cta-radius);
      font-size: var(--sb-cta-size);
      font-weight: 600;
      letter-spacing: 0.5px;
      text-decoration: none;
      transition: transform 200ms ease, opacity 200ms ease, filter 200ms ease;
      {% if section.settings.cta_style == 'solid' %}
        background: {{ section.settings.cta_bg }};
        border: 1px solid {{ section.settings.cta_bg }};
        color: {{ section.settings.cta_solid_text }};
      {% else %}
        background: transparent;
        border: 1px solid {{ section.settings.cta_color }};
        color: {{ section.settings.cta_color }};
      {% endif %}
    }
    #StatementBanner-{{ section.id }} .sb__cta:hover {
      transform: translateY(-1px);
      filter: brightness(1.08);
    }

    /* ---------- Entrance animation ---------- */
    #StatementBanner-{{ section.id }} .sb__content > * {
      transition: opacity var(--sb-speed) ease, transform var(--sb-speed) var(--sb-ease);
    }
    #StatementBanner-{{ section.id }} .sb__content > *:nth-child(2) { transition-delay: 80ms; }
    #StatementBanner-{{ section.id }} .sb__content > *:nth-child(3) { transition-delay: 160ms; }
    #StatementBanner-{{ section.id }} .sb__content > *:nth-child(4) { transition-delay: 240ms; }
    #StatementBanner-{{ section.id }} .sb__content > *:nth-child(5) { transition-delay: 320ms; }
    #StatementBanner-{{ section.id }}.sb-animated:not(.is-in-view) .sb__content > * {
      opacity: 0;
      transform: translateY(18px);
    }
    #StatementBanner-{{ section.id }}.sb-animated:not(.is-in-view) .sb__word {
      opacity: 0;
    }

    /* ---------- Mobile ---------- */
    @media screen and (max-width: 760px) {
      #StatementBanner-{{ section.id }} .sb__heading { font-size: var(--sb-head-size-m); }

      /* hide */
      #StatementBanner-{{ section.id }}.sb--mobile-hide .sb__word {
        display: none;
      }

      /* watermark: horizontal, static, behind content */
      #StatementBanner-{{ section.id }}.sb--mobile-watermark .sb__word {
        top: 10px;
        bottom: auto;
        height: auto;
        left: 50%;
        right: auto;
        translate: -50% 0;
        overflow: visible;
      }
      #StatementBanner-{{ section.id }}.sb--mobile-watermark .sb__word--right {
        top: auto;
        bottom: 10px;
      }
      #StatementBanner-{{ section.id }}.sb--mobile-watermark .sb__word-track {
        animation: none;
      }
      #StatementBanner-{{ section.id }}.sb--mobile-watermark .sb__word-text + .sb__word-text {
        display: none;
      }
      #StatementBanner-{{ section.id }}.sb--mobile-watermark .sb__word-text {
        writing-mode: horizontal-tb;
        transform: none;
        margin: 0;
        font-size: clamp(56px, 17vw, 140px);
        opacity: calc(var(--sb-stroke-a) * 0.7);
      }

      /* keep vertical: ticker continues, smaller */
      #StatementBanner-{{ section.id }}.sb--mobile-vertical .sb__word-text {
        font-size: clamp(32px, 8vw, 72px);
      }
      #StatementBanner-{{ section.id }}.sb--mobile-vertical .sb__word--left { left: 6px; }
      #StatementBanner-{{ section.id }}.sb--mobile-vertical .sb__word--right { right: 6px; }
    }

    @media (prefers-reduced-motion: reduce) {
      #StatementBanner-{{ section.id }} .sb__content > *,
      #StatementBanner-{{ section.id }} .sb__word,
      #StatementBanner-{{ section.id }} .sb__cta {
        transition: none;
      }
      #StatementBanner-{{ section.id }} .sb__word-track {
        animation: none;
      }
      #StatementBanner-{{ section.id }}.sb-animated:not(.is-in-view) .sb__content > *,
      #StatementBanner-{{ section.id }}.sb-animated:not(.is-in-view) .sb__word {
        opacity: 1;
        transform: none;
      }
    }
  {%- endstyle -%}

  {%- if section.settings.show_left_word and section.settings.left_word != blank -%}
    <span class="sb__word sb__word--left" aria-hidden="true">
      <span class="sb__word-track">
        <span class="sb__word-text">{{ section.settings.left_word }}</span>
        <span class="sb__word-text">{{ section.settings.left_word }}</span>
      </span>
    </span>
  {%- endif -%}
  {%- if section.settings.show_right_word and section.settings.right_word != blank -%}
    <span class="sb__word sb__word--right" aria-hidden="true">
      <span class="sb__word-track">
        <span class="sb__word-text">{{ section.settings.right_word }}</span>
        <span class="sb__word-text">{{ section.settings.right_word }}</span>
      </span>
    </span>
  {%- endif -%}

  <div class="sb__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sb__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sb__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_divider -%}
      <div class="sb__divider" aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <p class="sb__body">{{ section.settings.body_text | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.settings.show_cta and section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <a class="sb__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>

  <script>
    (() => {
      const root = document.getElementById('StatementBanner-{{ section.id }}');
      if (!root) return;

      /* Reduced motion: freeze tickers into the static centered layout */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.remove('sb--motion-up', 'sb--motion-down', 'sb--motion-opposite');
        root.classList.add('sb--motion-static');
      }

      {%- if section.settings.enable_animation -%}
        root.classList.add('sb-animated');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) {
          root.classList.add('is-in-view');
        } else {
          const obs = new IntersectionObserver((entries, o) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                root.classList.add('is-in-view');
                o.unobserve(e.target);
              }
            });
          }, { threshold: 0.1 });
          obs.observe(root);
        }
      {%- else -%}
        root.classList.add('is-in-view');
      {%- endif -%}
    })();
  </script>
</section>

{% schema %}
{
  "name": "Statement Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#5A1F1B" },
    { "type": "color", "id": "text_color", "label": "Heading / eyebrow color", "default": "#F3E3D3" },
    { "type": "color", "id": "body_color", "label": "Body text color", "default": "#D9BFB2" },
    { "type": "color", "id": "stroke_color", "label": "Outline word color", "default": "#E8C9B8" },
    { "type": "range", "id": "stroke_opacity", "label": "Outline word opacity", "min": 5, "max": 60, "step": 5, "default": 35, "unit": "%" },
    { "type": "range", "id": "stroke_width", "label": "Outline thickness", "min": 1, "max": 4, "step": 1, "default": 1, "unit": "px" },

    { "type": "header", "content": "Vertical words" },
    { "type": "checkbox", "id": "show_left_word", "label": "Show left word", "default": true },
    { "type": "text", "id": "left_word", "label": "Left word", "default": "pre-order now — pre-order now —" },
    { "type": "checkbox", "id": "show_right_word", "label": "Show right word", "default": true },
    { "type": "text", "id": "right_word", "label": "Right word", "default": "merry christmas — merry christmas —" },
    { "type": "range", "id": "word_size", "label": "Word max size", "min": 60, "max": 260, "step": 10, "default": 180, "unit": "px" },
    { "type": "range", "id": "word_gap", "label": "Distance from edge", "min": 8, "max": 80, "step": 2, "default": 24, "unit": "px" },
    { "type": "select", "id": "word_motion", "label": "Word motion", "default": "opposite", "options": [
      { "value": "opposite", "label": "Ticker — opposite directions" },
      { "value": "up", "label": "Ticker — both scroll up" },
      { "value": "down", "label": "Ticker — both scroll down" },
      { "value": "static", "label": "Static (centered, original look)" }
    ] },
    { "type": "range", "id": "ticker_speed", "label": "Ticker loop time", "min": 2, "max": 60, "step": 2, "default": 2, "unit": "s" },
    { "type": "select", "id": "mobile_words", "label": "Mobile word behavior", "default": "watermark", "options": [
      { "value": "watermark", "label": "Watermark behind text" },
      { "value": "hide", "label": "Hide on mobile" },
      { "value": "vertical", "label": "Keep vertical ticker (small)" }
    ] },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Project 1225." },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 9, "max": 22, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "eyebrow_spacing", "label": "Eyebrow spacing", "min": 0, "max": 8, "step": 0.5, "default": 2, "unit": "px" },
    { "type": "range", "id": "eyebrow_margin", "label": "Eyebrow bottom spacing", "min": 0, "max": 40, "step": 2, "default": 14, "unit": "px" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Merry Christmas!" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 80, "step": 2, "default": 44, "unit": "px" },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 24, "max": 56, "step": 2, "default": 32, "unit": "px" },
    { "type": "range", "id": "heading_weight", "label": "Heading weight", "min": 100, "max": 900, "step": 100, "default": 500 },
    { "type": "range", "id": "heading_margin", "label": "Heading bottom spacing", "min": 0, "max": 60, "step": 2, "default": 20, "unit": "px" },
    { "type": "checkbox", "id": "show_divider", "label": "Show divider", "default": true },
    { "type": "range", "id": "divider_width", "label": "Divider width", "min": 20, "max": 160, "step": 5, "default": 60, "unit": "px" },
    { "type": "range", "id": "divider_thickness", "label": "Divider thickness", "min": 1, "max": 4, "step": 1, "default": 1, "unit": "px" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#F3E3D3" },
    { "type": "range", "id": "divider_margin", "label": "Divider bottom spacing", "min": 0, "max": 80, "step": 2, "default": 28, "unit": "px" },
    { "type": "textarea", "id": "body_text", "label": "Body text (new line = line break)", "default": "Introducing our 2019 ascent Christmas edition.\nA scent-driven winter moment, made to be remembered.\nAn ornament piece that brings calm to every space." },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 11, "max": 22, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "body_line_height", "label": "Body line height", "min": 1, "max": 2.4, "step": 0.2, "default": 1.4 },
    { "type": "range", "id": "body_max_width", "label": "Body max width", "min": 300, "max": 900, "step": 20, "default": 560, "unit": "px" },

    { "type": "header", "content": "Button (optional)" },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": false },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Pre-order now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "cta_style", "label": "Button style", "default": "outline", "options": [
      { "value": "outline", "label": "Outline" },
      { "value": "solid", "label": "Solid" }
    ] },
    { "type": "color", "id": "cta_color", "label": "Outline button color", "default": "#F3E3D3" },
    { "type": "color", "id": "cta_bg", "label": "Solid button background", "default": "#F3E3D3" },
    { "type": "color", "id": "cta_solid_text", "label": "Solid button text", "default": "#5A1F1B" },
    { "type": "range", "id": "cta_radius", "label": "Button radius", "min": 0, "max": 60, "step": 2, "default": 30, "unit": "px" },
    { "type": "range", "id": "cta_size", "label": "Button size", "min": 9, "max": 18, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "cta_pad_x", "label": "Button horizontal padding", "min": 12, "max": 48, "step": 2, "default": 26, "unit": "px" },
    { "type": "range", "id": "cta_pad_y", "label": "Button vertical padding", "min": 6, "max": 24, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "cta_margin", "label": "Button top spacing", "min": 0, "max": 80, "step": 2, "default": 28, "unit": "px" },

    { "type": "header", "content": "Layout & animation" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 36, "max": 200, "step": 2, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 36, "max": 200, "step": 2, "default": 96, "unit": "px" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable entrance animation", "default": true },
    { "type": "range", "id": "animation_speed", "label": "Animation speed", "min": 250, "max": 1200, "step": 50, "default": 700, "unit": "ms" }
  ],
  "presets": [
    {
      "name": "Statement Banner"
    }
  ]
}
{% endschema %}