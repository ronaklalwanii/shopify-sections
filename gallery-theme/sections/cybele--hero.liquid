      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "enr_border_width",
      "label": "Card border width",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1 px"
        },
        {
          "value": "2",
          "label": "2 px"
        },
        {
          "value": "3",
          "label": "3 px"
        },
        {
          "value": "4",
          "label": "4 px"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "Enriched sizes (off = as designed)"
