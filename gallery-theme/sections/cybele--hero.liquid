{%- comment -%} Section Library: injected global assets for store "cybele" {%- endcomment -%}
{{ 'cybele--base.css' | asset_url | stylesheet_tag }}
{{ 'cybele--components.css' | asset_url | stylesheet_tag }}
{% render 'cybele--layout-tokens' %}
{{ 'cybele--global.js' | asset_url | script_tag }}
{{ 'cybele--wishlist.js' | asset_url | script_tag }}
{%- comment -%}
  Hero image banner. Two layouts:
  - split: content on one side, image on the other (boutique look)
  - full:  full-bleed image with overlaid content (noir / homeware look)
  Buttons are blocks so merchants can add/remove/reorder.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign height = section.settings.height
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign ov_soft = overlay | times: 0.3
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }}
  class="hero hero--{{ layout }}{% if layout == 'split' and section.settings.image_position == 'left' %} hero--image-left{% elsif layout == 'split' %} hero--image-right{% endif %} hero__height-{{ height }}"
  style="{% if layout == 'full' %}--overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay }};{% endif %} {% if layout == 'split' and section.settings.image_height != blank %}--split-image-height: {{ section.settings.image_height }}px;{% endif %}"
>
  <div class="hero__media">
    {%- if section.settings.show_image and section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '640, 960, 1280, 1600, 2400',
        sizes: '100vw',
        alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if layout == 'full' -%}
    <div class="hero__overlay" style="--overlay-color: linear-gradient(90deg, {{ section.settings.overlay_color | color_modify: 'alpha', overlay }}, {{ section.settings.overlay_color | color_modify: 'alpha', ov_soft }});" aria-hidden="true"></div>
  {%- endif -%}

  <div class="{% if layout == 'full' %}page-width{% endif %} hero__content-wrap" style="display: flex; width: {% if layout == 'split' %}100%{% endif %};">
    <div
      class="hero__content{% if layout == 'split' %} hero__content--{{ section.settings.content_align }}{% endif %}"
      style="{% if layout == 'split' %}margin-inline: auto; margin-left: max(calc((100vw - var(--page-width)) / 2 + clamp(1rem, 4vw, 3rem)), clamp(1rem, 4vw, 3rem));{% endif %} text-align: {{ section.settings.text_align }};"
    >
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h1 class="hero__heading {{ section.settings.heading_size }}{% if section.settings.fluid_heading %} hero__heading--fluid{% endif %}">
          {{ section.settings.heading | escape | newline_to_br }}
        </h1>
      {%- endif -%}

      {%- if section.settings.show_subheading and section.settings.subheading != blank -%}
        <div class="hero__text">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__buttons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              {% render 'cybele--button',
                label: block.settings.label,
                link: block.settings.link,
                style: block.settings.style,
                attributes: block.shopify_attributes
              %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.avatars_count > 0 or section.settings.meta_text != blank -%}
        <div class="hero__meta">
          {%- if section.settings.avatars_count > 0 -%}
            <div class="hero__avatars">
              {%- for i in (1..section.settings.avatars_count) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign av = section.settings.avatar_1 -%}
                  {%- when 2 -%}{%- assign av = section.settings.avatar_2 -%}
                  {%- when 3 -%}{%- assign av = section.settings.avatar_3 -%}
                  {%- when 4 -%}{%- assign av = section.settings.avatar_4 -%}
                {%- endcase -%}
                {%- if av != blank -%}
                  {{ av | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  <span style="display:inline-flex;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--color-background-secondary);border:2px solid var(--color-background);"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.meta_text != blank -%}
            <p class="hero__meta-text">{{ section.settings.meta_text | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if layout == 'full' and section.settings.scroll_label != blank -%}
    <a href="{{ section.settings.scroll_link | default: '#main' }}" class="hero__scroll">
      <span class="icon-button">{% render 'cybele--icon', name: 'arrow-down', size: 14 %}</span>
      {{ section.settings.scroll_label | escape }}
    </a>
  {%- endif -%}
</section>

<style>
  .hero--split .hero__media img { height: 100%; }
  @media (min-width: 990px) {
    .hero--split .hero__media img { max-height: var(--split-image-height, 620px); }
  }
</style>

{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Hero",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Split — content beside image"
        },
        {
          "value": "full",
          "label": "Full width — content over image"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (split layout)",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image max height (split layout)",
      "min": 520,
      "max": 720,
      "step": 2,
      "unit": "px",
      "default": 620
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height (full layout)",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (full layout)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pure indulgence, true happiness"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Wear the Story.\nLive the Style."
    },
    {
      "type": "checkbox",
      "id": "fluid_heading",
      "label": "Fluid wordmark size (scales with viewport)",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "Display"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p><em>Timeless designs. Thoughtfully crafted. Made for your every moment.</em></p>"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content vertical alignment (split)",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "range",
      "id": "avatars_count",
      "label": "Avatar count",
      "min": 0,
      "max": 4,
      "step": 2,
      "default": 0
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "image_picker",
      "id": "avatar_4",
      "label": "Avatar 4"
    },
    {
      "type": "textarea",
      "id": "meta_text",
      "label": "Social proof text"
    },
    {
      "type": "header",
      "content": "Scroll hint (full layout)"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "scroll_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "header",
      "content": "Enriched shape"
    },
