      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media",
      "label": "Enable custom media heights",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_media_height",
      "label": "Media height (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 400
