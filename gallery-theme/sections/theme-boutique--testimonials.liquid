    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
