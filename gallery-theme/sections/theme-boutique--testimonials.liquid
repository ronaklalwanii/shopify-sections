      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
