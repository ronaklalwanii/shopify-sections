{%- comment -%} Section Library: injected global assets for store "cybele" {%- endcomment -%}
{{ 'cybele--base.css' | asset_url | stylesheet_tag }}
{{ 'cybele--components.css' | asset_url | stylesheet_tag }}
{% render 'cybele--layout-tokens' %}
{%- comment -%}
  Main product section — gallery, buy form with variant picker, blocks.
{%- endcomment -%}
{%- liquid
  assign product = product
  assign current = product.selected_or_first_available_variant
-%}
<div class="page-width section" style="--section-space: {{ section.settings.padding | default: 56 }}px;" id="MainProduct-{{ section.id }}">
  <nav class="visually-hidden" aria-label="breadcrumbs"></nav>
  <div class="product-page" data-product-container>
    <div class="product-media" data-gallery>
      <div class="product-media__main">
        {%- if product.featured_media -%}
          <img
            data-gallery-main
            src="{{ product.featured_media | image_url: width: 1200 }}"
            srcset="{{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 900 }} 900w, {{ product.featured_media | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="1200"
            height="1500"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-media__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product-media__thumb{% if forloop.first %} is-active{% endif %}"
              data-gallery-thumb="{{ media | image_url: width: 1200 }}"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
            >
              {{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="product-info__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}
          {%- when 'title' -%}
            <h1 class="product-info__title h2" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
          {%- when 'rating' -%}
            {%- if product.metafields.reviews.rating.value != blank -%}
              <div style="margin-bottom: 1rem;" {{ block.shopify_attributes }}>
                {% render 'cybele--rating', rating: product.metafields.reviews.rating.value.rating %}
              </div>
            {%- endif -%}
          {%- when 'price' -%}
            <div class="product-info__price" id="price-{{ section.id }}" {{ block.shopify_attributes }}>
              {%- if current.compare_at_price > current.price -%}
                <s>{{ current.compare_at_price | money }}</s>
                <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
              {%- endif -%}
              <span>{{ current.price | money }}</span>
              {%- if current.unit_price_measurement -%}
                <span class="product-info__tax">
                  {{ current.unit_price | money }}/{{ current.unit_price_measurement.reference_value }}{{ current.unit_price_measurement.reference_unit }}
                </span>
              {%- endif -%}
            </div>
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <p class="product-info__tax">
                {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif %}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url | default: '' }}
                {%- endif -%}
              </p>
            {%- endif -%}
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <div class="variant-picker__option">
                    <label>{{ option.name | escape }}</label>
                    <div class="variant-picker__values">
                      {%- for value in option.values -%}
                        <input
                          type="radio"
                          id="Option-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                          name="Option-{{ section.id }}-{{ forloop.parentloop.index }}"
                          class="visually-hidden"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label for="Option-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" class="variant-picker__value{% if option.selected_value == value %} is-selected{% endif %}">
                          {{ value }}
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
                <script type="application/json" data-variant-json>
                  {{ product.variants | json }}
                </script>
              </div>
            {%- endunless -%}
          {%- when 'quantity' -%}
            <div class="product-form__quantity" style="margin-bottom: 1.4rem; align-self: flex-start;" {{ block.shopify_attributes }}>
              <button type="button" class="quantity__button" data-qty-step="minus" aria-label="{{ 'sections.cart.decrease' | t }}">
                {% render 'cybele--icon', name: 'minus', size: 12 %}
              </button>
              <input type="number" class="quantity__input" name="quantity" value="1" min="1" aria-label="{{ 'sections.cart.quantity' | t }}">
              <button type="button" class="quantity__button" data-qty-step="plus" aria-label="{{ 'sections.cart.increase' | t }}">
                {% render 'cybele--icon', name: 'plus', size: 12 %}
              </button>
            </div>
          {%- when 'buttons' -%}
            {%- liquid assign form_id = 'ProductForm-' | append: section.id -%}
            {%- form 'product', product, class: 'product-form', id: form_id -%}
              <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
              <button
                type="submit"
                name="add"
                class="button button--{{ block.settings.button_style }} button--full"
                {% unless current.available %}disabled{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if current.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            {%- endform -%}
          {%- when 'description' -%}
            <div class="product-info__description rte" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {%- when 'accordion' -%}
            <div class="product-accordions" {{ block.shopify_attributes }}>
              <details class="faq-item">
                <summary class="faq-item__summary">
                  {{ block.settings.title | escape }}
                  {% render 'cybele--icon', name: 'plus', size: 14 %}
                </summary>
                <div class="faq-item__answer">{{ block.settings.content }}</div>
              </details>
            </div>
          {%- when 'share' -%}
            <div class="product-info__share" {{ block.shopify_attributes }}>
              {{ 'general.share.copy' | t }}
            </div>
          {%- when 'text' -%}
            <div style="font-size: 0.9rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Product information",
  "max_blocks": 10,
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses the product assigned by the template."
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 16,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "header",
      "content": "Enriched shape"
    },
    {
      "type": "range",
      "id": "enr_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "enr_border_width",
      "label": "Card border width",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1 px"
        },
        {
          "value": "2",
          "label": "2 px"
        },
        {
          "value": "3",
          "label": "3 px"
        },
        {
          "value": "4",
          "label": "4 px"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "Enriched sizes (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_sizes",
      "label": "Enable custom sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_title_size",
      "label": "Title size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "enr_body_size",
      "label": "Body size",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "enr_eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "enr_icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Enriched spacing (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_space_top",
      "label": "Space top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_space_bottom",
      "label": "Space bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media",
      "label": "Enable custom media heights",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_media_height",
      "label": "Media height (desktop)",
      "min": 380,
      "max": 580,
      "step": 2,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 300,
      "max": 500,
      "step": 2,
      "unit": "px",
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Add-to-cart style",
          "options": [
            {
              "value": "primary",
              "label": "Accent"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "dark"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping and returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free delivery on orders over $100. Hassle-free 30-day returns.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
  {% endschema %}
