{%- comment -%} Section Library: injected global assets for store "cybele" {%- endcomment -%}
{{ 'cybele--base.css' | asset_url | stylesheet_tag }}
{{ 'cybele--components.css' | asset_url | stylesheet_tag }}
{% render 'cybele--layout-tokens' %}
{%- comment -%} Cybele shades — taupe band, rotating badge, hand photo, 3 shade cards. {%- endcomment -%}
{%- assign cysize = section.settings.badge_size | default: 120 -%}
<section class="cysh cysh-{{ section.id }}" style="--cysh-bg: {{ section.settings.background_color | default: '#e8ddd0' }};">
  <div class="page-width">
    <div class="cysh__intro">
      <div>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.copy != blank -%}<div class="cysh__copy">{{ section.settings.copy }}</div>{%- endif -%}
      </div>
      <div class="cysh__orbit" aria-hidden="true" style="--orbit: {{ cysize }}px;">
        <svg viewBox="0 0 100 100">
          <defs><path id="cysh-circ-{{ section.id }}" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" fill="none"/></defs>
          <text><textPath href="#cysh-circ-{{ section.id }}">{{ section.settings.badge_text | default: 'GETTING STARTED • ' | escape }}{{ section.settings.badge_text | default: 'GETTING STARTED • ' | escape }}</textPath></text>
        </svg>
        {% render 'cybele--icon', name: 'arrow-down', size: 16 %}
      </div>
      <div class="cysh__hand">
        {%- if section.settings.hand_image != blank -%}
          {{ section.settings.hand_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 800', alt: section.settings.heading }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
    <div class="cysh__grid">
      {%- for block in section.blocks -%}
        {%- assign dot = block.settings.color | default: '#a41e34' -%}
        <article class="cysh__shade" {{ block.shopify_attributes }}>
          <p class="cysh__name"><i style="background: {{ dot }};"></i>{{ block.settings.name | escape }}</p>
          <div class="cysh__shot">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', alt: block.settings.name }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  .cysh-{{ section.id }} { background: var(--cysh-bg); padding-block: var(--section-space); color: var(--cysh-ink); --cysh-ink: {{ section.settings.ink_color }}; }
  .cysh-{{ section.id }} .cysh__intro { display: grid; grid-template-columns: 1.2fr auto 1fr; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; margin-bottom: clamp(1.4rem, 3vw, 2.4rem); }
  .cysh-{{ section.id }} .cysh__copy { font-size: 0.8rem; color: color-mix(in srgb, var(--cysh-ink) 65%, transparent); max-width: 24rem; margin-top: 0.6rem; }
  .cysh-{{ section.id }} .cysh__orbit { position: relative; width: var(--orbit, 120px); height: var(--orbit, 120px); }
  .cysh-{{ section.id }} .cysh__orbit > svg:first-child { width: 100%; height: 100%; animation: cysh-spin 16s linear infinite; }
  .cysh-{{ section.id }} .cysh__orbit text { font-size: 10.5px; letter-spacing: 2.5px; text-transform: uppercase; fill: var(--cysh-ink); font-weight: 600; }
  .cysh-{{ section.id }} .cysh__orbit > svg:last-child { position: absolute; width: 16px; height: 16px; top: calc(50% - 8px); left: calc(50% - 8px); }
  @keyframes cysh-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .cysh-{{ section.id }} .cysh__orbit > svg:first-child { animation: none; } }
  .cysh-{{ section.id }} .cysh__hand { border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 10; }
  .cysh-{{ section.id }} .cysh__hand > img, .cysh-{{ section.id }} .cysh__hand > svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cysh-{{ section.id }} .cysh__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.9rem, 2vw, 1.6rem); }
  .cysh-{{ section.id }} .cysh__shot { border-radius: 12px; overflow: hidden; aspect-ratio: 3 / 4; background: rgba(255,255,255,0.4); }
  .cysh-{{ section.id }} .cysh__shot > img, .cysh-{{ section.id }} .cysh__shot > svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cysh-{{ section.id }} .cysh__name { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.7rem; font-size: 0.8rem; font-weight: 600; }
  .cysh-{{ section.id }} .cysh__name i { width: 0.7rem; height: 0.7rem; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  @media (max-width: 989px) {
    .cysh-{{ section.id }} .cysh__intro { grid-template-columns: 1fr 1fr; }
    .cysh-{{ section.id }} .cysh__hand { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) { .cysh-{{ section.id }} .cysh__grid { grid-template-columns: 1fr; } }
{% endstyle %}
{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
