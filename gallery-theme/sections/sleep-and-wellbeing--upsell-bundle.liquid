{%- comment -%} Section Library: injected global assets for store "sleep-and-wellbeing" {%- endcomment -%}
{{ 'sleep-and-wellbeing--theme.css' | asset_url | stylesheet_tag }}
{{ 'sleep-and-wellbeing--product.css' | asset_url | stylesheet_tag }}
{% render 'sleep-and-wellbeing--css-variables' %}
{%- comment -%}
  ============================================================
  Upsell / Bundle
  ------------------------------------------------------------
  A self-contained, drop-in section to raise average order value.
  Show complementary products as a grid or carousel, or as a
  selectable bundle with a live total and one-click "add all".
  Works on any Shopify theme (Online Store 2.0 or vintage).
  No external dependencies. Styles are scoped to this instance.

  Built by LazyCodeLab.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', ''
  assign wrap = 'fbu-' | append: uid
  assign align = section.settings.content_alignment
  assign st = section.settings

  assign bg = st.section_background
  if st.transparent_bg
    assign bg = 'transparent'
  endif

  assign use_collection = false
  if st.product_source == 'collection' and st.collection != blank
    assign use_collection = true
  endif

  assign ratio = '1 / 1'
  case st.image_ratio
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} .{{ wrap }}{
    --fbu-bg: {{ bg }};
    --fbu-heading: {{ st.heading_color }};
    --fbu-text: {{ st.text_color }};
    --fbu-eyebrow: {{ st.eyebrow_color }};
    --fbu-price: {{ st.price_color }};
    --fbu-card-bg: {{ st.card_background }};
    --fbu-card-border: {{ st.card_border_color }};
    --fbu-btn-bg: {{ st.button_bg }};
    --fbu-btn-text: {{ st.button_text }};
    --fbu-badge-bg: {{ st.badge_bg }};
    --fbu-badge-text: {{ st.badge_text }};
    --fbu-cols: {{ st.columns_desktop }};
    --fbu-cols-mobile: {{ st.columns_mobile }};
    --fbu-maxw: {{ st.max_width }}px;
    --fbu-ratio: {{ ratio }};
    background: var(--fbu-bg);
    color: var(--fbu-text);
    padding-top: {{ st.padding_top }}px;
    padding-bottom: {{ st.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__inner{
    max-width: var(--fbu-maxw); margin: 0 auto; padding: 0 20px; text-align: {{ align }};
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__eyebrow{
    color: var(--fbu-eyebrow); font-size: .78rem; letter-spacing: .12em;
    text-transform: uppercase; font-weight: 600; margin: 0 0 .5rem;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__heading{
    color: var(--fbu-heading); margin: 0 0 .6rem; line-height: 1.15;
    font-size: {% case st.heading_size %}{% when 'small' %}1.6rem{% when 'medium' %}2.1rem{% when 'large' %}2.7rem{% when 'xlarge' %}3.3rem{% endcase %};
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__sub{ margin: 0 auto 2rem; max-width: 640px; line-height: 1.6; opacity: .92; }
  #shopify-section-{{ section.id }} .{{ wrap }}--left .{{ wrap }}__sub{ margin-left: 0; }

  /* Layouts */
  #shopify-section-{{ section.id }} .{{ wrap }}__grid{
    display: grid; grid-template-columns: repeat(var(--fbu-cols), minmax(0,1fr)); gap: 1.2rem; text-align: left;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}--carousel .{{ wrap }}__grid{
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    gap: 1.2rem; padding-bottom: .6rem; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}--carousel .{{ wrap }}__card{
    flex: 0 0 calc((100% - (var(--fbu-cols) - 1) * 1.2rem) / var(--fbu-cols)); scroll-snap-align: start;
  }

  /* Card */
  #shopify-section-{{ section.id }} .{{ wrap }}__card{
    position: relative; display: flex; flex-direction: column; gap: .5rem;
    background: var(--fbu-card-bg); border: 1px solid var(--fbu-card-border);
    border-radius: 12px; padding: .85rem; transition: border-color .15s ease;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}--bundle .{{ wrap }}__card{ cursor: pointer; }
  #shopify-section-{{ section.id }} .{{ wrap }}__card.is-selected{ border-color: var(--fbu-btn-bg); }
  #shopify-section-{{ section.id }} .{{ wrap }}__media{
    position: relative; aspect-ratio: var(--fbu-ratio); border-radius: 8px; overflow: hidden; background: #f1eee9;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__media img{ width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .{{ wrap }}__badge{
    position: absolute; top: .5rem; left: .5rem; z-index: 2;
    background: var(--fbu-badge-bg); color: var(--fbu-badge-text);
    font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    padding: .22rem .5rem; border-radius: 4px;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__check{
    position: absolute; top: .5rem; right: .5rem; z-index: 2; width: 22px; height: 22px;
    accent-color: var(--fbu-btn-bg); cursor: pointer;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__vendor{ font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; opacity: .6; margin: 0; }
  #shopify-section-{{ section.id }} .{{ wrap }}__title{
    font-size: .95rem; font-weight: 600; line-height: 1.3; margin: 0; color: var(--fbu-heading); text-decoration: none;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__title:hover{ text-decoration: underline; }
  #shopify-section-{{ section.id }} .{{ wrap }}__prices{ display: flex; gap: .4rem; align-items: baseline; margin-top: auto; }
  #shopify-section-{{ section.id }} .{{ wrap }}__price{ color: var(--fbu-price); font-weight: 700; font-size: 1rem; }
  #shopify-section-{{ section.id }} .{{ wrap }}__compare{ color: var(--fbu-text); opacity: .55; text-decoration: line-through; font-size: .85rem; }

  #shopify-section-{{ section.id }} .{{ wrap }}__add{
    margin-top: .4rem; width: 100%; padding: .55rem .8rem; border-radius: 7px; border: 1.5px solid var(--fbu-btn-bg);
    background: var(--fbu-btn-bg); color: var(--fbu-btn-text); font-weight: 600; font-size: .85rem; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__add:hover{ opacity: .9; }
  #shopify-section-{{ section.id }} .{{ wrap }}__add[disabled]{ opacity: .55; cursor: default; }

  /* Bundle bar */
  #shopify-section-{{ section.id }} .{{ wrap }}__bar{
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
    margin-top: 1.6rem; padding: 1.1rem 1.3rem; border-radius: 12px;
    background: var(--fbu-card-bg); border: 1px solid var(--fbu-card-border); text-align: left;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__bar-info{ display: flex; flex-direction: column; gap: .15rem; }
  #shopify-section-{{ section.id }} .{{ wrap }}__total-label{ font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; opacity: .6; }
  #shopify-section-{{ section.id }} .{{ wrap }}__total{ font-size: 1.5rem; font-weight: 700; color: var(--fbu-heading); }
  #shopify-section-{{ section.id }} .{{ wrap }}__savings{ font-size: .85rem; color: var(--fbu-eyebrow); font-weight: 600; }
  #shopify-section-{{ section.id }} .{{ wrap }}__bundle-btn{
    padding: .85rem 1.8rem; border-radius: 8px; border: 2px solid var(--fbu-btn-bg);
    background: var(--fbu-btn-bg); color: var(--fbu-btn-text); font-weight: 600; font-size: 1rem; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .{{ wrap }}__bundle-btn:hover{ opacity: .9; }
  #shopify-section-{{ section.id }} .{{ wrap }}__bundle-btn[disabled]{ opacity: .55; cursor: default; }

  #shopify-section-{{ section.id }} .{{ wrap }}__empty{ opacity: .6; font-size: .9rem; padding: 1rem 0; }

  /* Animation */
  #shopify-section-{{ section.id }} .{{ wrap }}--animate .{{ wrap }}__card{ opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
  #shopify-section-{{ section.id }} .{{ wrap }}--animate .{{ wrap }}__card.is-visible{ opacity: 1 !important; transform: none !important; }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .{{ wrap }}--animate .{{ wrap }}__card{ opacity: 1; transform: none; transition: none; }
  }

  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .{{ wrap }}__grid{ grid-template-columns: repeat(var(--fbu-cols-mobile), minmax(0,1fr)); gap: .8rem; }
    #shopify-section-{{ section.id }} .{{ wrap }}--carousel .{{ wrap }}__card{ flex-basis: 70%; }
    #shopify-section-{{ section.id }} .{{ wrap }}__heading{ font-size: 1.7rem; }
  }
</style>

{%- comment -%} -------- Card markup is repeated for the two product sources -------- {%- endcomment -%}

<div class="{{ wrap }} {{ wrap }}--{{ st.layout }} {{ wrap }}--{{ align }}{% if st.bundle_mode %} {{ wrap }}--bundle{% endif %}{% if st.enable_animation %} {{ wrap }}--animate{% endif %}"
     data-money-format="{{ shop.money_format | escape }}"
     data-after-add="{{ st.after_add }}"
     data-discount="{{ st.discount_code | escape }}">
  <div class="{{ wrap }}__inner">

    {%- if st.eyebrow != blank -%}<p class="{{ wrap }}__eyebrow">{{ st.eyebrow }}</p>{%- endif -%}
    {%- if st.heading != blank -%}<h2 class="{{ wrap }}__heading">{{ st.heading }}</h2>{%- endif -%}
    {%- if st.subheading != blank -%}<div class="{{ wrap }}__sub">{{ st.subheading }}</div>{%- endif -%}

    <div class="{{ wrap }}__grid">

      {%- comment -%} Current product as the first, locked bundle item {%- endcomment -%}
      {%- if st.bundle_mode and st.include_current_product and product != blank -%}
        {%- assign cp = product.selected_or_first_available_variant -%}
        <div class="{{ wrap }}__card is-selected" data-fbu-item data-locked="true" data-variant="{{ cp.id }}" data-price="{{ cp.price }}">
          <input type="checkbox" class="{{ wrap }}__check" checked disabled aria-label="This product (always included)">
          <div class="{{ wrap }}__media">
            {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
          </div>
          {%- if st.show_vendor and product.vendor != blank -%}<p class="{{ wrap }}__vendor">{{ product.vendor }}</p>{%- endif -%}
          <p class="{{ wrap }}__title">{{ product.title }} <span class="{{ wrap }}__badge" style="position:static;display:inline-block;margin-left:4px;">This item</span></p>
          {%- if st.show_price -%}<div class="{{ wrap }}__prices"><span class="{{ wrap }}__price">{{ cp.price | money }}</span></div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if use_collection -%}
        {%- assign plist = st.collection.products -%}
        {%- if plist.size == 0 -%}
          <p class="{{ wrap }}__empty">Select a collection with products in the section settings.</p>
        {%- endif -%}
        {%- for p in plist limit: st.products_limit -%}
          {%- assign pv = p.selected_or_first_available_variant -%}
          <div class="{{ wrap }}__card{% if st.bundle_mode and st.preselect %} is-selected{% endif %}" data-fbu-item data-variant="{{ pv.id }}" data-price="{{ pv.price }}">
            {%- if st.bundle_mode -%}<input type="checkbox" class="{{ wrap }}__check"{% if st.preselect %} checked{% endif %}{% unless pv.available %} disabled{% endunless %} aria-label="Add {{ p.title | escape }}">{%- endif -%}
            <a href="{{ p.url }}"{% unless st.title_links %} style="pointer-events:none;"{% endunless %} class="{{ wrap }}__media">
              {% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy">{% endif %}
            </a>
            {%- if st.show_vendor and p.vendor != blank -%}<p class="{{ wrap }}__vendor">{{ p.vendor }}</p>{%- endif -%}
            <a href="{{ p.url }}" class="{{ wrap }}__title"{% unless st.title_links %} style="pointer-events:none;color:var(--fbu-heading);"{% endunless %}>{{ p.title }}</a>
            {%- if st.show_price -%}
              <div class="{{ wrap }}__prices">
                <span class="{{ wrap }}__price">{{ pv.price | money }}</span>
                {%- if st.show_compare and pv.compare_at_price > pv.price -%}<span class="{{ wrap }}__compare">{{ pv.compare_at_price | money }}</span>{%- endif -%}
              </div>
            {%- endif -%}
            {%- unless st.bundle_mode -%}
              <button type="button" class="{{ wrap }}__add" data-fbu-add="{{ pv.id }}"{% unless pv.available %} disabled{% endunless %}>{% if pv.available %}{{ st.add_button_label }}{% else %}Sold out{% endif %}</button>
            {%- endunless -%}
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- assign has_block = false -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- assign has_block = true -%}
            {%- assign pv = p.selected_or_first_available_variant -%}
            <div class="{{ wrap }}__card{% if st.bundle_mode and st.preselect %} is-selected{% endif %}" data-fbu-item data-variant="{{ pv.id }}" data-price="{{ pv.price }}" {{ block.shopify_attributes }}>
              {%- if st.bundle_mode -%}<input type="checkbox" class="{{ wrap }}__check"{% if st.preselect %} checked{% endif %}{% unless pv.available %} disabled{% endunless %} aria-label="Add {{ p.title | escape }}">{%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="{{ wrap }}__badge">{{ block.settings.badge }}</span>{%- endif -%}
              <a href="{{ p.url }}"{% unless st.title_links %} style="pointer-events:none;"{% endunless %} class="{{ wrap }}__media">
                {% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy">{% endif %}
              </a>
              {%- if st.show_vendor and p.vendor != blank -%}<p class="{{ wrap }}__vendor">{{ p.vendor }}</p>{%- endif -%}
              <a href="{{ p.url }}" class="{{ wrap }}__title"{% unless st.title_links %} style="pointer-events:none;color:var(--fbu-heading);"{% endunless %}>{{ p.title }}</a>
              {%- if st.show_price -%}
                <div class="{{ wrap }}__prices">
                  <span class="{{ wrap }}__price">{{ pv.price | money }}</span>
                  {%- if st.show_compare and pv.compare_at_price > pv.price -%}<span class="{{ wrap }}__compare">{{ pv.compare_at_price | money }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              {%- unless st.bundle_mode -%}
                <button type="button" class="{{ wrap }}__add" data-fbu-add="{{ pv.id }}"{% unless pv.available %} disabled{% endunless %}>{% if pv.available %}{{ st.add_button_label }}{% else %}Sold out{% endif %}</button>
              {%- endunless -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- unless has_block -%}
          <p class="{{ wrap }}__empty">Add product blocks in the section settings to show upsells here.</p>
        {%- endunless -%}
      {%- endif -%}

    </div>

    {%- if st.bundle_mode -%}
      <div class="{{ wrap }}__bar">
        <div class="{{ wrap }}__bar-info">
          <span class="{{ wrap }}__total-label">Bundle total</span>
          <span class="{{ wrap }}__total" data-fbu-total>—</span>
          {%- if st.savings_note != blank -%}<span class="{{ wrap }}__savings">{{ st.savings_note }}</span>{%- endif -%}
        </div>
        <button type="button" class="{{ wrap }}__bundle-btn" data-fbu-bundle>{{ st.bundle_button_label }}</button>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function(){
    var root = document.querySelector('#shopify-section-{{ section.id }} .{{ wrap }}');
    if(!root) return;

    var fmt = root.getAttribute('data-money-format') || '${{amount}}';
    function money(cents){
      var v = (cents/100), out = fmt;
      function withCommas(n, dec, tsep, dsep){
        var parts = parseFloat(n).toFixed(dec).split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, tsep || ',');
        return dec ? parts.join(dsep || '.') : parts[0];
      }
      out = out.replace(/\{\{\s*amount\s*\}\}/g, withCommas(v,2,',','.'));
      out = out.replace(/\{\{\s*amount_no_decimals\s*\}\}/g, withCommas(v,0,',',''));
      out = out.replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, withCommas(v,2,'.',','));
      out = out.replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, withCommas(v,0,'.',''));
      out = out.replace(/\{\{\s*amount_with_space_separator\s*\}\}/g, withCommas(v,2,' ','.'));
      return out;
    }

    /* Individual add buttons */
    root.querySelectorAll('[data-fbu-add]').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault(); e.stopPropagation();
        var id = btn.getAttribute('data-fbu-add'), original = btn.textContent;
        btn.setAttribute('disabled','');
        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:id,quantity:1}]})})
          .then(function(r){return r.json();})
          .then(function(){ btn.textContent='Added \u2713'; document.dispatchEvent(new CustomEvent('cart:refresh'));
            setTimeout(function(){ btn.textContent=original; btn.removeAttribute('disabled'); },1800); })
          .catch(function(){ btn.textContent=original; btn.removeAttribute('disabled'); });
      });
    });

    /* Bundle mode */
    var bundleBtn = root.querySelector('[data-fbu-bundle]');
    if(bundleBtn){
      var totalEl = root.querySelector('[data-fbu-total]');
      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-fbu-item]'));

      function selected(){
        return cards.filter(function(c){
          var cb = c.querySelector('.{{ wrap }}__check');
          return cb && cb.checked;
        });
      }
      function recalc(){
        var sum = 0;
        selected().forEach(function(c){ sum += parseInt(c.getAttribute('data-price'),10) || 0; });
        if(totalEl) totalEl.textContent = sum > 0 ? money(sum) : '—';
        bundleBtn.disabled = selected().length === 0;
      }

      cards.forEach(function(c){
        var cb = c.querySelector('.{{ wrap }}__check');
        if(!cb) return;
        function sync(){ c.classList.toggle('is-selected', cb.checked); recalc(); }
        cb.addEventListener('change', sync);
        c.addEventListener('click', function(e){
          if(cb.disabled) return;
          if(e.target.tagName === 'A' || e.target === cb) return;
          cb.checked = !cb.checked; sync();
        });
      });
      recalc();

      bundleBtn.addEventListener('click', function(){
        var items = selected().map(function(c){ return { id: parseInt(c.getAttribute('data-variant'),10), quantity: 1 }; })
                              .filter(function(i){ return i.id; });
        if(!items.length) return;
        var label = bundleBtn.textContent; bundleBtn.disabled = true; bundleBtn.textContent = 'Adding…';
        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
          .then(function(r){return r.json();})
          .then(function(){
            var code = root.getAttribute('data-discount');
            var after = root.getAttribute('data-after-add');
            if(code){ window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=' + (after==='checkout' ? '/checkout' : '/cart'); return; }
            if(after === 'checkout'){ window.location.href = '/checkout'; return; }
            if(after === 'cart'){ window.location.href = '/cart'; return; }
            bundleBtn.textContent = 'Added \u2713'; document.dispatchEvent(new CustomEvent('cart:refresh'));
            setTimeout(function(){ bundleBtn.textContent = label; bundleBtn.disabled = false; },1800);
          })
          .catch(function(){ bundleBtn.textContent = label; bundleBtn.disabled = false; });
      });
    }

    /* Scroll animation */
    if(root.classList.contains('{{ wrap }}--animate') && 'IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('is-visible'); io.unobserve(en.target); } });
      },{threshold:0.12});
      root.querySelectorAll('.{{ wrap }}__card').forEach(function(el,i){ el.style.transitionDelay=(i*70)+'ms'; io.observe(el); });
    }
  })();
</script>

{%- comment -%} ====================== SCHEMA ====================== {%- endcomment -%}
{% schema %}
{
  "name": "Upsell / Bundle",
  "tag": "section",
  "class": "section-upsell-bundle",
  "settings": [
    { "type": "header", "content": "Heading & layout" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Complete your order" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Frequently bought together" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "large",
      "options": [
        { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }, { "value": "xlarge", "label": "Extra large" }
      ]
    },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Add these to get the most out of your purchase.</p>" },
    {
      "type": "select", "id": "content_alignment", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },

    { "type": "header", "content": "Products" },
    {
      "type": "select", "id": "product_source", "label": "Product source", "default": "selected",
      "options": [
        { "value": "selected", "label": "Selected products (blocks below)" },
        { "value": "collection", "label": "From a collection" }
      ]
    },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used when source is set to From a collection." },
    { "type": "range", "id": "products_limit", "label": "Max products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "grid",
      "options": [ { "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Carousel (swipe)" } ]
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "default": "2",
      "options": [ { "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" } ]
    },
    { "type": "checkbox", "id": "include_current_product", "label": "Include this product in the bundle", "info": "Adds the current product as a locked first item. Bundle mode + product pages only.", "default": true },

    { "type": "header", "content": "Card display" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "show_compare", "label": "Show compare-at price", "default": true },
    { "type": "checkbox", "id": "title_links", "label": "Link cards to product pages", "default": true },
    {
      "type": "select", "id": "image_ratio", "label": "Image shape", "default": "square",
      "options": [ { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" } ]
    },

    { "type": "header", "content": "Bundle mode" },
