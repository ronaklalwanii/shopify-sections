{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{{ 'mariana-red--global.js' | asset_url | script_tag }}
{%- comment -%}
  Style cards — photo + title + item list + link ("How to style it").
{%- endcomment -%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }} class="section" style="--section-space: {{ section.settings.padding | default: 72 }}px;">
  <div class="page-width">
    <div class="section-intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2 section-intro__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    <div class="style-cards" style="--style-cols: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <div class="style-card" {{ block.shopify_attributes }}>
          <div class="style-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="style-card__body">
            <h3 class="style-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.items != blank -%}
              <ul class="style-card__list">
                {%- assign items = block.settings.items | split: ',' -%}
                {%- for item in items -%}
                  <li>{{ item | strip }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}" class="text-link">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .style-card__body { flex: 1; }
</style>

{% schema %}
{
  "name": "Style cards",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to style it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Effortless Day Out"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Item list",
          "info": "Separate items with commas.",
          "default": "Linen Skirt, Wide Leg Pants, Leather Sandals"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop the look"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style cards",
      "blocks": [
        {
          "type": "style"
        },
        {
          "type": "style",
          "settings": {
            "title": "City Chic",
            "items": "Blazer, Silk Cami, Tailored Trousers"
          }
        },
        {
          "type": "style",
          "settings": {
            "title": "Evening Elegance",
            "items": "Silk Dress, Heeled Sandals, Clutch Bag"
          }
        }
      ]
    }
  ]
}
{% endschema %}
