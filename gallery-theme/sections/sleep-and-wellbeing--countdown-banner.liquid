{%- comment -%} Section Library: injected global assets for store "sleep-and-wellbeing" {%- endcomment -%}
{{ 'sleep-and-wellbeing--theme.css' | asset_url | stylesheet_tag }}
{{ 'sleep-and-wellbeing--product.css' | asset_url | stylesheet_tag }}
{% render 'sleep-and-wellbeing--css-variables' %}
{% comment %}
  Premium Christmas Countdown Banner
  - Luxury Christmas palette
  - Optional full-width / full-bleed mode
  - Compact / wide / full content distribution
  - Custom gift and snowflake icons
  - Responsive
  - Shopify Theme Editor compatible
{% endcomment %}

{%- liquid
  assign banner_background = section.settings.bg_color

  if section.settings.bg_gradient != blank
    assign banner_background = section.settings.bg_gradient
  endif
-%}

<div
  class="countdown-banner countdown-banner--{{ section.id }}{% if section.settings.full_width_banner %} countdown-banner--full-width{% endif %}"
  data-section-id="{{ section.id }}"
  data-end-date="{{ section.settings.countdown_end_date | escape }}"
  data-content-width="{{ section.settings.content_width_mode }}"
  style="
    --countdown-bg: {{ banner_background }};
    --countdown-text: {{ section.settings.text_color }};
    --countdown-accent: {{ section.settings.accent_color }};
    --countdown-timer: {{ section.settings.timer_color }};
    --countdown-timer-label: {{ section.settings.timer_label_color }};
    --countdown-button-bg: {{ section.settings.button_bg_color }};
    --countdown-button-text: {{ section.settings.button_text_color }};
    --countdown-banner-width: {{ section.settings.banner_width }}px;
    --countdown-radius: {{ section.settings.banner_radius }}px;
    --countdown-border-opacity: {{ section.settings.border_opacity | divided_by: 100.0 }};
    --countdown-shadow-opacity: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
    --countdown-padding-y: {{ section.settings.padding_vertical }}px;
    --countdown-padding-x: {{ section.settings.padding_horizontal }}px;
    --countdown-content-max-width: {{ section.settings.content_max_width }}px;
    --countdown-content-padding: {{ section.settings.content_horizontal_padding }}px;
    --countdown-gap: {{ section.settings.content_gap }}px;
    --countdown-icon-size: {{ section.settings.icon_size }}px;
    --countdown-title-size: {{ section.settings.title_size }}px;
    --countdown-subtitle-size: {{ section.settings.subtitle_size }}px;
    --countdown-badge-size: {{ section.settings.badge_size }}px;
    --countdown-timer-size: {{ section.settings.timer_size }}px;
    --countdown-timer-label-size: {{ section.settings.timer_label_size }}px;
    --countdown-timer-width: {{ section.settings.timer_box_width }}px;
    --countdown-timer-height: {{ section.settings.timer_box_height }}px;
    --countdown-timer-radius: {{ section.settings.timer_radius }}px;
    --countdown-timer-gap: {{ section.settings.timer_gap }}px;
    --countdown-button-radius: {{ section.settings.button_radius }}px;
    --countdown-button-padding-x: {{ section.settings.button_padding_x }}px;
    --countdown-button-padding-y: {{ section.settings.button_padding_y }}px;
  "
>
  <div class="countdown-banner__wrapper countdown-banner__wrapper--{{ section.settings.content_width_mode }}">
    <div class="countdown-banner__inner">

      {% if section.settings.show_gift_icon %}
        <div class="countdown-banner__icon" aria-hidden="true">
          {% if section.settings.icon_source == 'custom' and section.settings.custom_icon != blank %}
            <img
              class="countdown-banner__custom-icon{% if section.settings.custom_icon_tint %} countdown-banner__custom-icon--tinted{% endif %}"
              src="{{ section.settings.custom_icon | image_url: width: 256 }}"
              alt=""
              width="{{ section.settings.icon_size }}"
              height="{{ section.settings.icon_size }}"
              loading="lazy"
            >
          {% elsif section.settings.icon_type == 'present' %}
            <svg class="countdown-banner__gift-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="10" y="24" width="44" height="32" rx="2" stroke="currentColor" stroke-width="2"/>
              <rect x="7" y="17" width="50" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
              <path d="M32 17V56" stroke="currentColor" stroke-width="2"/>
              <path d="M32 17C32 17 26 8 20 8C15 8 13 12 16 16C19 20 32 17 32 17Z" stroke="currentColor" stroke-width="2"/>
              <path d="M32 17C32 17 38 8 44 8C49 8 51 12 48 16C45 20 32 17 32 17Z" stroke="currentColor" stroke-width="2"/>
            </svg>
          {% else %}
            <svg class="countdown-banner__gift-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="24" width="48" height="32" stroke="currentColor" stroke-width="2"/>
              <rect x="28" y="8" width="8" height="48" stroke="currentColor" stroke-width="2"/>
              <path d="M32 8C32 8 28 4 24 4C20 4 16 8 16 12C16 16 20 20 32 20" stroke="currentColor" stroke-width="2"/>
              <path d="M32 8C32 8 36 4 40 4C44 4 48 8 48 12C48 16 44 20 32 20" stroke="currentColor" stroke-width="2"/>
              <path d="M8 28H56" stroke="currentColor" stroke-width="2"/>
            </svg>
          {% endif %}
        </div>
      {% endif %}

      <div class="countdown-banner__content">
        {% if section.settings.show_badge and section.settings.badge_text != blank %}
          <span class="countdown-banner__badge">{{ section.settings.badge_text }}</span>
        {% endif %}

        <p class="countdown-banner__title">
          {{ section.settings.title_text }}
          <span class="countdown-banner__discount">
            {{ section.settings.discount_percentage }}% {{ section.settings.discount_suffix }}
          </span>
        </p>

        {% if section.settings.subtitle_text != blank %}
          <p class="countdown-banner__subtitle">{{ section.settings.subtitle_text }}</p>
        {% endif %}
      </div>

      <div
        class="countdown-banner__timer"
        role="timer"
        aria-label="{{ section.settings.timer_aria_label }}"
      >
        <div class="countdown-banner__timer-unit">
          <span class="countdown-banner__timer-value" data-days>00</span>
          <span class="countdown-banner__timer-label">{{ section.settings.days_label }}</span>
        </div>

        <span class="countdown-banner__timer-separator" aria-hidden="true">:</span>

        <div class="countdown-banner__timer-unit">
          <span class="countdown-banner__timer-value" data-hours>00</span>
          <span class="countdown-banner__timer-label">{{ section.settings.hours_label }}</span>
        </div>

        <span class="countdown-banner__timer-separator" aria-hidden="true">:</span>

        <div class="countdown-banner__timer-unit">
          <span class="countdown-banner__timer-value" data-minutes>00</span>
          <span class="countdown-banner__timer-label">{{ section.settings.minutes_label }}</span>
        </div>

        <span class="countdown-banner__timer-separator" aria-hidden="true">:</span>

        <div class="countdown-banner__timer-unit">
          <span class="countdown-banner__timer-value" data-seconds>00</span>
          <span class="countdown-banner__timer-label">{{ section.settings.seconds_label }}</span>
        </div>
      </div>

      {% if section.settings.show_snowflake %}
        <div class="countdown-banner__snowflake" aria-hidden="true">
          {% if section.settings.snowflake_icon_source == 'custom' and section.settings.custom_snowflake_icon != blank %}
            <img
              class="countdown-banner__custom-snowflake"
              src="{{ section.settings.custom_snowflake_icon | image_url: width: 128 }}"
              alt=""
              width="24"
              height="24"
              loading="lazy"
            >
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2V22M2 12H22M4.93 4.93L19.07 19.07M19.07 4.93L4.93 19.07" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M8 5L12 2L16 5M8 19L12 22L16 19M5 8L2 12L5 16M19 8L22 12L19 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a class="countdown-banner__button" href="{{ section.settings.button_link }}">
          <span>{{ section.settings.button_text }}</span>
          {% if section.settings.show_button_arrow %}
            <svg class="countdown-banner__button-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
        </a>
      {% endif %}

    </div>
  </div>

  <div class="countdown-banner__expired" hidden>
    <p>{{ section.settings.expired_message }}</p>
  </div>
</div>

{% stylesheet %}
  .countdown-banner {
    width: 100%;
    padding-inline: 16px;
    background: transparent;
    color: var(--countdown-text);
    box-sizing: border-box;
  }

  .countdown-banner--full-width {
    width: 100vw;
    max-width: 100vw;
    margin-inline-start: calc(50% - 50vw);
    margin-inline-end: calc(50% - 50vw);
    padding-inline: 0;
  }

  .countdown-banner--full-width .countdown-banner__wrapper {
    width: 100%;
    max-width: none;
    border-radius: 0;
  }

  .countdown-banner__wrapper {
    width: min(100%, var(--countdown-banner-width));
    margin: 0 auto;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgba(243, 237, 226, var(--countdown-border-opacity));
    border-radius: var(--countdown-radius);
    background: var(--countdown-bg);
    box-shadow: 0 8px 28px rgba(17, 20, 22, var(--countdown-shadow-opacity));
  }

  .countdown-banner__wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .countdown-banner__wrapper {
    position: relative;
  }

  .countdown-banner__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: var(--countdown-gap);
    width: 100%;
    padding: var(--countdown-padding-y) var(--countdown-padding-x);
    box-sizing: border-box;
  }

  .countdown-banner__wrapper--compact .countdown-banner__inner {
    grid-template-columns: auto auto auto auto auto;
    justify-content: center;
  }

  .countdown-banner__wrapper--full .countdown-banner__inner {
    grid-template-columns: auto minmax(0, 1fr) auto auto auto;
  }

  .countdown-banner__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--countdown-icon-size);
    height: var(--countdown-icon-size);
    flex: 0 0 auto;
    color: var(--countdown-accent);
  }

  .countdown-banner__gift-icon,
  .countdown-banner__custom-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: var(--countdown-accent);
    transition: transform 240ms ease;
  }

  .countdown-banner__custom-icon--tinted {
    filter: brightness(0) saturate(100%) invert(69%) sepia(16%) saturate(654%) hue-rotate(7deg) brightness(90%) contrast(89%);
  }

  .countdown-banner__icon:hover .countdown-banner__gift-icon,
  .countdown-banner__icon:hover .countdown-banner__custom-icon {
    transform: translateY(-2px);
  }

  .countdown-banner__content {
    min-width: 0;
    max-width: var(--countdown-content-max-width);
    padding-inline: var(--countdown-content-padding);
  }

  .countdown-banner__wrapper--full .countdown-banner__content {
    max-width: none;
  }

  .countdown-banner__wrapper--compact .countdown-banner__content {
    flex: 0 1 auto;
    max-width: 440px;
  }

  .countdown-banner__badge {
    display: block;
    margin: 0 0 2px;
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--countdown-badge-size);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--countdown-text);
    opacity: 0.88;
  }

  .countdown-banner__title {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: var(--countdown-title-size);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--countdown-text);
    white-space: nowrap;
  }

  .countdown-banner__discount {
    color: var(--countdown-accent);
  }

  .countdown-banner__subtitle {
    margin: 3px 0 0;
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--countdown-subtitle-size);
    font-weight: 400;
    line-height: 1.25;
    color: var(--countdown-text);
    opacity: 0.92;
  }

  .countdown-banner__timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--countdown-timer-gap);
    flex-shrink: 0;
  }

  .countdown-banner__timer-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: var(--countdown-timer-width);
    min-height: var(--countdown-timer-height);
    padding: 5px 4px;
    box-sizing: border-box;
    border: 1px solid rgba(243, 237, 226, 0.24);
    border-radius: var(--countdown-timer-radius);
    background: rgba(243, 237, 226, 0.06);
  }

  .countdown-banner__timer-value {
    display: block;
    color: var(--countdown-timer);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: var(--countdown-timer-size);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .countdown-banner__timer-label {
    display: block;
    margin-top: 3px;
    color: var(--countdown-timer-label);
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--countdown-timer-label-size);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.88;
  }

  .countdown-banner__timer-separator {
    color: var(--countdown-accent);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 20px;
    line-height: 1;
    opacity: 0.72;
  }

  .countdown-banner__snowflake {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 32px;
    flex: 0 0 auto;
    color: var(--countdown-accent);
  }

  .countdown-banner__snowflake svg,
  .countdown-banner__custom-snowflake {
    display: block;
    width: 23px;
    height: 23px;
    object-fit: contain;
    transition: transform 240ms ease;
  }

  .countdown-banner__snowflake:hover svg,
  .countdown-banner__snowflake:hover .countdown-banner__custom-snowflake {
    transform: rotate(15deg);
  }

  .countdown-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 42px;
    padding: var(--countdown-button-padding-y) var(--countdown-button-padding-x);
    box-sizing: border-box;
    border: 1px solid rgba(17, 26, 22, 0.08);
    border-radius: var(--countdown-button-radius);
    background: var(--countdown-button-bg);
    color: var(--countdown-button-text);
    font-family: var(--font-body-family, sans-serif);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .countdown-banner__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 16px rgba(17, 26, 22, 0.14);
  }

  .countdown-banner__button:active {
    transform: translateY(0);
  }

  .countdown-banner__button:focus-visible {
    outline: 2px solid var(--countdown-accent);
    outline-offset: 3px;
  }

  .countdown-banner__button-arrow {
    transition: transform 220ms ease;
  }

  .countdown-banner__button:hover .countdown-banner__button-arrow {
    transform: translateX(3px);
  }

  .countdown-banner__expired {
    padding: 14px var(--countdown-padding-x);
    text-align: center;
    color: var(--countdown-text);
  }

  .countdown-banner__expired p {
    margin: 0;
    font-family: var(--font-body-family, sans-serif);
    font-size: 13px;
  }

  @media screen and (max-width: 1180px) {
    .countdown-banner__inner {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
    }

    .countdown-banner__snowflake {
      display: none;
    }

    .countdown-banner__title {
      font-size: 21px;
    }
  }

  @media screen and (max-width: 900px) {
    .countdown-banner__inner,
    .countdown-banner__wrapper--full .countdown-banner__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .countdown-banner__button {
      grid-column: 2 / -1;
      justify-self: end;
    }

    .countdown-banner__content {
      padding-inline: 0;
    }
  }

  @media screen and (max-width: 700px) {
    .countdown-banner {
      padding-inline: 10px;
    }

    .countdown-banner--full-width {
      padding-inline: 0;
    }

    .countdown-banner__wrapper,
    .countdown-banner__wrapper--full,
    .countdown-banner__wrapper--compact {
      width: 100%;
      border-radius: var(--countdown-radius);
    }

    .countdown-banner--full-width .countdown-banner__wrapper {
      border-radius: 0;
    }

    .countdown-banner__inner,
    .countdown-banner__wrapper--full .countdown-banner__inner,
    .countdown-banner__wrapper--compact .countdown-banner__inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 10px 12px;
      padding: 16px;
    }

    .countdown-banner__content,
    .countdown-banner__wrapper--compact .countdown-banner__content {
      max-width: none;
      padding-inline: 0;
    }

    .countdown-banner__title {
      font-size: 20px;
      white-space: normal;
    }

    .countdown-banner__subtitle {
      font-size: 12px;
    }

    .countdown-banner__badge {
      font-size: 9px;
    }

    .countdown-banner__timer {
      grid-column: 1 / -1;
      width: 100%;
      justify-content: center;
    }

    .countdown-banner__button {
      grid-column: 1 / -1;
      width: 100%;
    }
  }

  @media screen and (max-width: 420px) {
    .countdown-banner__icon {
      width: 42px;
      height: 42px;
    }

    .countdown-banner__timer {
      gap: 4px;
    }

    .countdown-banner__timer-unit {
      width: 48px;
      min-height: 46px;
    }

    .countdown-banner__timer-value {
      font-size: 18px;
    }

    .countdown-banner__timer-label {
      font-size: 7px;
    }

    .countdown-banner__timer-separator {
      font-size: 15px;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .countdown-banner * {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const instances = new WeakMap();

    class CountdownBanner {
      constructor(container) {
        this.container = container;
        this.endDate = container.dataset.endDate;
        this.timer = container.querySelector('.countdown-banner__timer');
        this.expired = container.querySelector('.countdown-banner__expired');
        this.days = container.querySelector('[data-days]');
        this.hours = container.querySelector('[data-hours]');
        this.minutes = container.querySelector('[data-minutes]');
        this.seconds = container.querySelector('[data-seconds]');
        this.interval = null;

        if (!this.endDate) return;

        this.update();
        this.interval = window.setInterval(() => this.update(), 1000);
      }

      update() {
        const end = new Date(this.endDate).getTime();

        if (!Number.isFinite(end)) {
          this.stop();
          return;
        }

        const distance = end - Date.now();

        if (distance <= 0) {
          this.showExpired();
          return;
        }

        const days = Math.floor(distance / 86400000);
        const hours = Math.floor((distance % 86400000) / 3600000);
        const minutes = Math.floor((distance % 3600000) / 60000);
        const seconds = Math.floor((distance % 60000) / 1000);

        if (this.days) this.days.textContent = String(days).padStart(2, '0');
        if (this.hours) this.hours.textContent = String(hours).padStart(2, '0');
        if (this.minutes) this.minutes.textContent = String(minutes).padStart(2, '0');
        if (this.seconds) this.seconds.textContent = String(seconds).padStart(2, '0');
      }

      showExpired() {
        this.stop();
        if (this.timer) this.timer.hidden = true;
        if (this.expired) this.expired.hidden = false;
      }

      stop() {
        if (this.interval) {
          window.clearInterval(this.interval);
          this.interval = null;
        }
      }

      destroy() {
        this.stop();
      }
    }

    function init(root) {
      if (!root) return;
      if (instances.has(root)) return;
      instances.set(root, new CountdownBanner(root));
    }

    function destroy(root) {
      if (!root) return;
      const instance = instances.get(root);
      if (!instance) return;
      instance.destroy();
      instances.delete(root);
    }

    document.querySelectorAll('.countdown-banner[data-section-id]').forEach(init);

    document.addEventListener('shopify:section:load', (event) => {
      init(event.target.querySelector('.countdown-banner[data-section-id]'));
    });

    document.addEventListener('shopify:section:unload', (event) => {
      destroy(event.target.querySelector('.countdown-banner[data-section-id]'));
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Countdown Banner",
  "tag": "section",
  "class": "countdown-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Banner appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#6B1F2A"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(135deg, #6B1F2A 0%, #5A1923 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F3EDE2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#B59A62"
    },
    {
      "type": "color",
      "id": "timer_color",
      "label": "Timer number color",
      "default": "#F3EDE2"
    },
    {
      "type": "color",
      "id": "timer_label_color",
