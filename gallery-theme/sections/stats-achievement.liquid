{%- comment -%} Section Library: injected global assets for store "base" {%- endcomment -%}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'product.css' | asset_url | stylesheet_tag }}
{% render 'fonts' %}
{% render 'js-variables' %}
{% render 'css-variables' %}
{{ 'theme.js' | asset_url | script_tag }}
{{ 'sections.js' | asset_url | script_tag }}
{{ 'sleek-hero-editor.js' | asset_url | script_tag }}
{%- comment -%}
  Section: Stats & Achievements (Masonry)
  5-col layout with center images, or auto-collapsed 4-col when no center images.
  Edge images | stat cards | (center images) | stat cards | edge images.
{%- endcomment -%}

{%- assign has_center = false -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'center_image' -%}{%- assign has_center = true -%}{%- endif -%}
{%- endfor -%}

<section id="StatsMasonry-{{ section.id }}" class="sm{% unless has_center %} sm--four{% endunless %}">
  {%- style -%}
    /* Override theme's default section spacing */
    #shopify-section-{{ section.id }} {
      padding: 0 !important;
      margin: 0 !important;
    }

    #StatsMasonry-{{ section.id }} {
      --sm-bg: {{ section.settings.background_color }};
      --sm-card-bg: {{ section.settings.card_background }};
      --sm-card-border-w: {{ section.settings.card_border_width }}px;
      --sm-card-border: {{ section.settings.card_border_color }};
      --sm-head-color: {{ section.settings.heading_color }};
      --sm-sub-color: {{ section.settings.subheading_color }};
      --sm-desc-color: {{ section.settings.description_color }};
      --sm-accent: {{ section.settings.accent_color }};
      --sm-gap: {{ section.settings.grid_gap }}px;
      --sm-radius: {{ section.settings.border_radius }}px;
      --sm-img-radius: {{ section.settings.image_radius }}px;
      --sm-row-h: {{ section.settings.row_min_height }}px;
      --sm-max-width: {{ section.settings.max_width }}px;
      --sm-space-top: {{ section.settings.space_top }}px;
      --sm-space-bottom: {{ section.settings.space_bottom }}px;
      --sm-gutter: {{ section.settings.mobile_gutter }}px;
      --sm-head-size: {{ section.settings.heading_size }}px;
      --sm-head-weight: {{ section.settings.heading_weight }};
      --sm-head-spacing: {{ section.settings.heading_spacing }}px;
      --sm-sub-size: {{ section.settings.subheading_size }}px;
      --sm-header-mb: {{ section.settings.header_margin_bottom }}px;
      --sm-card-pad: {{ section.settings.card_padding }}px;
      --sm-number-size: {{ section.settings.number_size }}px;
      --sm-number-weight: {{ section.settings.number_weight }};
      --sm-title-size: {{ section.settings.title_size }}px;
      --sm-title-weight: {{ section.settings.title_weight }};
      --sm-desc-size: {{ section.settings.desc_size }}px;
      --sm-icon-size: {{ section.settings.icon_size }}px;
      --sm-shadow-a: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
      --sm-lift: {{ section.settings.hover_lift }}px;
      --sm-dur: {{ section.settings.animation_duration }}ms;
      --sm-ease: cubic-bezier(.22, 1, .36, 1);
      --sm-img-pos: {{ section.settings.image_position }};
      --sm-mobile-edge: {{ section.settings.mobile_edge_height }}px;
      --sm-mobile-head: {{ section.settings.mobile_heading_size }}px;
    }

    #StatsMasonry-{{ section.id }} {
      background: var(--sm-bg);
      padding: var(--sm-space-top) var(--sm-gutter) var(--sm-space-bottom);
      overflow-x: clip;
    }

    #StatsMasonry-{{ section.id }} .sm__shell {
      width: min(100%, var(--sm-max-width));
      margin: 0 auto;
      min-width: 0;
    }

    /* Header */
    #StatsMasonry-{{ section.id }} .sm__header {
      text-align: center;
      margin-bottom: var(--sm-header-mb);
    }
    #StatsMasonry-{{ section.id }} .sm__heading {
      margin: 0 0 12px;
      color: var(--sm-head-color);
      font-size: var(--sm-head-size);
      font-weight: var(--sm-head-weight);
      letter-spacing: var(--sm-head-spacing);
      line-height: 1.15;
    }
    #StatsMasonry-{{ section.id }} .sm__subheading {
      margin: 0;
      color: var(--sm-sub-color);
      font-size: var(--sm-sub-size);
      line-height: 1.5;
    }

    /* Grid + deterministic placement */
    #StatsMasonry-{{ section.id }} .sm__grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(var(--sm-row-h), auto));
      gap: var(--sm-gap);
      align-items: stretch;
      min-width: 0;
    }
    #StatsMasonry-{{ section.id }} .sm-edge-l { grid-column: 1; grid-row: 1 / span 2; }
    #StatsMasonry-{{ section.id }} .sm-edge-r { grid-column: 5; grid-row: 1 / span 2; }
    #StatsMasonry-{{ section.id }} .sm-s1 { grid-column: 2; grid-row: 1; }
    #StatsMasonry-{{ section.id }} .sm-s2 { grid-column: 4; grid-row: 1; }
    #StatsMasonry-{{ section.id }} .sm-s3 { grid-column: 2; grid-row: 2; }
    #StatsMasonry-{{ section.id }} .sm-s4 { grid-column: 4; grid-row: 2; }
    #StatsMasonry-{{ section.id }} .sm-i1 { grid-column: 3; grid-row: 1; }
    #StatsMasonry-{{ section.id }} .sm-i2 { grid-column: 3; grid-row: 2; }

    /* No center images uploaded: collapse to 4 columns so cards fill the space */
    #StatsMasonry-{{ section.id }}.sm--four .sm__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    #StatsMasonry-{{ section.id }}.sm--four .sm-edge-r { grid-column: 4; }
    #StatsMasonry-{{ section.id }}.sm--four .sm-s2 { grid-column: 3; }
    #StatsMasonry-{{ section.id }}.sm--four .sm-s4 { grid-column: 3; }

    /* Images (edge + center) */
    #StatsMasonry-{{ section.id }} .sm__media {
      position: relative;
      overflow: hidden;
      border-radius: var(--sm-img-radius);
      min-width: 0;
    }
    #StatsMasonry-{{ section.id }} .sm__media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--sm-img-pos);
      display: block;
    }
    #StatsMasonry-{{ section.id }} .sm__placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #E8E4DF;
      color: #999;
      font-size: 13px;
    }

    /* Stat cards */
    #StatsMasonry-{{ section.id }} .sm__card {
      min-width: 0;
      display: flex;
    }
    #StatsMasonry-{{ section.id }} .sm__card-inner {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: var(--sm-card-pad);
      background: var(--sm-card-bg);
      border: var(--sm-card-border-w) solid var(--sm-card-border);
      border-radius: var(--sm-radius);
      box-shadow: 0 4px 24px rgba(28, 24, 20, var(--sm-shadow-a));
      transition: transform 350ms var(--sm-ease), box-shadow 350ms var(--sm-ease);
    }
    {%- if section.settings.enable_hover %}
      #StatsMasonry-{{ section.id }} .sm__card-inner:hover {
        transform: translateY(calc(var(--sm-lift) * -1));
        box-shadow: 0 14px 40px rgba(28, 24, 20, calc(var(--sm-shadow-a) * 2));
      }
    {%- endif %}

    #StatsMasonry-{{ section.id }} .sm__icon {
      width: var(--sm-icon-size);
      height: var(--sm-icon-size);
      margin-bottom: 16px;
      color: var(--sm-accent);
    }
    #StatsMasonry-{{ section.id }} .sm__icon svg {
      width: 100%;
      height: 100%;
    }

    #StatsMasonry-{{ section.id }} .sm__number {
      color: var(--sm-head-color);
      font-size: var(--sm-number-size);
      font-weight: var(--sm-number-weight);
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }
    #StatsMasonry-{{ section.id }} .sm__title {
      margin: 0 0 10px;
      color: var(--sm-head-color);
      font-size: var(--sm-title-size);
      font-weight: var(--sm-title-weight);
      line-height: 1.3;
    }
    #StatsMasonry-{{ section.id }} .sm__desc {
      margin: 0;
      color: var(--sm-desc-color);
      font-size: var(--sm-desc-size);
      line-height: 1.6;
    }

    /* Entrance animation */
    #StatsMasonry-{{ section.id }} .sm__item {
      transition: opacity var(--sm-dur) ease, transform var(--sm-dur) var(--sm-ease);
      transition-delay: calc(var(--i, 0) * 80ms);
    }
    #StatsMasonry-{{ section.id }}.sm-animated:not(.is-in-view) .sm__item {
      opacity: 0;
      transform: translateY(26px);
    }

    /* Tablet */
    @media screen and (max-width: 1100px) {
      #StatsMasonry-{{ section.id }} .sm__grid,
      #StatsMasonry-{{ section.id }}.sm--four .sm__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: auto;
      }
      #StatsMasonry-{{ section.id }} .sm__grid > * {
        grid-column: auto !important;
        grid-row: auto !important;
      }
      #StatsMasonry-{{ section.id }} .sm-edge-l,
      #StatsMasonry-{{ section.id }} .sm-edge-r {
        grid-column: 1 / -1 !important;
        min-height: var(--sm-mobile-edge);
      }
      #StatsMasonry-{{ section.id }} .sm__media {
        min-height: var(--sm-mobile-edge);
      }
    }

    /* Mobile */
    @media screen and (max-width: 640px) {
      #StatsMasonry-{{ section.id }} .sm__grid,
      #StatsMasonry-{{ section.id }}.sm--four .sm__grid {
        grid-template-columns: 1fr;
      }
      #StatsMasonry-{{ section.id }} .sm__heading {
        font-size: var(--sm-mobile-head);
      }
      #StatsMasonry-{{ section.id }} .sm-edge-l,
      #StatsMasonry-{{ section.id }} .sm-edge-r,
      #StatsMasonry-{{ section.id }} .sm__media {
        min-height: calc(var(--sm-mobile-edge) * 0.85);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #StatsMasonry-{{ section.id }} .sm__item,
      #StatsMasonry-{{ section.id }} .sm__card-inner {
        transition: none;
      }
      #StatsMasonry-{{ section.id }}.sm-animated:not(.is-in-view) .sm__item {
        opacity: 1;
        transform: none;
      }
    }
  {%- endstyle -%}

  <div class="sm__shell">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="sm__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="sm__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="sm__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sm__grid">
      {%- assign stat_i = 0 -%}
      {%- assign img_i = 0 -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'edge_image_left' -%}
            {%- assign pos_class = 'sm-edge-l' -%}
          {%- when 'edge_image_right' -%}
            {%- assign pos_class = 'sm-edge-r' -%}
          {%- when 'center_image' -%}
            {%- if img_i == 0 -%}
              {%- assign pos_class = 'sm-i1' -%}
            {%- else -%}
              {%- assign pos_class = 'sm-i2' -%}
            {%- endif -%}
            {%- assign img_i = img_i | plus: 1 -%}
          {%- when 'stat_card' -%}
            {%- assign mod = stat_i | modulo: 4 -%}
            {%- if mod == 0 -%}
              {%- assign pos_class = 'sm-s1' -%}
            {%- elsif mod == 1 -%}
              {%- assign pos_class = 'sm-s2' -%}
            {%- elsif mod == 2 -%}
              {%- assign pos_class = 'sm-s3' -%}
            {%- else -%}
              {%- assign pos_class = 'sm-s4' -%}
            {%- endif -%}
            {%- assign stat_i = stat_i | plus: 1 -%}
        {%- endcase -%}

        {%- if block.type == 'stat_card' -%}
          <div class="sm__item sm__card {{ pos_class }}" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="sm__card-inner">
              {%- if block.settings.icon != 'none' -%}
                <div class="sm__icon" style="color: {{ block.settings.icon_color }};">
                  {%- case block.settings.icon -%}
                    {%- when 'user' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    {%- when 'briefcase' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {%- when 'award' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                    {%- when 'box' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z"></path></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                  {%- endcase -%}
                </div>
              {%- endif -%}

              {%- if block.settings.stat_number != blank -%}
                <div class="sm__number" style="color: {{ block.settings.number_color }};">{{ block.settings.stat_number }}</div>
              {%- endif -%}

              {%- if block.settings.stat_title != blank -%}
                <h3 class="sm__title" style="color: {{ block.settings.title_color }};">{{ block.settings.stat_title }}</h3>
              {%- endif -%}

              {%- if block.settings.stat_description != blank -%}
                <p class="sm__desc" style="color: {{ block.settings.description_color }};">{{ block.settings.stat_description }}</p>
              {%- endif -%}
            </div>
          </div>

        {%- else -%}
          <div class="sm__item sm__media {{ pos_class }}" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.image.alt | default: 'Gallery image' | escape }}"
                loading="lazy"
                width="900"
                height="1200"
              >
            {%- else -%}
              <div class="sm__placeholder">Upload image</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.enable_animation -%}
    <script>
      (() => {
        const root = document.getElementById('StatsMasonry-{{ section.id }}');
        if (!root) return;
        root.classList.add('sm-animated');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('is-in-view');
          return;
        }
        if (!('IntersectionObserver' in window)) {
          root.classList.add('is-in-view');
          return;
        }
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              root.classList.add('is-in-view');
              o.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        obs.observe(root);
      })();
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Stats & Achievements",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 900, "max": 1800, "step": 20, "default": 1400, "unit": "px" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 160, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 160, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "mobile_gutter", "label": "Side gutters", "min": 0, "max": 60, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "row_min_height", "label": "Row min height", "min": 180, "max": 420, "step": 10, "default": 250, "unit": "px" },
    { "type": "range", "id": "border_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "default": 14, "unit": "px" },
    { "type": "range", "id": "image_radius", "label": "Image radius", "min": 0, "max": 32, "step": 2, "default": 14, "unit": "px" },
    { "type": "select", "id": "image_position", "label": "Image focal point", "default": "center", "options": [
      { "value": "left center", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right center", "label": "Right" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" }
    ] },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Us" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "default": 40, "unit": "px" },
    { "type": "range", "id": "heading_weight", "label": "Heading weight", "min": 100, "max": 900, "step": 100, "default": 700 },
    { "type": "range", "id": "heading_spacing", "label": "Heading letter spacing", "min": 0, "max": 6, "step": 0.5, "default": 0, "unit": "px" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#2C2420" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover what makes us different" },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 12, "max": 24, "step": 1, "default": 17, "unit": "px" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6B5B4F" },
    { "type": "range", "id": "header_margin_bottom", "label": "Header bottom spacing", "min": 20, "max": 120, "step": 4, "default": 60, "unit": "px" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAF8F5" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 0, "max": 3, "step": 1, "default": 1, "unit": "px" },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#EEE9E4" },
    { "type": "color", "id": "accent_color", "label": "Default icon color", "default": "#8B7355" },
    { "type": "color", "id": "description_color", "label": "Default description color", "default": "#6B5B4F" },

    { "type": "header", "content": "Card typography" },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 12, "max": 56, "step": 2, "default": 28, "unit": "px" },
    { "type": "range", "id": "number_size", "label": "Number size", "min": 24, "max": 72, "step": 2, "default": 40, "unit": "px" },
    { "type": "range", "id": "number_weight", "label": "Number weight", "min": 100, "max": 900, "step": 100, "default": 700 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 12, "max": 28, "step": 1, "default": 17, "unit": "px" },
    { "type": "range", "id": "title_weight", "label": "Title weight", "min": 100, "max": 900, "step": 100, "default": 600 },
    { "type": "range", "id": "desc_size", "label": "Description size", "min": 11, "max": 20, "step": 1, "default": 14, "unit": "px" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 64, "step": 2, "default": 34, "unit": "px" },

    { "type": "header", "content": "Effects" },
    { "type": "range", "id": "shadow_opacity", "label": "Card shadow strength", "min": 0, "max": 40, "step": 2, "default": 8, "unit": "%" },
    { "type": "checkbox", "id": "enable_hover", "label": "Enable hover lift", "default": true },
    { "type": "range", "id": "hover_lift", "label": "Hover lift", "min": 0, "max": 12, "step": 1, "default": 6, "unit": "px" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable entrance animation", "default": true },
    { "type": "range", "id": "animation_duration", "label": "Animation duration", "min": 250, "max": 1200, "step": 50, "default": 700, "unit": "ms" },

    { "type": "header", "content": "Mobile" },
    { "type": "range", "id": "mobile_edge_height", "label": "Mobile image height", "min": 160, "max": 420, "step": 10, "default": 260, "unit": "px" },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 44, "step": 2, "default": 30, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "edge_image_left",
      "name": "Edge Image (Left)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
