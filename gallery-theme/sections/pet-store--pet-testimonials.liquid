  ],
  "presets": [
    {
      "name": "Pet Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Excellent service, friendly staff, and outstanding veterinary care. They treat every pet like family, and it shows in everything they do.",
            "name": "Hanna D.",
            "role": "Mother of Cats"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The best pet store in the city. Healthy animals, quality food, and a team that genuinely cares about every wagging tail that walks in.",
            "name": "Marcus T.",
            "role": "Dog Dad of Two"
          }
        }
      ]
    }
  ]
}
{% endschema %}
