{%- comment -%} Section Library: injected global assets for store "sleep-and-wellbeing" {%- endcomment -%}
{{ 'sleep-and-wellbeing--theme.css' | asset_url | stylesheet_tag }}
{{ 'sleep-and-wellbeing--product.css' | asset_url | stylesheet_tag }}
{% render 'sleep-and-wellbeing--css-variables' %}
{%- liquid
  assign s = section.settings
  assign legal_count = section.blocks | where: 'type', 'legal_link' | size
  assign social_count = section.blocks | where: 'type', 'social_icon' | size
  assign nav_count = section.blocks | where: 'type', 'nav_column' | size
-%}

<style>
  {{ s.font_body | font_face: font_display: 'swap' }}
</style>
<style>
  {{ s.font_display | font_face: font_display: 'swap' }}
</style>

<style>
  /* ===========================================================
     EQ Footer — per-instance design tokens (from section schema)
     =========================================================== */
  .eqf--{{ section.id }} {
    --eqf-bg: {{ s.background_color }};
    --eqf-text: {{ s.text_color }};
    --eqf-muted: {{ s.text_secondary_color }};
    --eqf-accent: {{ s.accent_color }};
    --eqf-divider: {{ s.divider_color }};
    --eqf-max-w: {{ s.max_width }}px;
    --eqf-pad-top: {{ s.padding_top }}px;
    --eqf-pad-bottom: {{ s.padding_bottom }}px;
    --eqf-col-gap: {{ s.column_gap }}px;
    --eqf-cta-w: {{ s.cta_width }}%;
    --eqf-cta-pad: {{ s.cta_padding }}px;

    --eqf-btn-c: {{ s.cta_button_text_color }};
    --eqf-btn-bc: {{ s.cta_button_border_color }};
    {% if s.cta_button_transparent %}
    --eqf-btn-bg: transparent;
    {% else %}
    --eqf-btn-bg: {{ s.cta_button_bg }};
    {% endif %}
    --eqf-btn-hbg: {{ s.cta_button_hover_bg }};
    --eqf-btn-ht: {{ s.cta_button_hover_text }};
    --eqf-btn-fs: {{ s.cta_button_font_size }}px;
    --eqf-btn-py: {{ s.cta_button_pad_y }}px;
    --eqf-btn-px: {{ s.cta_button_pad_x }}px;
    --eqf-btn-radius: {{ s.cta_button_radius }}px;
    --eqf-btn-tracking: {{ s.cta_button_tracking | divided_by: 100.0 }}em;

    --eqf-logo-w: {{ s.logo_width }}px;
    --eqf-logo-max: {{ s.logo_max_width }}px;
  }

  /* ===========================================================
     Base
     =========================================================== */
  .eqf--{{ section.id }} {
    background: var(--eqf-bg);
    color: var(--eqf-text);
    font-family: {{ s.font_body.family }}, {{ s.font_body.fallback_families }};
    font-weight: 400;
    padding-top: var(--eqf-pad-top);
    padding-bottom: var(--eqf-pad-bottom);
    -webkit-font-smoothing: antialiased;
  }

  .eqf--{{ section.id }} *,
  .eqf--{{ section.id }} *::before,
  .eqf--{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .eqf--{{ section.id }} .eqf__inner {
    max-width: var(--eqf-max-w);
    margin-inline: auto;
    padding-inline: clamp(24px, 4vw, 64px);
  }

  .eqf--{{ section.id }} a {
    color: inherit;
  }

  .eqf--{{ section.id }} a:focus-visible,
  .eqf--{{ section.id }} button:focus-visible {
    outline: 1px solid var(--eqf-accent);
    outline-offset: 3px;
    border-radius: 1px;
  }

  /* ===========================================================
     Top row: navigation columns + expert CTA
     =========================================================== */
  .eqf--{{ section.id }} .eqf__top {
    display: flex;
    align-items: stretch;
    gap: var(--eqf-col-gap);
  }

  .eqf--{{ section.id }} .eqf__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 40px var(--eqf-col-gap);
    flex: 1 1 auto;
    align-content: flex-start;
    min-width: 0;
  }

  .eqf--{{ section.id }} .eqf__col {
    flex: 1 1 160px;
    min-width: 140px;
    max-width: 320px;
  }

  .eqf--{{ section.id }} .eqf__col-heading {
    margin: 0;
    font-family: {{ s.font_display.family }}, {{ s.font_display.fallback_families }};
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .eqf--{{ section.id }} .eqf__col-heading--tick::after {
    content: '';
    display: block;
    width: 44px;
    height: 1px;
    margin-top: 14px;
    background: currentColor;
    opacity: 0.9;
  }

  .eqf--{{ section.id }} .eqf__col--center {
    text-align: center;
  }

  .eqf--{{ section.id }} .eqf__col--center .eqf__col-heading--tick::after {
    margin-inline: auto;
  }

  .eqf--{{ section.id }} .eqf__col--right {
    text-align: right;
  }

  .eqf--{{ section.id }} .eqf__col--right .eqf__col-heading--tick::after {
    margin-left: auto;
  }

  .eqf--{{ section.id }} .eqf__col-links {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eqf--{{ section.id }} .eqf__col-links a {
    font-size: 16px;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: break-word;
    transition: color 0.3s ease;
  }

  .eqf--{{ section.id }} .eqf__col-links a:hover {
    color: var(--eqf-accent);
  }

  /* ---------- Column accordion toggle (inactive on desktop) ---------- */
.eqf--{{ section.id }} .eqf__col-toggle {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
  cursor: default;
  -webkit-tap-highlight-color: transparent;
}

.eqf--{{ section.id }} .eqf__col--center .eqf__col-toggle { justify-content: center; }
.eqf--{{ section.id }} .eqf__col--right .eqf__col-toggle { justify-content: flex-end; }

.eqf--{{ section.id }} .eqf__col-chevron {
  display: none;
  flex-shrink: 0;
  transition: transform 0.35s ease;
}

.eqf--{{ section.id }} .eqf__col.is-open .eqf__col-chevron {
  transform: rotate(180deg);
}

/* desktop: wrapper is invisible in the layout, links render exactly as before */
.eqf--{{ section.id }} .eqf__col-collapse {
  display: contents;
}

  /* ---------- Expert CTA panel ---------- */
  .eqf--{{ section.id }} .eqf__cta {
    flex: 0 0 var(--eqf-cta-w);
    min-width: 0;
    border-left: 1px solid var(--eqf-divider);
    padding-left: var(--eqf-cta-pad);
  }

  {% unless s.cta_divider %}
  .eqf--{{ section.id }} .eqf__cta {
    border-left: 0;
    padding-left: 0;
  }
  {% endunless %}

  .eqf--{{ section.id }} .eqf__cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .eqf--{{ section.id }} .eqf__cta--center .eqf__cta-inner {
    align-items: center;
    text-align: center;
  }

  .eqf--{{ section.id }} .eqf__cta--right .eqf__cta-inner {
    align-items: flex-end;
    text-align: right;
  }

  .eqf--{{ section.id }} .eqf__cta-icon {
    width: var(--eqf-icon-w, 56px);
    height: auto;
    display: block;
    margin-bottom: 22px;
  }

  .eqf--{{ section.id }} .eqf__cta-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eqf--{{ section.id }} .eqf__cta-head--inline {
    flex-direction: row;
    align-items: center;
  }

  .eqf--{{ section.id }} .eqf__cta-head--inline .eqf__cta-icon {
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .eqf--{{ section.id }} .eqf__cta-heading {
    margin: 0;
    font-family: {{ s.font_display.family }}, {{ s.font_display.fallback_families }};
    font-weight: {{ s.cta_heading_weight }};
    line-height: 1.25;
    letter-spacing: 0.05em;
  }

  {% if s.cta_heading_uppercase %}
  .eqf--{{ section.id }} .eqf__cta-heading {
    text-transform: uppercase;
  }
  {% endif %}

  .eqf--{{ section.id }} .eqf__cta-body {
    margin: 18px 0 0;
    line-height: 1.6;
    font-weight: 400;
  }

  .eqf--{{ section.id }} .eqf__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
    padding: var(--eqf-btn-py) var(--eqf-btn-px);
    background: var(--eqf-btn-bg);
    border: 1px solid var(--eqf-btn-bc);
    border-radius: var(--eqf-btn-radius);
    color: var(--eqf-btn-c);
    font-family: inherit;
    font-size: var(--eqf-btn-fs);
    letter-spacing: var(--eqf-btn-tracking);
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease;
  }

  .eqf--{{ section.id }} .eqf__cta-btn:hover {
    background: var(--eqf-btn-hbg);
    border-color: var(--eqf-btn-hbg);
    color: var(--eqf-btn-ht);
  }

  .eqf--{{ section.id }} .eqf__cta-btn .eqf__arrow {
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .eqf--{{ section.id }} .eqf__cta-btn:hover .eqf__arrow {
    transform: translateX(4px);
  }

  /* ===========================================================
     Lower footer: brand / legal / social
     =========================================================== */
  .eqf--{{ section.id }} .eqf__lower {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-top: clamp(48px, 6vw, 88px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--eqf-divider);
  }

  .eqf--{{ section.id }} .eqf__brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .eqf--{{ section.id }} .eqf__brand--center {
    align-items: center;
    text-align: center;
  }

  .eqf--{{ section.id }} .eqf__brand--right {
    align-items: flex-end;
    text-align: right;
  }

  .eqf--{{ section.id }} .eqf__logo {
    display: block;
    width: var(--eqf-logo-w);
    max-width: var(--eqf-logo-max);
    height: auto;
  }

  .eqf--{{ section.id }} .eqf__copyright {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--eqf-muted);
  }

  .eqf--{{ section.id }} .eqf__legal ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .eqf--{{ section.id }} .eqf__legal li {
    display: flex;
    align-items: center;
  }

  .eqf--{{ section.id }} .eqf__legal li + li::before {
    content: '';
    width: 1px;
    height: 16px;
    background: var(--eqf-divider);
    margin-inline: 22px;
    flex-shrink: 0;
  }

  .eqf--{{ section.id }} .eqf__legal a {
    font-size: 15px;
    text-decoration: none;
    color: var(--eqf-text);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .eqf--{{ section.id }} .eqf__legal a:hover {
    color: var(--eqf-accent);
  }

  .eqf--{{ section.id }} .eqf__social ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .eqf--{{ section.id }} .eqf__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  /* recolored glyph: the uploaded icon is used as a CSS mask so the
     icon-color and hover-color settings can tint it */
  .eqf--{{ section.id }} .eqf__social-glyph {
    display: block;
    width: var(--soc-size, 22px);
    height: var(--soc-size, 22px);
    background: var(--soc-color, var(--eqf-accent));
    transition: background-color 0.3s ease;
    -webkit-mask: var(--soc-mask) center / contain no-repeat;
    mask: var(--soc-mask) center / contain no-repeat;
  }

  .eqf--{{ section.id }} .eqf__social-link:hover .eqf__social-glyph {
    background: var(--soc-hover, var(--eqf-text));
  }

  .eqf--{{ section.id }} .eqf__social-img {
    display: block;
    width: var(--soc-size, 22px);
    height: auto;
    transition: opacity 0.3s ease;
  }

  .eqf--{{ section.id }} .eqf__social-link:hover .eqf__social-img {
    opacity: 0.7;
  }

  /* ===========================================================
     Tablet: CTA drops below the columns, divider goes horizontal
     =========================================================== */
  @media screen and (max-width: 983px) {
    .eqf--{{ section.id }} .eqf__top {
      flex-direction: column;
      gap: 56px;
    }

    .eqf--{{ section.id }} .eqf__cta {
      flex-basis: auto;
      width: 100%;
      border-left: 0;
      padding-left: 0;
      {% if s.cta_divider %}
      border-top: 1px solid var(--eqf-divider);
      padding-top: 48px;
      {% endif %}
    }
  }

  /* ===========================================================
     Mobile: stacked columns, wrapped legal, roomy spacing
     =========================================================== */
  @media screen and (max-width: 639px) {
    .eqf--{{ section.id }} {
      padding-inline: 0;
    }

    .eqf--{{ section.id }} .eqf__inner {
      padding-inline: {{ s.mobile_padding }}px;
    }

    .eqf--{{ section.id }} .eqf__top {
      gap: 44px;
    }

    .eqf--{{ section.id }} .eqf__nav {
      gap: 36px;
    }

    .eqf--{{ section.id }} .eqf__col {
      flex: 1 1 100%;
      max-width: 100%;
    }

    .eqf--{{ section.id }} .eqf__cta {
      margin-top: 8px;
      {% if s.cta_divider %}
      padding-top: 40px;
      {% endif %}
    }

    .eqf--{{ section.id }} .eqf__lower {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .eqf--{{ section.id }} .eqf__legal {
      width: 100%;
    }

    .eqf--{{ section.id }} .eqf__legal ul {
      justify-content: flex-start;
      row-gap: 12px;
    }

    .eqf--{{ section.id }} .eqf__legal li + li::before {
      display: none;
    }

    .eqf--{{ section.id }} .eqf__legal li {
      margin-right: 24px;
    }

    .eqf--{{ section.id }} .eqf__legal a {
      white-space: normal;
    }

    .eqf--{{ section.id }} .eqf__social ul {
      gap: 20px;
    }
  }

  /* ---------- Mobile: nav columns become accordions ---------- */
@media screen and (max-width: 639px) {
  .eqf--{{ section.id }} .eqf__col-toggle {
    cursor: pointer;
    justify-content: space-between;
  }

  .eqf--{{ section.id }} .eqf__col-chevron {
    display: block;
  }

  .eqf--{{ section.id }} .eqf__col:not(.eqf__col--nohead) .eqf__col-collapse {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s linear 0.45s;
  }

  .eqf--{{ section.id }} .eqf__col:not(.eqf__col--nohead).is-open .eqf__col-collapse {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .eqf--{{ section.id }} .eqf__col-links {
    margin-top: 0;
    padding-top: 20px;
    min-height: 0;
    overflow: hidden;
  }

  .eqf__brand eqf__brand--left {
    align-items: center;
    
  }
}

@media (prefers-reduced-motion: reduce) {
  .eqf--{{ section.id }} .eqf__col-collapse,
  .eqf--{{ section.id }} .eqf__col-chevron {
    transition: none !important;
  }
}
</style>

<footer class="eqf eqf--{{ section.id }}">
  <div class="eqf__inner">

    {%- comment -%} =========== Top: navigation columns + CTA =========== {%- endcomment -%}
    <div class="eqf__top">
      {%- if nav_count > 0 -%}
        <div class="eqf__nav">
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_column' -%}
              {%- assign cb = block.settings -%}
             <nav
  class="eqf__col eqf__col--{{ cb.heading_align }}{% if cb.heading == blank %} eqf__col--nohead{% endif %}"
  aria-label="{{ cb.heading | default: 'Footer' | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if cb.heading != blank -%}
    <h2
      class="eqf__col-heading{% if cb.heading_tick %} eqf__col-heading--tick{% endif %}"
      style="color: {{ cb.heading_color }}; font-size: {{ cb.heading_size }}px; letter-spacing: {{ cb.heading_tracking | divided_by: 100.0 }}em; font-weight: {{ cb.heading_weight }};"
    >
      <button
        class="eqf__col-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="eqf-links-{{ block.id }}"
      >
        <span>{{- cb.heading | escape -}}</span>
        <svg class="eqf__col-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
      </button>
    </h2>
  {%- endif -%}

  <div class="eqf__col-collapse" id="eqf-links-{{ block.id }}">
    <ul class="eqf__col-links">
      {%- assign next_block_i = forloop.index0 | plus: 1 -%}
      {%- for inner in section.blocks offset: next_block_i -%}
        {%- if inner.type == 'nav_column' -%}
          {% break %}
        {%- endif -%}
        {%- if inner.type == 'nav_link' -%}
          {%- assign lb = inner.settings -%}
          {%- if lb.label != blank -%}
            <li {{ inner.shopify_attributes }}>
              <a
                href="{% if lb.url != blank %}{{ lb.url }}{% else %}{{ routes.root_url }}{% endif %}"
                {% if lb.new_tab %}target="_blank" rel="noopener"{% endif %}
                {% if lb.color != blank %}style="color: {{ lb.color }};"{% endif %}
              >
                {{- lb.label | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</nav>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} =========== Expert CTA panel =========== {%- endcomment -%}
      {%- if s.show_cta -%}
        <aside
          class="eqf__cta eqf__cta--{{ s.cta_align }}"
          style="--eqf-icon-w: {{ s.cta_icon_width }}px;"
          aria-label="{{ s.cta_heading | default: 'Expert help' | escape }}"
        >
          <div class="eqf__cta-inner">
            <div class="eqf__cta-head{% if s.cta_icon_position == 'inline' %} eqf__cta-head--inline{% endif %}">
              {%- if s.cta_icon != blank -%}
                <img
                  class="eqf__cta-icon"
                  src="{{ s.cta_icon | image_url: width: 240 }}"
                  alt=""
                  width="{{ s.cta_icon_width }}"
                  height="{{ s.cta_icon_width }}"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if s.cta_heading != blank -%}
                <h2
                  class="eqf__cta-heading"
                  style="color: {{ s.cta_heading_color }}; font-size: {{ s.cta_heading_size }}px;"
                >
                  {{- s.cta_heading | escape -}}
                </h2>
              {%- endif -%}
            </div>

            {%- if s.cta_body != blank -%}
              <p
                class="eqf__cta-body"
                style="color: {{ s.cta_body_color }}; font-size: {{ s.cta_body_size }}px;"
              >
                {{- s.cta_body | escape | newline_to_br -}}
              </p>
            {%- endif -%}

            {%- if s.cta_button_text != blank -%}
              <a
                class="eqf__cta-btn"
                href="{% if s.cta_button_url != blank %}{{ s.cta_button_url }}{% else %}{{ routes.root_url }}{% endif %}"
              >
                {{- s.cta_button_text | escape -}}
                {%- if s.cta_button_arrow -%}
                  <svg class="eqf__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15" /><path d="M13 6l6 6-6 6" /></svg>
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
        </aside>
      {%- endif -%}
    </div>

    {%- comment -%} =========== Lower footer: brand / legal / social =========== {%- endcomment -%}
    {%- if s.logo != blank or s.copyright_text != blank or legal_count > 0 or social_count > 0 -%}
      <div class="eqf__lower">
        {%- if s.logo != blank or s.copyright_text != blank -%}
          <div class="eqf__brand eqf__brand--{{ s.logo_align }}">
            {%- if s.logo != blank -%}
              {%- assign logo_alt = s.logo.alt | default: shop.name | escape -%}
              <img
                class="eqf__logo"
                src="{{ s.logo | image_url: width: 720 }}"
                alt="{{ logo_alt }}"
                width="{{ s.logo_width }}"
                loading="lazy"
                style="width: {{ s.logo_width }}px; max-width: {{ s.logo_max_width }}px; height: auto;"
              >
            {%- endif -%}
            {%- if s.copyright_text != blank -%}
              <p class="eqf__copyright">
                &copy;
                {%- if s.auto_year -%}
                  {{ 'now' | date: '%Y' }}
                {%- else -%}
                  {{ s.copyright_year | escape }}
                {%- endif -%}
                {{ s.copyright_text | escape }}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if legal_count > 0 -%}
          <nav class="eqf__legal" aria-label="Legal">
            <ul>
              {%- for block in section.blocks -%}
                {%- if block.type == 'legal_link' -%}
                  {%- assign lb = block.settings -%}
                  {%- if lb.label != blank -%}
                    <li {{ block.shopify_attributes }}>
                      <a href="{% if lb.url != blank %}{{ lb.url }}{% else %}{{ routes.root_url }}{% endif %}">
                        {{- lb.label | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if social_count > 0 -%}
          <div class="eqf__social">
            <ul>
              {%- for block in section.blocks -%}
                {%- if block.type == 'social_icon' -%}
                  {%- assign sb = block.settings -%}
                  {%- if sb.icon != blank -%}
                    <li {{ block.shopify_attributes }}>
                      <a
                        class="eqf__social-link"
                        href="{% if sb.url != blank %}{{ sb.url }}{% else %}{{ routes.root_url }}{% endif %}"
                        {% if sb.new_tab %}target="_blank" rel="noopener"{% endif %}
                        aria-label="{{ sb.accessible_label | default: sb.name | escape }}"
                        style="--soc-size: {{ sb.size }}px; --soc-color: {{ sb.color }}; --soc-hover: {{ sb.hover_color }}; --soc-mask: url('{{ sb.icon | image_url: width: 128 }}');"
                      >
                        {%- if sb.recolor -%}
                          <span class="eqf__social-glyph"></span>
                        {%- else -%}
                          <img
                            class="eqf__social-img"
                            src="{{ sb.icon | image_url: width: 128 }}"
                            alt="{{ sb.accessible_label | default: sb.name | escape }}"
                            width="{{ sb.size }}"
                            height="{{ sb.size }}"
                            loading="lazy"
                          >
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</footer>

<script>
  (function () {
    var root = document.querySelector('.eqf--{{ section.id }}');
    if (!root) return;
    var mq = window.matchMedia('(max-width: 639px)');

    root.addEventListener('click', function (event) {
      if (!mq.matches) return; /* accordion only on mobile */
      var button = event.target.closest('.eqf__col-toggle');
      if (!button || !root.contains(button)) return;
      var col = button.closest('.eqf__col');
      if (!col) return;
      var isOpen = col.classList.toggle('is-open');
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  })();
</script>

