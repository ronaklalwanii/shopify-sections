{%- comment -%} Section Library: injected global assets for store "nocturne-store" {%- endcomment -%}
{{ 'nocturne-store--theme.css' | asset_url | stylesheet_tag }}
{{ 'nocturne-store--product.css' | asset_url | stylesheet_tag }}
{% render 'nocturne-store--css-variables' %}
{%- comment -%}
  Section: Brand Story + Commitment
  Left: dark story panel with image. Right: commitment accordion rows.
  Eyebrow & header icons: show/hide, custom upload, adjustable size.
{%- endcomment -%}

<section id="FigMouseStory-{{ section.id }}" class="fms">
  {%- style -%}
    #FigMouseStory-{{ section.id }} {
      --fms-bg: {{ section.settings.bg_color }};
      --fms-max-width: {{ section.settings.max_width }}px;
      --fms-space-top: {{ section.settings.space_top }}px;
      --fms-space-bottom: {{ section.settings.space_bottom }}px;
      --fms-gutter: {{ section.settings.mobile_gutter }}px;
      --fms-panel-gap: {{ section.settings.panel_gap }}px;
      --fms-radius: {{ section.settings.panel_radius }}px;
      --fms-split: {{ section.settings.column_split }}%;
      --fms-pad: {{ section.settings.panel_pad }}px;
      --fms-left-bg: {{ section.settings.left_bg }};
      --fms-eyebrow-size: {{ section.settings.eyebrow_size }}px;
      --fms-eyebrow-spacing: {{ section.settings.eyebrow_spacing }}px;
      --fms-eyebrow-color: {{ section.settings.eyebrow_color }};
      --fms-eyebrow-icon-size: {{ section.settings.eyebrow_icon_size }}px;
      --fms-head-size: {{ section.settings.heading_size }}px;
      --fms-head-color: {{ section.settings.heading_color }};
      --fms-head-lh: {{ section.settings.heading_line_height }};
      --fms-desc-size: {{ section.settings.desc_size }}px;
      --fms-desc-color: {{ section.settings.desc_color }};
      --fms-desc-maxw: {{ section.settings.desc_max_width }}px;
      --fms-script-size: {{ section.settings.script_size }}px;
      --fms-script-color: {{ section.settings.script_color }};
      --fms-img-radius: {{ section.settings.image_radius }}px;
      --fms-img-width: {{ section.settings.image_width }}%;
      --fms-right-bg: {{ section.settings.right_bg }};
      --fms-header-size: {{ section.settings.header_size }}px;
      --fms-header-spacing: {{ section.settings.header_spacing }}px;
      --fms-header-color: {{ section.settings.header_color }};
      --fms-header-icon-size: {{ section.settings.header_icon_size }}px;
      --fms-divider: {{ section.settings.divider_color }};
      --fms-row-pad: {{ section.settings.row_padding_y }}px;
      --fms-icon-size: {{ section.settings.icon_size }}px;
      --fms-icon-color: {{ section.settings.icon_color }};
      --fms-title-size: {{ section.settings.title_size }}px;
      --fms-title-weight: {{ section.settings.title_weight }};
      --fms-title-color: {{ section.settings.title_color }};
      --fms-row-desc-size: {{ section.settings.row_desc_size }}px;
      --fms-row-desc-color: {{ section.settings.row_desc_color }};
      --fms-plus-size: {{ section.settings.plus_size }}px;
      --fms-plus-color: {{ section.settings.plus_color }};
    }

    #FigMouseStory-{{ section.id }} {
      background: var(--fms-bg);
      padding-top: var(--fms-space-top);
      padding-bottom: var(--fms-space-bottom);
      padding-left: var(--fms-gutter);
      padding-right: var(--fms-gutter);
      overflow-x: clip;
    }

    #FigMouseStory-{{ section.id }} .fms__shell {
      width: min(100%, var(--fms-max-width));
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, var(--fms-split)) minmax(0, 1fr);
      gap: var(--fms-panel-gap);
      min-width: 0;
    }

    /* ---------- Left: story panel ---------- */
    #FigMouseStory-{{ section.id }} .fms__story {
      background: var(--fms-left-bg);
      border-radius: var(--fms-radius);
      padding: var(--fms-pad);
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--fms-img-width);
      gap: 32px;
      align-items: center;
      min-width: 0;
    }

    #FigMouseStory-{{ section.id }} .fms__eyebrow {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--fms-eyebrow-color);
      font-size: var(--fms-eyebrow-size);
      font-weight: 600;
      letter-spacing: var(--fms-eyebrow-spacing);
      text-transform: uppercase;
    }
    #FigMouseStory-{{ section.id }} .fms__eyebrow svg,
    #FigMouseStory-{{ section.id }} .fms__eyebrow img {
      width: var(--fms-eyebrow-icon-size);
      height: var(--fms-eyebrow-icon-size);
      object-fit: contain;
      flex-shrink: 0;
    }

    #FigMouseStory-{{ section.id }} .fms__heading {
      margin: 20px 0 0;
      color: var(--fms-head-color);
      font-size: var(--fms-head-size);
      line-height: var(--fms-head-lh);
      font-weight: 400;
      font-family: Georgia, 'Times New Roman', serif;
    }

    #FigMouseStory-{{ section.id }} .fms__desc {
      margin: 20px 0 0;
      max-width: var(--fms-desc-maxw);
      color: var(--fms-desc-color);
      font-size: var(--fms-desc-size);
      line-height: 1.6;
    }

    #FigMouseStory-{{ section.id }} .fms__script {
      margin: 28px 0 0;
      color: var(--fms-script-color);
      font-size: var(--fms-script-size);
      font-family: 'Segoe Script', 'Brush Script MT', 'Snell Roundhand', cursive;
      font-style: italic;
      line-height: 1.3;
    }

    #FigMouseStory-{{ section.id }} .fms__media {
      align-self: stretch;
      min-height: 320px;
      border-radius: var(--fms-img-radius);
      overflow: hidden;
    }
    #FigMouseStory-{{ section.id }} .fms__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ---------- Right: commitment panel ---------- */
    #FigMouseStory-{{ section.id }} .fms__commit {
      background: var(--fms-right-bg);
      border-radius: var(--fms-radius);
      padding: var(--fms-pad);
      min-width: 0;
    }

    #FigMouseStory-{{ section.id }} .fms__commit-header {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--fms-header-color);
      font-size: var(--fms-header-size);
      font-weight: 600;
      letter-spacing: var(--fms-header-spacing);
      text-transform: uppercase;
    }
    #FigMouseStory-{{ section.id }} .fms__commit-header svg,
    #FigMouseStory-{{ section.id }} .fms__commit-header img {
      width: var(--fms-header-icon-size);
      height: var(--fms-header-icon-size);
      object-fit: contain;
      flex-shrink: 0;
    }

    #FigMouseStory-{{ section.id }} .fms__rows {
      margin-top: 8px;
    }

    #FigMouseStory-{{ section.id }} .fms-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 20px;
      align-items: start;
      padding: var(--fms-row-pad) 0;
      border-bottom: 1px solid var(--fms-divider);
    }
    #FigMouseStory-{{ section.id }} .fms-row:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    #FigMouseStory-{{ section.id }} .fms-row__icon {
      width: var(--fms-icon-size);
      height: var(--fms-icon-size);
      color: var(--fms-icon-color);
    }
    #FigMouseStory-{{ section.id }} .fms-row__icon svg,
    #FigMouseStory-{{ section.id }} .fms-row__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #FigMouseStory-{{ section.id }} .fms-row__title {
      margin: 0;
      color: var(--fms-title-color);
      font-size: var(--fms-title-size);
      font-weight: var(--fms-title-weight);
      line-height: 1.3;
    }
    #FigMouseStory-{{ section.id }} .fms-row__desc {
      margin: 6px 0 0;
      color: var(--fms-row-desc-color);
      font-size: var(--fms-row-desc-size);
      line-height: 1.55;
    }

    #FigMouseStory-{{ section.id }} .fms-row__extra {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 400ms ease, opacity 300ms ease, margin 300ms ease;
    }
    #FigMouseStory-{{ section.id }} .fms-row.is-open .fms-row__extra {
      max-height: 300px;
      opacity: 1;
      margin-top: 10px;
    }
    #FigMouseStory-{{ section.id }} .fms-row__extra p {
      margin: 0;
      color: var(--fms-row-desc-color);
      font-size: var(--fms-row-desc-size);
      line-height: 1.55;
    }

    #FigMouseStory-{{ section.id }} .fms-row__toggle {
      margin-top: 4px;
      width: calc(var(--fms-plus-size) + 12px);
      height: calc(var(--fms-plus-size) + 12px);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 0;
      cursor: pointer;
      color: var(--fms-plus-color);
      padding: 0;
    }
    #FigMouseStory-{{ section.id }} .fms-row__toggle svg {
      width: var(--fms-plus-size);
      height: var(--fms-plus-size);
      transition: transform 300ms ease;
    }
    #FigMouseStory-{{ section.id }} .fms-row.is-open .fms-row__toggle svg {
      transform: rotate(45deg);
    }
    #FigMouseStory-{{ section.id }} .fms-row__toggle:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1080px) {
      #FigMouseStory-{{ section.id }} .fms__shell {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- Mobile ---------- */
    @media (max-width: 640px) {
      #FigMouseStory-{{ section.id }} .fms__story {
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 28px 24px;
      }
      #FigMouseStory-{{ section.id }} .fms__media {
        min-height: 0;
        aspect-ratio: 4 / 5;
        order: -1;
      }
      #FigMouseStory-{{ section.id }} .fms__commit {
        padding: 28px 24px;
      }
      #FigMouseStory-{{ section.id }} .fms-row {
        gap: 14px;
      }
      #FigMouseStory-{{ section.id }} .fms-row__icon {
        width: calc(var(--fms-icon-size) * 0.8);
        height: calc(var(--fms-icon-size) * 0.8);
      }
    }
  {%- endstyle -%}

  <div class="fms__shell">
    <div class="fms__story">
      <div class="fms__story-content">
        {%- if section.settings.eyebrow_text != blank -%}
          <span class="fms__eyebrow">
            {{ section.settings.eyebrow_text }}
            {%- if section.settings.show_eyebrow_icon -%}
              {%- if section.settings.eyebrow_icon_custom != blank -%}
                <img src="{{ section.settings.eyebrow_icon_custom | image_url: width: 64 }}" alt="" width="64" height="64" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
              {%- endif -%}
            {%- endif -%}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="fms__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="fms__desc">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.script_text != blank -%}
          <p class="fms__script">{{ section.settings.script_text }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_image and section.settings.image != blank -%}
        <div class="fms__media">
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | default: 'Brand story' }}"
            loading="lazy"
            width="900"
            height="1100"
          >
        </div>
      {%- endif -%}
    </div>

    <div class="fms__commit">
      {%- if section.settings.header_text != blank -%}
        <span class="fms__commit-header">
          {{ section.settings.header_text }}
          {%- if section.settings.show_header_icon -%}
            {%- if section.settings.header_icon_custom != blank -%}
              <img src="{{ section.settings.header_icon_custom | image_url: width: 64 }}" alt="" width="64" height="64" loading="lazy">
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
            {%- endif -%}
          {%- endif -%}
        </span>
      {%- endif -%}

      <div class="fms__rows">
        {%- for block in section.blocks -%}
          <div class="fms-row" data-fmr-row {{ block.shopify_attributes }}>
            <span class="fms-row__icon">
              {%- if block.settings.icon_custom != blank -%}
                <img src="{{ block.settings.icon_custom | image_url: width: 96 }}" alt="" width="96" height="96">
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                  {%- when 'sparkle' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"></path></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>

            <div class="fms-row__body">
              {%- if block.settings.title != blank -%}
                <h3 class="fms-row__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="fms-row__desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.extra_text != blank -%}
                <div class="fms-row__extra">
                  <p>{{ block.settings.extra_text }}</p>
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.extra_text != blank -%}
              <button
                type="button"
                class="fms-row__toggle"
                data-fmr-toggle
                aria-expanded="false"
                aria-label="Toggle {{ block.settings.title | escape }} details"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            {%- else -%}
              <span></span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('FigMouseStory-{{ section.id }}');
      if (!root) return;

      root.querySelectorAll('[data-fmr-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('[data-fmr-row]');
          if (!row) return;
          const open = row.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Brand Story + Commitment",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#F2EFEA" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 800, "max": 2000, "step": 20, "default": 1500, "unit": "px" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "mobile_gutter", "label": "Side gutters", "min": 0, "max": 60, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "panel_gap", "label": "Gap between panels", "min": 0, "max": 64, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "panel_radius", "label": "Panel radius", "min": 0, "max": 48, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "column_split", "label": "Left panel width", "min": 40, "max": 60, "step": 1, "default": 50, "unit": "%" },
    { "type": "range", "id": "panel_pad", "label": "Panel padding", "min": 16, "max": 96, "step": 2, "default": 48, "unit": "px" },

    { "type": "header", "content": "Story panel" },
    { "type": "color", "id": "left_bg", "label": "Story background", "default": "#3A2B20" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow", "default": "Why Fig & Mouse" },
    { "type": "checkbox", "id": "show_eyebrow_icon", "label": "Show eyebrow icon", "default": true },
    { "type": "image_picker", "id": "eyebrow_icon_custom", "label": "Eyebrow icon (overrides leaf)" },
    { "type": "range", "id": "eyebrow_icon_size", "label": "Eyebrow icon size", "min": 10, "max": 40, "step": 1, "default": 16, "unit": "px" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 9, "max": 18, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "eyebrow_spacing", "label": "Eyebrow spacing", "min": 0, "max": 6, "step": 0.5, "default": 2, "unit": "px" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#E8DCCB" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Thoughtfully designed for every walk." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "default": 40, "unit": "px" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#F3EADB" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "We believe the things we buy for our dogs should be just as thoughtfully designed as the things we buy for ourselves — beautifully crafted, built to last, and rooted in purpose." },
    { "type": "range", "id": "desc_size", "label": "Description size", "min": 11, "max": 20, "step": 1, "default": 14, "unit": "px" },
    { "type": "color", "id": "desc_color", "label": "Description color", "default": "#D9CBB8" },
    { "type": "range", "id": "desc_max_width", "label": "Description max width", "min": 180, "max": 480, "step": 10, "default": 320, "unit": "px" },
    { "type": "text", "id": "script_text", "label": "Script accent line", "default": "Designed with dogs in mind." },
    { "type": "range", "id": "script_size", "label": "Script size", "min": 16, "max": 44, "step": 2, "default": 26, "unit": "px" },
    { "type": "color", "id": "script_color", "label": "Script color", "default": "#C9A15E" },
    { "type": "checkbox", "id": "show_image", "label": "Show story image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Story image" },
    { "type": "range", "id": "image_radius", "label": "Image radius", "min": 0, "max": 32, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 25, "max": 60, "step": 1, "default": 40, "unit": "%" },

    { "type": "header", "content": "Commitment panel" },
    { "type": "color", "id": "right_bg", "label": "Commitment background", "default": "#EFEAE2" },
    { "type": "text", "id": "header_text", "label": "Header", "default": "Our Commitment" },
    { "type": "checkbox", "id": "show_header_icon", "label": "Show header icon", "default": true },
    { "type": "image_picker", "id": "header_icon_custom", "label": "Header icon (overrides leaf)" },
    { "type": "range", "id": "header_icon_size", "label": "Header icon size", "min": 10, "max": 40, "step": 1, "default": 16, "unit": "px" },
    { "type": "range", "id": "header_size", "label": "Header size", "min": 10, "max": 20, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 6, "step": 0.5, "default": 2, "unit": "px" },
    { "type": "color", "id": "header_color", "label": "Header color", "default": "#4A382B" },
    { "type": "color", "id": "divider_color", "label": "Row divider color", "default": "#DCD2C4" },
