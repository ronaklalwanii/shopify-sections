{%- comment -%} Section Library: injected global assets for store "nocturne-store" {%- endcomment -%}
{{ 'nocturne-store--theme.css' | asset_url | stylesheet_tag }}
{{ 'nocturne-store--product.css' | asset_url | stylesheet_tag }}
{% render 'nocturne-store--css-variables' %}
{%- comment -%}
  KOVARI — Styling Atelier / KOVARI Edit / Insider Updates
  Responsive, block-based editorial commerce section.
  Newsletter capture uses Shopify's native customer form.
{%- endcomment -%}

<section id="KovariEditorial-{{ section.id }}" class="kovari-editorial">
  {%- style -%}
    #KovariEditorial-{{ section.id }} {
      --ke-max-width: {{ section.settings.max_width }}px;
      --ke-gap: {{ section.settings.layout_gap }}px;
      --ke-mobile-gap: {{ section.settings.mobile_gap }}px;
      --ke-margin-top: {{ section.settings.margin_top }}px;
      --ke-margin-bottom: {{ section.settings.margin_bottom }}px;
      --ke-radius: {{ section.settings.panel_radius }}px;
      --ke-mobile-radius: {{ section.settings.mobile_panel_radius }}px;
      --ke-border-width: {{ section.settings.panel_border_width }}px;
      --ke-border-color: {{ section.settings.panel_border_color }};

      --ke-style-bg: {{ section.settings.styling_background }};
      --ke-style-text: {{ section.settings.styling_text_color }};
      --ke-style-height: {{ section.settings.styling_height }}px;
      --ke-style-title-size: {{ section.settings.styling_title_size }}px;
      --ke-style-title-weight: {{ section.settings.styling_title_weight }};
      --ke-style-copy-size: {{ section.settings.styling_copy_size }}px;
      --ke-style-copy-weight: {{ section.settings.styling_copy_weight }};
      --ke-tool-title-size: {{ section.settings.tool_title_size }}px;
      --ke-tool-title-weight: {{ section.settings.tool_title_weight }};
      --ke-tool-subtitle-size: {{ section.settings.tool_subtitle_size }}px;
      --ke-tool-image-w: {{ section.settings.tool_image_width }}px;
      --ke-tool-image-h: {{ section.settings.tool_image_height }}px;

      --ke-edit-bg: {{ section.settings.edit_background }};
      --ke-edit-text: {{ section.settings.edit_text_color }};
      --ke-edit-height: {{ section.settings.edit_height }}px;
      --ke-edit-title-size: {{ section.settings.edit_title_size }}px;
      --ke-edit-title-weight: {{ section.settings.edit_title_weight }};
      --ke-edit-copy-size: {{ section.settings.edit_copy_size }}px;
      --ke-edit-copy-weight: {{ section.settings.edit_copy_weight }};
      --ke-edit-copy-line-height: {{ section.settings.edit_copy_line_height }};
      --ke-edit-card-gap: {{ section.settings.edit_card_gap }}px;
      --ke-edit-card-image-h: {{ section.settings.edit_card_image_height }}px;
      --ke-edit-card-radius: {{ section.settings.edit_card_radius }}px;
      --ke-edit-card-title-size: {{ section.settings.edit_card_title_size }}px;

      --ke-insider-bg: {{ section.settings.insider_background }};
      --ke-insider-text: {{ section.settings.insider_text_color }};
      --ke-insider-min-h: {{ section.settings.insider_height }}px;
      --ke-insider-title-size: {{ section.settings.insider_title_size }}px;
      --ke-insider-title-weight: {{ section.settings.insider_title_weight }};
      --ke-insider-copy-size: {{ section.settings.insider_copy_size }}px;

      --ke-cta-size: {{ section.settings.cta_font_size }}px;
      --ke-cta-weight: {{ section.settings.cta_font_weight }};
      --ke-cta-gap: {{ section.settings.cta_gap }}px;
      --ke-cta-arrow-size: {{ section.settings.cta_arrow_size }}px;
      --ke-cta-bg: {{ section.settings.styling_cta_background }};
      --ke-cta-color: {{ section.settings.styling_cta_text_color }};
      --ke-cta-radius: {{ section.settings.styling_cta_radius }}px;
      --ke-cta-padding-x: {{ section.settings.styling_cta_padding_x }}px;
      --ke-cta-padding-y: {{ section.settings.styling_cta_padding_y }}px;
      --ke-hover-duration: {{ section.settings.hover_duration }}ms;
      --ke-hover-lift: {{ section.settings.hover_lift }}px;

      --ke-input-bg: {{ section.settings.insider_input_background }};
      --ke-input-border: {{ section.settings.insider_input_border }};
      --ke-input-border-width: {{ section.settings.insider_input_border_width }}px;
      --ke-input-text: {{ section.settings.insider_input_text_color }};
      --ke-input-placeholder: {{ section.settings.insider_input_placeholder_color }};
      --ke-input-radius: {{ section.settings.insider_input_radius }}px;
      --ke-input-height: {{ section.settings.insider_input_height }}px;
      --ke-input-button-w: {{ section.settings.insider_button_width }}px;
      --ke-input-button-bg: {{ section.settings.insider_button_background }};
      --ke-input-button-color: {{ section.settings.insider_button_text_color }};

      --ke-mobile-style-h: {{ section.settings.mobile_styling_height }}px;
      --ke-mobile-edit-h: {{ section.settings.mobile_edit_height }}px;
      --ke-mobile-insider-h: {{ section.settings.mobile_insider_height }}px;
    }

    #KovariEditorial-{{ section.id }} {
    margin-top: var(--ke-margin-top);
      margin-bottom: var(--ke-margin-bottom);
      padding-left: 20px;
      padding-right: 20px;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__shell {
      /* width: min(100%, var(--ke-max-width)); */
      margin-inline: auto;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__layout {
      display: grid;
      grid-template-columns: minmax(0, {{ section.settings.left_column_ratio }}%) minmax(0, 1fr);
      gap: var(--ke-gap);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__left {
      min-width: 0;
      display: grid;
      grid-template-rows: minmax(0, {{ section.settings.styling_row_ratio }}fr) minmax(0, {{ section.settings.edit_row_ratio }}fr);
      gap: var(--ke-gap);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__panel {
      position: relative;
      min-width: 0;
      overflow: hidden;
      border: var(--ke-border-width) solid var(--ke-border-color);
      border-radius: var(--ke-radius);
      box-sizing: border-box;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__styling {
      min-height: var(--ke-style-height);
      background: var(--ke-style-bg);
      color: var(--ke-style-text);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__styling-inner {
      height: 100%;
      display: grid;
      grid-template-columns: {{ section.settings.styling_intro_width }}px minmax(0, 1fr);
      gap: {{ section.settings.styling_intro_gap }}px;
      padding: {{ section.settings.styling_padding_y }}px {{ section.settings.styling_padding_x }}px;
      box-sizing: border-box;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__intro {
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__title {
      margin: 0;
      color: inherit;
      font-family: {{ section.settings.styling_heading_font }};
      font-size: var(--ke-style-title-size);
      font-weight: var(--ke-style-title-weight);
      line-height: 1.05;
      letter-spacing: {{ section.settings.styling_title_letter_spacing }}px;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__copy {
      max-width: {{ section.settings.styling_copy_max_width }}px;
      margin: {{ section.settings.copy_top_margin }}px 0 0;
      color: inherit;
      font-size: var(--ke-style-copy-size);
      font-weight: var(--ke-style-copy-weight);
      line-height: {{ section.settings.copy_line_height }};
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__cta {
      display: inline-flex;
      align-items: center;
      gap: var(--ke-cta-gap);
      margin-top: {{ section.settings.cta_top_margin }}px;
      padding: var(--ke-cta-padding-y) var(--ke-cta-padding-x);
      background: var(--ke-cta-bg);
      color: var(--ke-cta-color);
      border-radius: var(--ke-cta-radius);
      font-size: var(--ke-cta-size);
      font-weight: var(--ke-cta-weight);
      line-height: 1.2;
      letter-spacing: {{ section.settings.cta_letter_spacing }}px;
      text-decoration: none;
      text-transform: uppercase;
      transition: opacity var(--ke-hover-duration) ease, transform var(--ke-hover-duration) ease;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__cta:hover {
      opacity: .72;
      transform: translateX(2px);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__cta-arrow {
      display: inline-flex;
      width: var(--ke-cta-arrow-size);
      height: var(--ke-cta-arrow-size);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__cta-arrow svg {
      width: 100%;
      height: 100%;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__tools {
      min-width: 0;
      display: grid;
      grid-template-columns: repeat({{ section.settings.tools_desktop_columns }}, minmax(0, 1fr));
      gap: {{ section.settings.tool_gap }}px;
      align-items: center;
    }

    #KovariEditorial-{{ section.id }} .kovari-tool {
      min-width: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      color: inherit;
      text-align: center;
      text-decoration: none;
      transition: transform var(--ke-hover-duration) ease, opacity var(--ke-hover-duration) ease;
    }

    #KovariEditorial-{{ section.id }} .kovari-tool:hover {
      transform: translateY(calc(var(--ke-hover-lift) * -1));
      opacity: .92;
    }

    #KovariEditorial-{{ section.id }} .kovari-tool__media {
      width: var(--ke-tool-image-w);
      height: var(--ke-tool-image-h);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-radius: {{ section.settings.tool_image_radius }}px;
    }

    #KovariEditorial-{{ section.id }} .kovari-tool__image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: {{ section.settings.tool_image_fit }};
      object-position: {{ section.settings.tool_image_position }};
    }

    #KovariEditorial-{{ section.id }} .kovari-tool__title {
      margin: {{ section.settings.tool_title_margin }}px 0 0;
      max-width: {{ section.settings.tool_title_max_width }}px;
      font-size: var(--ke-tool-title-size);
      font-weight: var(--ke-tool-title-weight);
      line-height: 1.15;
    }

    #KovariEditorial-{{ section.id }} .kovari-tool__subtitle {
      margin: {{ section.settings.tool_subtitle_margin }}px 0 0;
      font-size: var(--ke-tool-subtitle-size);
      line-height: 1.2;
      opacity: {{ section.settings.tool_subtitle_opacity | divided_by: 100.0 }};
    }

    /* KOVARI Edit */
    #KovariEditorial-{{ section.id }} .kovari-editorial__edit {
      min-height: var(--ke-edit-height);
      background: var(--ke-edit-bg);
      color: var(--ke-edit-text);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__edit-inner {
      height: 100%;
      display: grid;
      grid-template-columns: {{ section.settings.edit_intro_width }}px minmax(0, 1fr);
      gap: {{ section.settings.edit_intro_gap }}px;
      padding: {{ section.settings.edit_padding_y }}px {{ section.settings.edit_padding_x }}px;
      box-sizing: border-box;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__edit-title {
      margin: 0;
      color: inherit;
      font-family: {{ section.settings.edit_heading_font }};
      font-size: var(--ke-edit-title-size);
      font-weight: var(--ke-edit-title-weight);
      line-height: 1.05;
      letter-spacing: {{ section.settings.edit_title_letter_spacing }}px;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__edit-cards {
      min-width: 0;
      display: grid;
      grid-template-columns: repeat({{ section.settings.edit_desktop_columns }}, minmax(0, 1fr));
      gap: var(--ke-edit-card-gap);
      align-items: center;
    }

    #KovariEditorial-{{ section.id }} .kovari-edit-card {
      min-width: 0;
      color: inherit;
      text-decoration: none;
      transition: transform var(--ke-hover-duration) ease, opacity var(--ke-hover-duration) ease;
    }

    #KovariEditorial-{{ section.id }} .kovari-edit-card:hover {
      transform: translateY(calc(var(--ke-hover-lift) * -1));
      opacity: .92;
    }

    #KovariEditorial-{{ section.id }} .kovari-edit-card__media {
      width: 100%;
      height: var(--ke-edit-card-image-h);
      overflow: hidden;
      border-radius: var(--ke-edit-card-radius);
      background: #D8D0C8;
    }

    #KovariEditorial-{{ section.id }} .kovari-edit-card__image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: {{ section.settings.edit_image_position }};
      transition: transform var(--ke-hover-duration) ease;
    }

    #KovariEditorial-{{ section.id }} .kovari-edit-card:hover .kovari-edit-card__image {
      transform: scale({{ section.settings.edit_image_hover_scale | divided_by: 100.0 }});
    }

    #KovariEditorial-{{ section.id }} .kovari-edit-card__title {
      margin: {{ section.settings.edit_card_title_margin }}px 0 0;
      color: inherit;
      font-size: var(--ke-edit-card-title-size);
      font-weight: {{ section.settings.edit_card_title_weight }};
      line-height: {{ section.settings.edit_card_title_line_height }};
    }

    /* Insider Updates */
    #KovariEditorial-{{ section.id }} .kovari-editorial__insider {
      min-height: var(--ke-insider-min-h);
      background: var(--ke-insider-bg);
      color: var(--ke-insider-text);
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__insider-inner {
      min-height: var(--ke-insider-min-h);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: {{ section.settings.insider_padding_y }}px {{ section.settings.insider_padding_x }}px;
      box-sizing: border-box;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__insider-title {
      margin: 0;
      color: inherit;
      font-family: {{ section.settings.insider_heading_font }};
      font-size: var(--ke-insider-title-size);
      font-weight: var(--ke-insider-title-weight);
      line-height: 1.05;
      letter-spacing: {{ section.settings.insider_title_letter_spacing }}px;
    }

    #KovariEditorial-{{ section.id }} .kovari-editorial__insider-copy {
      max-width: {{ section.settings.insider_copy_max_width }}px;
      margin: {{ section.settings.insider_copy_margin }}px 0 0;
      color: inherit;
      font-size: var(--ke-insider-copy-size);
      font-weight: {{ section.settings.insider_copy_weight }};
      line-height: {{ section.settings.insider_copy_line_height }};
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter {
      width: 100%;
      max-width: {{ section.settings.insider_form_max_width }}px;
      margin-top: {{ section.settings.insider_form_margin }}px;
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--ke-input-button-w);
      width: 100%;
      min-height: var(--ke-input-height);
      border: var(--ke-input-border-width) solid var(--ke-input-border);
      border-radius: var(--ke-input-radius);
      overflow: hidden;
      background: var(--ke-input-bg);
      box-sizing: border-box;
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__input {
      width: 100%;
      min-width: 0;
      height: 100%;
      border: 0;
      outline: 0;
      padding: 0 {{ section.settings.insider_input_padding_x }}px;
      background: transparent;
      color: var(--ke-input-text);
      font-size: {{ section.settings.insider_input_font_size }}px;
      font-weight: {{ section.settings.insider_input_font_weight }};
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__input::placeholder {
      color: var(--ke-input-placeholder);
      opacity: 1;
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__button {
      border: 0;
      cursor: pointer;
      background: var(--ke-input-button-bg);
      color: var(--ke-input-button-color);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: opacity var(--ke-hover-duration) ease;
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__button:hover {
      opacity: .78;
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__button svg {
      width: {{ section.settings.insider_button_icon_size }}px;
      height: {{ section.settings.insider_button_icon_size }}px;
    }

    #KovariEditorial-{{ section.id }} .kovari-newsletter__message {
      margin: 10px 0 0;
      color: inherit;
      font-size: {{ section.settings.insider_message_size }}px;
      line-height: 1.35;
    }

    #KovariEditorial-{{ section.id }} .visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0,0,0,0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    #KovariEditorial-{{ section.id }} a:focus-visible,
    #KovariEditorial-{{ section.id }} button:focus-visible,
    #KovariEditorial-{{ section.id }} input:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    @media (max-width: 990px) {
      #KovariEditorial-{{ section.id }} .kovari-editorial__layout {
        grid-template-columns: 1fr;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__left {
        grid-template-rows: auto auto;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__styling,
      #KovariEditorial-{{ section.id }} .kovari-editorial__edit,
      #KovariEditorial-{{ section.id }} .kovari-editorial__insider {
        min-height: auto;
      }
    }

    @media (max-width: 640px) {

        

      #KovariEditorial-{{ section.id }} {
        padding-right: 20px;
        padding-left:20px;
        margin-top: min(var(--ke-margin-top), 24px);
        margin-bottom: min(var(--ke-margin-bottom), 24px);
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__layout,
      #KovariEditorial-{{ section.id }} .kovari-editorial__left {
        gap: var(--ke-mobile-gap);
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__panel {
        border-radius: var(--ke-mobile-radius);
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__styling {
        min-height: var(--ke-mobile-style-h);
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__styling-inner,
      #KovariEditorial-{{ section.id }} .kovari-editorial__edit-inner,
      #KovariEditorial-{{ section.id }} .kovari-editorial__insider-inner {
        display: block;
        height: auto;
        padding-left: {{ section.settings.mobile_padding_x }}px;
        padding-right: {{ section.settings.mobile_padding_x }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__styling-inner {
        padding-top: {{ section.settings.mobile_styling_padding_y }}px;
        padding-bottom: {{ section.settings.mobile_styling_padding_y }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__styling-intro {
        display: block;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__title,
      #KovariEditorial-{{ section.id }} .kovari-editorial__edit-title,
      #KovariEditorial-{{ section.id }} .kovari-editorial__insider-title {
        font-size: {{ section.settings.mobile_heading_size }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__copy,
      #KovariEditorial-{{ section.id }} .kovari-editorial__edit-copy,
      #KovariEditorial-{{ section.id }} .kovari-editorial__insider-copy {
        max-width: 100%;
        font-size: {{ section.settings.mobile_copy_size }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__tools {
        margin-top: {{ section.settings.mobile_tools_top_margin }}px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: {{ section.settings.mobile_tool_gap }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-tool__media {
        width: {{ section.settings.mobile_tool_image_width }}px;
        height: {{ section.settings.mobile_tool_image_height }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-tool__title {
        max-width: {{ section.settings.mobile_tool_title_max_width }}px;
        font-size: {{ section.settings.mobile_tool_title_size }}px;
        margin-top: {{ section.settings.mobile_tool_title_margin }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-tool__subtitle {
        font-size: {{ section.settings.mobile_tool_subtitle_size }}px;
        margin-top: {{ section.settings.mobile_tool_subtitle_margin }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__edit {
        min-height: var(--ke-mobile-edit-h);
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__edit-inner {
        padding-top: {{ section.settings.mobile_edit_padding_y }}px;
        padding-bottom: {{ section.settings.mobile_edit_padding_y }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__edit-cards {
        margin-top: {{ section.settings.mobile_edit_cards_margin }}px;
        grid-template-columns: 1fr;
        gap: {{ section.settings.mobile_edit_card_gap }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-edit-card {
        display: grid;
        grid-template-columns: {{ section.settings.mobile_edit_image_width }}% minmax(0, 1fr);
        align-items: center;
        gap: {{ section.settings.mobile_edit_card_inner_gap }}px;
        padding: {{ section.settings.mobile_edit_card_padding }}px;
        border-radius: {{ section.settings.mobile_edit_card_radius }}px;
        background: {{ section.settings.mobile_edit_card_background }};
      }

      #KovariEditorial-{{ section.id }} .kovari-edit-card__media {
        height: {{ section.settings.mobile_edit_image_height }}px;
        border-radius: {{ section.settings.mobile_edit_image_radius }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-edit-card__title {
        margin: 0;
        padding-right: {{ section.settings.mobile_edit_title_right_padding }}px;
        font-size: {{ section.settings.mobile_edit_card_title_size }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__insider {
        min-height: var(--ke-mobile-insider-h);
      }

      #KovariEditorial-{{ section.id }} .kovari-editorial__insider-inner {
        min-height: var(--ke-mobile-insider-h);
        padding-top: {{ section.settings.mobile_insider_padding_y }}px;
        padding-bottom: {{ section.settings.mobile_insider_padding_y }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-newsletter {
        max-width: 100%;
      }

      #KovariEditorial-{{ section.id }} .kovari-newsletter__row {
        min-height: {{ section.settings.mobile_insider_input_height }}px;
        grid-template-columns: minmax(0, 1fr) {{ section.settings.mobile_insider_button_width }}px;
      }
    }

    @media (max-width: 420px) {
      #KovariEditorial-{{ section.id }} .kovari-tool__media {
        width: {{ section.settings.small_mobile_tool_image_width }}px;
        height: {{ section.settings.small_mobile_tool_image_height }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-tool__title {
        font-size: {{ section.settings.small_mobile_tool_title_size }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-tool__subtitle {
        font-size: {{ section.settings.small_mobile_tool_subtitle_size }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-edit-card {
        grid-template-columns: {{ section.settings.small_mobile_edit_image_width }}% minmax(0, 1fr);
        gap: {{ section.settings.small_mobile_edit_card_inner_gap }}px;
        padding: {{ section.settings.small_mobile_edit_card_padding }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-edit-card__media {
        height: {{ section.settings.small_mobile_edit_image_height }}px;
      }

      #KovariEditorial-{{ section.id }} .kovari-edit-card__title {
        font-size: {{ section.settings.small_mobile_edit_card_title_size }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #KovariEditorial-{{ section.id }} * {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  {%- endstyle -%}

  <div class="kovari-editorial__shell">
    <div class="kovari-editorial__layout">
      <div class="kovari-editorial__left">

        <section class="kovari-editorial__panel kovari-editorial__styling">
          <div class="kovari-editorial__styling-inner">
            <div class="kovari-editorial__intro">
              <h2 class="kovari-editorial__title">{{ section.settings.styling_title }}</h2>
              <p class="kovari-editorial__copy">{{ section.settings.styling_copy }}</p>
              {%- if section.settings.styling_cta_link != blank -%}
                <a class="kovari-editorial__cta" href="{{ section.settings.styling_cta_link }}">
                  {{ section.settings.styling_cta_text }}
                  <span class="kovari-editorial__cta-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="18" y2="12"></line>
                      <polyline points="13 7 18 12 13 17"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
            </div>

            <div class="kovari-editorial__tools">
              {%- for block in section.blocks -%}
                {%- if block.type == 'styling_tool' -%}
                  {%- assign tool_product = block.settings.product -%}
                  {%- assign tool_title = block.settings.title -%}
                  {%- assign tool_image = block.settings.image -%}
                  {%- assign tool_link = block.settings.link -%}
                  {%- if tool_product != blank -%}
                    {%- assign tool_title = tool_product.title -%}
                    {%- assign tool_image = tool_product.featured_image -%}
                    {%- assign tool_link = tool_product.url -%}
                  {%- endif -%}
                  {%- if tool_link != blank -%}<a class="kovari-tool" href="{{ tool_link }}" {{ block.shopify_attributes }}>{%- else -%}<div class="kovari-tool" {{ block.shopify_attributes }}>{%- endif -%}
                    <span class="kovari-tool__media">
                      {%- if tool_image != blank -%}
                        <img class="kovari-tool__image" src="{{ tool_image | image_url: width: 500 }}" alt="{{ tool_title | escape }}" loading="{{ section.settings.image_loading }}" width="500" height="500">
                      {%- endif -%}
                    </span>
                    {%- if tool_title != blank -%}<span class="kovari-tool__title">{{ tool_title }}</span>{%- endif -%}
                    {%- if block.settings.subtitle != blank -%}<span class="kovari-tool__subtitle">{{ block.settings.subtitle }}</span>{%- endif -%}
                  {%- if tool_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </section>

        <section class="kovari-editorial__panel kovari-editorial__edit">
          <div class="kovari-editorial__edit-inner">
            <div class="kovari-editorial__intro">
              <h2 class="kovari-editorial__edit-title">{{ section.settings.edit_title }}</h2>
              <p class="kovari-editorial__copy">{{ section.settings.edit_copy }}</p>
              {%- if section.settings.edit_cta_link != blank -%}
                <a class="kovari-editorial__cta" href="{{ section.settings.edit_cta_link }}">
                  {{ section.settings.edit_cta_text }}
                  <span class="kovari-editorial__cta-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="18" y2="12"></line>
                      <polyline points="13 7 18 12 13 17"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
            </div>

            <div class="kovari-editorial__edit-cards">
              {%- for block in section.blocks -%}
                {%- if block.type == 'edit_article' -%}
                  {%- if block.settings.link != blank -%}<a class="kovari-edit-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<div class="kovari-edit-card" {{ block.shopify_attributes }}>{%- endif -%}
                    <div class="kovari-edit-card__media">
                      {%- if block.settings.image != blank -%}
                        <img class="kovari-edit-card__image" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="{{ section.settings.image_loading }}" width="1000" height="600">
                      {%- endif -%}
                    </div>
                    {%- if block.settings.title != blank -%}<div class="kovari-edit-card__title">{{ block.settings.title }}</div>{%- endif -%}
                  {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </section>
      </div>

      <aside class="kovari-editorial__panel kovari-editorial__insider">
        <div class="kovari-editorial__insider-inner">
          <h2 class="kovari-editorial__insider-title">{{ section.settings.insider_title }}</h2>
          <p class="kovari-editorial__insider-copy">{{ section.settings.insider_copy }}</p>

          {%- form 'customer', class: 'kovari-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="KovariNewsletterEmail-{{ section.id }}">{{ section.settings.insider_email_label }}</label>
            <div class="kovari-newsletter__row">
              <input
                id="KovariNewsletterEmail-{{ section.id }}"
                class="kovari-newsletter__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="{{ section.settings.insider_placeholder }}"
                required
                aria-required="true"
              >
              <button class="kovari-newsletter__button" type="submit" aria-label="{{ section.settings.insider_submit_label }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="18" y2="12"></line>
                  <polyline points="13 7 18 12 13 17"></polyline>
                </svg>
              </button>
            </div>
            {%- if form.posted_successfully? -%}<p class="kovari-newsletter__message" role="status">{{ section.settings.insider_success_message }}</p>{%- endif -%}
            {%- if form.errors -%}<div class="kovari-newsletter__message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {%- endform -%}
        </div>
      </aside>
    </div>
  </div>
</section>

