{%- comment -%} Section Library: injected global assets for store "sleep-and-wellbeing" {%- endcomment -%}
{{ 'sleep-and-wellbeing--theme.css' | asset_url | stylesheet_tag }}
{{ 'sleep-and-wellbeing--product.css' | asset_url | stylesheet_tag }}
{% render 'sleep-and-wellbeing--css-variables' %}
{% comment %}
  =============================================================================
  SECTION: Featured Product — Christmas Luxury Editorial
  =============================================================================
  Design target:
  - Warm ivory editorial canvas
  - Three-column layout: copy / product image / feature stack
  - No automatic decorative stars, branches, ornaments, or icon graphics
  - Christmas decoration is manual through uploaded top/bottom artwork
  - Feature icons are optional uploads only
  - Product can be selected from Shopify or populated manually
  =============================================================================
{% endcomment %}

{%- assign featured_product = section.settings.product -%}

{%- if featured_product != blank -%}
  {%- assign product_title = featured_product.title -%}
  {%- assign product_description = featured_product.description -%}
  {%- assign product_price = featured_product.price -%}
  {%- assign product_compare_price = featured_product.compare_at_price -%}
  {%- assign product_url = featured_product.url -%}
  {%- assign product_image = featured_product.featured_image -%}
{%- else -%}
  {%- assign product_title = section.settings.manual_title -%}
  {%- assign product_description = section.settings.manual_description -%}
  {%- assign product_price = section.settings.manual_price | times: 100 -%}
  {%- assign product_compare_price = section.settings.manual_compare_price | times: 100 -%}
  {%- assign product_url = section.settings.manual_url -%}
  {%- assign product_image = section.settings.manual_image -%}
{%- endif -%}

{%- assign heading_size = section.settings.heading_size | default: 3 | plus: 0 -%}
{%- case heading_size -%}
  {%- when 1 -%}
    {%- assign heading_min = 34 -%}
    {%- assign heading_max = 42 -%}
  {%- when 2 -%}
    {%- assign heading_min = 38 -%}
    {%- assign heading_max = 48 -%}
  {%- when 3 -%}
    {%- assign heading_min = 42 -%}
    {%- assign heading_max = 56 -%}
  {%- when 4 -%}
    {%- assign heading_min = 46 -%}
    {%- assign heading_max = 64 -%}
  {%- else -%}
    {%- assign heading_min = 50 -%}
    {%- assign heading_max = 72 -%}
{%- endcase -%}

{%- case section.settings.image_aspect_ratio -%}
  {%- when '1:1' -%}{%- assign image_padding = 100 -%}
  {%- when '4:3' -%}{%- assign image_padding = 75 -%}
  {%- when '3:4' -%}{%- assign image_padding = 133.333 -%}
  {%- when '16:9' -%}{%- assign image_padding = 56.25 -%}
  {%- when '9:16' -%}{%- assign image_padding = 177.778 -%}
  {%- else -%}{%- assign image_padding = 125 -%}
{%- endcase -%}

<section
  class="fp-section fp-section--{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --fp-bg: {{ section.settings.background_color }};
    --fp-text: {{ section.settings.text_color }};
    --fp-accent: {{ section.settings.accent_color }};
    --fp-btn-bg: {{ section.settings.button_background }};
    --fp-btn-text: {{ section.settings.button_text_color }};
    --fp-card-bg: {{ section.settings.feature_card_background }};
    --fp-card-border: {{ section.settings.feature_card_border }};
    --fp-card-hover-bg: {{ section.settings.feature_card_hover_background }};
    --fp-card-hover-text: {{ section.settings.feature_card_hover_text }};
    --fp-heading-min: {{ heading_min }}px;
    --fp-heading-max: {{ heading_max }}px;
    --fp-gap: {{ section.settings.section_gap }}px;
    --fp-radius: {{ section.settings.border_radius }}px;
    --fp-padding-x: {{ section.settings.padding_horizontal }}px;
    --fp-padding-y: {{ section.settings.padding_vertical }}px;
  "
>
  {%- comment -%}
    Manual decoration only. These images are intentionally not generated by CSS.
  {%- endcomment -%}

  {%- if section.settings.show_top_decoration and section.settings.top_decoration_image != blank -%}
    <div
      class="fp-decoration fp-decoration--top"
      style="
        --fp-decoration-width: {{ section.settings.top_decoration_width }}%;
        --fp-decoration-opacity: {{ section.settings.top_decoration_opacity | divided_by: 100.0 }};
      "
      aria-hidden="true"
    >
      {{ section.settings.top_decoration_image
        | image_url: width: 2000
        | image_tag:
          class: 'fp-decoration__image',
          loading: 'lazy',
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw'
      }}
    </div>
  {%- endif -%}

  <div
    class="fp-inner"
    style="
      max-width: {{ section.settings.max_content_width }}px;
      margin-inline: auto;
    "
  >
    <div class="fp-col fp-col--copy">
      {%- if section.settings.eyebrow != blank -%}
        <div class="fp-eyebrow-row">
          <span class="fp-eyebrow-line" aria-hidden="true"></span>
          <p class="fp-eyebrow">{{ section.settings.eyebrow }}</p>
          <span class="fp-eyebrow-line" aria-hidden="true"></span>
        </div>
      {%- endif -%}

      <h2 class="fp-title">{{ product_title | default: 'Weighted Blanket' }}</h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="fp-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if product_description != blank -%}
        <div class="fp-description">{{ product_description }}</div>
      {%- endif -%}

      {%- if section.settings.benefit_1 != blank or section.settings.benefit_2 != blank or section.settings.benefit_3 != blank -%}
        <ul class="fp-benefits" role="list">
          {%- if section.settings.benefit_1 != blank -%}
            <li class="fp-benefit">
              <span class="fp-check" aria-hidden="true">✓</span>
              <span>{{ section.settings.benefit_1 }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.benefit_2 != blank -%}
            <li class="fp-benefit">
              <span class="fp-check" aria-hidden="true">✓</span>
              <span>{{ section.settings.benefit_2 }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.benefit_3 != blank -%}
            <li class="fp-benefit">
              <span class="fp-check" aria-hidden="true">✓</span>
              <span>{{ section.settings.benefit_3 }}</span>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <div class="fp-price-cta">
        {%- if product_price > 0 -%}
          <div class="fp-price-block">
            {%- if product_compare_price > product_price -%}
              <span class="fp-price fp-price--compare">{{ product_compare_price | money }}</span>
            {%- endif -%}
            <span class="fp-price">
              {%- if section.settings.price_prefix != blank -%}
                {{ section.settings.price_prefix }}&nbsp;
              {%- endif -%}
              {{ product_price | money }}
            </span>
          </div>
        {%- endif -%}

        {%- assign cta_url = product_url -%}
        {%- if section.settings.custom_cta_url != blank -%}
          {%- assign cta_url = section.settings.custom_cta_url -%}
        {%- endif -%}

        {%- if cta_url != blank -%}
          <a
            href="{{ cta_url }}"
            class="fp-btn"
            {% if section.settings.cta_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <span>{{ section.settings.cta_label }}</span>
            <span class="fp-btn-arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_seasonal_note and section.settings.seasonal_note != blank -%}
        <div class="fp-seasonal-note">
          {%- if section.settings.seasonal_note_icon != blank -%}
            {{ section.settings.seasonal_note_icon
              | image_url: width: 80
              | image_tag:
                class: 'fp-seasonal-note__icon',
                loading: 'lazy',
                widths: '40, 60, 80',
                sizes: '24px'
            }}
          {%- endif -%}
          <span>{{ section.settings.seasonal_note }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="fp-col fp-col--image">
      {%- if product_image != blank -%}
        <div class="fp-image-frame">
          <div class="fp-image-wrap" style="padding-bottom: {{ image_padding }}%;">
            {{ product_image
              | image_url: width: 1800
              | image_tag:
                class: 'fp-image',
                loading: 'lazy',
                widths: '600, 900, 1200, 1500, 1800',
                sizes: '(max-width: 760px) 100vw, 42vw'
            }}
          </div>

          {%- if section.settings.show_product_badge and section.settings.product_badge_text != blank -%}
            <div class="fp-product-badge">
              <span>{{ section.settings.product_badge_text }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="fp-image-wrap fp-image-wrap--placeholder" style="padding-bottom: {{ image_padding }}%;">
          <div class="fp-placeholder">Select a product image</div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="fp-col fp-col--features">
        <div class="fp-features">
          {%- for block in section.blocks -%}
            <article class="fp-feature-card" {{ block.shopify_attributes }}>
              {%- if block.settings.feature_image != blank -%}
                <div class="fp-feature-icon">
                  {{ block.settings.feature_image
                    | image_url: width: 160
                    | image_tag:
                      class: 'fp-feature-image',
                      loading: 'lazy',
                      widths: '80, 120, 160',
                      sizes: '48px'
                  }}
                </div>
              {%- endif -%}

              <div class="fp-feature-content">
                {%- if block.settings.feature_title != blank -%}
                  <h3 class="fp-feature-title">{{ block.settings.feature_title }}</h3>
                {%- endif -%}

                {%- if block.settings.feature_description != blank -%}
                  <p class="fp-feature-desc">{{ block.settings.feature_description }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_bottom_decoration and section.settings.bottom_decoration_image != blank -%}
    <div
      class="fp-decoration fp-decoration--bottom"
      style="
        --fp-decoration-width: {{ section.settings.bottom_decoration_width }}%;
        --fp-decoration-opacity: {{ section.settings.bottom_decoration_opacity | divided_by: 100.0 }};
      "
      aria-hidden="true"
    >
      {{ section.settings.bottom_decoration_image
        | image_url: width: 2000
        | image_tag:
          class: 'fp-decoration__image',
          loading: 'lazy',
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw'
      }}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .fp-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    box-sizing: border-box;
    background: var(--fp-bg);
    color: var(--fp-text);
    padding: var(--fp-padding-y) var(--fp-padding-x);
  }

  .fp-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(300px, .91fr) minmax(420px, 1.16fr) minmax(280px, .70fr);
    gap: var(--fp-gap);
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    
  }

  .fp-col {
    min-width: 0;
  }

  .fp-col--copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fp-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 26px;
    width: 100%;
    max-width: 330px;
  }

  .fp-eyebrow {
    margin: 0;
    flex: 0 0 auto;
    color: var(--fp-accent);
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .fp-eyebrow-line {
    display: block;
    flex: 1 1 auto;
    height: 1px;
    background: var(--fp-accent);
    opacity: .55;
  }

  .fp-title {
    margin: 0;
    max-width: 540px;
    color: var(--fp-text);
    font-family: var(--font-heading-family);
    font-size: clamp(var(--fp-heading-min), 4vw, var(--fp-heading-max));
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.045em;
  }

  .fp-subtitle {
    margin: 20px 0 0;
    max-width: 510px;
    color: var(--fp-text);
    font-family: var(--font-heading-family);
    font-size: clamp(20px, 2vw, 27px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.02em;
  }

  .fp-description {
    margin-top: 22px;
    max-width: 500px;
    color: var(--fp-text);
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.72;
    opacity: .66;
  }

  .fp-description p {
    margin: 0 0 8px;
  }

  .fp-benefits {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .fp-benefit {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--fp-text);
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.45;
  }

  .fp-check {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--fp-accent);
    font-size: 18px;
    line-height: 1;
  }

  .fp-price-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 34px;
  }

  .fp-price-block {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .fp-price {
    color: #6B1F2A;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 2.6vw, 37px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.035em;
  }

  .fp-price--compare {
    color: var(--fp-text);
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 400;
    opacity: .42;
    text-decoration: line-through;
  }

  .fp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 56px;
    padding: 0 30px;
    border-radius: 7px;
    background: var(--fp-btn-bg);
    color: var(--fp-btn-text);
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .13em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .24s ease, box-shadow .24s ease;
  }

  .fp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(17,26,22,.12);
  }

  .fp-btn-arrow {
    font-size: 20px;
    line-height: 1;
    transition: transform .24s ease;
  }

  .fp-btn:hover .fp-btn-arrow {
    transform: translateX(4px);
  }

  .fp-seasonal-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    color: var(--fp-accent);
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .fp-seasonal-note__icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
    flex: 0 0 24px;
  }

  .fp-image-frame {
    position: relative;
  }

  .fp-image-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--fp-radius);
    background: #ddd4c8;
    box-shadow: 0 18px 42px rgba(17,26,22,.10);
  }

  .fp-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .8s cubic-bezier(.2,.65,.25,1);
  }

  .fp-image-wrap:hover .fp-image {
    transform: scale(1.022);
  }

  .fp-product-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    padding: 10px 16px;
    border: 1px solid rgba(181,154,98,.70);
    border-radius: 999px;
    background: rgba(17,26,22,.92);
    color: var(--fp-btn-text);
    box-shadow: 0 10px 22px rgba(17,26,22,.14);
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .11em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fp-image-wrap--placeholder {
    display: grid;
    place-items: center;
  }

  .fp-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--fp-text);
    font-size: 13px;
    opacity: .45;
  }

  .fp-features {
    display: grid;
    gap: 13px;
    width: 100%;
  }

  .fp-feature-card {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 94px;
    padding: 15px 18px;
    box-sizing: border-box;
    border: 1px solid var(--fp-card-border);
    border-radius: var(--fp-radius);
    background: var(--fp-card-bg);
    color: var(--fp-text);
    transition: transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .fp-feature-card:hover {
    transform: translateX(-4px);
    border-color: var(--fp-accent);
    background: var(--fp-card-hover-bg);
    color: var(--fp-card-hover-text);
    box-shadow: 0 10px 24px rgba(17,26,22,.08);
  }

  .fp-feature-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    overflow: hidden;
    border-radius: 50%;
    background: #2D3A30;
  }

  .fp-feature-image {
    display: block;
    width: 70%;
    height: 70%;
    object-fit: contain;
  }

  .fp-feature-content {
    min-width: 0;
  }

  .fp-feature-title {
    margin: 0 0 5px;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: .10em;
    text-transform: uppercase;
  }

  .fp-feature-desc {
    margin: 0;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.45;
    opacity: .68;
  }

  .fp-decoration {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    pointer-events: none;
    line-height: 0;
    opacity: var(--fp-decoration-opacity);
  }

  .fp-decoration--top {
    top: 0;
  }

  .fp-decoration--bottom {
    bottom: 0;
  }

  .fp-decoration__image {
    display: block;
    width: var(--fp-decoration-width);
    max-width: none;
    height: auto;
    object-fit: contain;
  }

  .fp-decoration--top .fp-decoration__image {
    margin-left: auto;
    margin-right: 0;
  }

  .fp-decoration--bottom .fp-decoration__image {
    margin-left: 0;
    margin-right: auto;
  }

  @media (max-width: 1180px) {
    .fp-inner {
      grid-template-columns: minmax(270px, .95fr) minmax(380px, 1.05fr);
    }

    .fp-col--features {
      grid-column: 1 / -1;
    }

    .fp-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .fp-section {
      padding: 50px 20px;
    }

    .fp-inner {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .fp-col--image {
      order: -1;
      width: 100%;
    }

    .fp-eyebrow-row {
      margin-bottom: 22px;
    }

    .fp-title {
      font-size: clamp(40px, 12vw, 54px);
    }

    .fp-subtitle {
      font-size: 21px;
    }

    .fp-description {
      font-size: 14px;
    }

    .fp-price-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .fp-btn {
      width: 100%;
    }

    .fp-features {
      grid-template-columns: 1fr;
    }

    .fp-decoration__image {
      width: min(var(--fp-decoration-width), 100%);
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-image,
    .fp-btn,
    .fp-btn-arrow,
    .fp-feature-card {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Product",
  "tag": "section",
  "class": "section-featured-product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Product source"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select product",
      "info": "Uses the product title, description, price and featured image."
    },
    {
      "type": "text",
      "id": "manual_title",
      "label": "Manual product title",
      "default": "Weighted Blanket"
    },
    {
      "type": "richtext",
      "id": "manual_description",
      "label": "Manual description",
      "default": "<p>Our signature blanket uses gentle, even pressure to calm your body and quiet your mind.</p>"
    },
    {
      "type": "number",
      "id": "manual_price",
      "label": "Manual price",
      "default": 199
    },
    {
      "type": "number",
      "id": "manual_compare_price",
      "label": "Manual compare-at price",
      "default": 0
    },
    {
      "type": "url",
      "id": "manual_url",
      "label": "Manual product URL"
    },
    {
      "type": "image_picker",
      "id": "manual_image",
      "label": "Manual product image"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE WINTER EDIT · 01"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Deep pressure. Deeper rest."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "1", "label": "Small" },
        { "value": "2", "label": "Medium" },
        { "value": "3", "label": "Large" },
        { "value": "4", "label": "Extra large" },
        { "value": "5", "label": "Display" }
      ],
      "default": "3"
