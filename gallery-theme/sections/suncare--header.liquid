{%- comment -%} Section Library: injected global assets for store "suncare" {%- endcomment -%}
{{ 'suncare--base.css' | asset_url | stylesheet_tag }}
{{ 'suncare--components.css' | asset_url | stylesheet_tag }}
{% render 'suncare--layout-tokens' %}
{{ 'suncare--global.js' | asset_url | script_tag }}
{{ 'suncare--wishlist.js' | asset_url | script_tag }}
{%- comment -%}
  Site header. Layouts: logo-left (nav center), logo-center (nav left, Cocobella),
  minimal (nav right, noir). Optional pill nav, sticky, CTA button, icons.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign menu = section.settings.menu
  assign has_cta = false
  if section.settings.cta_label != blank
    assign has_cta = true
  endif
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<header {{ section_colors_style }}
  class="site-header site-header--{{ layout }}{% if section.settings.pill_nav %} site-header--pills{% endif %}{% if section.settings.sticky %} site-header--sticky{% endif %}"
  role="banner"
>
  <div class="page-width site-header__inner" style="--logo-width: {{ section.settings.logo_width }}px;">
    <button
      type="button"
      class="header-icon site-header__burger"
      data-mobile-nav-open
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      {% render 'suncare--icon', name: 'menu', size: 20 %}
    </button>

    {%- if settings.logo != blank -%}
      <a href="{{ routes.root_url }}" class="site-header__logo">
        {{ settings.logo | image_url: width: 600 | image_tag: widths: '150, 300, 450, 600', alt: shop.name, style: 'width: 100%;' }}
      </a>
    {%- else -%}
      <a href="{{ routes.root_url }}" class="site-header__wordmark">
        {{ section.settings.wordmark | default: shop.name }}
        {%- if section.settings.tagline != blank -%}<small>{{ section.settings.tagline }}</small>{%- endif -%}
      </a>
    {%- endif -%}

    <nav class="site-header__nav" aria-label="{{ 'sections.header.navigation' | t }}">
      <ul>
        {%- for link in linklists[menu].links -%}
          <li>
            <a href="{{ link.url }}" class="site-header__link{% if link.current or link.child_active %} is-active{% endif %}">
              {{ link.title | escape }}
              {%- if link.links.size > 0 -%}{% render 'suncare--icon', name: 'chevron-down', size: 10 %}{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="header-icon header-icon--secondary" aria-label="{{ 'general.search.search' | t }}">
          {% render 'suncare--icon', name: 'search', size: 18 %}
        </a>
      {%- endif -%}
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header-icon header-icon--secondary" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'suncare--icon', name: 'account', size: 18 %}
        </a>
      {%- endif -%}
      {%- if section.settings.show_cart -%}
        <a
          href="{{ routes.cart_url }}"
          class="header-icon"
          {% if settings.cart_type == 'drawer' %}data-cart-open{% endif %}
          aria-label="{{ 'sections.cart.title' | t }}"
        >
          {% render 'suncare--icon', name: 'cart', size: 18 %}
          <span class="header-icon__label" data-cart-count{% if cart.item_count == 0 %} style="display: none;"{% endif %}>
            {{- cart.item_count -}}
          </span>
        </a>
      {%- endif -%}
      {%- if has_cta -%}
        <span class="site-header__cta desktop-only">
          {% render 'suncare--button', label: section.settings.cta_label, link: section.settings.cta_link, style: section.settings.cta_style, size: 'small' %}
        </span>
      {%- endif -%}
    </div>
  </div>

  <div class="mobile-nav" id="MobileNav-{{ section.id }}" aria-hidden="true">
    <div class="mobile-nav__overlay" data-mobile-nav-close></div>
    <div class="mobile-nav__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
      <div class="mobile-nav__header">
        <p class="mobile-nav__title h5">{{ 'sections.header.menu' | t }}</p>
        <button type="button" class="mobile-nav__close" data-mobile-nav-close aria-label="{{ 'accessibility.close' | t }}">
          {% render 'suncare--icon', name: 'close' %}
        </button>
      </div>
      <div class="mobile-nav__body">
        <nav class="mobile-nav__links">
          {%- for link in linklists[menu].links -%}
            <a href="{{ link.url }}" class="mobile-nav__link{% if link.current %} is-active{% endif %}">{{ link.title | escape }}</a>
            {%- for child in link.links -%}
              <a href="{{ child.url }}" class="mobile-nav__link mobile-nav__link--child">{{ child.title | escape }}</a>
            {%- endfor -%}
          {%- endfor -%}
        </nav>
      </div>
      {%- if has_cta -%}
        <div class="mobile-nav__footer">
          {% render 'suncare--button', label: section.settings.cta_label, link: section.settings.cta_link, style: section.settings.cta_style, full: true %}
        </div>
      {%- endif -%}
    </div>
  </div>
</header>

{% style %}
  @media (max-width: 989px) {
    /* Design: wordmark left, burger right on mobile */
    .site-header .site-header__burger { order: 3; }
  }
{% endstyle %}
{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "logo-left",
          "label": "Logo left, nav center"
        },
        {
          "value": "logo-center",
          "label": "Nav left, centered logo"
        },
        {
          "value": "minimal",
          "label": "Minimal, nav right"
        }
      ],
      "default": "logo-left"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark override",
      "info": "Shown when no logo image is set. Defaults to shop name."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Wordmark tagline",
      "info": "Small uppercase line under the shop name, e.g. ARTISAN CHOCOLATES"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 250,
      "step": 2,
      "unit": "px",
      "default": 150
    },
    {
      "type": "checkbox",
      "id": "pill_nav",
      "label": "Pill-style navigation",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Call-to-action button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Accent"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "header",
      "content": "Enriched shape"
    },
    {
      "type": "range",
      "id": "enr_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "enr_border_width",
      "label": "Card border width",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1 px"
        },
        {
          "value": "2",
          "label": "2 px"
        },
        {
          "value": "3",
          "label": "3 px"
        },
        {
          "value": "4",
          "label": "4 px"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "Enriched sizes (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_sizes",
      "label": "Enable custom sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_title_size",
      "label": "Title size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "enr_body_size",
      "label": "Body size",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "enr_eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "enr_icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Enriched spacing (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_space_top",
      "label": "Space top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_space_bottom",
      "label": "Space bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media",
      "label": "Enable custom media heights",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_media_height",
      "label": "Media height (desktop)",
      "min": 380,
      "max": 580,
      "step": 2,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 300,
      "max": 500,
      "step": 2,
      "unit": "px",
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
  {% endschema %}
