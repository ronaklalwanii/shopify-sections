{%- comment -%} Section Library: injected global assets for store "speed" {%- endcomment -%}
{{ 'speed--base.css' | asset_url | stylesheet_tag }}
{{ 'speed--components.css' | asset_url | stylesheet_tag }}
{% render 'speed--layout-tokens' %}
{%- comment -%}
  Featured collection — product grid or carousel ("New This Season", "Bestsellers").
{%- endcomment -%}
{%- liquid
  assign products = collections[section.settings.collection].products
  assign limit = section.settings.products_count
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }} class="section fct" style="--section-space: {{ section.settings.padding | default: 72 }}px;">
  <div class="page-width">
    <div class="section-intro{% if section.settings.heading_align == 'left' %} section-intro--left{% endif %}">
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <span class="eyebrow fct__eyebrow">
          {%- if section.settings.eyebrow_icon -%}
            <svg class="fct__star" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12 1.5 14 8l6-2.8-4.2 5.1L22 12l-6.2 1.7L20 18.8 14 16l-2 6.5L10 16l-6 2.8 4.2-5.1L2 12l6.2-1.7L4 5.2 10 8l2-6.5z" fill="#f2a7cc"/><circle cx="12" cy="12" r="3.4" fill="#fbe3ef"/></svg>
          {%- endif -%}
          {{ section.settings.eyebrow | escape }}
        </span>
      {%- endif -%}
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="h2 section-intro__title{% if section.settings.ornate %} section-intro--ornate{% endif %}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.show_subheading and section.settings.subheading != blank -%}
        <p class="section-intro__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="fct__tabs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'category_tab' -%}
              <a href="{{ block.settings.link | default: '#' }}" class="fct__tab" {{ block.shopify_attributes }}>
                <span>{{ block.settings.label | escape }}</span>
                <span class="fct__tab-line" aria-hidden="true"></span>
                {%- if block.settings.count != blank -%}<span class="fct__tab-count">{{ block.settings.count | escape }}</span>{%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_tabs_nav -%}
      <div class="fct__nav">
        <div class="fct__nav-tabs">
          <span class="fct__nav-tab is-active">{{ section.settings.tab_1_label | escape }}<sup class="fct__nav-dot"></sup></span>
          {%- if section.settings.tab_2_label != blank -%}
            <span class="fct__nav-tab">{{ section.settings.tab_2_label | escape }}</span>
          {%- endif -%}
        </div>
        <div class="fct__nav-arrows">
          <button type="button" class="fct__arrow fct__arrow--muted" aria-label="{{ 'general.slider.previous' | t }}">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M20 12H4m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <button type="button" class="fct__arrow" aria-label="{{ 'general.slider.next' | t }}">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M4 12h16m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'carousel' -%}
      <div class="card-carousel" data-carousel>
        <div class="card-carousel__track" style="--visible: {{ section.settings.columns }};">
          {%- if products.size > 0 -%}
            {%- for product in products limit: limit -%}
              {% render 'speed--product-card',
                product: product,
                show_subtitle: section.settings.show_subtitle,
                subtitle_source: section.settings.subtitle_source,
                subtitle_text: section.settings.subtitle_text,
                show_price: section.settings.show_price,
                show_rating: section.settings.show_rating,
                rating_count: section.settings.rating_count,
                show_button: section.settings.show_button,
                button_label: section.settings.button_label,
                button_style: section.settings.card_button_style,
                image_ratio: section.settings.image_ratio,
                badge_text: section.settings.badge_text,
                show_swatches: section.settings.show_swatches,
                swatches: section.settings.swatches,
                show_wishlist: section.settings.show_wishlist,
                price_align: section.settings.price_align,
                show_quick_add: section.settings.show_quick_add
              %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..limit) -%}
              {%- assign ph = 'product-' | append: i -%}
              <div class="card">
                <div class="card__media ratio-{{ section.settings.image_ratio | default: 'portrait' }}">
                  {{ ph | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="card__content">
                  <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
                  <p class="card__price">{{ 1999 | money }}</p>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <button type="button" class="card-carousel__arrow card-carousel__arrow--prev" data-carousel-prev aria-label="{{ 'general.slider.previous' | t }}">
          <span class="icon-button">{% render 'speed--icon', name: 'chevron-left', size: 14 %}</span>
        </button>
        <button type="button" class="card-carousel__arrow card-carousel__arrow--next" data-carousel-next aria-label="{{ 'general.slider.next' | t }}">
          <span class="icon-button">{% render 'speed--icon', name: 'chevron-right', size: 14 %}</span>
        </button>
      </div>
    {%- else -%}
      <div class="product-grid product-grid--cols-{{ section.settings.columns }}">
        {%- if products.size > 0 -%}
          {%- for product in products limit: limit -%}
            {% render 'speed--product-card',
              product: product,
              show_subtitle: section.settings.show_subtitle,
              subtitle_source: section.settings.subtitle_source,
              subtitle_text: section.settings.subtitle_text,
              show_price: section.settings.show_price,
              show_rating: section.settings.show_rating,
              rating_count: section.settings.rating_count,
              show_button: section.settings.show_button,
              button_label: section.settings.button_label,
              button_style: section.settings.card_button_style,
              image_ratio: section.settings.image_ratio,
              badge_text: section.settings.badge_text,
              show_swatches: section.settings.show_swatches,
              swatches: section.settings.swatches,
              show_wishlist: section.settings.show_wishlist,
              price_align: section.settings.price_align,
              show_quick_add: section.settings.show_quick_add
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            {%- assign ph = 'product-' | append: i -%}
            <div class="card">
              <div class="card__media ratio-{{ section.settings.image_ratio | default: 'portrait' }}">
                {{ ph | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="card__content">
                <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
                <p class="card__price">{{ 1999 | money }}</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.section_button_label != blank -%}
      {%- assign view_all_url = section.settings.button_link -%}
      {%- if view_all_url == blank -%}{%- assign view_all_url = collections[section.settings.collection].url -%}{%- endif -%}
      <div style="text-align: center; margin-top: clamp(1.5rem, 3vw, 2.5rem);">
        {% render 'speed--button', label: section.settings.section_button_label, link: view_all_url, style: section.settings.button_style %}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  /* SPEED featured-collection treatment */
  .fct .fct__eyebrow { font-family: var(--font-mono); letter-spacing: 0.24em; text-transform: uppercase; font-size: 0.72rem; display: inline-flex; align-items: center; gap: 0.6rem; }
  .fct .fct__star { flex: none; }
  .fct .section-intro__title {
    font-family: var(--font-heading); font-weight: 400; text-transform: uppercase;
    font-size: clamp(2.5rem, 4.9vw, 4.6rem); line-height: 0.98; letter-spacing: 0.005em;
    max-width: 46rem; margin-inline: auto;
  }
  .fct .section-intro__sub { font-size: 0.9rem; max-width: 34rem; }
  .fct .fct__tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.7rem; }
  .fct .fct__tab {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; width: 13.5rem;
    border: 1px solid #e3e3e3; border-radius: 8px; padding: 0.68rem 1rem;
    font-size: 0.88rem; color: var(--color-heading); text-decoration: none; background: #fff;
  }
  .fct .fct__tab:hover { border-color: #bdbdbd; }
  .fct .fct__tab-count { color: var(--color-heading); }
  .fct .fct__tab-line { flex: 1 1 auto; height: 1px; background: #e5e5e5; min-width: 2rem; }
  .fct .fct__nav { display: flex; align-items: center; justify-content: space-between; margin-top: 2.4rem; margin-bottom: 1.3rem; }
  .fct .fct__nav-tabs { display: flex; align-items: baseline; gap: 1.6rem; }
  .fct .fct__nav-tab { font-size: 1.05rem; color: #b3b3b3; cursor: pointer; }
  .fct .fct__nav-tab.is-active { color: var(--color-heading); font-weight: 500; }
  .fct .fct__nav-dot { display: inline-block; width: 5px; height: 5px; margin-left: 2px; background: #35b24a; border-radius: 50%; vertical-align: super; }
  .fct .fct__nav-arrows { display: flex; align-items: center; gap: 1.1rem; }
  .fct .fct__arrow { background: none; border: 0; padding: 0; color: var(--color-heading); cursor: pointer; display: inline-flex; }
  .fct .fct__arrow--muted { color: #c3c3c3; }
  /* cards */
  .fct .product-grid { gap: 1.6rem; }
  .fct .card__media { background: #f6f6f6; border-radius: 14px; overflow: hidden; border: 0; }
  .fct .card__media.ratio-square { aspect-ratio: 1 / 1; }
  .fct .card__badge { background: #ffffff; color: #2e6bd6; border: 1px solid #e2e8f2; border-radius: 999px; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em; padding: 0.34rem 0.85rem; top: 0.9rem; left: 0.9rem; }
  .fct .card__title { font-size: 0.98rem; font-weight: 400; font-family: var(--font-body); }
  .fct .card__title a { color: inherit; text-decoration: none; }
  .fct .product-card--split .card__row--top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .fct .product-card--split .price { font-weight: 700; font-size: 1.35rem; letter-spacing: -0.01em; }
  .fct .product-card--split .card__row--bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 0.55rem; }
  .fct .card__quick {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    border: 1px solid #b9b9b9; background: #fff; color: var(--color-heading); cursor: pointer;
  }
  .fct .card__quick:hover { border-color: var(--color-heading); }
  .fct .card__swatches { display: inline-flex; align-items: center; gap: 0.45rem; }
  .fct .card__swatches i { width: 13px; height: 13px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.14); display: inline-block; }
{% endstyle %}

{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "products_count",
      "label": "Products to show",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "7",
          "label": "7"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "9",
          "label": "9"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "11",
          "label": "11"
        },
        {
          "value": "12",
          "label": "12"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "tall",
          "label": "Tall (4:5)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
      "label": "Show secondary line",
      "default": true
    },
    {
      "type": "select",
      "id": "subtitle_source",
      "label": "Secondary line source",
      "options": [
        {
          "value": "vendor",
          "label": "Vendor"
        },
        {
          "value": "type",
          "label": "Product type"
        },
        {
          "value": "custom",
          "label": "Custom text"
        }
      ],
      "default": "vendor"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "Custom secondary text",
      "info": "Used when source is Custom text, e.g. CLEANSER"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "select",
      "id": "price_align",
      "label": "Price layout",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "split",
          "label": "Title left / price right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": false
    },
    {
      "type": "text",
