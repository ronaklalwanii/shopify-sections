        {
          "type": "card",
          "settings": {
            "title_override": "Premium Sauna Towel Set",
            "description": "Ultra-soft. Highly absorbent.",
            "price_fallback": "£120"
          }
        },
        {
          "type": "card",
          "settings": {
            "title_override": "Ambient Sauna Light",
            "description": "Create the perfect atmosphere.",
            "price_fallback": "£195"
          }
        }
      ]
    }
  ]
}
{% endschema %}
