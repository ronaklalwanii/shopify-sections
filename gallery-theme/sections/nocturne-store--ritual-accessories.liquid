  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Ritual accessories",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title_override": "Sauna Bucket + Ladle",
            "description": "Handcrafted from natural timber.",
            "price_fallback": "£149"
          }
        },
        {
          "type": "card",
          "settings": {
            "title_override": "Essential Oil Collection",
            "description": "Pure essential oils for mind and body.",
            "price_fallback": "£65"
          }
        },
        {
          "type": "card",
          "settings": {
            "title_override": "Sauna Headrest",
