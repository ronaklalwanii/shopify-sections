  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Title, price and image come from the product when set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. Overrides the product image."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Custom title",
          "info": "Optional. Overrides the product title."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Handcrafted from natural timber."
        },
        {
          "type": "text",
          "id": "price_fallback",
          "label": "Fallback price",
          "info": "Only used when no product is selected.",
          "default": "£149"
        }
      ]
