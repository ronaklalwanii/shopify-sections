{%- comment -%} Section Library: injected global assets for store "nocturne-store" {%- endcomment -%}
{{ 'nocturne-store--theme.css' | asset_url | stylesheet_tag }}
{{ 'nocturne-store--product.css' | asset_url | stylesheet_tag }}
{% render 'nocturne-store--css-variables' %}
{% liquid
  assign brand_block = blank
  assign navigation_columns = 0
%}

<footer
  class="minimal-footer minimal-footer--{{ section.id }}"
  style="
    --mf-bg: {{ section.settings.background }};
    --mf-text: {{ section.settings.text_color }};
    --mf-muted: {{ section.settings.muted_color }};
    --mf-accent: {{ section.settings.accent_color }};
    --mf-divider: {{ section.settings.divider_color }};
    --mf-heading-font: {{ section.settings.heading_font }};
    --mf-title-font: {{ section.settings.title_font }};
    --mf-body-font: {{ section.settings.body_font }};
    --mf-giant-font: {{ section.settings.giant_brand_font }};
    --mf-max-width: {{ section.settings.max_width }}px;
  "
>
  <div class="minimal-footer__inner">

    {%- comment -%}
      TOP CONTENT
    {%- endcomment -%}

    <div class="minimal-footer__top">

      {%- for block in section.blocks -%}

        {% case block.type %}

          {%- when 'brand' -%}

            <div
              class="minimal-footer__brand"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.logo != blank %}
                <a
                  href="{{ routes.root_url }}"
                  class="minimal-footer__logo-link"
                >
                  {{
                    block.settings.logo
                    | image_url: width: block.settings.logo_width
                    | image_tag:
                      class: 'minimal-footer__logo',
                      loading: 'lazy',
                      widths: '120, 180, 240, 320'
                  }}
                </a>
              {% else %}
                <a
                  href="{{ routes.root_url }}"
                  class="minimal-footer__text-logo"
                >
                  {{ shop.name }}
                </a>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="minimal-footer__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}
            </div>

          {%- when 'navigation_column' -%}

            {% assign navigation_columns = navigation_columns | plus: 1 %}

            <div
              class="minimal-footer__column minimal-footer__accordion-item"
              data-column-id="{{ block.settings.column_id | handleize }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.heading != blank %}
                <h3 class="minimal-footer__column-title minimal-footer__accordion-trigger">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}

              <div class="minimal-footer__links minimal-footer__accordion-content">

                {% for link_block in section.blocks %}

                  {% if link_block.type == 'navigation_link' %}
                    {% assign link_column = link_block.settings.column_id | handleize %}
                    {% assign current_column = block.settings.column_id | handleize %}

                    {% if link_column == current_column %}
                      <a
                        href="{{ link_block.settings.url | default: '#' }}"
                        class="minimal-footer__link"
                        {{ link_block.shopify_attributes }}
                      >
                        {{ link_block.settings.label }}
                      </a>
                    {% endif %}
                  {% endif %}

                {% endfor %}

              </div>
            </div>

        {% endcase %}

      {%- endfor -%}

    </div>


    {%- comment -%}
      BOTTOM AREA
    {%- endcomment -%}

    <div class="minimal-footer__bottom">

      <div class="minimal-footer__copyright">
        {% if section.settings.copyright_text != blank %}
          ©
          {% if section.settings.auto_year %}
            {{ 'now' | date: '%Y' }}
          {% else %}
            {{ section.settings.copyright_year }}
          {% endif %}
          {{ section.settings.copyright_text }}
        {% endif %}
      </div>


      <div class="minimal-footer__legal">

        {% for block in section.blocks %}

          {% if block.type == 'legal_link' %}
            <a
              href="{{ block.settings.url | default: '#' }}"
              class="minimal-footer__legal-link"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {% endif %}

        {% endfor %}

      </div>


      <div class="minimal-footer__social">

        {% for block in section.blocks %}

          {% if block.type == 'social_link' %}

            <a
              href="{{ block.settings.url | default: '#' }}"
              class="minimal-footer__social-link"
              aria-label="{{ block.settings.label }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.icon != blank %}
                {{
                  block.settings.icon
                  | image_url: width: 48
                  | image_tag:
                    class: 'minimal-footer__social-icon',
                    loading: 'lazy',
                    widths: '24, 48'
                }}
              {% else %}
                {{ block.settings.label }}
              {% endif %}
            </a>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

  {%- comment -%}
    GIANT BRAND MARK (optional, decorative)
  {%- endcomment -%}

  {%- if section.settings.show_giant_brand -%}
    {%- assign giant_text = section.settings.giant_brand_text | default: shop.name -%}
    <div class="minimal-footer__giant" aria-hidden="true">
      <span
        class="minimal-footer__giant-text"
        data-giant-brand
        data-max-h="{{ section.settings.giant_brand_max_height }}"
      >{{ giant_text }}</span>
    </div>
  {%- endif -%}
</footer>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const footerId = 'minimal-footer--{{ section.id }}';
    const footer = document.getElementById(footerId) || document.querySelector('.' + footerId);

    if (footer) {
      const triggers = footer.querySelectorAll('.minimal-footer__accordion-trigger');

      triggers.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          const parentItem = this.closest('.minimal-footer__accordion-item');
          parentItem.classList.toggle('active');
        });
      });
    }
  });
</script>

<script>
  /* Giant brand mark: auto-fit to footer width, capped height, re-runs on resize/fonts */
  (function () {
    const selector = '.minimal-footer--{{ section.id }} [data-giant-brand]';

    function fitGiantBrand() {
      document.querySelectorAll(selector).forEach(function (el) {
        const wrap = el.parentNode;
        if (!wrap) return;
        const cap = Math.min(
          parseFloat(el.dataset.maxH) || 9999,
          wrap.clientWidth * 0.7
        );
        el.style.fontSize = '100px';
        const scale = Math.min(
          wrap.clientWidth / el.scrollWidth,
          cap / el.scrollHeight
        );
        el.style.fontSize = Math.max(24, Math.floor(100 * scale)) + 'px';
      });
    }

    let resizeTimer;
    window.addEventListener('resize', function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(fitGiantBrand, 150);
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(fitGiantBrand);
    }
    document.addEventListener('DOMContentLoaded', fitGiantBrand);
    document.addEventListener('shopify:section:load', fitGiantBrand);
    fitGiantBrand();
  })();
</script>


<style>
  .minimal-footer--{{ section.id }} {
    background: var(--mf-bg);
    color: var(--mf-text);
    width: 100%;
    overflow: hidden;
  }

  .minimal-footer--{{ section.id }} *,
  .minimal-footer--{{ section.id }} *::before,
  .minimal-footer--{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__inner {
    width: min(100% - 48px, var(--mf-max-width));
    margin: 0 auto;
  }

  /* =========================
     TOP
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__top {
    display: grid;
    grid-template-columns:
      minmax(220px, 1.2fr)
      repeat({{ section.settings.max_columns }}, minmax(140px, 1fr));
    gap: {{ section.settings.column_gap }}px;
    padding-top: {{ section.settings.top_padding }}px;
    padding-bottom: {{ section.settings.bottom_padding }}px;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__brand {
    max-width: {{ section.settings.brand_width }}px;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__logo {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__text-logo {
    display: inline-block;
    color: var(--mf-text);
    text-decoration: none;
    font-family: var(--mf-heading-font);
    font-size: 42px;
    line-height: 1;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__description {
    margin-top: 22px;
    max-width: 380px;
    color: var(--mf-muted);
    font-family: var(--mf-body-font);
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.55;
  }

  /* =========================
     COLUMNS
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__column {
    min-width: 0;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__column-title {
    margin: 0 0 24px;
    color: var(--mf-accent);
    font-family: var(--mf-title-font);
    font-size: {{ section.settings.column_title_size }}px;
    font-weight: {{ section.settings.column_title_weight }};
    line-height: 1.2;
    letter-spacing: {{ section.settings.column_letter_spacing }}px;
    text-transform: {{ section.settings.column_uppercase }};
  }

  .minimal-footer--{{ section.id }} .minimal-footer__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: {{ section.settings.link_gap }}px;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__link {
    color: var(--mf-text);
    font-family: var(--mf-body-font);
    font-size: {{ section.settings.link_size }}px;
    line-height: 1.4;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__link:hover {
    opacity: 0.65;
    transform: translateX(2px);
  }

  /* =========================
     DIVIDER
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__bottom {
    border-top: 1px solid var(--mf-divider);
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 32px;
    padding-top: {{ section.settings.bottom_top_padding }}px;
    padding-bottom: {{ section.settings.bottom_bottom_padding }}px;
  }

  /* =========================
     COPYRIGHT
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__copyright {
    color: var(--mf-muted);
    font-family: var(--mf-body-font);
    font-size: {{ section.settings.copyright_size }}px;
    line-height: 1.4;
  }

  /* =========================
     LEGAL
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__legal-link {
    color: var(--mf-muted);
    font-family: var(--mf-body-font);
    font-size: {{ section.settings.legal_size }}px;
    line-height: 1.4;
    text-decoration: none;
    padding: 0 16px;
    border-left: 1px solid var(--mf-divider);
  }

  .minimal-footer--{{ section.id }} .minimal-footer__legal-link:first-child {
    border-left: 0;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__legal-link:hover {
    color: var(--mf-text);
  }

  /* =========================
     SOCIAL
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__social {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--mf-text);
    text-decoration: none;
    font-family: var(--mf-body-font);
    font-size: 14px;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__social-icon {
    display: block;
    width: {{ section.settings.social_icon_size }}px;
    height: {{ section.settings.social_icon_size }}px;
    object-fit: contain;
  }

  /* =========================
     GIANT BRAND MARK
  ========================= */

  .minimal-footer--{{ section.id }} .minimal-footer__giant {
    width: 100%;
    padding-top: {{ section.settings.giant_brand_top_space }}px;
    text-align: center;
    overflow: hidden;
  }

  .minimal-footer--{{ section.id }} .minimal-footer__giant-text {
    display: inline-block;
    white-space: nowrap;
    font-family: var(--mf-giant-font);
    font-weight: 400;
    line-height: 0.8;
    color: {{ section.settings.giant_brand_color }};
    opacity: {{ section.settings.giant_brand_opacity | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.giant_brand_spacing }}px;
    {% if section.settings.giant_brand_uppercase %}text-transform: uppercase;{% endif %}
    transform: translateY({{ section.settings.giant_brand_offset }}%);
  }

  /* =========================
     TABLET
  ========================= */

  @media screen and (max-width: 990px) {

    .minimal-footer--{{ section.id }} .minimal-footer__top {
      grid-template-columns:
        minmax(200px, 1.2fr)
        repeat(2, minmax(140px, 1fr));
    }

    .minimal-footer--{{ section.id }} .minimal-footer__bottom {
      grid-template-columns: 1fr auto;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__social {
      grid-column: 2;
      justify-content: flex-end;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__copyright {
      grid-column: 1;
      grid-row: 1;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__legal {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
    }
  }

  /* =========================
     MOBILE (Centered Layout)
  ========================= */

  @media screen and (max-width: 749px) {

    .minimal-footer--{{ section.id }} .minimal-footer__inner {
      width: calc(100% - ({{ section.settings.mobile_side_padding }}px * 2));
    }

    .minimal-footer--{{ section.id }} .minimal-footer__top {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: {{ section.settings.mobile_top_padding }}px;
      padding-bottom: 0;
    }

    /* Center Brand & Logo */
    .minimal-footer--{{ section.id }} .minimal-footer__brand {
      max-width: 100%;
      margin-bottom: 0;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--mf-divider);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__logo {
      margin: 0 auto;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__text-logo {
      display: inline-block;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__description {
      max-width: 100%;
      margin-top: 16px;
    }

    /* Accordion Styles */
    .minimal-footer--{{ section.id }} .minimal-footer__accordion-item {
      border-top: 1px solid var(--mf-divider);
    }

    .minimal-footer--{{ section.id }} .minimal-footer__accordion-item:first-child {
      border-top: none;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__accordion-trigger {
      margin: 0;
      padding: 20px 0;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      user-select: none;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__accordion-trigger::after {
      content: '+';
      font-size: 24px;
      font-weight: 300;
      line-height: 1;
      color: var(--mf-text);
    }

    .minimal-footer--{{ section.id }} .minimal-footer__accordion-item.active .minimal-footer__accordion-trigger::after {
      content: '−';
    }

    .minimal-footer--{{ section.id }} .minimal-footer__accordion-content {
      display: none;
      padding-bottom: 20px;
      text-align: center;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__accordion-item.active .minimal-footer__accordion-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__links {
      gap: 16px;
      align-items: center;
    }

    /* Bottom Area - Centered */
    .minimal-footer--{{ section.id }} .minimal-footer__bottom {
      grid-template-columns: 1fr;
      gap: 22px;
      padding-top: 28px;
      padding-bottom: 28px;
      text-align: center;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__copyright,
    .minimal-footer--{{ section.id }} .minimal-footer__legal,
    .minimal-footer--{{ section.id }} .minimal-footer__social {
      grid-column: auto;
      grid-row: auto;
      justify-content: center;
    }

    /* Center Legal Links */
    .minimal-footer--{{ section.id }} .minimal-footer__legal {
      flex-wrap: wrap;
      gap: 8px 12px;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__legal-link {
      padding: 0 8px;
      border-left: 1px solid var(--mf-divider);
    }

    .minimal-footer--{{ section.id }} .minimal-footer__legal-link:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .minimal-footer--{{ section.id }} .minimal-footer__social {
      justify-content: center;
    }
  }
</style>


{% schema %}
{
  "name": "Minimal Footer",
  "tag": "section",
  "class": "section-minimal-footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#A8907D"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#E6E2DE"
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "brand_heading_font",
      "label": "Brand heading font",
      "default": "garamond_n4"
    },
    {
      "type": "font_picker",
      "id": "column_title_font",
      "label": "Column title font",
      "default": "garamond_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "max_columns",
      "label": "Maximum navigation columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "brand_width",
      "label": "Brand width",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Top padding",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "Content bottom padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },

    {
      "type": "header",
      "content": "Column titles"
    },
    {
      "type": "range",
      "id": "column_title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "column_title_weight",
      "label": "Title weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "column_uppercase",
      "label": "Uppercase titles",
      "options": [
        { "value": "none", "label": "No" },
        { "value": "uppercase", "label": "Yes" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "column_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },

    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Link spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Description size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "range",
      "id": "bottom_top_padding",
      "label": "Top padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "bottom_bottom_padding",
      "label": "Bottom padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "copyright_size",
      "label": "Copyright size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "legal_size",
      "label": "Legal link size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "social_icon_size",
      "label": "Social icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
