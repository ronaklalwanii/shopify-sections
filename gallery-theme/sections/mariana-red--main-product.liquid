{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{%- comment -%}
  Main product section — gallery, buy form with variant picker, blocks.
{%- endcomment -%}
{%- liquid
  assign product = product
  assign current = product.selected_or_first_available_variant
-%}
<div class="page-width section" style="--section-space: {{ section.settings.padding | default: 56 }}px;" id="MainProduct-{{ section.id }}">
  <nav class="visually-hidden" aria-label="breadcrumbs"></nav>
  <div class="product-page" data-product-container>
    <div class="product-media" data-gallery>
      <div class="product-media__main">
        {%- if product.featured_media -%}
          <img
            data-gallery-main
            src="{{ product.featured_media | image_url: width: 1200 }}"
            srcset="{{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 900 }} 900w, {{ product.featured_media | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="1200"
            height="1500"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-media__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product-media__thumb{% if forloop.first %} is-active{% endif %}"
              data-gallery-thumb="{{ media | image_url: width: 1200 }}"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
            >
              {{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="product-info__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}
          {%- when 'title' -%}
            <h1 class="product-info__title h2" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
          {%- when 'rating' -%}
            {%- if product.metafields.reviews.rating.value != blank -%}
              <div style="margin-bottom: 1rem;" {{ block.shopify_attributes }}>
                {% render 'mariana-red--rating', rating: product.metafields.reviews.rating.value.rating %}
              </div>
            {%- endif -%}
          {%- when 'price' -%}
            <div class="product-info__price" id="price-{{ section.id }}" {{ block.shopify_attributes }}>
              {%- if current.compare_at_price > current.price -%}
                <s>{{ current.compare_at_price | money }}</s>
                <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
              {%- endif -%}
              <span>{{ current.price | money }}</span>
              {%- if current.unit_price_measurement -%}
                <span class="product-info__tax">
                  {{ current.unit_price | money }}/{{ current.unit_price_measurement.reference_value }}{{ current.unit_price_measurement.reference_unit }}
                </span>
              {%- endif -%}
            </div>
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <p class="product-info__tax">
                {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif %}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url | default: '' }}
                {%- endif -%}
              </p>
            {%- endif -%}
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <div class="variant-picker__option">
                    <label>{{ option.name | escape }}</label>
                    <div class="variant-picker__values">
                      {%- for value in option.values -%}
                        <input
                          type="radio"
                          id="Option-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                          name="Option-{{ section.id }}-{{ forloop.parentloop.index }}"
                          class="visually-hidden"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label for="Option-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" class="variant-picker__value{% if option.selected_value == value %} is-selected{% endif %}">
                          {{ value }}
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
                <script type="application/json" data-variant-json>
                  {{ product.variants | json }}
                </script>
              </div>
            {%- endunless -%}
          {%- when 'quantity' -%}
            <div class="product-form__quantity" style="margin-bottom: 1.4rem; align-self: flex-start;" {{ block.shopify_attributes }}>
              <button type="button" class="quantity__button" data-qty-step="minus" aria-label="{{ 'sections.cart.decrease' | t }}">
                {% render 'mariana-red--icon', name: 'minus', size: 12 %}
              </button>
              <input type="number" class="quantity__input" name="quantity" value="1" min="1" aria-label="{{ 'sections.cart.quantity' | t }}">
              <button type="button" class="quantity__button" data-qty-step="plus" aria-label="{{ 'sections.cart.increase' | t }}">
                {% render 'mariana-red--icon', name: 'plus', size: 12 %}
              </button>
            </div>
          {%- when 'buttons' -%}
            {%- liquid assign form_id = 'ProductForm-' | append: section.id -%}
            {%- form 'product', product, class: 'product-form', id: form_id -%}
              <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
              <button
                type="submit"
                name="add"
                class="button button--{{ block.settings.button_style }} button--full"
                {% unless current.available %}disabled{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if current.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            {%- endform -%}
          {%- when 'description' -%}
            <div class="product-info__description rte" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {%- when 'accordion' -%}
            <div class="product-accordions" {{ block.shopify_attributes }}>
              <details class="faq-item">
                <summary class="faq-item__summary">
                  {{ block.settings.title | escape }}
                  {% render 'mariana-red--icon', name: 'plus', size: 14 %}
                </summary>
                <div class="faq-item__answer">{{ block.settings.content }}</div>
              </details>
            </div>
          {%- when 'share' -%}
            <div class="product-info__share" {{ block.shopify_attributes }}>
              {{ 'general.share.copy' | t }}
            </div>
          {%- when 'text' -%}
            <div style="font-size: 0.9rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "max_blocks": 10,
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses the product assigned by the template."
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Add-to-cart style",
          "options": [
            { "value": "primary", "label": "Accent" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "dark"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping and returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free delivery on orders over $100. Hassle-free 30-day returns.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
