{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{{ 'mariana-red--global.js' | asset_url | script_tag }}
{%- comment -%}
  Editorial trio — intro card beside captioned photo tiles
  (homeware "Made for the way you actually cook").
{%- endcomment -%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }} class="section" style="--section-space: {{ section.settings.padding | default: 72 }}px;">
  <div class="page-width">
    <div class="editorial">
      <div class="editorial__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h3">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <span style="margin-top: 0.8rem;">
            {% render 'mariana-red--button', label: section.settings.link_label, link: section.settings.link, style: 'dark', size: 'small' %}
          </span>
        {%- endif -%}
      </div>
      <div class="editorial__tiles">
        {%- for block in section.blocks -%}
          <div class="editorial-tile" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: block.settings.caption }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <span class="editorial-tile__caption">{{ block.settings.caption | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial trio",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the way you actually cook."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "From quick weekday meals to long, slow weekends. Our kitchenware is designed to be part of your everyday rituals \u2014 not just special occasions."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Photo tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "For everyday moments"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial trio",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "caption": "For everyday moments"
          }
        },
        {
          "type": "tile",
          "settings": {
            "caption": "For bigger gatherings"
          }
        },
        {
          "type": "tile",
          "settings": {
            "caption": "For a more beautiful home"
          }
        }
      ]
    }
  ]
}
{% endschema %}
