{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{{ 'mariana-red--global.js' | asset_url | script_tag }}
{%- comment -%}
  Case studies — two wide project cards with split layouts
  (Mariana "Selected case studies").
{%- endcomment -%}
<section class="section case-studies" style="--section-space: {{ section.settings.padding | default: 72 }}px;">
  <div class="page-width">
    <div class="case-studies__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="rose-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="pill-link">
          {{ section.settings.button_label | escape }}
          <span class="pill-link__arrow">{% render 'mariana-red--icon', name: 'arrow-right', size: 12 %}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="case-studies__row">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="case-card case-card--{{ block.settings.tone | default: 'dark' }}{% if block.settings.image_side == 'left' %} case-card--image-left{% endif %}" {{ block.shopify_attributes }}>
          <span class="case-card__copy">
            {%- if block.settings.title != blank -%}
              <span class="case-card__title">{{ block.settings.title | escape | newline_to_br }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="case-card__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <span class="case-card__link">
                {{ block.settings.link_label | escape }}
                {% render 'mariana-red--icon', name: 'arrow-right', size: 11 %}
              </span>
            {%- endif -%}
          </span>
          <span class="case-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 900', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .case-studies__head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
    margin-bottom: clamp(1.4rem, 3vw, 2.2rem);
  }
  .case-studies__row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.9rem, 1.6vw, 1.4rem); }
  .case-card {
    display: grid; grid-template-columns: 1fr 0.75fr;
    min-height: 15rem;
    border-radius: 1rem; overflow: hidden;
    text-decoration: none;
    background: var(--color-background-secondary);
    border: 1px solid rgba(226, 178, 164, 0.14);
  }
  .case-card--image-left .case-card__copy { order: 2; }
  .case-card--image-left .case-card__media { order: 1; }
  .case-card__copy {
    display: flex; flex-direction: column; justify-content: center;
    gap: 0.7rem;
    padding: clamp(1.3rem, 2.4vw, 2rem);
  }
  .case-card__title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-heading);
  }
  .case-card__text { font-size: 0.82rem; line-height: 1.6; color: var(--color-text-muted); max-width: 17rem; }
  .case-card__link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.64rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent);
    border-bottom: 1px solid rgba(226, 178, 164, 0.5);
    padding-bottom: 0.25rem;
    align-self: flex-start;
    margin-top: 0.4rem;
  }
  .case-card__media { position: relative; overflow: hidden; }
  .case-card__media img, .case-card__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .case-card--blush { background: #e9c9be; border-color: transparent; }
  .case-card--blush .case-card__title { color: #41141b; }
  .case-card--blush .case-card__text { color: rgba(65, 20, 27, 0.75); }
  .case-card--blush .case-card__link { color: #41141b; border-bottom-color: rgba(65, 20, 27, 0.4); }
  @media (max-width: 989px) {
    .case-studies__row { grid-template-columns: 1fr; }
    .case-card { min-height: 13rem; }
  }
  @media (max-width: 540px) {
    .case-card, .case-card--image-left { grid-template-columns: 1fr; }
    .case-card--image-left .case-card__copy { order: 1; }
    .case-card--image-left .case-card__media { order: 2; }
    .case-card__media { min-height: 12rem; }
  }
</style>

{% schema %}
{
  "name": "Case studies",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected case studies" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "New case studies" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 32, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Case card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Noiré Cosmetics" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A bold beauty brand with timeless elegance and edge." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View project" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "tone",
          "label": "Card tone",
          "options": [
            { "value": "dark", "label": "Dark maroon" },
            { "value": "blush", "label": "Blush" }
          ],
          "default": "dark"
        },
        {
          "type": "select",
          "id": "image_side",
          "label": "Image side",
          "options": [
            { "value": "right", "label": "Right" },
            { "value": "left", "label": "Left" }
          ],
          "default": "right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Case studies",
      "blocks": [
        { "type": "case" },
        {
          "type": "case",
          "settings": {
            "title": "Aurea Wellness",
            "text": "A wellness brand that promotes balance, beauty, and self-care.",
            "tone": "blush"
          }
        }
      ]
    }
  ]
}
{% endschema %}
