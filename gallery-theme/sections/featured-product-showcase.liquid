{%- comment -%} Section Library: injected global assets for store "base" {%- endcomment -%}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'product.css' | asset_url | stylesheet_tag }}
{% render 'fonts' %}
{% render 'js-variables' %}
{% render 'css-variables' %}
{{ 'theme.js' | asset_url | script_tag }}
{{ 'sections.js' | asset_url | script_tag }}
{{ 'sleek-hero-editor.js' | asset_url | script_tag }}
{%- comment -%}
  Section: KOVARI Featured Product Showcase
  Purpose: Premium featured-product banner inspired by the approved KOVARI homepage design.
  Fully configurable from the Shopify theme editor with non-flow-affecting product positioning,
  responsive controls, and restrained entrance/hover animations.
{%- endcomment -%}

<section
  id="KovariFeaturedProduct-{{ section.id }}"
  class="kovari-featured-product"
  data-section-id="{{ section.id }}"
>
  {%- style -%}
    #KovariFeaturedProduct-{{ section.id }} {
      --kfp-max-width: {{ section.settings.max_width }}px;
      --kfp-section-margin-top: {{ section.settings.margin_top }}px;
      --kfp-section-margin-bottom: {{ section.settings.margin_bottom }}px;
      --kfp-radius: {{ section.settings.section_radius }}px;
      --kfp-bg: {{ section.settings.background_color }};
      --kfp-text: {{ section.settings.text_color }};
      --kfp-brand-color: {{ section.settings.brand_color }};
      --kfp-brand-size: {{ section.settings.brand_size }}px;
      --kfp-brand-weight: {{ section.settings.brand_weight }};
      --kfp-brand-spacing: {{ section.settings.brand_letter_spacing }}px;
      --kfp-brand-opacity: {{ section.settings.brand_opacity | divided_by: 100.0 }};
      --kfp-eyebrow-size: {{ section.settings.eyebrow_size }}px;
      --kfp-eyebrow-weight: {{ section.settings.eyebrow_weight }};
      --kfp-price-size: {{ section.settings.price_size }}px;
      --kfp-price-weight: {{ section.settings.price_weight }};
      --kfp-card-width: {{ section.settings.card_width }}px;
      --kfp-card-radius: {{ section.settings.card_radius }}px;
      --kfp-card-bg: {{ section.settings.card_background }};
      --kfp-card-blur: {{ section.settings.card_blur }}px;
      --kfp-card-title-size: {{ section.settings.card_title_size }}px;
      --kfp-image-width: {{ section.settings.product_image_width }}%;
      --kfp-image-max-width: {{ section.settings.product_image_max_width }}px;
      --kfp-image-radius: {{ section.settings.product_image_radius }}px;
      --kfp-image-scale: {{ section.settings.product_image_scale | divided_by: 100.0 }};
      --kfp-tag-bg: {{ section.settings.tag_background }};
      --kfp-tag-text: {{ section.settings.tag_text_color }};
      --kfp-tag-border: {{ section.settings.tag_border_color }};
      --kfp-tag-size: {{ section.settings.tag_font_size }}px;
      --kfp-cta-bg: {{ section.settings.cta_background }};
      --kfp-cta-text: {{ section.settings.cta_text_color }};
      --kfp-cta-radius: {{ section.settings.cta_radius }}px;
      --kfp-cta-size: {{ section.settings.cta_font_size }}px;
      --kfp-cta-weight: {{ section.settings.cta_font_weight }};
      --kfp-cta-top-margin: {{ section.settings.cta_top_margin }}px;
      --kfp-overlay-opacity: {{ section.settings.brand_overlay_opacity | divided_by: 100.0 }};
      --kfp-mobile-height: {{ section.settings.mobile_height }}px;
      --kfp-mobile-card-width: {{ section.settings.mobile_card_width }}%;
      --kfp-animation-duration: {{ section.settings.animation_duration }}ms;
      --kfp-animation-stagger: {{ section.settings.animation_stagger }}ms;
    }

    #KovariFeaturedProduct-{{ section.id }} {
      margin-top: var(--kfp-section-margin-top);
      margin-bottom: var(--kfp-section-margin-bottom);
      color: var(--kfp-text);
      padding-left: 20px;
      padding-right: 20px;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__shell {
      position: relative;
      /* width: min(100%, var(--kfp-max-width)); */
      margin: 0 auto;
      overflow: hidden;
      border-radius: var(--kfp-radius);
      background: var(--kfp-bg);
      isolation: isolate;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__background {
      position: absolute;
      inset: 0;
      z-index: -2;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.background_position }};
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__overlay {
      position: absolute;
      inset: 0;
      z-index: -1;
      background: {{ section.settings.overlay_color }};
      opacity: var(--kfp-overlay-opacity);
      pointer-events: none;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__stage {
      position: relative;
      min-height: {{ section.settings.desktop_height }}px;
      padding:
        {{ section.settings.padding_top }}px
        {{ section.settings.padding_right }}px
        {{ section.settings.padding_bottom }}px
        {{ section.settings.padding_left }}px;
    }

    /* Brand is decorative and never contributes to section height. */
    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__brand {
      position: absolute;
      top: {{ section.settings.brand_top }}%;
      left: 50%;
      z-index: 0;
      width: min(90%, {{ section.settings.brand_max_width }}px);
      margin: 0;
      transform: translate(-50%, -50%);
      color: var(--kfp-brand-color);
      font-size: var(--kfp-brand-size);
      font-weight: var(--kfp-brand-weight);
      line-height: .78;
      letter-spacing: var(--kfp-brand-spacing);
      text-align: center;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: var(--kfp-brand-opacity);
      pointer-events: none;
      user-select: none;
      transition: opacity var(--kfp-animation-duration) cubic-bezier(.22,1,.36,1),
                  transform var(--kfp-animation-duration) cubic-bezier(.22,1,.36,1);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__media {
      position: absolute;
      top: {{ section.settings.product_vertical_position }}%;
      left: 50%;
      z-index: 1;
      width: var(--kfp-image-width);
      max-width: var(--kfp-image-max-width);
      margin: 0;
      transform: translate(-50%, -50%) scale(var(--kfp-image-scale));
      transform-origin: center center;
      transition: opacity var(--kfp-animation-duration) cubic-bezier(.22,1,.36,1),
                  transform var(--kfp-animation-duration) cubic-bezier(.22,1,.36,1);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__media-link {
      display: block;
      width: 100%;
      text-decoration: none;
      color: inherit;
      transition: transform 240ms ease;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__media:hover .kovari-featured-product__media-link {
      transform: scale(1.03);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__image {
      display: block;
      width: 100%;
      max-height: {{ section.settings.product_image_max_height }}px;
      height: auto;
      object-fit: contain;
      object-position: center bottom;
      border-radius: var(--kfp-image-radius);
      filter: {{ section.settings.product_image_filter }};
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__fallback {
      width: 100%;
      min-height: 280px;
      display: grid;
      place-items: center;
      border-radius: var(--kfp-image-radius);
      color: rgba(0,0,0,.42);
      font-size: 14px;
      text-align: center;
      background: rgba(255,255,255,.24);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__tags {
      position: absolute;
      top: {{ section.settings.tags_top }}px;
      right: {{ section.settings.tags_right }}px;
      z-index: 4;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: {{ section.settings.tag_gap }}px;
      max-width: 45%;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__tag,
    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__featured-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--kfp-tag-border);
      border-radius: 999px;
      background: var(--kfp-tag-bg);
      color: var(--kfp-tag-text);
      font-weight: 600;
      line-height: 1;
      letter-spacing: .04em;
      text-transform: uppercase;
      white-space: nowrap;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__tag {
      padding: {{ section.settings.tag_padding_y }}px {{ section.settings.tag_padding_x }}px;
      font-size: var(--kfp-tag-size);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__featured-badge {
      position: absolute;
      top: {{ section.settings.featured_badge_top }}px;
      left: {{ section.settings.featured_badge_left }}px;
      z-index: 4;
      padding: {{ section.settings.featured_badge_padding_y }}px {{ section.settings.featured_badge_padding_x }}px;
      background: {{ section.settings.featured_badge_background }};
      color: {{ section.settings.featured_badge_text_color }};
      border-color: {{ section.settings.featured_badge_border_color }};
      border-radius: {{ section.settings.featured_badge_radius }}px;
      font-size: {{ section.settings.featured_badge_font_size }}px;
      font-weight: {{ section.settings.featured_badge_font_weight }};
      letter-spacing: {{ section.settings.featured_badge_letter_spacing }}px;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card {
      position: absolute;
      left: {{ section.settings.card_left }}px;
      bottom: {{ section.settings.card_bottom }}px;
      z-index: 5;
      width: min(var(--kfp-card-width), calc(100% - 40px));
      padding:
        {{ section.settings.card_padding_top }}px
        {{ section.settings.card_padding_right }}px
        {{ section.settings.card_padding_bottom }}px
        {{ section.settings.card_padding_left }}px;
      border-radius: var(--kfp-card-radius);
      background: var(--kfp-card-bg);
      backdrop-filter: blur(var(--kfp-card-blur));
      -webkit-backdrop-filter: blur(var(--kfp-card-blur));
      box-shadow: 0 14px 40px rgba(0,0,0,.08);
      transition: opacity var(--kfp-animation-duration) cubic-bezier(.22,1,.36,1),
                  transform var(--kfp-animation-duration) cubic-bezier(.22,1,.36,1);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card-eyebrow {
      margin: 0 0 {{ section.settings.eyebrow_bottom }}px;
      color: {{ section.settings.eyebrow_color }};
      font-size: var(--kfp-eyebrow-size);
      font-weight: var(--kfp-eyebrow-weight);
      letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
      line-height: 1.2;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card-title {
      margin: 0;
      max-width: {{ section.settings.card_title_max_width }}px;
      color: {{ section.settings.card_title_color }};
      font-size: var(--kfp-card-title-size);
      font-weight: {{ section.settings.card_title_weight }};
      line-height: 1.12;
      overflow-wrap: anywhere;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: {{ section.settings.price_top_margin }}px;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__price-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 10px;
      min-width: 0;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__price {
      color: {{ section.settings.price_color }};
      font-size: var(--kfp-price-size);
      font-weight: var(--kfp-price-weight);
      line-height: 1;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__compare {
      color: {{ section.settings.compare_price_color }};
      font-size: calc(var(--kfp-price-size) * .76);
      text-decoration: line-through;
      opacity: .72;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: {{ section.settings.cta_gap }}px;
      flex: 0 0 auto;
      min-height: {{ section.settings.cta_height }}px;
      margin-top: var(--kfp-cta-top-margin);
      padding: 0 {{ section.settings.cta_padding_x }}px;
      border: 0;
      border-radius: var(--kfp-cta-radius);
      background: var(--kfp-cta-bg);
      color: var(--kfp-cta-text);
      font-size: var(--kfp-cta-size);
      font-weight: var(--kfp-cta-weight);
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
      transition: transform 200ms ease, opacity 200ms ease;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta:hover {
      transform: translateY(-2px);
      opacity: .92;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta-arrow {
      display: inline-flex;
      width: 16px;
      height: 16px;
      align-items: center;
      justify-content: center;
      transition: transform 200ms ease;
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta:hover .kovari-featured-product__cta-arrow {
      transform: translateX(4px);
    }

    #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta-arrow svg {
      width: 100%;
      height: 100%;
    }

    /* Entrance states; only enabled when the section animation option is on. */
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated:not(.is-in-view) .kovari-featured-product__brand {
      opacity: calc(var(--kfp-brand-opacity) * .68);
      transform: translate(-50%, -50%) scale(.96);
    }

    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated:not(.is-in-view) .kovari-featured-product__media {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 36px)) scale(calc(var(--kfp-image-scale) * .96));
    }

    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated:not(.is-in-view) .kovari-featured-product__card {
      opacity: 0;
      transform: translateY(18px);
    }

    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated:not(.is-in-view) .kovari-featured-product__tag,
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated:not(.is-in-view) .kovari-featured-product__featured-badge {
      opacity: 0;
      transform: translateY(-8px);
    }

    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__tag:nth-child(1) { transition-delay: 80ms; }
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__tag:nth-child(2) { transition-delay: calc(80ms + var(--kfp-animation-stagger)); }
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__tag:nth-child(3) { transition-delay: calc(80ms + (var(--kfp-animation-stagger) * 2)); }
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__brand {
      opacity: 1;
      transform: translate(-50%, -50%);
    }

    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__media {
      opacity: 1;
      transform: translate(-50%, -50%) scale(var(--kfp-image-scale));
    }

    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__card,
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__tag,
    #KovariFeaturedProduct-{{ section.id }}.kovari-featured-product--animated.is-in-view .kovari-featured-product__featured-badge {
      opacity: 1;
      transform: none;
    }

    @media (max-width: 900px) {
      #KovariFeaturedProduct-{{ section.id }} {
        margin-top: min(var(--kfp-section-margin-top), 24px);
        margin-bottom: min(var(--kfp-section-margin-bottom), 24px);
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__shell {
        width: 100%;
        border-radius: {{ section.settings.mobile_section_radius }}px;
      }

      /* Variant 1 — recommended mobile composition:
         centered product + oversized KOVARI wordmark + full-width bottom card */
      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__stage {
        position: relative;
        min-height: var(--kfp-mobile-height);
        padding:
          {{ section.settings.mobile_padding_top }}px
          {{ section.settings.mobile_padding_right }}px
          0
          {{ section.settings.mobile_padding_left }}px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__brand {
        top: {{ section.settings.mobile_brand_top }}%;
        left: 50%;
        width: max-content;
        max-width: calc(100% - 20px);
        font-size: {{ section.settings.mobile_brand_size }}px;
        letter-spacing: {{ section.settings.mobile_brand_letter_spacing }}px;
        line-height: .78;
        transform: translate(-50%, -50%);
        z-index: 0;
        white-space: nowrap;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__media {
        position: absolute;
        left: 50%;
        top: {{ section.settings.mobile_product_position }}%;
        z-index: 1;
        width: min({{ section.settings.mobile_image_width }}%, {{ section.settings.mobile_image_max_width }}px);
        max-width: none;
        margin: 0;
        transform:
          translate(-50%, -50%)
          translate(
            {{ section.settings.mobile_image_offset_x }}px,
            {{ section.settings.mobile_image_offset_y }}px
          )
          scale({{ section.settings.mobile_image_scale | divided_by: 100.0 }});
        transform-origin: center center;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__image {
        width: 100%;
        max-height: {{ section.settings.mobile_image_max_height }}px;
        height: auto;
        object-fit: contain;
        object-position: center;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__tags {
        top: {{ section.settings.mobile_tags_top }}px;
        right: {{ section.settings.mobile_tags_right }}px;
        z-index: 4;
        max-width: calc(100% - 24px);
        gap: {{ section.settings.mobile_tag_gap }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__tag {
        padding:
          {{ section.settings.mobile_tag_padding_y }}px
          {{ section.settings.mobile_tag_padding_x }}px;
        font-size: {{ section.settings.mobile_tag_font_size }}px;
      }

      /* Bottom card is in normal flex flow at the bottom of the stage,
         but the product image is absolute, so moving the product never changes section height. */
      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card {
        position: relative;
        z-index: 5;
        left: auto;
        right: auto;
        top: auto;
        bottom: auto;
        width: var(--kfp-mobile-card-width);
        max-width: 100%;
        margin: 0 auto {{ section.settings.mobile_card_bottom }}px;
        padding:
          {{ section.settings.mobile_card_padding_top }}px
          {{ section.settings.mobile_card_padding_right }}px
          {{ section.settings.mobile_card_padding_bottom }}px
          {{ section.settings.mobile_card_padding_left }}px;
        border-radius: {{ section.settings.mobile_card_radius }}px;
        box-shadow: 0 12px 34px rgba(0, 0, 0, .08);
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card-title {
        max-width: none;
        font-size: {{ section.settings.mobile_card_title_size }}px;
        line-height: 1.12;
        overflow-wrap: normal;
        word-break: normal;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__price {
        font-size: {{ section.settings.mobile_price_size }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__price-row {
        margin-top: {{ section.settings.mobile_price_top_margin }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta {
        width: {{ section.settings.mobile_cta_width }}%;
        min-height: {{ section.settings.mobile_cta_height }}px;
        margin-top: {{ section.settings.mobile_cta_top_margin }}px;
        padding: 0 {{ section.settings.mobile_cta_padding_x }}px;
        font-size: {{ section.settings.mobile_cta_font_size }}px;
      }
    }

    @media (max-width: 560px) {
      #KovariFeaturedProduct-{{ section.id }}{
             padding-left: 20px;
        padding-right:20px;
        }
      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__stage {
        min-height: calc(var(--kfp-mobile-height) + {{ section.settings.small_mobile_height_add }}px);
        padding-left: 12px;
        padding-right: 12px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__brand {
        top: {{ section.settings.small_mobile_brand_top }}%;
        max-width: calc(100% - 16px);
        font-size: {{ section.settings.small_mobile_brand_size }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__media {
        top: {{ section.settings.small_mobile_product_position }}%;
        width: min({{ section.settings.small_mobile_image_width }}%, {{ section.settings.small_mobile_image_max_width }}px);
        transform:
          translate(-50%, -50%)
          translate(
            {{ section.settings.small_mobile_image_offset_x }}px,
            {{ section.settings.small_mobile_image_offset_y }}px
          )
          scale({{ section.settings.small_mobile_image_scale | divided_by: 100.0 }});
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__image {
        max-height: {{ section.settings.small_mobile_image_max_height }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__tags {
        top: {{ section.settings.small_mobile_tags_top }}px;
        right: {{ section.settings.small_mobile_tags_right }}px;
        max-width: calc(100% - 24px);
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card {
        width: calc(100% - 24px);
        margin-bottom: {{ section.settings.small_mobile_card_bottom }}px;
        padding:
          {{ section.settings.small_mobile_card_padding_top }}px
          {{ section.settings.small_mobile_card_padding_right }}px
          {{ section.settings.small_mobile_card_padding_bottom }}px
          {{ section.settings.small_mobile_card_padding_left }}px;
        border-radius: {{ section.settings.small_mobile_card_radius }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__card-title {
        font-size: {{ section.settings.small_mobile_card_title_size }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__price {
        font-size: {{ section.settings.small_mobile_price_size }}px;
      }

      #KovariFeaturedProduct-{{ section.id }} .kovari-featured-product__cta {
        width: 100%;
        min-height: {{ section.settings.small_mobile_cta_height }}px;
        margin-top: {{ section.settings.small_mobile_cta_top_margin }}px;
      }
    }

  {%- endstyle -%}

  {%- assign product = section.settings.product -%}
  {%- assign featured_image = blank -%}
  {%- if product != blank -%}
    {%- assign featured_image = product.featured_image -%}
  {%- elsif section.settings.product_image != blank -%}
    {%- assign featured_image = section.settings.product_image -%}
  {%- endif -%}

  <div class="kovari-featured-product__shell">
    {%- if section.settings.background_image != blank -%}
      <img
        class="kovari-featured-product__background"
        src="{{ section.settings.background_image | image_url: width: 2400 }}"
        alt=""
        loading="lazy"
        width="2400"
        height="1400"
      >
    {%- endif -%}
    <div class="kovari-featured-product__overlay" aria-hidden="true"></div>

    <div class="kovari-featured-product__stage">
      {%- if section.settings.brand_text != blank -%}
        <div class="kovari-featured-product__brand" aria-hidden="true">
          {{ section.settings.brand_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_featured_badge and section.settings.featured_badge_text != blank -%}
        <div class="kovari-featured-product__featured-badge">
          {{ section.settings.featured_badge_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_tags and section.settings.tags != blank -%}
        <div class="kovari-featured-product__tags" aria-label="Product highlights">
          {%- assign tag_list = section.settings.tags | split: ',' -%}
          {%- for tag in tag_list -%}
            {%- assign clean_tag = tag | strip -%}
            {%- if clean_tag != blank -%}
              <span class="kovari-featured-product__tag">{{ clean_tag }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="kovari-featured-product__media">
        {%- assign image_link = section.settings.image_link -%}
        {%- if image_link == blank and product != blank -%}
          {%- assign image_link = product.url -%}
        {%- endif -%}

        {%- if featured_image != blank -%}
          {%- if image_link != blank -%}
            <a
              class="kovari-featured-product__media-link"
              href="{{ image_link }}"
              aria-label="View {{ product.title | default: section.settings.product_title | escape }}"
            >
          {%- endif -%}

          <img
            class="kovari-featured-product__image"
            src="{{ featured_image | image_url: width: 1400 }}"
            alt="{{ featured_image.alt | default: product.title | default: section.settings.product_title | escape }}"
            loading="{{ section.settings.image_loading }}"
            width="1400"
            height="1400"
          >

          {%- if image_link != blank -%}
            </a>
          {%- endif -%}
        {%- else -%}
          <div class="kovari-featured-product__fallback">
            Select a product or product image in the theme editor.
          </div>
        {%- endif -%}
      </div>

      <div class="kovari-featured-product__card">
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="kovari-featured-product__card-eyebrow">
            {{ section.settings.eyebrow_text }}
          </p>
        {%- endif -%}

        <h2 class="kovari-featured-product__card-title">
          {%- if section.settings.product_title_source == 'product' and product != blank -%}
            {{ product.title }}
          {%- elsif section.settings.product_title != blank -%}
            {{ section.settings.product_title }}
          {%- else -%}
            Featured Product
          {%- endif -%}
        </h2>

        {%- assign show_price = section.settings.show_price -%}
        {%- assign cta_link = section.settings.cta_link -%}
        {%- if cta_link == blank and product != blank -%}
          {%- assign cta_link = product.url -%}
        {%- endif -%}

        {%- if show_price or section.settings.show_cta -%}
          <div class="kovari-featured-product__card-footer">
            {%- if show_price and product != blank -%}
              <div class="kovari-featured-product__price-row">
                <span class="kovari-featured-product__price">
                  {{ product.price | money }}
                </span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="kovari-featured-product__compare">
                    {{ product.compare_at_price | money }}
                  </span>
                {%- endif -%}
              </div>
            {%- elsif section.settings.manual_price != blank -%}
              <div class="kovari-featured-product__price-row">
                <span class="kovari-featured-product__price">{{ section.settings.manual_price }}</span>
              </div>
            {%- else -%}
              <span></span>
            {%- endif -%}

            {%- if section.settings.show_cta and cta_link != blank -%}
              <a class="kovari-featured-product__cta" href="{{ cta_link }}">
                <span>{{ section.settings.cta_text }}</span>
                {%- if section.settings.show_cta_arrow -%}
                  <span class="kovari-featured-product__cta-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="18" y2="12"></line>
                      <polyline points="13 7 18 12 13 17"></polyline>
                    </svg>
                  </span>
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.enable_entrance_animation -%}
    <script>
      (function() {
        var root = document.getElementById('KovariFeaturedProduct-{{ section.id }}');
        if (!root || root.dataset.kfpAnimationReady === 'true') return;
        root.dataset.kfpAnimationReady = 'true';
        root.classList.add('kovari-featured-product--animated');

        var reveal = function() {
          root.classList.add('is-in-view');
        };

        if (!('IntersectionObserver' in window)) {
          reveal();
          return;
        }

        var observer = new IntersectionObserver(function(entries, obs) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              reveal();
              obs.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        observer.observe(root);
      })();
    </script>
  {%- endif -%}
</section>

