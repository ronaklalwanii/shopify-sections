{%- comment -%} Section Library: injected global assets for store "base" {%- endcomment -%}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'product.css' | asset_url | stylesheet_tag }}
{% render 'fonts' %}
{% render 'js-variables' %}
{% render 'css-variables' %}
{{ 'theme.js' | asset_url | script_tag }}
{{ 'sections.js' | asset_url | script_tag }}
{{ 'sleek-hero-editor.js' | asset_url | script_tag }}
{%- comment -%}
  ==========================================================================
  FASHION COVERFLOW — self-contained Shopify section
  Editorial product coverflow: enlarged center card with name + "View
  Product", smaller peeking side cards, prev/next arrows. Drag/swipe too.
  Single file, no dependencies. Horizon-era settings only.
  ==========================================================================
{%- endcomment -%}
{%- assign sid = section.id -%}

<section class="fcv fcv-{{ section.id }}" id="fcv-{{ section.id }}">
  <div class="fcv__stage-wrap">
    <button type="button" class="fcv__arrow fcv__arrow--prev" data-fcv-prev aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 5-7 7 7 7"/></svg>
    </button>

    <div class="fcv__stage" data-fcv-stage>
      {%- for block in section.blocks -%}
        <div class="fcv__card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', alt: block.settings.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'fcv__placeholder' }}
          {%- endif -%}
          <div class="fcv__overlay">
            {%- if block.settings.eyebrow != blank -%}<p class="fcv__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            <p class="fcv__name">{{ block.settings.title | escape }}</p>
            <span class="fcv__view">{{ section.settings.view_label | escape }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <button type="button" class="fcv__arrow fcv__arrow--next" data-fcv-next aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 5 7 7-7 7"/></svg>
    </button>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('fcv-{{ section.id }}');
    if (!root || root.dataset.fcvInit) return;
    root.dataset.fcvInit = '1';
    var cards = Array.prototype.slice.call(root.querySelectorAll('.fcv__card'));
    var idx = 0;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var AUTO = {{ section.settings.autoplay_seconds | times: 1000 }};
    var timer = null;

    function layout() {
      var n = cards.length;
      cards.forEach(function (card, k) {
        var pos = ((k - idx) % n + n) % n;
        if (pos > n / 2) pos -= n;
        var abs = Math.abs(pos);
        var show = abs <= {{ section.settings.peek_cards }};
        card.style.display = show ? '' : 'none';
        card.style.zIndex = String(50 - abs);
        card.style.transform =
          'translateX(calc(-50% + ' + (pos * {{ section.settings.side_offset }}) + 'px))' +
          ' scale(' + Math.max(1 - abs * {{ section.settings.scale_step | divided_by: 100.0 }}, 0.66) + ')';
        card.style.opacity = show ? (abs === 0 ? '1' : '0.9') : '0';
        card.classList.toggle('is-active', abs === 0);
      });
    }
    function go(step) {
      idx = (idx + step + cards.length) % cards.length;
      if (reduce) { layout(); } else { layout(); }
    }
    function play() { stop(); if (AUTO > 0 && !reduce) timer = setInterval(function () { go(1); }, AUTO); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    root.querySelector('[data-fcv-prev]').addEventListener('click', function () { stop(); go(-1); play(); });
    root.querySelector('[data-fcv-next]').addEventListener('click', function () { stop(); go(1); play(); });

    var startX = null;
    root.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { stop(); go(dx < 0 ? 1 : -1); play(); }
      startX = null;
    }, { passive: true });

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { layout(); play(); } else { stop(); } });
    }, { threshold: 0.3 });
    io.observe(root);

    cards.forEach(function (c) {
      c.addEventListener('click', function () { if (!c.classList.contains('is-active')) { stop(); idx = parseInt(c.dataset.index, 10); layout(); play(); } });
    });
    layout(); play();
  })();
</script>

{% style %}
  #fcv-{{ sid }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ section.settings.font_stack }};
    padding-block: clamp(2.5rem, 7vh, 5rem);
    overflow: hidden;
  }
  #fcv-{{ sid }} *, #fcv-{{ sid }} *::before, #fcv-{{ sid }} *::after { box-sizing: border-box; margin: 0; padding: 0; }
  #fcv-{{ sid }} a { color: inherit; text-decoration: none; }

  #fcv-{{ sid }} .fcv__stage-wrap { position: relative; }
  #fcv-{{ sid }} .fcv__stage {
    position: relative;
    height: clamp(340px, {{ section.settings.stage_height }}vw, {{ section.settings.stage_height_max }}px);
    display: flex; align-items: center; justify-content: center;
  }
  #fcv-{{ sid }} .fcv__card {
    position: absolute; left: 50%; top: 50%;
    width: min({{ section.settings.card_width }}vw, {{ section.settings.card_width_max }}px);
    aspect-ratio: {{ section.settings.card_ratio }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
    cursor: pointer;
  }
  #fcv-{{ sid }} .fcv__card img, #fcv-{{ sid }} .fcv__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  #fcv-{{ sid }} .fcv__placeholder { background: #e6e2d8; }

  #fcv-{{ sid }} .fcv__overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: 0.4rem;
    padding: clamp(0.9rem, 2vw, 1.5rem);
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.5));
    color: #fff;
    opacity: 0; transition: opacity 0.4s ease 0.2s;
  }
  #fcv-{{ sid }} .fcv__card.is-active .fcv__overlay { opacity: 1; }
  #fcv-{{ sid }} .fcv__eyebrow { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.8; }
  #fcv-{{ sid }} .fcv__name { font-size: clamp(0.95rem, 1.6vw, 1.3rem); font-weight: 600; }
  #fcv-{{ sid }} .fcv__view {
    margin-top: 0.4rem;
    background: #fff; color: #1c1e22;
    font-size: 0.64rem; font-weight: 700; letter-spacing: 0.05em;
    padding: 0.5rem 1.1rem; border-radius: 999px;
  }

  #fcv-{{ sid }} .fcv__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 20;
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.18); background: transparent; color: inherit;
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }
  #fcv-{{ sid }} .fcv__arrow svg { width: 1rem; height: 1rem; }
  #fcv-{{ sid }} .fcv__arrow:hover { background: #1c1e22; color: #fff; border-color: #1c1e22; }
  #fcv-{{ sid }} .fcv__arrow--prev { left: clamp(0.6rem, 3vw, 3rem); }
  #fcv-{{ sid }} .fcv__arrow--next { right: clamp(0.6rem, 3vw, 3rem); }

  @media (max-width: 700px) {
    #fcv-{{ sid }} .fcv__arrow { width: 2.2rem; height: 2.2rem; }
    #fcv-{{ sid }} .fcv__arrow--prev { left: 0.4rem; }
    #fcv-{{ sid }} .fcv__arrow--next { right: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { #fcv-{{ sid }} .fcv__card { transition: none; } }
{% endstyle %}

{% schema %}
{
  "name": "Fashion Coverflow",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "label": "Autoplay every", "min": 0, "max": 12, "step": 1, "unit": "s", "info": "0 = manual only", "default": 0 },
    { "type": "range", "id": "card_width", "label": "Active card width", "min": 20, "max": 44, "step": 1, "unit": "vw", "default": 26 },
    { "type": "range", "id": "card_width_max", "label": "Active card max width", "min": 260, "max": 560, "step": 10, "unit": "px", "default": 380 },
    {
      "type": "select", "id": "card_ratio", "label": "Card ratio",
      "options": [
        { "value": "3 / 4", "label": "Tall (3:4)" },
        { "value": "2 / 3", "label": "Editorial (2:3)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ],
      "default": "2 / 3"
    },
    { "type": "range", "id": "stage_height", "label": "Stage height", "min": 30, "max": 60, "step": 1, "unit": "vw", "default": 42 },
    { "type": "range", "id": "stage_height_max", "label": "Stage max height", "min": 400, "max": 900, "step": 10, "unit": "px", "default": 640 },
    { "type": "range", "id": "side_offset", "label": "Side card offset", "min": 80, "max": 240, "step": 5, "unit": "px", "default": 170 },
    { "type": "range", "id": "scale_step", "label": "Depth scale step", "min": 5, "max": 25, "step": 1, "unit": "%", "default": 12 },
    { "type": "range", "id": "peek_cards", "label": "Peek cards each side", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "text", "id": "view_label", "label": "Button label", "default": "View Product" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f4f0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1c1e22" },
    {
      "type": "select", "id": "font_stack", "label": "Typeface",
      "options": [
        { "value": "system-ui, sans-serif", "label": "System" },
        { "value": "'Helvetica Neue', Helvetica, Arial, sans-serif", "label": "Grotesque" },
        { "value": "Georgia, 'Times New Roman', serif", "label": "Serif" }
      ],
      "default": "system-ui, sans-serif"
    }
  ],
  "blocks": [
    { "type": "product", "name": "Product card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "title", "label": "Title", "default": "Mirkat Leather Bag" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [
    { "name": "Fashion Coverflow", "blocks": [
      { "type": "product", "settings": { "eyebrow": "Minimale Attire", "title": "Vibrant Summer Shirt" } },
      { "type": "product", "settings": { "eyebrow": "Minimale Attire", "title": "Mirkat Leather Bag" } },
      { "type": "product", "settings": { "eyebrow": "Minimale Attire", "title": "Relaxed Linen Shirt" } },
      { "type": "product", "settings": { "eyebrow": "Minimale Attire", "title": "Over Sized Wool Coat" } },
      { "type": "product", "settings": { "eyebrow": "Minimale Attire", "title": "Wide Leg Trouser" } },
      { "type": "product", "settings": { "eyebrow": "Minimale Attire", "title": "Midnight Summer Pant" } }
    ] }
  ]
}
{% endschema %}
