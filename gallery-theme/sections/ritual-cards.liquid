{%- comment -%} Section Library: injected global assets for store "base" {%- endcomment -%}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'product.css' | asset_url | stylesheet_tag }}
{% render 'fonts' %}
{% render 'js-variables' %}
{% render 'css-variables' %}
{{ 'theme.js' | asset_url | script_tag }}
{{ 'sections.js' | asset_url | script_tag }}
{{ 'sleek-hero-editor.js' | asset_url | script_tag }}
{%- comment -%}
  Section: KOVARI Haircare Ritual Cards
  v2 — image scales with card height (%), hugs bottom-right like the mock.
{%- endcomment -%}

<section id="KovariRitualCards-{{ section.id }}" class="kovari-ritual-cards">
  {%- style -%}
    #KovariRitualCards-{{ section.id }} {
      --krc-max-width: {{ section.settings.max_width }}px;
      --krc-margin-top: {{ section.settings.margin_top }}px;
      --krc-margin-bottom: {{ section.settings.margin_bottom }}px;
      --krc-gap: {{ section.settings.card_gap }}px;
      --krc-columns: {{ section.settings.desktop_columns }};
      --krc-card-radius: {{ section.settings.card_radius }}px;
      --krc-card-height: {{ section.settings.card_height }}px;
      --krc-card-bg: {{ section.settings.default_card_background }};
      --krc-card-border: {{ section.settings.card_border_color }};
      --krc-card-border-width: {{ section.settings.card_border_width }}px;
      --krc-card-shadow: 0 {{ section.settings.shadow_y }}px {{ section.settings.shadow_blur }}px rgba(0,0,0,{{ section.settings.shadow_opacity | divided_by: 100.0 }});
      --krc-padding-top: {{ section.settings.card_padding_top }}px;
      --krc-padding-right: {{ section.settings.card_padding_right }}px;
      --krc-padding-bottom: {{ section.settings.card_padding_bottom }}px;
      --krc-padding-left: {{ section.settings.card_padding_left }}px;
      --krc-label-size: {{ section.settings.label_size }}px;
      --krc-label-weight: {{ section.settings.label_weight }};
      --krc-label-spacing: {{ section.settings.label_letter_spacing }}px;
      --krc-title-size: {{ section.settings.title_size }}px;
      --krc-title-weight: {{ section.settings.title_weight }};
      --krc-title-line-height: {{ section.settings.title_line_height }};
      --krc-text-size: {{ section.settings.description_size }}px;
      --krc-text-weight: {{ section.settings.description_weight }};
      --krc-text-line-height: {{ section.settings.description_line_height }};
      --krc-text-max-width: {{ section.settings.description_max_width }}px;
      --krc-text-color: {{ section.settings.default_text_color }};
      --krc-label-color: {{ section.settings.default_label_color }};
      --krc-title-color: {{ section.settings.default_title_color }};
      --krc-arrow-size: {{ section.settings.arrow_size }}px;
      --krc-arrow-bg: {{ section.settings.default_arrow_background }};
      --krc-arrow-bg-opacity: {{ section.settings.arrow_background_opacity }}%;
      --krc-arrow-color: {{ section.settings.default_arrow_color }};
      --krc-arrow-border: {{ section.settings.default_arrow_border }};
      --krc-arrow-border-width: {{ section.settings.arrow_border_width }}px;
      --krc-arrow-radius: {{ section.settings.arrow_radius }}px;
      --krc-arrow-top: {{ section.settings.arrow_top }}px;
      --krc-arrow-right: {{ section.settings.arrow_right }}px;
      --krc-image-width: {{ section.settings.image_width }}%;
      --krc-image-height: {{ section.settings.card_height | times: section.settings.image_height_pct | divided_by: 100 }}px;
      --krc-image-radius: {{ section.settings.image_radius }}px;
      --krc-image-object-position: {{ section.settings.image_position }};
      --krc-mobile-gap: {{ section.settings.mobile_card_gap }}px;
      --krc-mobile-radius: {{ section.settings.mobile_card_radius }}px;
      --krc-mobile-height: {{ section.settings.mobile_card_height }}px;
      --krc-mobile-padding-top: {{ section.settings.mobile_card_padding_top }}px;
      --krc-mobile-padding-right: {{ section.settings.mobile_card_padding_right }}px;
      --krc-mobile-padding-bottom: {{ section.settings.mobile_card_padding_bottom }}px;
      --krc-mobile-padding-left: {{ section.settings.mobile_card_padding_left }}px;
      --krc-mobile-label-size: {{ section.settings.mobile_label_size }}px;
      --krc-mobile-title-size: {{ section.settings.mobile_title_size }}px;
      --krc-mobile-text-size: {{ section.settings.mobile_description_size }}px;
      --krc-mobile-title-max-width: {{ section.settings.mobile_title_max_width }}px;
      --krc-mobile-text-max-width: {{ section.settings.mobile_description_max_width }}px;
      --krc-mobile-arrow-size: {{ section.settings.mobile_arrow_size }}px;
      --krc-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    }

    #KovariRitualCards-{{ section.id }} {
      margin-top: var(--krc-margin-top);
      margin-bottom: var(--krc-margin-bottom);
      padding-left: 20px;
      padding-right: 20px;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__shell {
      /* width: min(100%, var(--krc-max-width)); */
      margin: 0 auto;
      min-width: 0;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__grid {
      display: grid;
      grid-template-columns: repeat(var(--krc-columns), minmax(0, 1fr));
      gap: var(--krc-gap);
      min-width: 0;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card {
      position: relative;
      min-width: 0;
      min-height: var(--krc-card-height);
      overflow: hidden;
      padding:
        var(--krc-padding-top)
        var(--krc-padding-right)
        var(--krc-padding-bottom)
        var(--krc-padding-left);
      border: var(--krc-card-border-width) solid var(--krc-card-border);
      border-radius: var(--krc-card-radius);
      background: var(--krc-card-bg);
      box-shadow: var(--krc-card-shadow);
      isolation: isolate;
      text-decoration: none;
      color: inherit;
      display: block;
      transition:
        transform {{ section.settings.hover_transition_duration }}ms ease,
        box-shadow {{ section.settings.hover_transition_duration }}ms ease;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card:hover {
      transform:
        translateY({{ section.settings.hover_lift | times: -1 }}px)
        scale({{ section.settings.hover_scale | divided_by: 100.0 }});
      box-shadow:
        0
        {{ section.settings.hover_shadow_y }}px
        {{ section.settings.hover_shadow_blur }}px
        rgba(0,0,0,{{ section.settings.hover_shadow_opacity | divided_by: 100.0 }});
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__content {
      position: relative;
      z-index: 3;
      width: min(100%, {{ section.settings.content_max_width }}%);
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__label {
      margin: 0;
      color: var(--krc-label-color);
      font-size: var(--krc-label-size);
      font-weight: var(--krc-label-weight);
      letter-spacing: var(--krc-label-spacing);
      line-height: 1.2;
      text-transform: uppercase;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__title {
      max-width: 100%;
      margin: {{ section.settings.title_top_margin }}px 0 0;
      color: var(--krc-title-color);
      font-size: var(--krc-title-size);
      font-weight: var(--krc-title-weight);
      line-height: var(--krc-title-line-height);
      overflow-wrap: break-word;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__description {
      max-width: min(var(--krc-text-max-width), 100%);
      margin: {{ section.settings.description_top_margin }}px 0 0;
      color: var(--krc-text-color);
      font-size: var(--krc-text-size);
      font-weight: var(--krc-text-weight);
      line-height: var(--krc-text-line-height);
      overflow-wrap: break-word;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__image-wrap {
      position: absolute;
      z-index: 1;
      right: {{ section.settings.image_right }}%;
      bottom: {{ section.settings.image_bottom }}%;
      width: var(--krc-image-width);
      max-width: 75%;
      pointer-events: none;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__image {
      display: block;
      width: 100%;
      height: var(--krc-image-height);
      min-height: 120px;
      object-fit: contain;
      object-position: var(--krc-image-object-position);
      border-radius: var(--krc-image-radius);
      {% if section.settings.image_shadow %}
        filter: drop-shadow(
          {{ section.settings.image_shadow_x }}px
          {{ section.settings.image_shadow_y }}px
          {{ section.settings.image_shadow_blur }}px
          rgba(0,0,0,{{ section.settings.image_shadow_opacity | divided_by: 100.0 }})
        );
      {% endif %}
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__overlay {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      opacity: 0;
      transition: opacity {{ section.settings.hover_transition_duration }}ms ease;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card:hover .kovari-ritual-card__overlay {
      opacity: {{ section.settings.hover_overlay_opacity | divided_by: 100.0 }};
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__arrow {
      position: absolute;
      top: var(--krc-arrow-top);
      right: var(--krc-arrow-right);
      z-index: 5;
      width: var(--krc-arrow-size);
      height: var(--krc-arrow-size);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: var(--krc-arrow-border-width) solid var(--krc-arrow-border);
      border-radius: var(--krc-arrow-radius);
      background: var(--krc-arrow-bg);
      background: color-mix(
        in srgb,
        var(--krc-arrow-bg) var(--krc-arrow-bg-opacity),
        transparent
      );
      color: var(--krc-arrow-color);
      pointer-events: none;
      transition: transform {{ section.settings.hover_transition_duration }}ms ease;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card:hover .kovari-ritual-card__arrow {
      transform: translate(3px, 0);
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card--static {
      cursor: default;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__arrow svg,
    #KovariRitualCards-{{ section.id }} .kovari-ritual-card__arrow img {
      width: 48%;
      height: 48%;
      object-fit: contain;
    }

    @media (max-width: 990px) {
      #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__grid {
        grid-template-columns: repeat({{ section.settings.tablet_columns }}, minmax(0, 1fr));
      }
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card {
        min-height: {{ section.settings.tablet_card_height }}px;
      }
    }

    @media (max-width: 640px) {
      #KovariRitualCards-{{ section.id }} {
        padding-left: 20px;
        padding-right: 20px;
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__grid {
        gap: var(--krc-mobile-gap);
      }

      {% if section.settings.mobile_layout == 'stack' %}
        #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__grid {
          grid-template-columns: 1fr;
        }
      {% else %}
        #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__grid {
          grid-auto-flow: column;
          grid-auto-columns: {{ section.settings.mobile_card_width }}px;
          grid-template-columns: none;
          overflow-x: auto;
          overscroll-behavior-x: contain;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;
          padding-bottom: 4px;
        }
        #KovariRitualCards-{{ section.id }} .kovari-ritual-cards__grid::-webkit-scrollbar {
          display: none;
        }
        #KovariRitualCards-{{ section.id }} .kovari-ritual-card {
          scroll-snap-align: start;
        }
      {% endif %}

      /* Card hugs its content — no reserved height, no dead space */
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 0;
        height: auto;
        padding:
          var(--krc-mobile-padding-top)
          var(--krc-mobile-padding-right)
          var(--krc-mobile-padding-bottom)
          var(--krc-mobile-padding-left);
        border-radius: var(--krc-mobile-radius);
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__label {
        font-size: var(--krc-mobile-label-size);
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__content {
        width: min(100%, {{ section.settings.mobile_content_max_width }}%);
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__title {
        width: 100%;
        max-width: var(--krc-mobile-title-max-width);
        font-size: var(--krc-mobile-title-size);
        margin-top: {{ section.settings.mobile_title_top_margin }}px;
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__description {
        width: 100%;
        max-width: var(--krc-mobile-text-max-width);
        font-size: var(--krc-mobile-text-size);
        margin-top: {{ section.settings.mobile_description_top_margin }}px;
      }

      /* Image in normal flow, right-docked under the text */
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__image-wrap {
        position: relative;
        right: auto;
        bottom: auto;
        width: min({{ section.settings.mobile_image_width }}%, {{ section.settings.mobile_image_max_width }}px);
        max-width: 54%;
        margin: 20px 0 0 auto;
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__image {
        width: 100%;
        height: var(--krc-mobile-image-height);
        min-height: 100px;
        object-fit: contain;
        object-position: center bottom;
        border-radius: {{ section.settings.mobile_image_radius }}px;
      }

      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__arrow {
        width: var(--krc-mobile-arrow-size);
        height: var(--krc-mobile-arrow-size);
        top: {{ section.settings.mobile_arrow_top }}px;
        right: {{ section.settings.mobile_arrow_right }}px;
      }

      .kovari-ritual-card--static {
        max-height: 180px;
      }

      .kovari-ritual-card__image-wrap {
                right: -0% !important;
        bottom: 250px !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card,
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__overlay,
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card__arrow {
        transition: none;
      }
      #KovariRitualCards-{{ section.id }} .kovari-ritual-card:hover {
        transform: none;
      }
    }
  {%- endstyle -%}

  <div class="kovari-ritual-cards__shell">
    <div class="kovari-ritual-cards__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a
            class="kovari-ritual-card"
            role="listitem"
            href="{{ block.settings.link }}"
            style="
              --krc-card-bg: {{ block.settings.background_color }};
              --krc-label-color: {{ block.settings.label_color }};
              --krc-title-color: {{ block.settings.title_color }};
              --krc-text-color: {{ block.settings.text_color }};
              --krc-arrow-bg: {{ block.settings.arrow_background }};
              --krc-arrow-color: {{ block.settings.arrow_color }};
              --krc-arrow-border: {{ block.settings.arrow_border }};
              --krc-card-border: {{ block.settings.card_border_color }};
            "
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <div
            class="kovari-ritual-card kovari-ritual-card--static"
            role="listitem"
            style="
              --krc-card-bg: {{ block.settings.background_color }};
              --krc-label-color: {{ block.settings.label_color }};
              --krc-title-color: {{ block.settings.title_color }};
              --krc-text-color: {{ block.settings.text_color }};
              --krc-arrow-bg: {{ block.settings.arrow_background }};
              --krc-arrow-color: {{ block.settings.arrow_color }};
              --krc-arrow-border: {{ block.settings.arrow_border }};
              --krc-card-border: {{ block.settings.card_border_color }};
            "
            {{ block.shopify_attributes }}
          >
        {%- endif -%}

          {%- if block.settings.overlay_color != blank -%}
            <span
              class="kovari-ritual-card__overlay"
              style="background: {{ block.settings.overlay_color }};"
              aria-hidden="true"
            ></span>
          {%- endif -%}

          <div class="kovari-ritual-card__content">
            {%- if block.settings.label != blank -%}
              <p class="kovari-ritual-card__label">{{ block.settings.label }}</p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h2 class="kovari-ritual-card__title">{{ block.settings.title }}</h2>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="kovari-ritual-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>

          {%- if block.settings.image != blank -%}
            <div class="kovari-ritual-card__image-wrap" aria-hidden="true">
              <img
                class="kovari-ritual-card__image"
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt=""
                loading="{{ section.settings.image_loading }}"
                width="800"
                height="800"
              >
            </div>
          {%- endif -%}

          {%- if section.settings.show_arrow -%}
            <span class="kovari-ritual-card__arrow" aria-hidden="true">
              {%- if section.settings.custom_arrow_icon != blank -%}
                <img
                  src="{{ section.settings.custom_arrow_icon | image_url: width: 64 }}"
                  alt=""
                  width="64"
                  height="64"
                >
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              {%- endif -%}
            </span>
          {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOVARI Ritual Cards",
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 600, "max": 2400, "step": 20, "default": 1560, "unit": "px" },
    { "type": "range", "id": "margin_top", "label": "Space above section", "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "margin_bottom", "label": "Space below section", "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "desktop_columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "tablet_columns", "label": "Tablet columns", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "scroll", "options": [
      { "value": "scroll", "label": "Horizontal scroll" },
      { "value": "stack", "label": "Stack vertically" }
    ] },
    { "type": "range", "id": "mobile_card_width", "label": "Mobile card width", "min": 240, "max": 420, "step": 10, "default": 300, "unit": "px" },
    { "type": "range", "id": "card_gap", "label": "Desktop card gap", "min": 0, "max": 60, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "mobile_card_gap", "label": "Mobile card gap", "min": 0, "max": 40, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "content_max_width", "label": "Desktop text content width", "min": 45, "max": 80, "step": 1, "default": 60, "unit": "%" },
    { "type": "range", "id": "mobile_content_max_width", "label": "Mobile text content width", "min": 45, "max": 75, "step": 1, "default": 58, "unit": "%" },
    { "type": "range", "id": "mobile_image_max_width", "label": "Mobile maximum image width", "min": 120, "max": 360, "step": 10, "default": 220, "unit": "px" },

    { "type": "header", "content": "Card" },
    { "type": "range", "id": "card_height", "label": "Desktop card min height", "min": 180, "max": 700, "step": 10, "default": 280, "unit": "px" },
    { "type": "range", "id": "tablet_card_height", "label": "Tablet card min height", "min": 220, "max": 600, "step": 10, "default": 280, "unit": "px" },
    { "type": "range", "id": "mobile_card_height", "label": "Mobile card min height", "min": 220, "max": 620, "step": 10, "default": 260, "unit": "px" },
    { "type": "range", "id": "card_radius", "label": "Desktop card radius", "min": 0, "max": 60, "step": 2, "default": 18, "unit": "px" },
    { "type": "range", "id": "mobile_card_radius", "label": "Mobile card radius", "min": 0, "max": 50, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "card_border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "default": 0, "unit": "px" },
    { "type": "color", "id": "card_border_color", "label": "Default border color", "default": "#E6DFD8" },
    { "type": "range", "id": "card_padding_top", "label": "Desktop top padding", "min": 8, "max": 70, "step": 2, "default": 28, "unit": "px" },
    { "type": "range", "id": "card_padding_right", "label": "Desktop right padding", "min": 8, "max": 70, "step": 2, "default": 28, "unit": "px" },
    { "type": "range", "id": "card_padding_bottom", "label": "Desktop bottom padding", "min": 8, "max": 70, "step": 2, "default": 28, "unit": "px" },
    { "type": "range", "id": "card_padding_left", "label": "Desktop left padding", "min": 8, "max": 70, "step": 2, "default": 28, "unit": "px" },
    { "type": "range", "id": "mobile_card_padding_top", "label": "Mobile top padding", "min": 8, "max": 50, "step": 2, "default": 22, "unit": "px" },
    { "type": "range", "id": "mobile_card_padding_right", "label": "Mobile right padding", "min": 8, "max": 50, "step": 2, "default": 22, "unit": "px" },
