{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{{ 'mariana-red--global.js' | asset_url | script_tag }}
{%- comment -%}
  Announcement bar with dismissible option and message blocks.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    <div class="page-width announcement-bar__inner">
      {%- for block in section.blocks -%}
        {%- if forloop.index0 > 0 -%}
          <span class="announcement-bar__sep" aria-hidden="true">|</span>
        {%- endif -%}
        <p class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">
              {%- if block.settings.emoji != blank -%}<span aria-hidden="true">{{ block.settings.emoji }}</span>{%- endif -%}
              {{ block.settings.text | escape }}
            </a>
          {%- else -%}
            {%- if block.settings.emoji != blank -%}<span aria-hidden="true">{{ block.settings.emoji }}</span>{%- endif -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "class": "shopify-section--announcement",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    },
    {
      "type": "checkbox",
      "id": "show_dismiss",
      "label": "Show dismiss button",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $50"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji or symbol",
          "info": "Displayed before the text, e.g. \ud83d\ude9a"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "emoji": "\ud83d\ude9a",
            "text": "Free shipping on orders over $50"
          }
        },
        {
          "type": "message",
          "settings": {
            "emoji": "\ud83c\udf6b",
            "text": "Premium quality, made with love"
          }
        }
      ]
    }
  ]
}
{% endschema %}
