{%- comment -%} Section Library: injected global assets for store "pyko" {%- endcomment -%}
{{ 'pyko--base.css' | asset_url | stylesheet_tag }}
{{ 'pyko--components.css' | asset_url | stylesheet_tag }}
{% render 'pyko--layout-tokens' %}
{%- comment -%}
  Product showcase banner — full-bleed image with heading top-left, pill CTA
  top-right, mini product carousel bottom-left and benefit links bottom-right
  (Pyko "Every type of skin can benefit" composition).
{%- endcomment -%}
{%- liquid
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}
<section
  class="showcase showcase-{{ section.id }} hero__height-{{ section.settings.height }}"
  style="--overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay }}; --showcase-min-height: {{ section.settings.min_height }}px;"
>
  {%- if section.settings.show_image and section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'showcase__bg', loading: 'lazy', widths: '960, 1280, 1600, 2400', sizes: '100vw', alt: section.settings.image.alt }}
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'showcase__bg placeholder-svg' }}
  {%- endif -%}
  <div class="showcase__scrim" aria-hidden="true"></div>

  <div class="page-width showcase__inner">
    <div class="showcase__top">
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="showcase__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <span class="showcase__cta">
          {% render 'pyko--button', label: section.settings.cta_label, link: section.settings.cta_link, style: 'light', size: 'small' %}
          <span class="showcase__cta-arrow" aria-hidden="true">{% render 'pyko--icon', name: 'arrow-up-right', size: 13 %}</span>
        </span>
      {%- endif -%}
    </div>

    <div class="showcase__bottom">
      {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}
      {%- if product_blocks.size > 0 -%}
        <div class="showcase__products" data-carousel>
          <div class="showcase__arrows">
            <button type="button" class="showcase__arrow showcase__arrow--prev" data-carousel-prev aria-label="{{ 'general.slider.previous' | t }}">
              {% render 'pyko--icon', name: 'chevron-left', size: 12 %}
            </button>
            <button type="button" class="showcase__arrow showcase__arrow--next" data-carousel-next aria-label="{{ 'general.slider.next' | t }}">
              {% render 'pyko--icon', name: 'chevron-right', size: 12 %}
            </button>
          </div>
          <div class="card-carousel__track showcase__track">
            {%- for block in product_blocks -%}
              {%- liquid
                assign sp = block.settings.product
                if sp.title == blank
                  assign sp = all_products[sp]
                endif
              -%}
              {%- if sp != blank and sp.title != blank -%}
                <div class="showcase__card" {{ block.shopify_attributes }}>
                  <a href="{{ sp.url }}" class="showcase__card-media" tabindex="-1" aria-hidden="true">
                    {%- if sp.featured_media -%}
                      {{ sp.featured_media | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 320', alt: sp.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </a>
                  <div class="showcase__card-info">
                    <a href="{{ sp.url }}" class="showcase__card-copy">
                      <span class="showcase__card-title">{{ sp.title | escape }}</span>
                      <span class="showcase__card-price">{{ sp.price | money }}</span>
                    </a>
                    {%- if sp.available -%}
                      {%- if sp.variants.size == 1 -%}
                        {%- form 'product', sp, id: nil, class: 'showcase__card-form' -%}
                          <input type="hidden" name="id" value="{{ sp.selected_or_first_available_variant.id }}">
                          <button type="submit" class="showcase__card-plus" aria-label="{{ 'products.product.add_to_cart' | t }}">
                            {% render 'pyko--icon', name: 'plus', size: 12 %}
                          </button>
                        {%- endform -%}
                      {%- else -%}
                        <a href="{{ sp.url }}" class="showcase__card-plus" aria-label="{{ 'products.product.add_to_cart' | t }}">
                          {% render 'pyko--icon', name: 'plus', size: 12 %}
                        </a>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
      {%- if benefit_blocks.size > 0 -%}
        <ul class="showcase__benefits">
          {%- for block in benefit_blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .showcase-{{ section.id }} { position: relative; overflow: hidden; display: flex; align-items: stretch; min-height: var(--showcase-min-height, 620px); }
  .showcase-{{ section.id }} img.showcase__bg, .showcase-{{ section.id }} svg.showcase__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .showcase-{{ section.id }} .showcase__scrim { position: absolute; inset: 0; background: var(--overlay-color); }
  .showcase-{{ section.id }} .showcase__inner {
    position: relative; z-index: 2; width: 100%;
    display: flex; flex-direction: column; justify-content: space-between;
    gap: 2.5rem; padding-block: clamp(2.2rem, 5vh, 3.5rem);
    color: #ffffff;
  }
  .showcase-{{ section.id }} .showcase__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .showcase-{{ section.id }} .showcase__heading { margin: 0; max-width: 26rem; font-weight: 500; }
  .showcase-{{ section.id }} .showcase__cta { display: inline-flex; align-items: center; gap: 0.4rem; }
  .showcase-{{ section.id }} .showcase__cta .button--light { color: #2f2a24; }
  .showcase-{{ section.id }} .showcase__cta-arrow {
    width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: #ffffff; color: #2f2a24;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .showcase-{{ section.id }} .showcase__bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .showcase-{{ section.id }} .showcase__products { max-width: 13rem; }
  .showcase-{{ section.id }} .showcase__arrows { display: flex; gap: 0.4rem; margin-bottom: 0.6rem; }
  .showcase-{{ section.id }} .showcase__arrow {
    width: 2rem; height: 1.7rem; border-radius: 999px; border: none; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.35); color: #ffffff;
  }
  .showcase-{{ section.id }} .showcase__arrow--next { background: #ffffff; color: #2f2a24; }
  .showcase-{{ section.id }} .showcase__track { display: flex; gap: 0; }
  .showcase-{{ section.id }} .showcase__track > * { flex: 0 0 100%; }
  .showcase-{{ section.id }} .showcase__card {
    background: #ffffff; color: #2f2a24;
    border-radius: 1rem; padding: 0.55rem 0.55rem 0.7rem;
    display: block;
  }
  .showcase-{{ section.id }} .showcase__card-media { display: block; border-radius: 0.7rem; overflow: hidden; aspect-ratio: 1 / 1.15; background: {{ section.settings.fallback_bg }}; }
  .showcase-{{ section.id }} .showcase__card-media img, .showcase-{{ section.id }} .showcase__card-media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .showcase-{{ section.id }} .showcase__card-info { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.4rem; margin-top: 0.5rem; }
  .showcase-{{ section.id }} .showcase__card-copy { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; text-decoration: none; }
  .showcase-{{ section.id }} .showcase__card-title { font-size: 0.8rem; font-weight: 600; line-height: 1.3; color: #2f2a24; }
  .showcase-{{ section.id }} .showcase__card-price { font-size: 0.72rem; color: rgba(0, 0, 0, 0.55); }
  .showcase-{{ section.id }} .showcase__card-plus {
    position: static; margin: 0;
    width: 1.8rem; height: 1.8rem; border-radius: 50%; flex-shrink: 0;
    background: #1c1a16; color: #fff; border: none; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    text-decoration: none;
  }
  .showcase-{{ section.id }} .showcase__card-form { margin: 0; line-height: 0; }
  .showcase-{{ section.id }} .showcase__card { position: relative; }
  .showcase-{{ section.id }} .showcase__benefits {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: clamp(1.2rem, 2.6vw, 2.6rem); flex-wrap: wrap;
    font-size: 0.82rem;
  }
  .showcase-{{ section.id }} .showcase__benefits li { text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25); }
  @media (max-width: 989px) {
    .showcase-{{ section.id }} .showcase__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Product showcase",
  "max_blocks": 10,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 10
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height preset",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "default": "lg"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 520,
      "max": 720,
      "step": 2,
      "unit": "px",
      "default": 620
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Every type of skin can benefit\nfrom this product"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "Display"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#18120c"
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Card media background",
      "default": "#e8d9c4"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "header",
      "content": "Enriched shape"
    },
    {
      "type": "range",
      "id": "enr_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "enr_border_width",
      "label": "Card border width",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1 px"
        },
        {
          "value": "2",
          "label": "2 px"
        },
        {
          "value": "3",
          "label": "3 px"
        },
        {
          "value": "4",
          "label": "4 px"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "Enriched sizes (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_sizes",
      "label": "Enable custom sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_title_size",
      "label": "Title size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "enr_body_size",
      "label": "Body size",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "enr_eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "enr_icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Enriched spacing (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_space_top",
      "label": "Space top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_space_bottom",
      "label": "Space bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
