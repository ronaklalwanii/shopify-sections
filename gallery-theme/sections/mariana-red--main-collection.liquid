{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{{ 'mariana-red--global.js' | asset_url | script_tag }}
{%- comment -%}
  Collection page — header, sort, storefront filters, product grid, pagination.
{%- endcomment -%}
{%- liquid
  assign per_page = section.settings.products_per_page | default: 12
-%}
<section class="section" style="--section-space: {{ section.settings.padding | default: 48 }}px;">
  <div class="page-width">
    <div class="collection-header">
      {%- if section.settings.show_collection_title -%}
        <h1 class="h1">{{ collection.title | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="rte" style="margin-inline: auto;">{{ collection.description }}</div>
      {%- endif -%}
      {%- if section.settings.show_collection_image and collection.image -%}
        {{ collection.image | image_url: width: 1200 | image_tag: widths: '540, 720, 1200', alt: collection.image.alt }}
      {%- endif -%}
    </div>

    <div class="collection-toolbar">
      <p class="collection-toolbar__count" role="status">
        {{ 'collections.general.product_count' | t: count: collection.products_count }}
      </p>
      <div class="collection-toolbar__filters">
        {%- for filter in collection.filters -%}
          {%- case filter.type -%}
            {%- when 'boolean', 'list' -%}
              <details class="collection-filter">
                <summary>
                  {{ filter.label | escape }}
                  {%- if filter.active_values.size > 0 -%}
                    <span class="badge" style="padding: 0.1rem 0.45rem;">{{ filter.active_values.size }}</span>
                  {%- endif -%}
                  {% render 'mariana-red--icon', name: 'chevron-down', size: 11 %}
                </summary>
                <form class="collection-filter__panel">
                  <ul>
                    {%- for value in filter.values -%}
                      <li>
                        <label>
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          {{ value.label | escape }} ({{ value.count }})
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                  {%- if collection.current_type or collection.current_vendor or collection.current_tags -%}
                    <input type="hidden" name="q" value="{{ collection.title }}">
                  {%- endif -%}
                  <button type="submit" class="button button--dark button--small collection-filter__apply">{{ 'collections.general.apply' | t }}</button>
                </form>
              </details>
            {%- when 'price_range' -%}
              <details class="collection-filter">
                <summary>
                  {{ filter.label | escape }}
                  {% render 'mariana-red--icon', name: 'chevron-down', size: 11 %}
                </summary>
                <form class="collection-filter__panel">
                  <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <label class="visually-hidden" for="Filter-{{ filter.min_value.param_name }}">{{ 'collections.general.from' | t }}</label>
                    <input class="input" id="Filter-{{ filter.min_value.param_name }}" type="number" name="{{ filter.min_value.param_name }}" placeholder="Min" min="0" max="{{ filter.range_max | divided_by: 100 }}" value="{{ filter.min_value.value | divided_by: 100 }}">
                    <span>—</span>
                    <label class="visually-hidden" for="Filter-{{ filter.max_value.param_name }}">{{ 'collections.general.to' | t }}</label>
                    <input class="input" id="Filter-{{ filter.max_value.param_name }}" type="number" name="{{ filter.max_value.param_name }}" placeholder="Max" min="0" max="{{ filter.range_max | divided_by: 100 }}" value="{{ filter.max_value.value | divided_by: 100 }}">
                  </div>
                  <button type="submit" class="button button--dark button--small collection-filter__apply">{{ 'collections.general.apply' | t }}</button>
                </form>
              </details>
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.show_sort -%}
          <form class="select-wrapper">
            <label class="visually-hidden" for="SortBy">{{ 'collections.sorting.title' | t }}</label>
            <select name="sort_by" id="SortBy" class="input" style="padding-block: 0.5rem; font-size: 0.8rem;" onchange="this.form.submit()">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>
    </div>

    {%- paginate collection.products by per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid product-grid--cols-4 collection-grid--products">
          {%- for product in collection.products -%}
            {% render 'mariana-red--product-card', product: product, show_price: true, show_button: section.settings.card_button %}
          {%- endfor -%}
        </div>
        {% render 'mariana-red--pagination', paginate: paginate %}
      {%- else -%}
        <div class="collection-empty">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          {% render 'mariana-red--button', label_key: 'general.continue_shopping', link: collection.url, style: 'outline', size: 'small' %}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_button",
      "label": "Show add-to-cart on cards",
      "default": false
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
