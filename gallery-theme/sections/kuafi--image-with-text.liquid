{%- comment -%} Section Library: injected global assets for store "kuafi" {%- endcomment -%}
{{ 'kuafi--base.css' | asset_url | stylesheet_tag }}
{{ 'kuafi--components.css' | asset_url | stylesheet_tag }}
{% render 'kuafi--layout-tokens' %}
{{ 'kuafi--global.js' | asset_url | script_tag }}
{{ 'kuafi--wishlist.js' | asset_url | script_tag }}
{%- comment -%}
  Image with text — story sections ("Fashion with Purpose", "Crafted with
  Passion"). Optional feature blocks render as a third column.
{%- endcomment -%}
{%- liquid
  assign has_features = false
  for block in section.blocks
    if block.type == 'feature'
      assign has_features = true
    endif
  endfor
-%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }}
  class="section{% if section.settings.flush %} section--flush{% endif %}"
  style="--section-space: {{ section.settings.padding | default: 72 }}px; --iwt-ratio: {{ section.settings.image_ratio }};"
>
  <div class="page-width">
    <div class="image-with-text{% if has_features %} image-with-text--features{% endif %}{% if section.settings.image_position == 'left' %} image-with-text--image-left{% else %} image-with-text--image-right{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.show_image and section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '540, 720, 960, 1400', sizes: '(min-width: 990px) 33vw, 100vw', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content" style="text-align: {{ section.settings.text_align }};">
        {%- if section.settings.heading_last -%}
          {%- if section.settings.text != blank -%}
            <div class="image-with-text__text image-with-text__text--top" style="font-size: 0.85rem;">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <div class="image-with-text__buttons image-with-text__buttons--top">
              {%- for block in section.blocks -%}
                {%- if block.type == 'button' -%}
                  {% render 'kuafi--button',
                    label: block.settings.label,
                    link: block.settings.link,
                    style: block.settings.style,
                    size: 'small',
                    attributes: block.shopify_attributes
                  %}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.show_heading and section.settings.heading != blank -%}
            <h2 class="h2 image-with-text__heading{% if section.settings.heading_caps %} image-with-text__heading--caps{% endif %}">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- endif -%}
        {%- else -%}
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.show_heading and section.settings.heading != blank -%}
          <h2 class="h2 image-with-text__heading{% if section.settings.heading_caps %} image-with-text__heading--caps{% endif %}">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text" style="font-size: 0.9rem;">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="image-with-text__buttons">
            {%- for block in section.blocks -%}
              {%- if block.type == 'button' -%}
                {% render 'kuafi--button',
                  label: block.settings.label,
                  link: block.settings.link,
                  style: block.settings.style,
                  size: 'small',
                  attributes: block.shopify_attributes
                %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- endif -%}
      </div>

      {%- if has_features -%}
        <div class="image-with-text__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="image-with-text__feature" {{ block.shopify_attributes }}>
                {% render 'kuafi--icon', name: block.settings.icon, size: 24 %}
                <div>
                  <h4>{{ block.settings.title | escape }}</h4>
                  {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  /* phase 2 enrichment: every rule is merchant-gated; defaults change nothing */
  {%- if section.settings.enr_heading_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-heading: {{ section.settings.enr_heading_color }}; }
  #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} [class*="__title"] { color: var(--enr-heading); }
  {%- endif -%}
  {%- if section.settings.enr_text_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-text: {{ section.settings.enr_text_color }}; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"], #shopify-section-{{ section.id }} [class*="__sub"], #shopify-section-{{ section.id }} [class*="__desc"] { color: var(--enr-text); }
  {%- endif -%}
  {%- if section.settings.enr_accent_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-accent: {{ section.settings.enr_accent_color }}; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"], #shopify-section-{{ section.id }} [class*="__kicker"] { color: var(--enr-accent); }
  {%- endif -%}
  {%- if section.settings.enr_card_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-card: {{ section.settings.enr_card_bg }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { background-color: var(--enr-card); }
  {%- endif -%}
  {%- if section.settings.enr_border_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-border: {{ section.settings.enr_border_color }}; }
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__box"] { border-color: var(--enr-border); }
  {%- endif -%}
  {%- if section.settings.enr_muted_color != blank -%}
  #shopify-section-{{ section.id }} { --enr-muted: {{ section.settings.enr_muted_color }}; }
  #shopify-section-{{ section.id }} small, #shopify-section-{{ section.id }} [class*="__meta"], #shopify-section-{{ section.id }} [class*="__note"], #shopify-section-{{ section.id }} [class*="__caption"] { color: var(--enr-muted); }
  {%- endif -%}
  {%- if section.settings.enr_fallback_bg != blank -%}
  #shopify-section-{{ section.id }} { --enr-fallback: {{ section.settings.enr_fallback_bg }}; }
  #shopify-section-{{ section.id }} [class*="__placeholder"], #shopify-section-{{ section.id }} .placeholder-svg { background-color: var(--enr-fallback); }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'narrow' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: 46rem; }
  {%- endif -%}
  {%- if section.settings.enr_layout_width == 'wide' -%}
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'left' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: left; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'center' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: center; }
  {%- endif -%}
  {%- if section.settings.enr_layout_align == 'right' -%}
  #shopify-section-{{ section.id }} [class*="__head"], #shopify-section-{{ section.id }} [class*="__intro"] { text-align: right; }
  {%- endif -%}
  {%- if section.settings.enr_radius > 0 -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"], #shopify-section-{{ section.id }} [class*="__media"], #shopify-section-{{ section.id }} img { border-radius: {{ section.settings.enr_radius }}px; }
  {%- endif -%}
  {%- if section.settings.enr_border_width != '0' -%}
  #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} [class*="__tile"], #shopify-section-{{ section.id }} [class*="__panel"] { border: {{ section.settings.enr_border_width }}px solid var(--color-border, currentColor); }
  {%- endif -%}
  {%- if section.settings.enable_custom_sizes -%}
  #shopify-section-{{ section.id }} [class*="__heading"], #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3 { font-size: {{ section.settings.enr_title_size }}px; }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li, #shopify-section-{{ section.id }} [class*="__text"] { font-size: {{ section.settings.enr_body_size }}px; }
  #shopify-section-{{ section.id }} .eyebrow, #shopify-section-{{ section.id }} [class*="__eyebrow"] { font-size: {{ section.settings.enr_eyebrow_size }}px; }
  #shopify-section-{{ section.id }} [class*="__icon"] svg, #shopify-section-{{ section.id }} svg.icon { width: {{ section.settings.enr_icon_size }}px; height: {{ section.settings.enr_icon_size }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_spacing -%}
  #shopify-section-{{ section.id }} > section, #shopify-section-{{ section.id }} > div { padding-block: {{ section.settings.enr_space_top }}px {{ section.settings.enr_space_bottom }}px; }
  #shopify-section-{{ section.id }} [class*="__grid"], #shopify-section-{{ section.id }} [class*="__row"], #shopify-section-{{ section.id }} [class*="__cards"], #shopify-section-{{ section.id }} [class*="__list"] { gap: {{ section.settings.enr_gap }}px; }
  {%- endif -%}
  {%- if section.settings.enable_custom_media -%}
  #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height }}px; width: 100%; object-fit: cover; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} [class*="__media"] img, #shopify-section-{{ section.id }} [class*="__image"] img, #shopify-section-{{ section.id }} [class*="__photo"] img { max-height: {{ section.settings.enr_media_height_mobile }}px; }
  }
  {%- endif -%}
{% endstyle %}
{% schema %}
{
  "name": "Image with text",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sustainable by choice"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Fashion with Purpose.\nBetter for You. Better for Earth."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in slow fashion: crafted with care using sustainable fabrics and ethical practices. Look good while doing good.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Kuafi editorial"
    },
    {
      "type": "checkbox",
      "id": "heading_caps",
      "label": "Grotesk caps heading (sans uppercase)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_last",
      "label": "Heading last (text + button above heading)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "flush",
      "label": "Flush full-bleed (no card, hairline dividers)",
      "default": false
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    },
    {
      "type": "header",
      "content": "Enriched colors (blank = as designed)"
    },
    {
      "type": "color",
      "id": "enr_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "enr_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "enr_accent_color",
      "label": "Accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "enr_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "enr_border_color",
      "label": "Card border color"
    },
    {
      "type": "color",
      "id": "enr_muted_color",
      "label": "Muted text color"
    },
    {
      "type": "color",
      "id": "enr_fallback_bg",
      "label": "Image fallback background"
    },
    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "select",
      "id": "enr_layout_align",
      "label": "Intro alignment",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "as_designed"
    },
    {
      "type": "header",
      "content": "Enriched shape"
    },
    {
      "type": "range",
      "id": "enr_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "enr_border_width",
      "label": "Card border width",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1 px"
        },
        {
          "value": "2",
          "label": "2 px"
        },
        {
          "value": "3",
          "label": "3 px"
        },
        {
          "value": "4",
          "label": "4 px"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "Enriched sizes (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_sizes",
      "label": "Enable custom sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_title_size",
      "label": "Title size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "enr_body_size",
      "label": "Body size",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "enr_eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "enr_icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Enriched spacing (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_space_top",
      "label": "Space top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_space_bottom",
      "label": "Space bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media",
      "label": "Enable custom media heights",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_media_height",
      "label": "Media height (desktop)",
      "min": 380,
      "max": 580,
      "step": 2,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 300,
      "max": 500,
      "step": 2,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Learn our journey"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Accent"
            },
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Icon feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "flower",
              "label": "Flower"
            },
            {
              "value": "hands",
              "label": "Hands"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "shield-check",
              "label": "Shield with check"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium materials"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sourced from the world's finest farms"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        {
          "type": "button"
        }
      ]
    }
  ]
}
  {% endschema %}
