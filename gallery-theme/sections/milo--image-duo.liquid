      "min": 10,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "enr_icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Enriched spacing (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_space_top",
      "label": "Space top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_space_bottom",
      "label": "Space bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "enr_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Enriched media (off = as designed)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media",
      "label": "Enable custom media heights",
      "default": false
    },
    {
      "type": "range",
      "id": "enr_media_height",
      "label": "Media height (desktop)",
      "min": 380,
      "max": 580,
      "step": 2,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "enr_media_height_mobile",
      "label": "Media height (mobile)",
      "min": 300,
      "max": 500,
      "step": 2,
      "unit": "px",
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "Image duo"
    }
  ]
}
  {% endschema %}
