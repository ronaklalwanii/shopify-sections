{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{%- comment -%}
  FAQ — accordion. Optional split layout with heading beside the list.
{%- endcomment -%}
{%- capture section_colors_style -%}
  {%- if section.settings.colors_background != blank or section.settings.colors_text != blank -%}
    {%- assign override_bg = section.settings.colors_background | default: settings.colors_background -%}
    {%- assign override_fg = section.settings.colors_text | default: settings.colors_text -%}
    style="--color-background: {{ override_bg }}; --color-surface: {{ override_bg | color_lighten: 3 }}; --color-border: {{ override_bg | color_darken: 9 | color_modify: 'alpha', 0.85 }}; --color-foreground: {{ override_fg }}; --color-heading: {{ override_fg }}; --color-text-muted: {{ override_fg | color_modify: 'alpha', 0.62 }};"
  {%- endif -%}
{%- endcapture -%}
<section {{ section_colors_style }} class="section" style="--section-space: {{ section.settings.padding | default: 64 }}px;">
  <div class="page-width">
    {%- if section.settings.split -%}
      <div class="faq-split">
        <div>
          <h2 class="h3" style="margin-bottom: 0.4em;">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.link_label != blank -%}
            <a href="{{ section.settings.link }}" class="arrow-link" style="font-size: 0.72rem;">
              {{ section.settings.link_label | escape }}
              {% render 'mariana-red--icon', name: 'arrow-right', size: 12 %}
            </a>
          {%- endif -%}
        </div>
        <div>
          {%- for block in section.blocks -%}
            <details class="faq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
              <summary class="faq-item__summary">
                {{ block.settings.question | escape }}
                {% render 'mariana-red--icon', name: 'plus', size: 14 %}
              </summary>
              <div class="faq-item__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="section-intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 section-intro__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div style="max-width: 46rem; margin-inline: auto;">
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary class="faq-item__summary">
              {{ block.settings.question | escape }}
              {% render 'mariana-red--icon', name: 'plus', size: 14 %}
            </summary>
            <div class="faq-item__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Common questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "checkbox",
      "id": "split",
      "label": "Heading beside the list",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "colors_background",
      "label": "Background override",
      "info": "Leave empty to use the theme colors"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "Text color override"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your delivery time?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders are dispatched within 2 working days and typically arrive within 3\u20135 working days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you offer a warranty?",
            "answer": "<p>Every piece is covered by a 2-year warranty against manufacturing defects.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I return an item?",
            "answer": "<p>You can return any item within 30 days, hassle-free.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are your products sustainable?",
            "answer": "<p>We prioritise responsibly sourced materials and plastic-free packaging.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
