{%- comment -%} Section Library: injected global assets for store "mariana-red" {%- endcomment -%}
{{ 'mariana-red--base.css' | asset_url | stylesheet_tag }}
{{ 'mariana-red--components.css' | asset_url | stylesheet_tag }}
{% render 'mariana-red--layout-tokens' %}
{%- comment -%}
  Password entry — used with layout/password.liquid.
{%- endcomment -%}
<div class="password-page">
  <div style="margin-bottom: 1.6rem;">
    {%- if settings.logo -%}
      {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, style: 'width: var(--logo-width, 140px); margin-inline: auto;' }}
    {%- else -%}
      <p class="site-header__wordmark" style="font-size: 1.6rem;">{{ shop.name }}</p>
    {%- endif -%}
  </div>
  <h1 class="h2">{{ 'general.password_page.opening_soon' | t }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="text-muted" style="max-width: 30rem;">{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password', class: 'password-page__form' -%}
    {%- if form.errors -%}
      <p class="form__message form__message--error" style="width: 100%;">{{ form.errors.messages.form }}</p>
    {%- endif -%}
    <label class="visually-hidden" for="Password">{{ 'general.password_page.subtext' | t }}</label>
    <input type="password" id="Password" class="input" name="password" placeholder="{{ 'general.password_page.subtext' | t }}" autocomplete="current-password">
    <button type="submit" class="button button--dark">{{ 'general.password_page.submit' | t }}</button>
  {%- endform -%}
  <p class="text-muted" style="margin-top: 2.4rem; font-size: 0.78rem;">{{ 'general.password_page.admin_link_html' | t }}</p>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": []
}
{% endschema %}
