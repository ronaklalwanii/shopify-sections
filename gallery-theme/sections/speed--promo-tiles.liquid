    {
      "type": "header",
      "content": "Enriched layout"
    },
    {
      "type": "select",
      "id": "enr_layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "as_designed",
          "label": "As designed"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
