          {% else %}
            <div class="ai-sauna-benefits-image-placeholder-{{ ai_gen_id }} ai-sauna-benefits-image-mobile-{{ ai_gen_id }}">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
              <div class="ai-sauna-benefits-empty-state-{{ ai_gen_id }}">
                Add Longevity mobile image
              </div>
            </div>
          {% endif %}
        </div>

        <div class="ai-sauna-benefits-grid-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% liquid
              assign title_key = 'longevity_benefit_' | append: i | append: '_title'
              assign desc_key = 'longevity_benefit_' | append: i | append: '_description'
              assign title = block.settings[title_key]
              assign description = block.settings[desc_key]
            %}
            {% if title != blank or description != blank %}
              <div class="ai-sauna-benefits-card-{{ ai_gen_id }}">
                {% if title != blank %}
                  <h3 class="ai-sauna-benefits-card-title-{{ ai_gen_id }}">{{ title }}</h3>
                {% endif %}
                {% if description != blank %}
                  <p class="ai-sauna-benefits-card-description-{{ ai_gen_id }}">{{ description }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="ai-sauna-benefits-preload-{{ ai_gen_id }}">
      {% if block.settings.performance_image %}
        <img src="{{ block.settings.performance_image | image_url: width: 2000 }}" alt="">
      {% endif %}
      {% if block.settings.performance_image_mobile %}
        <img src="{{ block.settings.performance_image_mobile | image_url: width: 1000 }}" alt="">
      {% endif %}
      {% if block.settings.health_image %}
