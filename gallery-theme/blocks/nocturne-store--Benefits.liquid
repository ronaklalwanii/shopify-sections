      {% endif %}
      {% if block.settings.health_image_mobile %}
        <img src="{{ block.settings.health_image_mobile | image_url: width: 1000 }}" alt="">
      {% endif %}
      {% if block.settings.longevity_image %}
        <img src="{{ block.settings.longevity_image | image_url: width: 2000 }}" alt="">
      {% endif %}
      {% if block.settings.longevity_image_mobile %}
        <img src="{{ block.settings.longevity_image_mobile | image_url: width: 1000 }}" alt="">
      {% endif %}
    </div>
  </div>
</sauna-benefits-{{ ai_gen_id }}>

<script>
  (function() {
    class SaunaBenefits{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = this.querySelectorAll('.ai-sauna-benefits-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-sauna-benefits-tab-content-{{ ai_gen_id }}');
        this.indicator = this.querySelector('.ai-sauna-benefits-tab-indicator-{{ ai_gen_id }}');
        this.animationEnabled = {{ block.settings.enable_animation }};
        this.tabStyle = '{{ block.settings.tab_style }}';
      }

      connectedCallback() {
        if (this.indicator && this.tabStyle !== 'pills') {
          this.updateIndicator(this.querySelector('.ai-sauna-benefits-tab-{{ ai_gen_id }}.active'));
        }
        
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => this.switchTab(tab));
        });

        window.addEventListener('resize', () => {
          const activeTab = this.querySelector('.ai-sauna-benefits-tab-{{ ai_gen_id }}.active');
          if (activeTab && this.indicator && this.tabStyle !== 'pills') {
            this.updateIndicator(activeTab);
          }
        });
      }

      switchTab(clickedTab) {
        const targetTab = clickedTab.dataset.tab;
        
        this.tabs.forEach((tab) => tab.classList.remove('active'));
        clickedTab.classList.add('active');

        if (this.indicator && this.tabStyle !== 'pills') {
          this.updateIndicator(clickedTab);
        }

        this.contents.forEach((content) => {
          if (content.dataset.content === targetTab) {
            if (this.animationEnabled) {
              setTimeout(() => {
                content.classList.add('active');
              }, 100);
            } else {
              content.classList.add('active');
            }
          } else {
            content.classList.remove('active');
          }
        });
      }

      updateIndicator(activeTab) {
        const tabRect = activeTab.getBoundingClientRect();
        const containerRect = activeTab.parentElement.getBoundingClientRect();
        const offsetLeft = tabRect.left - containerRect.left;
        
        this.indicator.style.width = tabRect.width + 'px';
        this.indicator.style.transform = 'translateX(' + offsetLeft + 'px)';
      }
    }

    customElements.define('sauna-benefits-{{ ai_gen_id }}', SaunaBenefits{{ ai_gen_id }});
  })();
</script>

