</editorial-lifestyle-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLifestyle{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeCards();
      }

      initializeCards() {
        const cards = this.querySelectorAll('.ai-editorial-lifestyle-card-{{ ai_gen_id }}');
        
        cards.forEach(card => {
          card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
          });
          
          card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
          });
        });
      }
    }

    customElements.define('editorial-lifestyle-{{ ai_gen_id }}', EditorialLifestyle{{ ai_gen_id }});
  })();
</script>

