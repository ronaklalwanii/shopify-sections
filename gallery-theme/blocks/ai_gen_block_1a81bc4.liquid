        {% else %}
          <div class="ai-editorial-lifestyle-card-{{ ai_gen_id }}">
        {% endif %}
          {% if block.settings.card_3_desktop_image != blank %}
            <picture>
              {% if block.settings.card_3_mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.card_3_mobile_image | image_url: width: 800 }}"
                >
              {% endif %}
              <img
                src="{{ block.settings.card_3_desktop_image | image_url: width: 1200 }}"
