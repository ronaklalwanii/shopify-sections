      .ai-header-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: 2px;
        background-color: {{ block.settings.icon_color }};
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
