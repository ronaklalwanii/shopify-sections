          <a href="/">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
              loading="eager"
            >
          </a>
        {% else %}
          <a href="/" style="font-size: 20px; font-weight: bold; color: {{ block.settings.menu_text_color }};">
            {{ shop.name }}
          </a>
        {% endif %}
      </div>

      <nav class="ai-header-nav-{{ ai_gen_id }}">
        {% if block.settings.menu != blank %}
          {% for link in block.settings.menu.links %}
            <a href="{{ link.url }}" class="ai-header-nav-link-{{ ai_gen_id }}">
              {{ link.title }}
            </a>
          {% endfor %}
        {% endif %}
        
        {% if block.settings.show_loyalty_button %}
          <a href="{{ block.settings.loyalty_link }}" class="ai-header-loyalty-btn-{{ ai_gen_id }}">
