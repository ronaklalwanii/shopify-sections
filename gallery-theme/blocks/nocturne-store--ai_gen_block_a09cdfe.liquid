            <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
            <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
          {% endif %}
        </div>
      </button>

      <div class="ai-header-logo-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <a href="/">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
              loading="eager"
            >
          </a>
        {% else %}
          <a href="/" style="font-size: 24px; font-weight: bold; color: {{ block.settings.menu_text_color }};">
            {{ shop.name }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-header-center-{{ ai_gen_id }}">
