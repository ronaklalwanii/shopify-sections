      .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        width: 50%;
        transform: translateY(-50%) rotate(-45deg);
        transform-origin: left center;
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        transform: translateY(-50%) translateX(5px);
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        width: 50%;
        transform: translateY(50%) rotate(45deg);
        transform-origin: left center;
      }
    {% elsif block.settings.hamburger_style == 'minimal' %}
      .ai-header-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: 2px;
        background-color: {{ block.settings.icon_color }};
        transition: all 0.3s ease;
        left: 0;
      }

      .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 25%;
      }

      .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 75%;
      }

      .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(3) {
        display: none;
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-line-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translateY(-50%) rotate(-45deg);
      }
    {% elsif block.settings.hamburger_style == 'dots' %}
      .ai-header-hamburger-dot-{{ ai_gen_id }} {
        position: absolute;
        width: 4px;
        height: 4px;
        background-color: {{ block.settings.icon_color }};
        border-radius: 50%;
        transition: all 0.3s ease;
        left: 50%;
        transform: translateX(-50%);
      }

      .ai-header-hamburger-dot-{{ ai_gen_id }}:nth-child(1) {
        top: 0;
      }

      .ai-header-hamburger-dot-{{ ai_gen_id }}:nth-child(2) {
        top: 50%;
        transform: translate(-50%, -50%);
      }

      .ai-header-hamburger-dot-{{ ai_gen_id }}:nth-child(3) {
        bottom: 0;
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-dot-{{ ai_gen_id }}:nth-child(1) {
        top: 50%;
        left: 25%;
        transform: translate(-50%, -50%);
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-dot-{{ ai_gen_id }}:nth-child(2) {
        opacity: 0;
      }

      .ai-header-menu-button-{{ ai_gen_id }}.active .ai-header-hamburger-dot-{{ ai_gen_id }}:nth-child(3) {
        bottom: 50%;
        left: 75%;
        transform: translate(-50%, 50%);
      }
    {% elsif block.settings.hamburger_style == 'squeeze' %}
      .ai-header-hamburger-line-{{ ai_gen_id }} {
        position: absolute;
        width: 100%;
        height: 2px;
