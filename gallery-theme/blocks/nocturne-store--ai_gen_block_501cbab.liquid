{% doc %}
  @prompt
    Create an animated image card section which overlap eachother slightly and are diagonally split with a heading title above them and a clickable button below the section, use store fonts and make them overlap on mobile, by clicking an image on mobile to animates to the next card
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-diagonal-cards-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-diagonal-cards__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-diagonal-cards__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 60px;
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-style: {{ settings.heading_font.style }};
    letter-spacing: {{ settings.heading_letter_spacing }}%;
    text-transform: {{ settings.heading_text_transform }};
  }

  .ai-diagonal-cards__cards-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }

  .ai-diagonal-cards__card-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.card_width }}px;
    height: {{ block.settings.card_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    cursor: pointer;
  }

  .ai-diagonal-cards__card-{{ ai_gen_id }}:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 1.5 | divided_by: 100.0 }});
  }

  .ai-diagonal-cards__card-{{ ai_gen_id }}:nth-child(2) {
    margin-top: {{ block.settings.overlap_offset }}px;
  }

  .ai-diagonal-cards__card-{{ ai_gen_id }}:nth-child(3) {
    margin-top: {{ block.settings.overlap_offset | times: 2 }}px;
  }

  .ai-diagonal-cards__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    width: 100%;
    height: 100%;
    clip-path: polygon(0 0, 100% 0, 100% {{ block.settings.diagonal_split }}%, 0 100%);
  }

  .ai-diagonal-cards__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-diagonal-cards__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-diagonal-cards__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-diagonal-cards__overlay-{{ ai_gen_id }} {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, {{ block.settings.overlay_color_1 }} 0%, {{ block.settings.overlay_color_2 }} 100%);
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    clip-path: polygon(0 100%, 100% {{ block.settings.diagonal_split }}%, 100% 100%);
  }

  .ai-diagonal-cards__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 30px;
    right: 30px;
    color: {{ block.settings.card_text_color }};
    z-index: 2;
  }

  .ai-diagonal-cards__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    margin: 0 0 10px;
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-style: {{ settings.heading_font.style }};
  }

  .ai-diagonal-cards__card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    margin: 0;
    line-height: 1.5;
    font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
    font-weight: {{ settings.text_font.weight }};
    font-style: {{ settings.text_font.style }};
  }

  .ai-diagonal-cards__button-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.button_alignment }};
  }

  .ai-diagonal-cards__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_background }};
    font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
  }

  .ai-diagonal-cards__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-diagonal-cards__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
  }

  @media screen and (max-width: 989px) {
    .ai-diagonal-cards__cards-wrapper-{{ ai_gen_id }} {
      position: relative;
      flex-direction: column;
      gap: 0;
      align-items: center;
      height: {{ block.settings.card_height }}px;
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }} {
      position: absolute;
      width: 90%;
      max-width: 400px;
      opacity: 0;
      transform: translateX(100%);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }}.active {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
      z-index: 3;
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }}.prev {
      opacity: 0.3;
      transform: translateX(-20px) scale(0.95);
      z-index: 1;
      pointer-events: none;
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }}.next {
      opacity: 0.3;
      transform: translateX(20px) scale(0.95);
      z-index: 2;
      pointer-events: none;
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }}:nth-child(2),
    .ai-diagonal-cards__card-{{ ai_gen_id }}:nth-child(3) {
      margin-top: 0;
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }}:hover {
      transform: translateX(0) scale(1);
    }

    .ai-diagonal-cards__card-{{ ai_gen_id }}.active:hover {
      transform: translateX(0) scale(1);
    }

    .ai-diagonal-cards__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: 40px;
    }

    .ai-diagonal-cards__cards-wrapper-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-diagonal-cards-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-diagonal-cards__content-{{ ai_gen_id }} {
      bottom: 20px;
      left: 20px;
      right: 20px;
    }

    .ai-diagonal-cards__card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.8 }}px;
    }

    .ai-diagonal-cards__card-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<diagonal-cards-{{ ai_gen_id }} class="ai-diagonal-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-diagonal-cards__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-diagonal-cards__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-diagonal-cards__cards-wrapper-{{ ai_gen_id }}" data-card-container>
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign title_key = 'card_' | append: i | append: '_title'
          assign text_key = 'card_' | append: i | append: '_text'
          
          assign card_image = block.settings[image_key]
          assign card_title = block.settings[title_key]
          assign card_text = block.settings[text_key]
        %}

        <div class="ai-diagonal-cards__card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
          <div class="ai-diagonal-cards__image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                class="ai-diagonal-cards__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-diagonal-cards__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-diagonal-cards__overlay-{{ ai_gen_id }}"></div>

          {% if card_title != blank or card_text != blank %}
            <div class="ai-diagonal-cards__content-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3 class="ai-diagonal-cards__card-title-{{ ai_gen_id }}">
                  {{ card_title }}
                </h3>
              {% endif %}
              {% if card_text != blank %}
                <p class="ai-diagonal-cards__card-text-{{ ai_gen_id }}">
                  {{ card_text }}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if card_image == blank %}
            <div class="ai-diagonal-cards__empty-state-{{ ai_gen_id }}">
              Add image for card {{ i }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.button_text != blank %}
      <div class="ai-diagonal-cards__button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_link }}"
          class="ai-diagonal-cards__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</diagonal-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class DiagonalCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cards = [];
        this.isMobile = false;
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('[data-card-index]'));
        this.checkMobile();
        this.updateCards();
        this.setupEventListeners();
        
        window.addEventListener('resize', () => {
          this.checkMobile();
          this.updateCards();
        });
      }

      checkMobile() {
        this.isMobile = window.innerWidth <= 989;
      }

      setupEventListeners() {
        this.cards.forEach((card) => {
          card.addEventListener('click', () => {
            if (this.isMobile) {
              this.nextCard();
            }
          });
        });
      }

      nextCard() {
        this.currentIndex = (this.currentIndex + 1) % this.cards.length;
        this.updateCards();
      }

      updateCards() {
        if (!this.isMobile) {
          this.cards.forEach((card) => {
            card.classList.remove('active', 'prev', 'next');
          });
          return;
        }

        this.cards.forEach((card, index) => {
          card.classList.remove('active', 'prev', 'next');
          
          if (index === this.currentIndex) {
            card.classList.add('active');
          } else if (index === (this.currentIndex - 1 + this.cards.length) % this.cards.length) {
            card.classList.add('prev');
          } else if (index === (this.currentIndex + 1) % this.cards.length) {
            card.classList.add('next');
          }
        });
      }
    }

    customElements.define('diagonal-cards-{{ ai_gen_id }}', DiagonalCards{{ ai_gen_id }});
  })();
</script>

